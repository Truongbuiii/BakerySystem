@implements IDisposable
@inherits LayoutComponentBase
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject IServiceScopeFactory ScopeFactory
@inject WebCartService CartService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="shop-shell">
    <header class="shop-header">
        <div class="shop-header-inner">
            <!-- Brand & Navigation -->
            <div class="shop-header-left">
                <a href="/" class="shop-brand" title="BakeryShop - Tiệm bánh tươi">
                    <img src="/assets/images/logos/shop-logo.svg" alt="BakeryShop" class="shop-brand-logo" />
                </a>

                <span class="shop-header-divider" aria-hidden="true"></span>

                <nav class="shop-nav" aria-label="Điều hướng cửa hàng">
                    <NavLink href="/" Match="NavLinkMatch.All" class="shop-nav-link" ActiveClass="active">
                        <iconify-icon icon="solar:shop-2-bold" class="text-base"></iconify-icon>
                        <span>Thực đơn</span>
                    </NavLink>
                    <NavLink href="/my-orders" class="shop-nav-link" ActiveClass="active">
                        <iconify-icon icon="solar:bag-heart-bold" class="text-base"></iconify-icon>
                        <span>Đơn hàng của tôi</span>
                        @if (customerPendingConfirmCount > 0)
                        {
                            <span class="shop-nav-badge shop-nav-badge-success">@customerPendingConfirmCount</span>
                        }
                        else if (customerActiveOrdersCount > 0)
                        {
                            <span class="shop-nav-badge shop-nav-badge-primary">@customerActiveOrdersCount</span>
                        }
                    </NavLink>
                </nav>
            </div>

            <!-- Right Actions -->
            <div class="shop-header-right">
                <button type="button" @onclick="GoToCartAsync" class="shop-cart-pill" title="Xem giỏ hàng hiện tại">
                    <iconify-icon icon="solar:cart-large-2-bold" class="text-lg"></iconify-icon>
                    <span class="shop-cart-pill-label">Giỏ hàng</span>
                    <span class="shop-cart-pill-count @(CartService.TotalItemsCount > 0 ? "has-items" : "")">
                        @CartService.TotalItemsCount
                    </span>
                </button>

                <AuthorizeView Roles="Customer">
                    <Authorized>
                        <!-- Notifications Dropdown -->
                        <div class="relative">
                            <button type="button"
                                    data-dropdown-trigger
                                    onclick="window.bakeryAdmin.toggleDropdown('notif-dropdown')"
                                    class="shop-icon-btn"
                                    title="Thông báo đơn hàng">
                                <iconify-icon icon="solar:bell-linear" class="text-xl"></iconify-icon>
                                @if (customerAlertOrders.Count > 0)
                                {
                                    <span class="shop-notif-dot"></span>
                                }
                            </button>
                            <div id="notif-dropdown" data-admin-dropdown class="bakery-notification-dropdown hidden absolute right-0 mt-2 bg-white border border-border rounded-xl shadow-lg py-3 z-50">
                                <div class="px-4 pb-2.5 border-b border-border flex justify-between items-center">
                                    <span class="font-semibold text-sm text-dark">Cập nhật đơn hàng</span>
                                    <span class="bakery-badge bakery-badge-primary">@customerAlertOrders.Count mới</span>
                                </div>
                                <div class="divide-y divide-border max-h-64 overflow-y-auto">
                                    @if (customerAlertOrders.Count == 0)
                                    {
                                        <div class="px-4 py-6 text-center text-xs text-bodytext">
                                            Chưa có đơn hàng nào đang xử lý.
                                        </div>
                                    }
                                    @foreach (var order in customerAlertOrders)
                                    {
                                        var isDelivered = order.Status == OrderStatus.Delivered;
                                        <a href="/my-orders" class="px-4 py-3 hover:bg-lightprimary/40 cursor-pointer flex items-start gap-3 transition-colors">
                                            <span class="p-2 rounded-lg @(isDelivered ? "bg-lightsuccess text-success" : "bg-lightprimary text-primary") shrink-0">
                                                <iconify-icon icon="@(isDelivered ? "solar:delivery-bold" : "solar:bill-list-linear")" class="text-lg"></iconify-icon>
                                            </span>
                                            <div>
                                                <p class="text-xs font-semibold text-dark">
                                                    @(isDelivered ? $"Đơn #HD-{order.OrderID:D4} đã giao tới nơi!" : $"Đơn #HD-{order.OrderID:D4}: {GetCustomerOrderStatusText(order.Status)}")
                                                </p>
                                                <p class="text-[11px] text-bodytext">
                                                    @order.FinalAmount.ToString("N0")đ · @(isDelivered ? "Bấm để xác nhận đã nhận bánh" : "Đang được xử lý")
                                                </p>
                                                <span class="text-[10px] text-bodytext/70">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                                            </div>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Customer Profile Dropdown -->
                        @{
                            var displayName = context.User.FindFirst("FullName")?.Value ?? context.User.Identity?.Name ?? "Khách hàng";
                            var username = context.User.Identity?.Name ?? "customer";
                            var initials = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries) is { Length: > 1 } words
                                ? $"{words[0][0]}{words[^1][0]}".ToUpper()
                                : (displayName.Length >= 2 ? displayName[..2].ToUpper() : "KH");
                        }
                        <div class="relative">
                            <button type="button"
                                    data-dropdown-trigger
                                    onclick="window.bakeryAdmin.toggleDropdown('profile-dropdown')"
                                    class="shop-profile-btn">
                                <span class="shop-avatar">@initials</span>
                                <span class="shop-profile-meta">
                                    <span class="shop-profile-name">@displayName</span>
                                    <span class="shop-profile-role">Khách hàng</span>
                                </span>
                                <iconify-icon icon="solar:alt-arrow-down-linear" class="text-xs text-bodytext hidden sm:block"></iconify-icon>
                            </button>

                            <div id="profile-dropdown" data-admin-dropdown class="bakery-profile-dropdown hidden absolute right-0 mt-2 bg-white rounded-xl shadow-lg py-2 z-50 border border-border">
                                <div class="px-4 py-3 border-b border-border bg-slate-50/80 rounded-t-xl">
                                    <p class="text-sm font-semibold text-dark truncate">@displayName</p>
                                    <p class="text-xs text-bodytext truncate">@@@username</p>
                                    <span class="bakery-badge bakery-badge-warning mt-1.5 inline-block text-[10px] py-0.5 px-2">Khách hàng</span>
                                </div>
                                <div class="p-2 flex flex-col gap-1">
                                    <a href="/profile" class="px-3 py-2 text-sm text-dark hover:bg-lightprimary hover:text-primary rounded-lg flex items-center gap-2.5 transition-colors">
                                        <iconify-icon icon="solar:user-circle-linear" class="text-base"></iconify-icon>
                                        <span>Hồ sơ cá nhân</span>
                                    </a>
                                    <a href="/my-orders" class="px-3 py-2 text-sm text-dark hover:bg-lightprimary hover:text-primary rounded-lg flex items-center gap-2.5 transition-colors">
                                        <iconify-icon icon="solar:bag-heart-linear" class="text-base"></iconify-icon>
                                        <span>Đơn hàng của tôi</span>
                                    </a>
                                </div>
                                <div class="border-t border-border p-2">
                                    <button type="button"
                                            @onclick="LogoutAsync"
                                            class="w-full text-left px-3 py-2 text-sm text-error hover:bg-lighterror/50 rounded-lg flex items-center gap-2.5 transition-colors cursor-pointer font-medium bg-transparent border-0">
                                        <iconify-icon icon="solar:logout-2-linear" class="text-base"></iconify-icon>
                                        <span>Đăng xuất</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="shop-guest-actions">
                            <a href="/login" class="bakery-btn bakery-btn-outline bakery-btn-sm">
                                Đăng nhập
                            </a>
                            <a href="/login?mode=register" class="bakery-btn bakery-btn-primary bakery-btn-sm shop-register-btn">
                                Đăng ký
                            </a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <main class="shop-main">
        <div class="shop-main-container">
            @Body
        </div>
    </main>

    <footer class="shop-footer">
        <div class="shop-footer-inner">
            <span>&copy; @DateTime.Now.Year BakerySystem Shop — Tiệm bánh tươi thủ công mỗi ngày.</span>
            <span class="shop-footer-links">
                <a href="/">Thực đơn</a>
                <span>·</span>
                <a href="/my-orders">Tra cứu đơn hàng</a>
                <span>·</span>
                <a href="/profile">Tài khoản khách hàng</a>
            </span>
        </div>
    </footer>
</div>

<div id="bakery-toast-container" class="bakery-toast-container"></div>

@code {
    private int customerActiveOrdersCount;
    private int customerPendingConfirmCount;
    private List<Order> customerAlertOrders = [];
    private CancellationTokenSource? _pollCts;
    private bool _idleTimerStarted;

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += HandleCartChanged;
        await LoadCustomerSummaryAsync();
        StartCustomerPolling();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_idleTimerStarted)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                _idleTimerStarted = true;
                try
                {
                    await JS.InvokeVoidAsync("bakeryShopLayout.startIdleTimer", 60 * 60 * 1000);
                }
                catch { }
            }
        }
    }

    private void StartCustomerPolling()
    {
        _pollCts = new CancellationTokenSource();
        var token = _pollCts.Token;
        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            try
            {
                while (await timer.WaitForNextTickAsync(token))
                {
                    await LoadCustomerSummaryAsync();
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException)
            {
                // Ignored when layout disposes
            }
        }, token);
    }

    private async Task LoadCustomerSummaryAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated != true || !user.IsInRole(AccountRole.Customer))
            {
                customerActiveOrdersCount = 0;
                customerPendingConfirmCount = 0;
                customerAlertOrders = [];
                return;
            }

            var accountIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (!int.TryParse(accountIdClaim, out int accountId))
                return;

            using var scope = ScopeFactory.CreateScope();
            var authService = scope.ServiceProvider.GetRequiredService<IAuthService>();
            var customer = await authService.GetCustomerByAccountIdAsync(accountId);
            if (customer == null)
                return;

            var customerOrderService = scope.ServiceProvider.GetRequiredService<CustomerOrderService>();
            var orders = await customerOrderService.GetOrdersAsync(customer.CustomerId, null);

            customerPendingConfirmCount = orders.Count(o => o.Status == OrderStatus.Delivered);
            customerActiveOrdersCount = orders.Count(o => o.Status is OrderStatus.Pending or OrderStatus.Confirmed or OrderStatus.Delivered);
            customerAlertOrders = orders
                .Where(o => o.Status is OrderStatus.Delivered or OrderStatus.Confirmed or OrderStatus.Pending)
                .OrderByDescending(o => o.Status == OrderStatus.Delivered)
                .ThenByDescending(o => o.OrderDate)
                .Take(6)
                .ToList();
        }
        catch
        {
            // Keep UI stable if transient DB issue occurs during background poll
        }
    }

    private void HandleCartChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task GoToCartAsync()
    {
        var scrolled = await JS.InvokeAsync<bool>("bakeryShopLayout.scrollToCart");
        if (!scrolled)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task LogoutAsync()
    {
        CartService.Clear();
        await JS.InvokeVoidAsync("bakeryShopLayout.logout");
    }

    private static string GetCustomerOrderStatusText(string status) => status switch
    {
        OrderStatus.Pending => "Chờ cửa hàng duyệt",
        OrderStatus.Confirmed => "Đã duyệt, chuẩn bị giao",
        OrderStatus.Delivered => "Đã giao tới nơi",
        OrderStatus.Completed => "Đã hoàn tất",
        OrderStatus.Cancelled => "Đã hủy",
        _ => status
    };

    public void Dispose()
    {
        CartService.OnChange -= HandleCartChanged;
        _pollCts?.Cancel();
        _pollCts?.Dispose();
    }
}
