@page "/"
@inject IBakeryDbContext DbContext
@inject CartService CartService
@inject IJSRuntime JS
@implements IDisposable

<!-- 1. Mobile Top Header -->
<header class="mobile-header">
    <div class="header-top">
        <div class="location-box">
            <span class="location-label">
                <iconify-icon icon="solar:map-point-wave-bold" style="color: #E76F51; font-size: 14px;"></iconify-icon> Giao đến
            </span>
            <div class="location-value">
                <span>123 Lê Lợi, Bến Thành, Q.1</span>
                <iconify-icon icon="solar:alt-arrow-down-linear" style="font-size: 14px; color: #6E6259;"></iconify-icon>
            </div>
        </div>

        <div class="header-actions">
            <!-- Order / Search icon -->
            <button class="header-icon-btn" @onclick='() => SwitchTab("orders")' title="Đơn hàng">
                <iconify-icon icon="solar:bag-heart-linear"></iconify-icon>
            </button>

            <!-- Cart icon with dynamic badge -->
            <button class="header-icon-btn" @onclick="OpenCart" title="Giỏ hàng">
                <iconify-icon icon="solar:cart-large-2-linear"></iconify-icon>
                @if (CartService.TotalItemsCount > 0)
                {
                    <span class="badge-counter">@CartService.TotalItemsCount</span>
                }
            </button>
        </div>
    </div>
</header>

<!-- 2. Main Mobile Scrollable Content Area -->
<div class="mobile-content-area no-scrollbar">

    @if (currentTab == "home")
    {
        <!-- Greeting & Subtitle -->
        <div style="padding: 14px 18px 4px;">
            <p style="margin: 0; font-size: 12px; color: #9C8E84; font-weight: 600;">Chào mừng trở lại</p>
            <h4 style="margin: 2px 0 0; font-size: 19px; font-weight: 800; color: #2B2118;">Thực đơn bánh tươi hôm nay</h4>
        </div>

        <!-- Search Input Bar -->
        <div class="search-container">
            <div class="mobile-search-box">
                <iconify-icon icon="solar:magnifer-linear" style="font-size: 18px; color: #9C8E84;"></iconify-icon>
                <input type="text" class="mobile-search-input" placeholder="Tìm bánh kem sinh nhật, bánh mì bơ, tiramisu..."
                       @bind="searchQuery" @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <iconify-icon icon="solar:close-circle-bold" style="font-size: 16px; color: #9C8E84; cursor: pointer;" @onclick="() => searchQuery = string.Empty"></iconify-icon>
                }
            </div>
        </div>

        <!-- Promo Banner Carousel / Card -->
        <div class="promo-banner">
            <span class="promo-badge">Ưu Đãi Hôm Nay</span>
            <h3 class="promo-title">Giảm 10% Cho Đơn Bánh Mới</h3>
            <p class="promo-subtitle">Nhập mã ưu đãi <strong style="text-decoration: underline;">BAKERY2026</strong> khi thanh toán giỏ hàng.</p>
            <button class="promo-btn" @onclick="ApplyPromoDirectly">
                <span>Dùng mã ngay</span>
                <iconify-icon icon="solar:arrow-right-linear" style="font-size: 12px;"></iconify-icon>
            </button>
            <iconify-icon icon="solar:cake-bold" class="promo-decor-icon"></iconify-icon>
        </div>

        <!-- Categories Horizontal Pills -->
        <div class="category-section">
            <div class="section-header">
                <h5 class="section-title">Loại Sản Phẩm</h5>
                <span class="section-link" @onclick='() => SwitchTab("menu")'>Xem tất cả</span>
            </div>

            <div class="category-scroll-container no-scrollbar">
                <button class="category-pill @(selectedCategoryId == 0 ? "active" : "")" @onclick="() => SelectCategory(0)">
                    <iconify-icon icon="solar:star-fall-bold"></iconify-icon>
                    <span>Tất cả</span>
                </button>
                @foreach (var cat in categories)
                {
                    <button class="category-pill @(selectedCategoryId == cat.CategoryID ? "active" : "")" @onclick="() => SelectCategory(cat.CategoryID)">
                        <iconify-icon icon="@GetCategoryIcon(cat.CategoryName)"></iconify-icon>
                        <span>@cat.CategoryName</span>
                    </button>
                }
            </div>
        </div>

        <!-- Products 2-Column Grid -->
        <div class="products-grid-section">
            <div class="section-header">
                <h5 class="section-title">
                    @(selectedCategoryId == 0 ? "Bánh Tươi Trong Ngày" : categories.FirstOrDefault(c => c.CategoryID == selectedCategoryId)?.CategoryName ?? "Sản phẩm")
                </h5>
                <span style="font-size: 11px; color: #9C8E84; font-weight: 600;">@FilteredProducts.Count() món</span>
            </div>

            @if (!FilteredProducts.Any())
            {
                <div style="text-align: center; padding: 30px 10px; color: #9C8E84;">
                    <iconify-icon icon="solar:cup-paper-linear" style="font-size: 40px; margin-bottom: 6px;"></iconify-icon>
                    <p style="font-size: 13px; margin: 0;">Không tìm thấy món bánh phù hợp với từ khóa này.</p>
                </div>
            }
            else
            {
                <div class="product-grid">
                    @foreach (var prod in FilteredProducts)
                    {
                        <div class="mobile-product-card" @onclick="() => OpenProductModal(prod)">
                            <div class="product-img-wrap">
                                <img src="@GetProductImageUrl(prod)" alt="@prod.ProductName" class="product-img" style="@(prod.Quantity <= 0 ? "opacity: 0.5; filter: grayscale(40%);" : "")" onerror="this.src='http://localhost:5149/assets/images/products/default-bakery.svg';" />
                                <span class="product-tag">@prod.Category?.CategoryName</span>
                                @if (prod.Quantity <= 0)
                                {
                                    <span class="stock-badge stock-badge-out">Hết bánh</span>
                                }
                                else if (prod.Quantity <= 5)
                                {
                                    <span class="stock-badge stock-badge-low">Chỉ còn @prod.Quantity</span>
                                }
                            </div>
                            <div class="product-info">
                                <span class="product-category">Thủ công</span>
                                <h6 class="product-name">@prod.ProductName</h6>
                                <div class="product-price-row">
                                    <span class="product-price">@($"{prod.Price:N0}đ")</span>
                                    @if (prod.Quantity > 0)
                                    {
                                        <button class="btn-quick-add" @onclick:stopPropagation="true" @onclick="() => QuickAddToCart(prod)" title="Thêm nhanh">
                                            <iconify-icon icon="solar:add-linear"></iconify-icon>
                                        </button>
                                    }
                                    else
                                    {
                                        <span style="font-size: 11px; font-weight: 700; color: #9C8E84; background: #F1ECE6; padding: 4px 8px; border-radius: 8px;">Hết hàng</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (currentTab == "menu")
    {
        <!-- Full Menu Tab -->
        <div style="padding: 14px 18px;">
            <h4 style="margin: 0 0 4px; font-size: 19px; font-weight: 800; color: #2B2118;">Thực Đơn Bánh Tươi</h4>
            <p style="margin: 0 0 12px; font-size: 12px; color: #9C8E84;">Danh mục các món bánh nướng mới phục vụ trong ngày</p>

            <!-- Search in Menu -->
            <div class="mobile-search-box" style="margin-bottom: 14px;">
                <iconify-icon icon="solar:magnifer-linear" style="font-size: 18px; color: #9C8E84;"></iconify-icon>
                <input type="text" class="mobile-search-input" placeholder="Lọc theo tên món bánh..."
                       @bind="searchQuery" @bind:event="oninput" />
            </div>

            <!-- Categories Horizontal Pills -->
            <div class="category-scroll-container no-scrollbar" style="margin-bottom: 14px;">
                <button class="category-pill @(selectedCategoryId == 0 ? "active" : "")" @onclick="() => SelectCategory(0)">
                    <span>Tất cả</span>
                </button>
                @foreach (var cat in categories)
                {
                    <button class="category-pill @(selectedCategoryId == cat.CategoryID ? "active" : "")" @onclick="() => SelectCategory(cat.CategoryID)">
                        <span>@cat.CategoryName</span>
                    </button>
                }
            </div>

            <!-- Products Grid in Menu -->
            <div class="product-grid">
                @foreach (var prod in FilteredProducts)
                {
                    <div class="mobile-product-card" @onclick="() => OpenProductModal(prod)">
                        <div class="product-img-wrap">
                            <img src="@GetProductImageUrl(prod)" alt="@prod.ProductName" class="product-img" style="@(prod.Quantity <= 0 ? "opacity: 0.5; filter: grayscale(40%);" : "")" onerror="this.src='http://localhost:5149/assets/images/products/default-bakery.svg';" />
                            <span class="product-tag">@prod.Category?.CategoryName</span>
                            @if (prod.Quantity <= 0)
                            {
                                <span class="stock-badge stock-badge-out">Hết bánh</span>
                            }
                            else if (prod.Quantity <= 5)
                            {
                                <span class="stock-badge stock-badge-low">Chỉ còn @prod.Quantity</span>
                            }
                        </div>
                        <div class="product-info">
                            <h6 class="product-name">@prod.ProductName</h6>
                            <p style="font-size: 11px; color: #9C8E84; margin: 0 0 6px; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;">@prod.Description</p>
                            <div class="product-price-row">
                                <span class="product-price">@($"{prod.Price:N0}đ")</span>
                                @if (prod.Quantity > 0)
                                {
                                    <button class="btn-quick-add" @onclick:stopPropagation="true" @onclick="() => QuickAddToCart(prod)">
                                        <iconify-icon icon="solar:add-linear"></iconify-icon>
                                    </button>
                                }
                                else
                                {
                                    <span style="font-size: 11px; font-weight: 700; color: #9C8E84; background: #F1ECE6; padding: 4px 8px; border-radius: 8px;">Hết hàng</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (currentTab == "orders")
    {
        <!-- Customer Orders Tab (Real DB Data) -->
        <div style="padding: 14px 18px;">
            <h4 style="margin: 0 0 4px; font-size: 19px; font-weight: 800; color: #2B2118;">Đơn Hàng Của Tôi</h4>
            <p style="margin: 0 0 14px; font-size: 12px; color: #9C8E84;">Theo dõi tiến độ thực hiện và giao hàng theo thời gian thực</p>

            @if (customerOrders == null || !customerOrders.Any())
            {
                <div style="text-align: center; padding: 40px 10px; background: white; border-radius: 16px; border: 1px solid var(--bk-border);">
                    <iconify-icon icon="solar:box-minimalistic-linear" style="font-size: 48px; color: #C0B4A9; margin-bottom: 8px;"></iconify-icon>
                    <h6 style="margin: 0 0 4px; font-weight: 700; color: #2B2118;">Bạn chưa có đơn hàng nào</h6>
                    <p style="margin: 0 0 14px; font-size: 12px; color: #9C8E84;">Hãy chọn ngay những chiếc bánh thơm ngon và đặt hàng nhé!</p>
                    <button class="btn-bk-primary" style="width: auto; padding: 8px 20px;" @onclick='() => SwitchTab("home")'>Khám phá bánh ngay</button>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    @foreach (var order in customerOrders)
                    {
                        <div style="background: white; border-radius: 16px; border: 1px solid var(--bk-border); padding: 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px solid #F4EFEA;">
                                <div>
                                    <span style="font-size: 13px; font-weight: 800; color: #2B2118;">Đơn #@order.OrderID</span>
                                    <div style="font-size: 11px; color: #9C8E84;">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                                <div>
                                    <span class="order-status-badge @GetStatusCssClass(order.Status)">
                                        <iconify-icon icon="@GetStatusIcon(order.Status)"></iconify-icon>
                                        @GetStatusText(order.Status)
                                    </span>
                                </div>
                            </div>

                            <!-- List items summary -->
                            <div style="margin-bottom: 10px;">
                                @foreach (var detail in order.OrderDetails)
                                {
                                    <div style="display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 4px;">
                                        <span style="color: #2B2118; font-weight: 600;">@detail.Quantity x @detail.Product?.ProductName</span>
                                        <span style="color: #6E6259; font-weight: 700;">@($"{detail.SubTotal:N0}đ")</span>
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(order.Note))
                            {
                                <div style="font-size: 11px; color: #E76F51; background: #FFF5EE; padding: 6px 10px; border-radius: 8px; margin-bottom: 10px;">
                                    <strong>Ghi chú:</strong> @order.Note
                                </div>
                            }

                            <!-- Footer with total and payment -->
                            <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 8px; border-top: 1px dashed #EAE3D8;">
                                <div style="font-size: 11px; color: #9C8E84;">
                                    PTTT: <strong style="color: #2B2118;">@order.PaymentMethod</strong>
                                    <span style="margin-left: 4px; color: @(order.PaymentStatus == PaymentStatus.Paid ? "#16A34A" : "#D97706"); font-weight: 600;">
                                        (@(order.PaymentStatus == PaymentStatus.Paid ? "Đã thanh toán" : "Chưa thanh toán"))
                                    </span>
                                </div>
                                <div style="text-align: right;">
                                    <span style="font-size: 11px; color: #9C8E84;">Tổng cộng: </span>
                                    <span style="font-size: 14px; font-weight: 800; color: #E76F51;">@($"{order.FinalAmount:N0}đ")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (currentTab == "profile")
    {
        <!-- Customer Profile Tab -->
        <div style="padding: 14px 18px;">
            <!-- VIP Member Profile Card -->
            <div style="background: linear-gradient(135deg, #2B2118 0%, #463428 100%); border-radius: 20px; padding: 20px; color: white; margin-bottom: 16px; box-shadow: 0 10px 25px rgba(43,33,24,0.25);">
                <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 14px;">
                    <div style="width: 52px; height: 52px; border-radius: 50%; background: #F4A261; color: #2B2118; font-weight: 700; font-size: 18px; display: flex; align-items: center; justify-content: center; border: 2px solid rgba(255,255,255,0.2);">HA</div>
                    <div>
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <h5 style="margin: 0; font-size: 16px; font-weight: 800;">Nguyễn Hoàng Anh</h5>
                            <span style="background: #F4A261; color: #2B2118; font-size: 10px; font-weight: 800; padding: 2px 6px; border-radius: 10px;">VIP BẠC</span>
                        </div>
                        <p style="margin: 2px 0 0; font-size: 12px; color: #D5C8BD;">0912 345 678 • Khách hàng thân thiết</p>
                    </div>
                </div>

                <div style="display: flex; justify-content: space-around; background: rgba(255,255,255,0.08); border-radius: 12px; padding: 10px;">
                    <div style="text-align: center;">
                        <span style="font-size: 11px; color: #C0B4A9;">Điểm tích lũy</span>
                        <div style="font-size: 15px; font-weight: 800; color: #F4A261;">450 điểm</div>
                    </div>
                    <div style="width: 1px; background: rgba(255,255,255,0.15);"></div>
                    <div style="text-align: center;">
                        <span style="font-size: 11px; color: #C0B4A9;">Voucher có sẵn</span>
                        <div style="font-size: 15px; font-weight: 800; color: #E76F51;">02 mã</div>
                    </div>
                    <div style="width: 1px; background: rgba(255,255,255,0.15);"></div>
                    <div style="text-align: center;">
                        <span style="font-size: 11px; color: #C0B4A9;">Đơn đã mua</span>
                        <div style="font-size: 15px; font-weight: 800; color: #2A9D8F;">@(customerOrders?.Count ?? 0) đơn</div>
                    </div>
                </div>
            </div>

            <!-- Profile Menu Options -->
            <div style="background: white; border-radius: 16px; border: 1px solid var(--bk-border); overflow: hidden; margin-bottom: 16px;">
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid #F4EFEA; cursor: pointer;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 32px; height: 32px; border-radius: 8px; background: #FFF5EE; color: #E76F51; display: flex; align-items: center; justify-content: center;">
                            <iconify-icon icon="solar:ticket-sale-bold"></iconify-icon>
                        </div>
                        <span style="font-size: 13px; font-weight: 700; color: #2B2118;">Kho Voucher Của Tôi</span>
                    </div>
                    <span style="font-size: 11px; font-weight: 700; color: #E76F51;">Mã BAKERY2026</span>
                </div>

                <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid #F4EFEA; cursor: pointer;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 32px; height: 32px; border-radius: 8px; background: #F0FDF4; color: #16A34A; display: flex; align-items: center; justify-content: center;">
                            <iconify-icon icon="solar:map-point-wave-bold"></iconify-icon>
                        </div>
                        <div>
                            <span style="font-size: 13px; font-weight: 700; color: #2B2118;">Sổ Địa Chỉ Giao Hàng</span>
                            <div style="font-size: 11px; color: #9C8E84;">123 Lê Lợi, Bến Thành, Q.1, TP.HCM</div>
                        </div>
                    </div>
                    <iconify-icon icon="solar:alt-arrow-right-linear" style="color: #9C8E84;"></iconify-icon>
                </div>

                <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; cursor: pointer;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 32px; height: 32px; border-radius: 8px; background: #FEF3C7; color: #D97706; display: flex; align-items: center; justify-content: center;">
                            <iconify-icon icon="solar:phone-calling-bold"></iconify-icon>
                        </div>
                        <div>
                            <span style="font-size: 13px; font-weight: 700; color: #2B2118;">Hotline Hỗ Trợ Đặt Bánh</span>
                            <div style="font-size: 11px; color: #9C8E84;">1900 8888 (07:00 - 22:00)</div>
                        </div>
                    </div>
                    <iconify-icon icon="solar:alt-arrow-right-linear" style="color: #9C8E84;"></iconify-icon>
                </div>
            </div>

            <!-- App info footer -->
            <div style="text-align: center; padding: 10px; color: #9C8E84; font-size: 11px;">
                Bakery Mobile Customer v1.0.0<br />
                .NET 10 MAUI Blazor Hybrid
            </div>
        </div>
    }

</div>

<!-- 3. Floating Cart Bar (khi có sản phẩm trong giỏ) -->
@if (CartService.TotalItemsCount > 0 && !isCartOpen)
{
    <div class="floating-cart-bar" @onclick="OpenCart">
        <div class="floating-cart-info">
            <div class="floating-cart-badge">@CartService.TotalItemsCount</div>
            <div class="floating-cart-text">
                <h6>Giỏ hàng • @($"{CartService.FinalAmount:N0}đ")</h6>
                <p>@GetCartSummaryText()</p>
            </div>
        </div>
        <button class="floating-cart-btn">
            <span>Xem giỏ hàng</span>
            <iconify-icon icon="solar:alt-arrow-right-linear"></iconify-icon>
        </button>
    </div>
}

<!-- 4. Fixed Bottom Navigation Bar -->
<nav class="mobile-bottom-nav">
    <div class="nav-tab-item @(currentTab == "home" ? "active" : "")" @onclick='() => SwitchTab("home")'>
        <iconify-icon icon="@(currentTab == "home" ? "solar:home-smile-bold" : "solar:home-smile-linear")"></iconify-icon>
        <span>Trang chủ</span>
    </div>

    <div class="nav-tab-item @(currentTab == "menu" ? "active" : "")" @onclick='() => SwitchTab("menu")'>
        <iconify-icon icon="@(currentTab == "menu" ? "solar:cup-bold" : "solar:cup-linear")"></iconify-icon>
        <span>Thực đơn</span>
    </div>

    <div class="nav-tab-item" @onclick="OpenCart">
        <div style="position: relative;">
            <iconify-icon icon="solar:bag-2-linear"></iconify-icon>
            @if (CartService.TotalItemsCount > 0)
            {
                <span class="badge-counter" style="top: -6px; right: -8px;">@CartService.TotalItemsCount</span>
            }
        </div>
        <span>Giỏ hàng</span>
    </div>

    <div class="nav-tab-item @(currentTab == "orders" ? "active" : "")" @onclick='() => SwitchTab("orders")'>
        <iconify-icon icon="@(currentTab == "orders" ? "solar:bill-list-bold" : "solar:bill-list-linear")"></iconify-icon>
        <span>Đơn hàng</span>
    </div>

    <div class="nav-tab-item @(currentTab == "profile" ? "active" : "")" @onclick='() => SwitchTab("profile")'>
        <iconify-icon icon="@(currentTab == "profile" ? "solar:user-bold" : "solar:user-linear")"></iconify-icon>
        <span>Tài khoản</span>
    </div>
</nav>

<!-- 5. Product Detail Modal (Bottom Sheet) -->
@if (selectedProduct != null)
{
    <div class="bottom-sheet-backdrop" @onclick="CloseProductModal">
        <div class="bottom-sheet-panel" @onclick:stopPropagation="true">
            <div class="sheet-handle"></div>
            <div class="sheet-header">
                <h5>Chi Tiết Món Bánh</h5>
                <button class="sheet-close-btn" @onclick="CloseProductModal">&times;</button>
            </div>

            <div class="sheet-body">
                <div style="width: 100%; height: 210px; border-radius: 16px; overflow: hidden; background: #FFF5EE; margin-bottom: 14px;">
                    <img src="@GetProductImageUrl(selectedProduct)" alt="@selectedProduct?.ProductName" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='http://localhost:5149/assets/images/products/default-bakery.svg';" />
                </div>

                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px;">
                    <div>
                        <span style="font-size: 11px; font-weight: 700; color: #E76F51; text-transform: uppercase;">@selectedProduct?.Category?.CategoryName</span>
                        <h4 style="margin: 2px 0 0; font-size: 17px; font-weight: 800; color: #2B2118;">@selectedProduct?.ProductName</h4>
                    </div>
                    <span style="font-size: 18px; font-weight: 800; color: #E76F51;">@($"{selectedProduct?.Price ?? 0:N0}đ")</span>
                </div>

                <p style="font-size: 13px; color: #6E6259; line-height: 1.5; margin-bottom: 16px;">
                    @selectedProduct?.Description
                </p>


                <!-- Quantity selector -->
                <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 10px; border-top: 1px solid var(--bk-border);">
                    <div>
                        <span style="font-size: 13px; font-weight: 700; color: #2B2118; display: block;">Số lượng:</span>
                        @if (selectedProduct != null)
                        {
                            @if (selectedProduct.Quantity <= 0)
                            {
                                <span style="font-size: 11px; font-weight: 700; color: #E63946;">⚠️ Tạm hết bánh hôm nay</span>
                            }
                            else if (selectedProduct.Quantity <= 5)
                            {
                                <span style="font-size: 11px; font-weight: 700; color: #D97706;">🔥 Chỉ còn @selectedProduct.Quantity cái trong ngày</span>
                            }
                            else
                            {
                                <span style="font-size: 11px; font-weight: 600; color: #9C8E84;">(Còn @selectedProduct.Quantity cái trong ngày)</span>
                            }
                        }
                    </div>

                    @if (selectedProduct != null && selectedProduct.Quantity > 0)
                    {
                        <div class="quantity-stepper">
                            <button class="stepper-btn" @onclick="() => modalQuantity = Math.Max(1, modalQuantity - 1)" disabled="@(modalQuantity <= 1)">-</button>
                            <span class="stepper-value">@modalQuantity</span>
                            <button class="stepper-btn" 
                                    @onclick="IncreaseModalQuantity" 
                                    disabled="@(modalQuantity >= selectedProduct.Quantity)"
                                    style="@(modalQuantity >= selectedProduct.Quantity ? "opacity: 0.35; cursor: not-allowed;" : "")">+</button>
                        </div>
                    }
                    else
                    {
                        <span style="font-size: 12px; font-weight: 700; color: #9C8E84; background: #F3EFEA; padding: 4px 10px; border-radius: 8px;">Tạm hết hàng</span>
                    }
                </div>
            </div>

            <div class="sheet-footer">
                @if (selectedProduct != null && selectedProduct.Quantity > 0)
                {
                    <button class="btn-bk-primary" @onclick="AddToCartFromModal">
                        Thêm vào giỏ hàng • @($"{((selectedProduct.Price) * modalQuantity):N0}đ")
                    </button>
                }
                else
                {
                    <button class="btn-bk-primary" disabled style="background: #D1C7BD; color: #FFFFFF; cursor: not-allowed; box-shadow: none;">
                        Tạm Hết Bánh Hôm Nay
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- 6. Cart & Checkout Bottom Sheet -->
@if (isCartOpen)
{
    <div class="bottom-sheet-backdrop" @onclick="CloseCart">
        <div class="bottom-sheet-panel" @onclick:stopPropagation="true">
            <div class="sheet-handle"></div>
