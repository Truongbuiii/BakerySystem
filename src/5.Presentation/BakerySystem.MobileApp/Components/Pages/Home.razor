                <div class="auth-field">
                    <label>Mật khẩu mới (tối thiểu 6 ký tự):</label>
                    <div class="auth-input-wrapper">
                        <iconify-icon icon="solar:lock-password-linear" class="auth-input-icon"></iconify-icon>
                        <input type="password" class="auth-input" @bind="changeNewPassword" placeholder="Nhập mật khẩu mới..." />
                    </div>
                </div>
                <div class="auth-field">
                    <label>Xác nhận mật khẩu mới:</label>
                    <div class="auth-input-wrapper">
                        <iconify-icon icon="solar:check-circle-linear" class="auth-input-icon"></iconify-icon>
                        <input type="password" class="auth-input" @bind="changeConfirmPassword" placeholder="Xác nhận mật khẩu mới..." />
                    </div>
                </div>
            </div>
            <div class="sheet-footer">
                <button type="button" class="btn-bk-primary" @onclick="ChangePasswordAsync" disabled="@isChangingPassword">
                    @(isChangingPassword ? "Đang cập nhật..." : "Đổi Mật Khẩu")
                </button>
            </div>
        </div>
    </div>
}
}

