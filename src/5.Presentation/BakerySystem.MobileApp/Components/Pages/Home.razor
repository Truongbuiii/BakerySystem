                            <div style="display: flex; align-items: center; justify-content: space-between; background: #FAF7F2; border-radius: 14px; padding: 10px 12px;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <img src="@item.ImageURL" alt="@item.ProductName" style="width: 44px; height: 44px; border-radius: 10px; object-fit: cover;" onerror="this.src='http://localhost:5149/assets/images/products/default-bakery.svg';" />
                                    <div>
                                        <h6 style="margin: 0; font-size: 13px; font-weight: 700; color: #2B2118;">@item.ProductName</h6>
                                        <div style="font-size: 12px; font-weight: 800; color: #E76F51; margin-top: 2px;">@($"{item.UnitPrice:N0}đ")</div>
                                    </div>
                                </div>

                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <div class="quantity-stepper">
                                        <button class="stepper-btn" @onclick="() => CartService.UpdateQuantity(item.ProductID, -1)">-</button>
                                        <span class="stepper-value">@item.Quantity</span>
                                        <button class="stepper-btn" 
                                                @onclick="() => CartService.UpdateQuantity(item.ProductID, 1)"
                                                disabled="@(item.Quantity >= item.MaxStock)"
                                                style="@(item.Quantity >= item.MaxStock ? "opacity: 0.35; cursor: not-allowed;" : "")">+</button>
                                    </div>
                                    <button style="border: none; background: transparent; color: #E63946; font-size: 16px; cursor: pointer;" @onclick="() => CartService.RemoveItem(item.ProductID)">
                                        <iconify-icon icon="solar:trash-bin-trash-linear"></iconify-icon>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Voucher Promo Code -->
                    <div style="margin-bottom: 16px;">
                        <label style="font-size: 12px; font-weight: 700; color: #2B2118; margin-bottom: 4px; display: block;">Mã Khuyến Mãi / Voucher:</label>
                        <div style="display: flex; gap: 8px;">
                            <input type="text" class="form-control" placeholder="Nhập mã voucher (VD: BAKERY2026)"
                                   style="border-radius: 12px; font-size: 12px; border-color: var(--bk-border);"
                                   @bind="voucherInput" />
                            <button style="background: #2B2118; color: white; border: none; border-radius: 12px; padding: 0 16px; font-size: 12px; font-weight: 700; cursor: pointer; white-space: nowrap;"
                                    @onclick="ApplyVoucher">
                                Áp dụng
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(voucherMessage))
                        {
                            <span style="font-size: 11px; font-weight: 600; color: @(voucherMessage.Contains("thành công") ? "#16A34A" : "#E63946"); margin-top: 4px; display: block;">
                                @voucherMessage
                            </span>
                        }
                    </div>

                    <!-- Delivery & Contact Information Form -->
                    <div style="background: white; border: 1px solid var(--bk-border); border-radius: 14px; padding: 14px; margin-bottom: 16px;">
                        <h6 style="margin: 0 0 10px; font-size: 13px; font-weight: 800; color: #2B2118;">Thông Tin Nhận Bánh</h6>
                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            <div>
                                <label style="font-size: 11px; color: #6E6259;">Họ và tên người nhận:</label>
