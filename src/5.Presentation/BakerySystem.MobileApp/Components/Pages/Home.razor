<!-- 8. Order Detail Bottom Sheet / Modal with 5-Step Timeline -->
@if (selectedOrderForDetail != null)
{
    <div class="bottom-sheet-backdrop" @onclick="CloseOrderDetail">
        <div class="bottom-sheet-panel" @onclick:stopPropagation="true">
            <div class="sheet-handle"></div>
            <div class="sheet-header">
                <div>
                    <h5 style="margin: 0; font-size: 16px; font-weight: 800; color: #2B2118;">Chi Tiết Đơn Hàng #@selectedOrderForDetail.OrderID</h5>
                    <span style="font-size: 11px; color: #9C8E84;">Đặt lúc: @selectedOrderForDetail.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <button class="sheet-close-btn" @onclick="CloseOrderDetail">&times;</button>
            </div>

            <div class="sheet-body" style="max-height: 70vh; overflow-y: auto;">
                <!-- 5-Step Visual Timeline Tracker -->
                <div style="background: #FAF7F2; border-radius: 16px; padding: 14px 8px 8px; margin-bottom: 16px; border: 1px solid var(--bk-border);">
                    <div style="text-align: center; margin-bottom: 4px;">
                        <span class="order-status-badge @GetStatusCssClass(selectedOrderForDetail.Status)" style="font-size: 12px; padding: 4px 14px;">
                            <iconify-icon icon="@GetStatusIcon(selectedOrderForDetail.Status)"></iconify-icon>
                            <span>@GetStatusText(selectedOrderForDetail.Status)</span>
                        </span>
                    </div>

                    @if (selectedOrderForDetail.Status == OrderStatus.Cancelled)
                    {
                        <div style="text-align: center; padding: 12px 10px; color: #DC2626; font-size: 12px; font-weight: 700;">
                            <iconify-icon icon="solar:close-circle-bold" style="font-size: 24px; vertical-align: middle; margin-right: 4px;"></iconify-icon>
                            Đơn hàng này đã bị hủy.
                        </div>
                    }
                    else
                    {
                        <div class="order-timeline-stepper">
                            <div class="timeline-step completed">
                                <div class="timeline-step-icon">
                                    <iconify-icon icon="solar:bag-check-bold"></iconify-icon>
                                </div>
                                <span class="timeline-step-title">Đặt hàng</span>
                            </div>

                            <div class="timeline-step @(IsStepActiveOrCompleted(selectedOrderForDetail.Status, OrderStatus.Confirmed))">
                                <div class="timeline-step-icon">
                                    <iconify-icon icon="solar:clock-circle-bold"></iconify-icon>
                                </div>
                                <span class="timeline-step-title">Chờ duyệt</span>
                            </div>

                            <div class="timeline-step @(IsStepActiveOrCompleted(selectedOrderForDetail.Status, OrderStatus.InProgress))">
                                <div class="timeline-step-icon">
                                    <iconify-icon icon="solar:chef-hat-minimalistic-bold"></iconify-icon>
                                </div>
                                <span class="timeline-step-title">Làm bánh</span>
                            </div>

                            <div class="timeline-step @(IsStepActiveOrCompleted(selectedOrderForDetail.Status, OrderStatus.Shipping))">
                                <div class="timeline-step-icon">
                                    <iconify-icon icon="solar:scooter-bold"></iconify-icon>
                                </div>
                                <span class="timeline-step-title">Giao hàng</span>
                            </div>

                            <div class="timeline-step @(IsStepActiveOrCompleted(selectedOrderForDetail.Status, OrderStatus.Completed))">
                                <div class="timeline-step-icon">
                                    <iconify-icon icon="solar:check-circle-bold"></iconify-icon>
                                </div>
                                <span class="timeline-step-title">Hoàn tất</span>
                            </div>
                        </div>
                    }
                </div>

                <!-- Receiver Information -->
                <div style="background: white; border: 1px solid var(--bk-border); border-radius: 14px; padding: 12px 14px; margin-bottom: 14px;">
                    <div style="font-size: 12px; font-weight: 800; color: #2B2118; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                        <iconify-icon icon="solar:map-point-wave-bold" style="color: #E76F51;"></iconify-icon>
                        <span>Thông Tin Giao Hàng</span>
                    </div>
                    <div style="font-size: 12px; color: #6E6259; line-height: 1.6;">
                        <div><strong>Người nhận:</strong> @selectedOrderForDetail.ReceiverName</div>
                        <div><strong>Số điện thoại:</strong> @selectedOrderForDetail.ReceiverPhone</div>
                        <div><strong>Địa chỉ:</strong> @selectedOrderForDetail.ShippingAddress</div>
                        @if (!string.IsNullOrEmpty(selectedOrderForDetail.Note))
                        {
                            <div style="color: #E76F51; margin-top: 4px; padding-top: 4px; border-top: 1px dashed #F4EFEA;">
                                <strong>Ghi chú bánh:</strong> @selectedOrderForDetail.Note
                            </div>
                        }
                    </div>
                </div>

                <!-- Items Breakdown -->
                <div style="background: white; border: 1px solid var(--bk-border); border-radius: 14px; padding: 12px 14px; margin-bottom: 14px;">
                    <div style="font-size: 12px; font-weight: 800; color: #2B2118; margin-bottom: 10px;">
                        <span>Danh Sách Món Bánh (@selectedOrderForDetail.OrderDetails.Sum(d => d.Quantity) món)</span>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        @foreach (var detail in selectedOrderForDetail.OrderDetails)
                        {
                            <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <img src="@GetProductImageUrl(detail.Product)" alt="@detail.Product?.ProductName"
                                         style="width: 38px; height: 38px; border-radius: 8px; object-fit: cover;"
                                         onerror="this.src='/assets/images/products/default-bakery.svg';" />
                                    <div>
                                        <div style="font-size: 12px; font-weight: 700; color: #2B2118;">@detail.Product?.ProductName</div>
                                        <div style="font-size: 11px; color: #9C8E84;">@detail.Quantity x @($"{detail.UnitPrice:N0}đ")</div>
                                    </div>
                                </div>
                                <span style="font-size: 12px; font-weight: 800; color: #2B2118;">@($"{detail.SubTotal:N0}đ")</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Pricing & Payment Summary -->
                <div style="background: #FAF7F2; border-radius: 14px; padding: 12px 14px;">
                    <div style="display: flex; justify-content: space-between; font-size: 12px; color: #6E6259; margin-bottom: 4px;">
                        <span>Tạm tính tiền bánh:</span>
                        <span style="font-weight: 700;">@($"{selectedOrderForDetail.TotalAmount:N0}đ")</span>
                    </div>
                    @if (selectedOrderForDetail.DiscountAmount > 0)
                    {
                        <div style="display: flex; justify-content: space-between; font-size: 12px; color: #E76F51; margin-bottom: 4px;">
                            <span>Giảm giá khuyến mãi:</span>
                            <span style="font-weight: 700;">-@($"{selectedOrderForDetail.DiscountAmount:N0}đ")</span>
                        </div>
                    }
                    <div style="display: flex; justify-content: space-between; font-size: 12px; color: #6E6259; margin-bottom: 4px;">
                        <span>Phí vận chuyển:</span>
                        <span style="color: #16A34A; font-weight: 700;">Miễn phí (Freeship)</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 14px; color: #2B2118; font-weight: 800; padding-top: 6px; border-top: 1px dashed #E0D7CD; margin-bottom: 6px;">
                        <span>Tổng thanh toán:</span>
                        <span style="color: #E76F51; font-size: 16px;">@($"{selectedOrderForDetail.FinalAmount:N0}đ")</span>
                    </div>
                    <div style="font-size: 11px; color: #9C8E84;">
                        PTTT: <strong style="color: #2B2118;">@selectedOrderForDetail.PaymentMethod</strong>
                        <span style="margin-left: 4px; color: @(selectedOrderForDetail.PaymentStatus == PaymentStatus.Paid ? "#16A34A" : "#D97706"); font-weight: 700;">
                            (@(selectedOrderForDetail.PaymentStatus == PaymentStatus.Paid ? "Đã thanh toán" : "Chưa thanh toán"))
                        </span>
                    </div>
                </div>
            </div>

            <div class="sheet-footer" style="display: flex; gap: 8px;">
                <button type="button" class="btn-order-action btn-order-reorder" style="flex: 1; padding: 12px; justify-content: center; font-size: 13px;"
                        @onclick="() => { ReOrderFromHistory(selectedOrderForDetail); CloseOrderDetail(); }">
                    <iconify-icon icon="solar:cart-large-2-bold"></iconify-icon>
                    <span>Đặt Lại Đơn Này</span>
                </button>
                <button type="button" class="btn-order-action btn-order-detail" style="width: auto; padding: 12px 18px; font-size: 13px;"
                        @onclick="CloseOrderDetail">
                    Đóng
                </button>
            </div>
        </div>
    </div>
}

<!-- 9. Edit Profile Modal -->
