@code {
    private string currentTab = "home";
    private string searchQuery = string.Empty;
    private int selectedCategoryId = 0;

    private List<Category> categories = new();
    private List<Product> products = new();
    private List<Order> customerOrders = new();

    private Product? selectedProduct;
    private int modalQuantity = 1;

    private bool isCartOpen = false;
    private bool isSubmittingOrder = false;
    private string voucherInput = string.Empty;
    private string voucherMessage = string.Empty;

    private string receiverName = "Nguyễn Hoàng Anh";
    private string receiverPhone = "0912 345 678";
    private string receiverAddress = "123 Lê Lợi, Phường Bến Thành, Quận 1, TP.HCM";
    private string orderNote = "Giao lúc 16:30 chiều, kèm nến sinh nhật";
    private string selectedPaymentMethod = PaymentMethod.COD;

    private Order? justPlacedOrder;

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += StateHasChanged;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            // Tải danh mục và sản phẩm từ cơ sở dữ liệu thật BakerySystem
            categories = await DbContext.Categories.ToListAsync();
            products = await DbContext.Products
                .Include(p => p.Category)
                .Where(p => p.IsActive)
                .ToListAsync();

            await LoadOrdersAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine("DB load error: " + ex.Message);
            if (!categories.Any())
            {
                categories = new List<Category>
                {
                    new Category { CategoryID = 1, CategoryName = "Bánh kem sinh nhật" },
                    new Category { CategoryID = 2, CategoryName = "Bánh ngọt & Mousse" },
                    new Category { CategoryID = 3, CategoryName = "Bánh mì & Croissant" }
                };
            }
            if (!products.Any())
            {
                products = new List<Product>
                {
                    new Product { ProductID = 1, CategoryID = 2, ProductName = "Bánh Tiramisu Ý Hoàng Gia", Description = "Lớp bánh cà phê Mascarpone Ý thơm ngậy, rắc bột cacao nguyên chất cao cấp.", Price = 350000m, ImageURL = "/assets/images/products/tiramisu.jpg", IsActive = true, Category = categories[1] },
                    new Product { ProductID = 2, CategoryID = 3, ProductName = "Set Croissant Bơ Pháp (Hộp 6)", Description = "Bánh sừng bò nướng giòn xốp nhiều lớp với bơ sữa thượng hạng vùng Normandie.", Price = 180000m, ImageURL = "/assets/images/products/croissant.jpg", IsActive = true, Category = categories[2] },
                    new Product { ProductID = 3, CategoryID = 1, ProductName = "Bánh Kem Bắp Phô Mai 24cm", Description = "Cốt bánh bông lan vani mềm mịn, kem sữa tươi ngọt thanh xen kẽ hạt bắp ngọt và phô mai nướng.", Price = 420000m, ImageURL = "/assets/images/products/corn-cake.jpg", IsActive = true, Category = categories[0] },
                    new Product { ProductID = 4, CategoryID = 2, ProductName = "Bánh Mousse Dâu Tây Nhật Bản", Description = "Mousse dâu tây Đà Lạt tươi mát kết hợp thạch hoa hồng ngọt dịu và sốt dâu tươi.", Price = 290000m, ImageURL = "/assets/images/products/mousse.jpg", IsActive = true, Category = categories[1] },
                    new Product { ProductID = 5, CategoryID = 3, ProductName = "Bánh Mì Hoa Cúc Brioche", Description = "Bánh mì bơ Brioche Pháp thơm hương hoa cúc tự nhiên, mềm dẻo từng thớ bánh.", Price = 120000m, ImageURL = "/assets/images/products/brioche.jpg", IsActive = true, Category = categories[2] },
                    new Product { ProductID = 6, CategoryID = 1, ProductName = "Bánh Black Forest Cherry Rừng", Description = "Hương vị sô cô la đen Bỉ đậm đà hòa quyện cùng quả anh đào chua ngọt và rượu Kirsch.", Price = 480000m, ImageURL = "/assets/images/products/black-forest.jpg", IsActive = true, Category = categories[0] }
                };
            }
        }
    }

    private async Task LoadOrdersAsync()
    {
        try
        {
            customerOrders = await DbContext.Orders
                .Include(o => o.OrderDetails)
                .ThenInclude(od => od.Product)
                .OrderByDescending(o => o.OrderDate)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Orders load error: " + ex.Message);
        }
    }

    private IEnumerable<Product> FilteredProducts
    {
        get
        {
            var query = products.AsEnumerable();
            if (selectedCategoryId > 0)
            {
                query = query.Where(p => p.CategoryID == selectedCategoryId);
            }
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                query = query.Where(p => p.ProductName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                         (p.Description != null && p.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)));
            }
            return query;
        }
    }

    private void SwitchTab(string tab)
    {
        currentTab = tab;
        if (tab == "orders")
        {
            _ = LoadOrdersAsync();
        }
    }

    private void SelectCategory(int categoryId)
    {
        selectedCategoryId = categoryId;
    }

    private string GetCategoryIcon(string name)
    {
        if (name.Contains("kem", StringComparison.OrdinalIgnoreCase)) return "solar:cake-bold";
        if (name.Contains("mì", StringComparison.OrdinalIgnoreCase)) return "solar:cup-paper-bold";
        if (name.Contains("ngọt", StringComparison.OrdinalIgnoreCase)) return "solar:donut-bitten-bold";
        return "solar:box-minimalistic-bold";
    }

    private string GetProductImageUrl(Product? p)
    {
        if (p == null) return "http://localhost:5149/assets/images/products/default-bakery.svg";

        string rawUrl = p.ImageURL?.Trim() ?? string.Empty;
        if (string.IsNullOrEmpty(rawUrl))
        {
            var name = p.ProductName ?? string.Empty;
            if (name.Contains("Tiramisu", StringComparison.OrdinalIgnoreCase)) rawUrl = "/assets/images/products/tiramisu.jpg";
            else if (name.Contains("Croissant", StringComparison.OrdinalIgnoreCase)) rawUrl = "/assets/images/products/croissant.jpg";
            else if (name.Contains("Bắp", StringComparison.OrdinalIgnoreCase)) rawUrl = "/assets/images/products/corn-cake.jpg";
            else if (name.Contains("Mousse", StringComparison.OrdinalIgnoreCase)) rawUrl = "/assets/images/products/mousse.jpg";
            else if (name.Contains("Brioche", StringComparison.OrdinalIgnoreCase) || name.Contains("Cúc", StringComparison.OrdinalIgnoreCase)) rawUrl = "/assets/images/products/brioche.jpg";
            else if (name.Contains("Forest", StringComparison.OrdinalIgnoreCase)) rawUrl = "/assets/images/products/black-forest.jpg";
            else rawUrl = "/assets/images/products/default-bakery.svg";
        }

        if (rawUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || 
            rawUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return rawUrl;
        }

        return rawUrl.StartsWith('/') ? $"http://localhost:5149{rawUrl}" : $"http://localhost:5149/{rawUrl}";
    }

    private void QuickAddToCart(Product product)
    {
        if (product.Quantity <= 0) return;
        var existing = CartService.Items.FirstOrDefault(i => i.ProductID == product.ProductID);
        if (existing != null && existing.Quantity >= product.Quantity) return;
        CartService.AddItem(product, 1);
    }

    private void OpenProductModal(Product product)
    {
        selectedProduct = product;
        modalQuantity = product.Quantity > 0 ? 1 : 0;
    }

    private void IncreaseModalQuantity()
    {
        if (selectedProduct != null && modalQuantity < selectedProduct.Quantity)
        {
            modalQuantity++;
        }
    }

    private void CloseProductModal()
    {
        selectedProduct = null;
    }

    private void AddToCartFromModal()
    {
        if (selectedProduct != null && selectedProduct.Quantity > 0 && modalQuantity > 0)
        {
            CartService.AddItem(selectedProduct, modalQuantity);
            CloseProductModal();
        }
    }

    private void OpenCart()
    {
        isCartOpen = true;
    }

    private void CloseCart()
    {
        isCartOpen = false;
    }

    private string GetCartSummaryText()
    {
        if (!CartService.Items.Any()) return string.Empty;
        var first = CartService.Items.First();
        return CartService.Items.Count > 1 ? $"{first.ProductName} và {CartService.Items.Count - 1} món khác" : first.ProductName;
    }

    private async Task ApplyPromoDirectly()
    {
        voucherInput = "BAKERY2026";
        await ApplyVoucher();
        OpenCart();
    }

    private async Task ApplyVoucher()
    {
        bool success = await CartService.ApplyVoucherAsync(voucherInput);
        if (success)
        {
            voucherMessage = $"Áp dụng thành công mã {voucherInput}: Giảm {CartService.DiscountPercent}%!";
        }
        else
        {
            voucherMessage = "Mã voucher không hợp lệ hoặc đã hết hạn!";
        }
    }

    private async Task PlaceOrder()
    {
        if (isSubmittingOrder) return;
        isSubmittingOrder = true;

        try
        {
            var order = await CartService.PlaceOrderAsync(receiverName, receiverPhone, receiverAddress, orderNote, selectedPaymentMethod);
            if (order != null)
            {
                justPlacedOrder = order;
                CloseCart();
                await LoadOrdersAsync();
            }
        }
        catch (Exception ex)
        {
            voucherMessage = "Lỗi khi lưu đơn: " + ex.Message;
        }
        finally
        {
            isSubmittingOrder = false;
        }
    }

    private void ViewMyOrdersAfterPlacement()
    {
        justPlacedOrder = null;
        SwitchTab("orders");
    }

    private string GetStatusText(string status) => status switch
    {
        OrderStatus.Pending => "Chờ duyệt",
        OrderStatus.Confirmed => "Đang chuẩn bị bánh",
        OrderStatus.Shipping => "Đang giao hàng",
        OrderStatus.Completed => "Giao thành công",
        _ => "Đã hủy"
    };

    private string GetStatusCssClass(string status) => status switch
    {
        OrderStatus.Pending => "status-pending",
        OrderStatus.Confirmed => "status-confirmed",
        OrderStatus.Shipping => "status-shipping",
        OrderStatus.Completed => "status-completed",
        _ => "status-pending"
    };

    private string GetStatusIcon(string status) => status switch
    {
        OrderStatus.Pending => "solar:clock-circle-bold",
        OrderStatus.Confirmed => "solar:fire-bold",
        OrderStatus.Shipping => "solar:scooter-bold",
        OrderStatus.Completed => "solar:check-circle-bold",
        _ => "solar:close-circle-bold"
    };

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
    }
}
