    private string lookupPhone = string.Empty;
    private Order? selectedOrderForDetail;

    private string webAdminApiBaseUrl
    {
        get => Preferences.Default.Get(
            "WebAdminApiBaseUrl",
            Preferences.Default.Get("DemoPaymentPublicBaseUrl", "http://192.168.1.100:5149"));
        set
        {
            var baseUrl = value?.TrimEnd('/') ?? string.Empty;
            Preferences.Default.Set("WebAdminApiBaseUrl", baseUrl);
            Preferences.Default.Set("DemoPaymentPublicBaseUrl", baseUrl);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += StateHasChanged;
        CustomerSession.OnAuthChanged += HandleAuthChanged;
        SyncCustomerInfoToCheckout();
        await LoadDataAsync();
        _ = RefreshOrdersPeriodicallyAsync(orderRefreshCancellation.Token);
    }


    private async Task LoadDataAsync()
    {
        try
        {
            // Tải danh mục và sản phẩm từ cơ sở dữ liệu thật BakerySystem
            categories = await DbContext.Categories.ToListAsync();
            products = await DbContext.Products
                .Include(p => p.Category)
                .Where(p => p.IsActive)
                .ToListAsync();

            var now = DateTime.Today;
            // Tải danh sách voucher & chương trình khuyến mãi
            promotions = await DbContext.Promotions
                .Include(p => p.PromotionInvoice)
                .Where(p => p.Status == PromotionStatus.Active
                         && p.StartDate <= now
                         && p.EndDate >= now
                         && (p.PromotionInvoice == null || p.PromotionInvoice.UsageLimit == null || p.PromotionInvoice.UsedCount < p.PromotionInvoice.UsageLimit))
                .OrderByDescending(p => p.PromotionInvoice != null ? p.PromotionInvoice.DiscountPercent : 0)
                .ToListAsync();

            await LoadOrdersAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine("DB load error: " + ex.Message);
            if (!categories.Any())
            {
                categories = new List<Category>
                {
                    new Category { CategoryID = 1, CategoryName = "Bánh kem sinh nhật" },
                    new Category { CategoryID = 2, CategoryName = "Bánh ngọt & Mousse" },
                    new Category { CategoryID = 3, CategoryName = "Bánh mì & Croissant" }
                };
            }
            if (!products.Any())
            {
                products = new List<Product>
                {
                    new Product { ProductID = 1, CategoryID = 2, ProductName = "Bánh Tiramisu Ý Hoàng Gia", Description = "Lớp bánh cà phê Mascarpone Ý thơm ngậy, rắc bột cacao nguyên chất cao cấp.", Price = 350000m, ImageURL = "/assets/images/products/tiramisu.jpg", IsActive = true, Category = categories[1] },
                    new Product { ProductID = 2, CategoryID = 3, ProductName = "Set Croissant Bơ Pháp (Hộp 6)", Description = "Bánh sừng bò nướng giòn xốp nhiều lớp với bơ sữa thượng hạng vùng Normandie.", Price = 180000m, ImageURL = "/assets/images/products/croissant.jpg", IsActive = true, Category = categories[2] },
                    new Product { ProductID = 3, CategoryID = 1, ProductName = "Bánh Kem Bắp Phô Mai 24cm", Description = "Cốt bánh bông lan vani mềm mịn, kem sữa tươi ngọt thanh xen kẽ hạt bắp ngọt và phô mai nướng.", Price = 420000m, ImageURL = "/assets/images/products/corn-cake.jpg", IsActive = true, Category = categories[0] },
