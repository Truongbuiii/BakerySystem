    private string GetProductImageUrl(Product? p)
    {
        const string fallback = "/assets/images/products/default-bakery.svg";
        if (p == null) return fallback;

        string rawUrl = p.ImageURL?.Trim() ?? string.Empty;
        if (string.IsNullOrEmpty(rawUrl))
        {
            // Nếu DB không có ImageURL, mapping theo tên sản phẩm
            var name = p.ProductName ?? string.Empty;
            if (name.Contains("Tiramisu", StringComparison.OrdinalIgnoreCase)) rawUrl = "/assets/images/products/tiramisu.jpg";
            else if (name.Contains("Croissant", StringComparison.OrdinalIgnoreCase)) rawUrl = "/assets/images/products/croissant.jpg";
            else if (name.Contains("Bắp", StringComparison.OrdinalIgnoreCase)) rawUrl = "/assets/images/products/corn-cake.jpg";
            else if (name.Contains("Mousse", StringComparison.OrdinalIgnoreCase)) rawUrl = "/assets/images/products/mousse.jpg";
            else if (name.Contains("Brioche", StringComparison.OrdinalIgnoreCase) || name.Contains("Cúc", StringComparison.OrdinalIgnoreCase)) rawUrl = "/assets/images/products/brioche.jpg";
            else if (name.Contains("Forest", StringComparison.OrdinalIgnoreCase)) rawUrl = "/assets/images/products/black-forest.jpg";
            else rawUrl = fallback;
            return rawUrl;
        }

        // Nếu là URL đầy đủ (http/https) -> giữ nguyên
        if (rawUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || 
            rawUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return rawUrl;
        }

        rawUrl = rawUrl.Replace('\\', '/');
        rawUrl = rawUrl.TrimStart('/');
        if (rawUrl.StartsWith("wwwroot/", StringComparison.OrdinalIgnoreCase))
        {
            rawUrl = rawUrl["wwwroot/".Length..];
        }
        if (rawUrl.StartsWith("~/", StringComparison.Ordinal))
        {
            rawUrl = rawUrl[2..];
        }

        if (!rawUrl.StartsWith("assets/", StringComparison.OrdinalIgnoreCase))
        {
            return fallback;
        }

        return "/" + rawUrl;
    }

