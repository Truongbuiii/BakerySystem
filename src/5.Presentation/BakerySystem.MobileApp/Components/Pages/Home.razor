                    <div style="margin-bottom: 16px;">
                        <label style="font-size: 12px; font-weight: 700; color: #2B2118; margin-bottom: 6px; display: block;">Phương Thức Thanh Toán:</label>
                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            <label style="display: flex; align-items: center; justify-content: space-between; background: @(selectedPaymentMethod == PaymentMethod.COD ? "#FDF0ED" : "#FFFFFF"); border: 1.5px solid @(selectedPaymentMethod == PaymentMethod.COD ? "#E76F51" : "#EFE8DE"); border-radius: 12px; padding: 10px 14px; cursor: pointer;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <input type="radio" name="paymentMethod" checked="@(selectedPaymentMethod == PaymentMethod.COD)" @onchange="() => selectedPaymentMethod = PaymentMethod.COD" />
                                    <span style="font-size: 12px; font-weight: 700; color: #2B2118;">Tiền mặt khi nhận bánh (COD)</span>
                                </div>
                                <iconify-icon icon="solar:wallet-money-bold" style="font-size: 18px; color: #E76F51;"></iconify-icon>
                            </label>

                            <label style="display: flex; align-items: center; justify-content: space-between; background: @(selectedPaymentMethod == PaymentMethod.BankTransfer ? "#FDF0ED" : "#FFFFFF"); border: 1.5px solid @(selectedPaymentMethod == PaymentMethod.BankTransfer ? "#E76F51" : "#EFE8DE"); border-radius: 12px; padding: 10px 14px; cursor: pointer;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <input type="radio" name="paymentMethod" checked="@(selectedPaymentMethod == PaymentMethod.BankTransfer)" @onchange="() => selectedPaymentMethod = PaymentMethod.BankTransfer" />
                                    <span style="font-size: 12px; font-weight: 700; color: #2B2118;">Chuyển khoản VietQR</span>
                                </div>
                                <iconify-icon icon="solar:card-transfer-bold" style="font-size: 18px; color: #0284C7;"></iconify-icon>
                            </label>

                            <label style="display: flex; align-items: center; justify-content: space-between; background: @(selectedPaymentMethod == PaymentMethod.VNPAY ? "#FDF0ED" : "#FFFFFF"); border: 1.5px solid @(selectedPaymentMethod == PaymentMethod.VNPAY ? "#E76F51" : "#EFE8DE"); border-radius: 12px; padding: 10px 14px; cursor: pointer;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <input type="radio" name="paymentMethod" checked="@(selectedPaymentMethod == PaymentMethod.VNPAY)" @onchange="() => selectedPaymentMethod = PaymentMethod.VNPAY" />
                                    <span style="font-size: 12px; font-weight: 700; color: #2B2118;">Ví điện tử VNPAY</span>
                                </div>
                                <iconify-icon icon="solar:smartphone-bold" style="font-size: 18px; color: #16A34A;"></iconify-icon>
                            </label>
                        </div>
                    </div>

                    <!-- Pricing Summary -->
                    <div style="background: #FAF7F2; border-radius: 14px; padding: 12px 14px; margin-bottom: 12px;">
                        <div style="display: flex; justify-content: space-between; font-size: 12px; color: #6E6259; margin-bottom: 4px;">
                            <span>Tạm tính tiền bánh:</span>
                            <span style="font-weight: 700;">@($"{CartService.SubTotalAmount:N0}đ")</span>
                        </div>
                        @if (CartService.DiscountAmount > 0)
                        {
                            <div style="display: flex; justify-content: space-between; font-size: 12px; color: #E76F51; margin-bottom: 4px;">
                                <span>Giảm giá voucher (@CartService.AppliedVoucherCode):</span>
                                <span style="font-weight: 700;">-@($"{CartService.DiscountAmount:N0}đ")</span>
                            </div>
                        }
                        <div style="display: flex; justify-content: space-between; font-size: 12px; color: #6E6259; margin-bottom: 6px;">
                            <span>Phí giao hàng:</span>
                            <span style="color: #16A34A; font-weight: 700;">Miễn phí (Freeship)</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: 14px; color: #2B2118; font-weight: 800; padding-top: 6px; border-top: 1px dashed #E0D7CD;">
                            <span>Tổng thanh toán:</span>
                            <span style="color: #E76F51; font-size: 16px;">@($"{CartService.FinalAmount:N0}đ")</span>
                        </div>
                    </div>
                }
            </div>

            @if (CartService.Items.Any())
            {
                <div class="sheet-footer">
                    <button class="btn-bk-primary" @onclick="PlaceOrder" disabled="@isSubmittingOrder">
                        @if (isSubmittingOrder)
                        {
                            <span>Đang gửi đơn hàng vào hệ thống...</span>
                        }
                        else
                        {
                            <span>Xác Nhận Đặt Bánh Ngay • @($"{CartService.FinalAmount:N0}đ")</span>
                        }
                    </button>
                </div>
            }
        </div>
    </div>
}

