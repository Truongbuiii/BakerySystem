                            </div>
                            <div>
                                <label style="font-size: 11px; color: #6E6259;">Địa chỉ giao bánh:</label>
                                <input type="text" class="form-control form-control-sm" style="border-radius: 8px;" @bind="receiverAddress" />
                            </div>
                            <div>
                                <label style="font-size: 11px; color: #6E6259;">Ghi chú đơn hàng (ví dụ: giao trước 17h, kèm nến):</label>
