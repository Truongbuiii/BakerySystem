    private async Task LoadOrdersAsync()
    {
        try
        {
            var query = DbContext.Orders
                .AsNoTracking()
                .Include(o => o.OrderDetails)
                .ThenInclude(od => od.Product)
                .AsQueryable();

            if (CustomerSession.IsLoggedIn && CustomerSession.CurrentCustomer != null)
            {
                query = query.Where(o => o.CustomerID == CustomerSession.CurrentCustomer.CustomerId);
            }
            else if (!string.IsNullOrWhiteSpace(lookupPhone))
            {
                var cleanPhone = lookupPhone.Trim();
                query = query.Where(o => o.ReceiverPhone != null && o.ReceiverPhone.Contains(cleanPhone));
            }

            customerOrders = await query.OrderByDescending(o => o.OrderDate).ToListAsync();
            await SyncOrderStatusesFromWebAdminAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Orders load error: " + ex.Message);
        }
    }


    private async Task SyncOrderStatusesFromWebAdminAsync()
    {
        if (customerOrders.Count == 0 || !Uri.TryCreate(webAdminApiBaseUrl, UriKind.Absolute, out var baseUri))
            return;

        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(4));
            var url = $"{baseUri.ToString().TrimEnd('/')}/api/mobile/orders/status";
            using var response = await Http.PostAsJsonAsync(url, customerOrders.Select(order => order.OrderID).ToArray(), timeout.Token);
            response.EnsureSuccessStatusCode();
            var statuses = await response.Content.ReadFromJsonAsync<List<OrderStatusSyncDto>>(cancellationToken: timeout.Token);
            if (statuses == null) return;

            foreach (var latest in statuses)
            {
                var localOrder = customerOrders.FirstOrDefault(order => order.OrderID == latest.OrderId);
                if (localOrder == null) continue;
                localOrder.Status = latest.Status;
                localOrder.PaymentStatus = latest.PaymentStatus;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"WebAdmin status sync unavailable: {ex.Message}");
        }
    }

