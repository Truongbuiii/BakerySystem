@page "/"
@inject IBakeryDbContext DbContext
@inject CartService CartService
@inject CustomerSessionService CustomerSession
@inject IJSRuntime JS
@inject HttpClient Http
@implements IDisposable

@if (!string.IsNullOrEmpty(voucherToastMessage))
{
    <div class="voucher-toast">
        <iconify-icon icon="solar:check-circle-bold" style="color: #10B981; font-size: 16px;"></iconify-icon>
        <span>@voucherToastMessage</span>
    </div>
}

@if (!CustomerSession.IsLoggedIn)
{
    <!-- AUTHENTICATION GATEWAY: LOGIN & REGISTER REQUIRED BEFORE ENTERING APP -->
    <div class="auth-gateway-screen no-scrollbar">
        <div class="auth-gateway-container">
            <!-- Brand Hero Header -->
            <div class="auth-hero-header">
                <div class="auth-hero-icon">
                    <iconify-icon icon="solar:cup-paper-bold"></iconify-icon>
                </div>
                <div class="auth-hero-badge">CỬA HÀNG BÁNH TƯƠI CAO CẤP</div>
                <h2 class="auth-hero-title">Bakery System</h2>
                <p class="auth-hero-subtitle">Vui lòng đăng nhập hoặc tạo tài khoản để trải nghiệm đặt bánh tươi và nhận ngập tràn ưu đãi độc quyền!</p>
            </div>

            <!-- Segmented Switcher Tab -->
            <div class="auth-segmented-control">
                <button class="auth-segment-btn @(authMode == "login" ? "active" : "")" @onclick='() => SwitchAuthMode("login")'>
                    <iconify-icon icon="solar:login-2-linear"></iconify-icon>
                    <span>Đăng Nhập</span>
                </button>
                <button class="auth-segment-btn @(authMode == "register" ? "active" : "")" @onclick='() => SwitchAuthMode("register")'>
                    <iconify-icon icon="solar:user-plus-rounded-linear"></iconify-icon>
                    <span>Đăng Ký Mới</span>
                </button>
            </div>

            @if (authMode == "login")
            {
                <!-- LOGIN FORM -->
                <div class="auth-card">
                    <h5 style="margin: 0 0 14px; font-size: 16px; font-weight: 800; color: #2B2118;">Đăng Nhập Khách Hàng</h5>

                    @if (!string.IsNullOrEmpty(loginError))
                    {
                        <div class="auth-alert-error">
                            <iconify-icon icon="solar:danger-circle-bold" style="font-size: 18px; flex-shrink: 0;"></iconify-icon>
                            <span>@loginError</span>
                        </div>
                    }

                    <div class="auth-field">
                        <label>Tên đăng nhập hoặc Số điện thoại:</label>
                        <div class="auth-input-wrapper">
                            <iconify-icon icon="solar:user-linear" class="auth-input-icon"></iconify-icon>
                            <input type="text" class="auth-input" placeholder="VD: hoanganh hoặc 0912345678"
                                   @bind="loginUsername" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="auth-field">
                        <label>Mật khẩu:</label>
                        <div class="auth-input-wrapper">
                            <iconify-icon icon="solar:lock-password-linear" class="auth-input-icon"></iconify-icon>
                            <input type="@(showLoginPassword ? "text" : "password")" class="auth-input" placeholder="Nhập mật khẩu..."
                                   @bind="loginPassword" @bind:event="oninput" />
                            <button type="button" class="auth-toggle-pwd" @onclick="() => showLoginPassword = !showLoginPassword">
                                <iconify-icon icon="@(showLoginPassword ? "solar:eye-linear" : "solar:eye-closed-linear")"></iconify-icon>
                            </button>
                        </div>
                    </div>

                    <button type="button" class="btn-bk-primary" style="margin-top: 10px; width: 100%; height: 46px; font-size: 14px;" @onclick="HandleCustomerLogin" disabled="@isLoggingIn">
                        @if (isLoggingIn)
                        {
                            <span>Đang xác thực...</span>
                        }
                        else
                        {
                            <span>Đăng Nhập Vào Ứng Dụng</span>
                        }
                    </button>

                    <!-- Quick Demo Accounts for Testing / Lecturers -->
                    <div class="auth-demo-box">
                        <div style="font-size: 11px; font-weight: 700; color: #6E6259; margin-bottom: 8px; display: flex; align-items: center; gap: 4px;">
                            <iconify-icon icon="solar:star-circle-bold" style="color: #E76F51;"></iconify-icon>
                            <span>Tài khoản kiểm thử nhanh (1-chạm):</span>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            <button type="button" class="auth-demo-badge" style="justify-content: flex-start; padding: 8px 10px; font-size: 12px;" @onclick='() => QuickDemoLogin("hoanganh", "customer123")'>
                                <iconify-icon icon="solar:user-bold"></iconify-icon>
                                <span><strong>hoanganh</strong> (Nguyễn Hoàng Anh - VIP Bạc)</span>
                            </button>
                            <button type="button" class="auth-demo-badge" style="justify-content: flex-start; padding: 8px 10px; font-size: 12px;" @onclick='() => QuickDemoLogin("thuha", "customer123")'>
                                <iconify-icon icon="solar:user-bold"></iconify-icon>
                                <span><strong>thuha</strong> (Trần Thị Thu Hà)</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- REGISTER FORM -->
                <div class="auth-card">
                    <h5 style="margin: 0 0 14px; font-size: 16px; font-weight: 800; color: #2B2118;">Đăng Ký Thành Viên Mới</h5>

                    @if (!string.IsNullOrEmpty(registerError))
                    {
                        <div class="auth-alert-error">
                            <iconify-icon icon="solar:danger-circle-bold" style="font-size: 18px; flex-shrink: 0;"></iconify-icon>
                            <span>@registerError</span>
                        </div>
                    }

                    <div class="auth-field">
                        <label>Họ và tên của bạn (*):</label>
                        <div class="auth-input-wrapper">
                            <iconify-icon icon="solar:user-bold" class="auth-input-icon"></iconify-icon>
                            <input type="text" class="auth-input" placeholder="VD: Nguyễn Văn Anh"
                                   @bind="registerFullName" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="auth-field">
                        <label>Tên đăng nhập (*):</label>
                        <div class="auth-input-wrapper">
                            <iconify-icon icon="solar:user-id-linear" class="auth-input-icon"></iconify-icon>
                            <input type="text" class="auth-input" placeholder="VD: vananh2026 (ít nhất 3 ký tự)"
                                   @bind="registerUsername" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="auth-field">
                        <label>Số điện thoại nhận bánh (*):</label>
                        <div class="auth-input-wrapper">
                            <iconify-icon icon="solar:phone-linear" class="auth-input-icon"></iconify-icon>
                            <input type="tel" class="auth-input" placeholder="VD: 0912345678"
                                   @bind="registerPhone" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="auth-field">
                        <label>Địa chỉ giao bánh mặc định:</label>
                        <div class="auth-input-wrapper">
                            <iconify-icon icon="solar:map-point-linear" class="auth-input-icon"></iconify-icon>
                            <input type="text" class="auth-input" placeholder="VD: 123 Lê Lợi, Bến Thành, Q.1, TP.HCM"
                                   @bind="registerAddress" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="auth-field">
                        <label>Mật khẩu (*):</label>
                        <div class="auth-input-wrapper">
                            <iconify-icon icon="solar:lock-password-linear" class="auth-input-icon"></iconify-icon>
                            <input type="@(showRegisterPassword ? "text" : "password")" class="auth-input" placeholder="Tối thiểu 6 ký tự..."
                                   @bind="registerPassword" @bind:event="oninput" />
                            <button type="button" class="auth-toggle-pwd" @onclick="() => showRegisterPassword = !showRegisterPassword">
                                <iconify-icon icon="@(showRegisterPassword ? "solar:eye-linear" : "solar:eye-closed-linear")"></iconify-icon>
                            </button>
                        </div>
                    </div>

                    <div class="auth-field">
                        <label>Xác nhận mật khẩu (*):</label>
                        <div class="auth-input-wrapper">
                            <iconify-icon icon="solar:check-circle-linear" class="auth-input-icon"></iconify-icon>
                            <input type="@(showRegisterPassword ? "text" : "password")" class="auth-input" placeholder="Nhập lại mật khẩu..."
                                   @bind="registerConfirmPassword" @bind:event="oninput" />
                        </div>
                    </div>

                    <button type="button" class="btn-bk-primary" style="margin-top: 10px; width: 100%; height: 46px; font-size: 14px;" @onclick="HandleCustomerRegister" disabled="@isRegistering">
                        @if (isRegistering)
                        {
                            <span>Đang khởi tạo tài khoản...</span>
                        }
                        else
                        {
                            <span>Tạo Tài Khoản & Vào Ứng Dụng</span>
                        }
                    </button>
                </div>
            }
        </div>
    </div>
}
else
{
    <!-- 1. Mobile Top Header -->
    <header class="mobile-header">
        <div class="header-top">
            <div class="location-box" @onclick='() => SwitchTab("profile")' style="cursor: pointer;" title="Xem hoặc đổi địa chỉ">
                <span class="location-label">
                    <iconify-icon icon="solar:map-point-wave-bold" style="color: #E76F51; font-size: 14px;"></iconify-icon> Giao đến
                </span>
                <div class="location-value">
                    <span style="max-width: 190px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        @(CustomerSession.IsLoggedIn && !string.IsNullOrWhiteSpace(CustomerSession.CurrentCustomer?.Address) 
                            ? CustomerSession.CurrentCustomer.Address 
                            : "123 Lê Lợi, Bến Thành, Q.1")
                    </span>
                    <iconify-icon icon="solar:alt-arrow-down-linear" style="font-size: 14px; color: #6E6259;"></iconify-icon>
                </div>
            </div>

            <div class="header-actions">
                <!-- Order / Search icon -->
                <button class="header-icon-btn" @onclick='() => SwitchTab("orders")' title="Đơn hàng của tôi">
                    <iconify-icon icon="solar:bag-heart-linear"></iconify-icon>
                    @if (customerOrders.Any(o => o.Status == OrderStatus.Pending || o.Status == OrderStatus.InProgress || o.Status == OrderStatus.Shipping))
                    {
                        <span class="badge-counter" style="background: #E76F51;">
                            @customerOrders.Count(o => o.Status == OrderStatus.Pending || o.Status == OrderStatus.InProgress || o.Status == OrderStatus.Shipping)
                        </span>
                    }
                </button>

                <!-- Cart icon with dynamic badge -->
                <button class="header-icon-btn" @onclick="OpenCart" title="Giỏ hàng">
                    <iconify-icon icon="solar:cart-large-2-linear"></iconify-icon>
                    @if (CartService.TotalItemsCount > 0)
                    {
                        <span class="badge-counter">@CartService.TotalItemsCount</span>
                    }
                </button>

                <!-- User Profile Avatar/Button -->
                <button class="header-icon-btn user-avatar-btn" @onclick='() => SwitchTab("profile")' title="Tài khoản">
                    <span style="font-size: 12px; font-weight: 800; color: #E76F51;">@GetCustomerInitials(CustomerSession.CurrentCustomer?.FullName)</span>
                </button>
            </div>
        </div>
    </header>

    <!-- 2. Main Mobile Scrollable Content Area -->
    <div class="mobile-content-area no-scrollbar">

        @if (currentTab == "home")
        {
            <!-- Greeting & Subtitle -->
            <div style="padding: 14px 18px 4px;">
                <p style="margin: 0; font-size: 12px; color: #9C8E84; font-weight: 600;">
                    Xin chào, @CustomerSession.CurrentCustomer?.FullName! ✨
                </p>
                <h4 style="margin: 2px 0 0; font-size: 19px; font-weight: 800; color: #2B2118;">Thực đơn bánh tươi hôm nay</h4>
            </div>

        <!-- Search Input Bar -->

        <div class="search-container">
            <div class="mobile-search-box">
                <iconify-icon icon="solar:magnifer-linear" style="font-size: 18px; color: #9C8E84;"></iconify-icon>
                <input type="text" class="mobile-search-input" placeholder="Tìm bánh kem sinh nhật, bánh mì bơ, tiramisu..."
                       @bind="searchQuery" @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <iconify-icon icon="solar:close-circle-bold" style="font-size: 16px; color: #9C8E84; cursor: pointer;" @onclick="() => searchQuery = string.Empty"></iconify-icon>
                }
            </div>
        </div>

        <!-- Promo Banner Carousel / Card -->
        <div class="promo-banner" @onclick='() => OpenVouchersTab("home")' style="cursor: pointer;">
            <span class="promo-badge">Ưu Đãi Hôm Nay</span>
            <h3 class="promo-title">Kho Voucher & Khuyến Mãi Bánh</h3>
            <p class="promo-subtitle">Khám phá ngay @(promotions.Count > 0 ? $"{promotions.Count} mã" : "nhiều") ưu đãi giảm đến 20% khi đặt bánh!</p>
            <button class="promo-btn" @onclick:stopPropagation="true" @onclick='() => OpenVouchersTab("home")'>
                <span>Xem kho voucher</span>
                <iconify-icon icon="solar:arrow-right-linear" style="font-size: 12px;"></iconify-icon>
            </button>
            <iconify-icon icon="solar:ticket-sale-bold" class="promo-decor-icon"></iconify-icon>
        </div>

        <!-- Categories Horizontal Pills -->
        <div class="category-section">
            <div class="section-header">
                <h5 class="section-title">Loại Sản Phẩm</h5>
                <span class="section-link" @onclick='() => SwitchTab("menu")'>Xem tất cả</span>
            </div>

            <div class="category-scroll-container no-scrollbar">
                <button class="category-pill @(selectedCategoryId == 0 ? "active" : "")" @onclick="() => SelectCategory(0)">
                    <iconify-icon icon="solar:star-fall-bold"></iconify-icon>
                    <span>Tất cả</span>
                </button>
                @foreach (var cat in categories)
                {
                    <button class="category-pill @(selectedCategoryId == cat.CategoryID ? "active" : "")" @onclick="() => SelectCategory(cat.CategoryID)">
                        <iconify-icon icon="@GetCategoryIcon(cat.CategoryName)"></iconify-icon>
                        <span>@cat.CategoryName</span>
                    </button>
                }
            </div>
        </div>

        <!-- Products 2-Column Grid -->
        <div class="products-grid-section">
            <div class="section-header">
                <h5 class="section-title">
                    @(selectedCategoryId == 0 ? "Bánh Tươi Trong Ngày" : categories.FirstOrDefault(c => c.CategoryID == selectedCategoryId)?.CategoryName ?? "Sản phẩm")
                </h5>
                <span style="font-size: 11px; color: #9C8E84; font-weight: 600;">@FilteredProducts.Count() món</span>
            </div>

            @if (!FilteredProducts.Any())
            {
                <div style="text-align: center; padding: 30px 10px; color: #9C8E84;">
                    <iconify-icon icon="solar:cup-paper-linear" style="font-size: 40px; margin-bottom: 6px;"></iconify-icon>
                    <p style="font-size: 13px; margin: 0;">Không tìm thấy món bánh phù hợp với từ khóa này.</p>
                </div>
            }
            else
            {
                <div class="product-grid">
                    @foreach (var prod in FilteredProducts)
                    {
                        <div class="mobile-product-card" @onclick="() => OpenProductModal(prod)">
                            <div class="product-img-wrap">
                                <img src="@GetProductImageUrl(prod)" alt="@prod.ProductName" class="product-img" style="@(prod.Quantity <= 0 ? "opacity: 0.5; filter: grayscale(40%);" : "")" onerror="this.src='/assets/images/products/default-bakery.svg';" />
                                <span class="product-tag">@prod.Category?.CategoryName</span>
                                @if (prod.Quantity <= 0)
                                {
                                    <span class="stock-badge stock-badge-out">Hết bánh</span>
                                }
                                else if (prod.Quantity <= 5)
                                {
                                    <span class="stock-badge stock-badge-low">Chỉ còn @prod.Quantity</span>
                                }
                            </div>
                            <div class="product-info">
                                <span class="product-category">Thủ công</span>
                                <h6 class="product-name">@prod.ProductName</h6>
                                <div class="product-price-row">
                                    <span class="product-price">@($"{prod.Price:N0}đ")</span>
                                    @if (prod.Quantity > 0)
                                    {
                                        <button class="btn-quick-add" @onclick:stopPropagation="true" @onclick="() => QuickAddToCart(prod)" title="Thêm nhanh">
                                            <iconify-icon icon="solar:add-linear"></iconify-icon>
                                        </button>
                                    }
                                    else
                                    {
                                        <span style="font-size: 11px; font-weight: 700; color: #9C8E84; background: #F1ECE6; padding: 4px 8px; border-radius: 8px;">Hết hàng</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (currentTab == "menu")
    {
        <!-- Full Menu Tab -->
        <div style="padding: 14px 18px;">
            <h4 style="margin: 0 0 4px; font-size: 19px; font-weight: 800; color: #2B2118;">Thực Đơn Bánh Tươi</h4>
            <p style="margin: 0 0 12px; font-size: 12px; color: #9C8E84;">Danh mục các món bánh nướng mới phục vụ trong ngày</p>

            <!-- Search in Menu -->
            <div class="mobile-search-box" style="margin-bottom: 14px;">
                <iconify-icon icon="solar:magnifer-linear" style="font-size: 18px; color: #9C8E84;"></iconify-icon>
                <input type="text" class="mobile-search-input" placeholder="Lọc theo tên món bánh..."
                       @bind="searchQuery" @bind:event="oninput" />
            </div>

            <!-- Categories Horizontal Pills -->
            <div class="category-scroll-container no-scrollbar" style="margin-bottom: 14px;">
                <button class="category-pill @(selectedCategoryId == 0 ? "active" : "")" @onclick="() => SelectCategory(0)">
                    <span>Tất cả</span>
                </button>
                @foreach (var cat in categories)
                {
                    <button class="category-pill @(selectedCategoryId == cat.CategoryID ? "active" : "")" @onclick="() => SelectCategory(cat.CategoryID)">
                        <span>@cat.CategoryName</span>
                    </button>
                }
            </div>

            <!-- Products Grid in Menu -->
            <div class="product-grid">
                @foreach (var prod in FilteredProducts)
                {
                    <div class="mobile-product-card" @onclick="() => OpenProductModal(prod)">
                        <div class="product-img-wrap">
                            <img src="@GetProductImageUrl(prod)" alt="@prod.ProductName" class="product-img" style="@(prod.Quantity <= 0 ? "opacity: 0.5; filter: grayscale(40%);" : "")" onerror="this.src='/assets/images/products/default-bakery.svg';" />
                            <span class="product-tag">@prod.Category?.CategoryName</span>
                            @if (prod.Quantity <= 0)
                            {
                                <span class="stock-badge stock-badge-out">Hết bánh</span>
                            }
                            else if (prod.Quantity <= 5)
                            {
                                <span class="stock-badge stock-badge-low">Chỉ còn @prod.Quantity</span>
                            }
                        </div>
                        <div class="product-info">
                            <h6 class="product-name">@prod.ProductName</h6>
                            <p style="font-size: 11px; color: #9C8E84; margin: 0 0 6px; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;">@prod.Description</p>
                            <div class="product-price-row">
                                <span class="product-price">@($"{prod.Price:N0}đ")</span>
                                @if (prod.Quantity > 0)
                                {
                                    <button class="btn-quick-add" @onclick:stopPropagation="true" @onclick="() => QuickAddToCart(prod)">
                                        <iconify-icon icon="solar:add-linear"></iconify-icon>
                                    </button>
                                }
                                else
                                {
                                    <span style="font-size: 11px; font-weight: 700; color: #9C8E84; background: #F1ECE6; padding: 4px 8px; border-radius: 8px;">Hết hàng</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (currentTab == "orders")
    {
        <!-- Customer Orders Tab (Real DB Data & History) -->
        <div style="padding: 14px 18px 24px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                <div>
                    <h4 style="margin: 0 0 4px; font-size: 19px; font-weight: 800; color: #2B2118;">Đơn Hàng Của Tôi</h4>
                    <p style="margin: 0; font-size: 12px; color: #9C8E84;">
                        @(CustomerSession.IsLoggedIn 
                            ? $"Xin chào {CustomerSession.CurrentCustomer?.FullName} • {customerOrders.Count} đơn hàng" 
                            : "Theo dõi tiến độ làm bánh & giao hàng theo thời gian thực")
                    </p>
                </div>
                <button type="button" @onclick="RefreshMyOrders" disabled="@isRefreshingOrders"
                        style="border: 1px solid #EAE3D8; background: #FFFFFF; border-radius: 10px; padding: 7px 12px; font-size: 11px; font-weight: 700; color: #6E6259; display: flex; align-items: center; gap: 4px; box-shadow: 0 2px 6px rgba(0,0,0,0.03);"
                        title="Tải lại danh sách">
                    <iconify-icon icon="solar:restart-bold" class="@(isRefreshingOrders ? "spin" : "")"></iconify-icon>
                    <span>@(isRefreshingOrders ? "Đang đồng bộ..." : "Đồng bộ")</span>
                </button>
            </div>

            @if (!CustomerSession.IsLoggedIn)
            {
                <!-- Not Logged In Callout + Quick Lookup -->
                <div style="background: #FFF9F5; border: 1.5px dashed #F4A261; border-radius: 16px; padding: 14px 16px; margin-bottom: 16px;">
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                        <div style="width: 36px; height: 36px; border-radius: 10px; background: #FDF0ED; color: #E76F51; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                            <iconify-icon icon="solar:user-circle-bold"></iconify-icon>
                        </div>
                        <div style="flex: 1;">
                            <h6 style="margin: 0; font-size: 13px; font-weight: 800; color: #2B2118;">Bạn chưa đăng nhập</h6>
                            <p style="margin: 2px 0 0; font-size: 11px; color: #6E6259;">Đăng nhập để xem lịch sử mua bánh và nhận ưu đãi tích điểm.</p>
                        </div>
                        <button class="btn-bk-primary" style="width: auto; padding: 6px 14px; font-size: 11px; border-radius: 8px;" @onclick='() => SwitchTab("profile")'>
                            Đăng nhập
                        </button>
                    </div>

                    <!-- Quick lookup by phone without login -->
                    <div style="padding-top: 10px; border-top: 1px dashed rgba(244, 162, 97, 0.4);">
                        <label style="display: block; font-size: 11px; font-weight: 700; color: #6E6259; margin-bottom: 4px;">Hoặc tra cứu nhanh đơn hàng bằng Số điện thoại:</label>
                        <div style="display: flex; gap: 8px;">
                            <input type="tel" class="form-control" placeholder="Nhập số điện thoại đặt bánh (VD: 0912345678)..."
                                   style="font-size: 12px; border-radius: 8px; border-color: #EAE3D8;"
                                   @bind="lookupPhone" @bind:event="oninput" />
                            <button type="button" style="background: var(--bk-dark); color: white; border: none; border-radius: 8px; padding: 0 14px; font-size: 11px; font-weight: 700; white-space: nowrap;"
                                    @onclick="RefreshMyOrders">
                                Tra cứu
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- Order Status Filter Pills -->
            <div class="order-status-tabs no-scrollbar">
                <button class="order-filter-pill @(currentOrderStatusFilter == "All" ? "active" : "")" @onclick='() => SetOrderStatusFilter("All")'>
                    <span>Tất cả</span>
                    <span style="opacity: 0.8; font-size: 10px;">(@customerOrders.Count)</span>
                </button>
                <button class="order-filter-pill @(currentOrderStatusFilter == OrderStatus.Pending ? "active" : "")" @onclick='() => SetOrderStatusFilter(OrderStatus.Pending)'>
                    <iconify-icon icon="solar:clock-circle-bold" style="color: #D97706;"></iconify-icon>
                    <span>Chờ duyệt</span>
                    <span style="opacity: 0.8; font-size: 10px;">(@customerOrders.Count(o => o.Status == OrderStatus.Pending))</span>
                </button>
                <button class="order-filter-pill @(currentOrderStatusFilter == OrderStatus.Confirmed ? "active" : "")" @onclick='() => SetOrderStatusFilter(OrderStatus.Confirmed)'>
                    <iconify-icon icon="solar:fire-bold" style="color: #4F46E5;"></iconify-icon>
                    <span>Đã duyệt</span>
                    <span style="opacity: 0.8; font-size: 10px;">(@customerOrders.Count(o => o.Status == OrderStatus.Confirmed))</span>
                </button>
                <button class="order-filter-pill @(currentOrderStatusFilter == OrderStatus.InProgress ? "active" : "")" @onclick='() => SetOrderStatusFilter(OrderStatus.InProgress)'>
                    <iconify-icon icon="solar:chef-hat-minimalistic-bold" style="color: #C2410C;"></iconify-icon>
                    <span>Làm bánh</span>
                    <span style="opacity: 0.8; font-size: 10px;">(@customerOrders.Count(o => o.Status == OrderStatus.InProgress))</span>
                </button>
                <button class="order-filter-pill @(currentOrderStatusFilter == OrderStatus.Shipping ? "active" : "")" @onclick='() => SetOrderStatusFilter(OrderStatus.Shipping)'>
                    <iconify-icon icon="solar:scooter-bold" style="color: #0284C7;"></iconify-icon>
                    <span>Đang giao</span>
                    <span style="opacity: 0.8; font-size: 10px;">(@customerOrders.Count(o => o.Status == OrderStatus.Shipping))</span>
                </button>
                <button class="order-filter-pill @(currentOrderStatusFilter == OrderStatus.Completed ? "active" : "")" @onclick='() => SetOrderStatusFilter(OrderStatus.Completed)'>
                    <iconify-icon icon="solar:check-circle-bold" style="color: #16A34A;"></iconify-icon>
                    <span>Hoàn tất</span>
                    <span style="opacity: 0.8; font-size: 10px;">(@customerOrders.Count(o => o.Status == OrderStatus.Completed))</span>
                </button>
                <button class="order-filter-pill @(currentOrderStatusFilter == OrderStatus.Cancelled ? "active" : "")" @onclick='() => SetOrderStatusFilter(OrderStatus.Cancelled)'>
                    <iconify-icon icon="solar:close-circle-bold" style="color: #DC2626;"></iconify-icon>
                    <span>Đã hủy</span>
                    <span style="opacity: 0.8; font-size: 10px;">(@customerOrders.Count(o => o.Status == OrderStatus.Cancelled))</span>
                </button>
            </div>

            <!-- Search box for orders -->
            <div class="mobile-search-box" style="margin-bottom: 14px; background: white;">
                <iconify-icon icon="solar:magnifer-linear" style="font-size: 16px; color: #9C8E84;"></iconify-icon>
                <input type="text" class="mobile-search-input" placeholder="Tìm theo mã đơn (#1024), tên bánh..."
                       @bind="orderSearchQuery" @bind:event="oninput" style="font-size: 12px;" />
                @if (!string.IsNullOrEmpty(orderSearchQuery))
                {
                    <iconify-icon icon="solar:close-circle-bold" style="font-size: 16px; color: #9C8E84; cursor: pointer;" @onclick="() => orderSearchQuery = string.Empty"></iconify-icon>
                }
            </div>

            <!-- List of filtered orders -->
            @if (!FilteredCustomerOrders.Any())
            {
                <div style="text-align: center; padding: 40px 10px; background: white; border-radius: 16px; border: 1px solid var(--bk-border); margin-top: 6px;">
                    <iconify-icon icon="solar:box-minimalistic-linear" style="font-size: 48px; color: #C0B4A9; margin-bottom: 8px;"></iconify-icon>
                    <h6 style="margin: 0 0 4px; font-weight: 700; color: #2B2118;">Không có đơn hàng nào</h6>
                    <p style="margin: 0 0 14px; font-size: 12px; color: #9C8E84;">
                        @(string.IsNullOrEmpty(orderSearchQuery) 
                            ? "Bạn chưa có đơn hàng nào ở trạng thái này." 
                            : "Không tìm thấy đơn hàng phù hợp với từ khóa.")
                    </p>
                    <button class="btn-bk-primary" style="width: auto; padding: 8px 20px;" @onclick='() => SwitchTab("menu")'>
                        Khám phá thực đơn bánh ngay
                    </button>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    @foreach (var order in FilteredCustomerOrders)
                    {
                        <div class="order-card-modern">
                            <!-- Order Card Header -->
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px solid #F4EFEA;">
                                <div>
                                    <div style="display: flex; align-items: center; gap: 6px;">
                                        <span style="font-size: 14px; font-weight: 800; color: #2B2118;">#@order.OrderID</span>
                                        <span style="font-size: 11px; color: #9C8E84;">• @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    <div style="font-size: 11px; color: #6E6259; margin-top: 2px;">
                                        <iconify-icon icon="solar:user-linear" style="font-size: 12px;"></iconify-icon>
                                        <span>@order.ReceiverName (@order.ReceiverPhone)</span>
                                    </div>
                                </div>
                                <div>
                                    <span class="order-status-badge @GetStatusCssClass(order.Status)">
                                        <iconify-icon icon="@GetStatusIcon(order.Status)"></iconify-icon>
                                        <span>@GetStatusText(order.Status)</span>
                                    </span>
                                </div>
                            </div>

                            <!-- Order items list preview -->
                            <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 10px;">
                                @foreach (var detail in order.OrderDetails.Take(2))
                                {
                                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px; background: #FAF7F2; padding: 6px 10px; border-radius: 10px;">
                                        <div style="display: flex; align-items: center; gap: 8px; min-width: 0;">
                                            <img src="@GetProductImageUrl(detail.Product)" alt="@detail.Product?.ProductName"
                                                 style="width: 34px; height: 34px; border-radius: 6px; object-fit: cover;"
                                                 onerror="this.src='/assets/images/products/default-bakery.svg';" />
                                            <div style="min-width: 0;">
                                                <div style="font-size: 12px; font-weight: 700; color: #2B2118; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                    @detail.Product?.ProductName
                                                </div>
                                                <div style="font-size: 11px; color: #9C8E84;">
                                                    @detail.Quantity x @($"{detail.UnitPrice:N0}đ")
                                                </div>
                                            </div>
                                        </div>
                                        <span style="font-size: 12px; font-weight: 700; color: #2B2118; white-space: nowrap;">
                                            @($"{detail.SubTotal:N0}đ")
                                        </span>
                                    </div>
                                }
                                @if (order.OrderDetails.Count > 2)
                                {
                                    <div style="font-size: 11px; color: #E76F51; font-weight: 700; text-align: center; cursor: pointer;"
                                         @onclick="() => OpenOrderDetail(order)">
                                        + Xem thêm @(order.OrderDetails.Count - 2) món bánh khác...
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(order.Note))
                            {
                                <div style="font-size: 11px; color: #9C4221; background: #FFF5EE; padding: 7px 10px; border-radius: 8px; margin-bottom: 10px; display: flex; align-items: flex-start; gap: 6px;">
                                    <iconify-icon icon="solar:cake-bold" style="font-size: 14px; margin-top: 1px; color: #E76F51;"></iconify-icon>
                                    <div><strong>Ghi chú bánh:</strong> @order.Note</div>
                                </div>
                            }

                            <!-- Payment & Total Row -->
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-top: 1px dashed #EAE3D8; margin-bottom: 10px;">
                                <div style="font-size: 11px; color: #9C8E84;">
                                    PTTT: <strong style="color: #2B2118;">@order.PaymentMethod</strong>
                                    <span style="margin-left: 4px; color: @(order.PaymentStatus == PaymentStatus.Paid ? "#16A34A" : "#D97706"); font-weight: 700;">
                                        (@(order.PaymentStatus == PaymentStatus.Paid ? "Đã thanh toán" : "Chưa thanh toán"))
                                    </span>
                                </div>
                                <div style="text-align: right;">
                                    <span style="font-size: 11px; color: #9C8E84;">Tổng cộng: </span>
                                    <span style="font-size: 15px; font-weight: 800; color: #E76F51;">@($"{order.FinalAmount:N0}đ")</span>
                                </div>
                            </div>

                            <!-- Action Buttons Row -->
                            <div style="display: flex; justify-content: flex-end; gap: 8px;">
                                <button type="button" class="btn-order-action btn-order-detail" @onclick="() => OpenOrderDetail(order)">
                                    <iconify-icon icon="solar:eye-linear"></iconify-icon>
                                    <span>Xem chi tiết & Tiến trình</span>
                                </button>
                                <button type="button" class="btn-order-action btn-order-reorder" @onclick="() => ReOrderFromHistory(order)">
                                    <iconify-icon icon="solar:cart-large-2-bold"></iconify-icon>
                                    <span>Đặt lại</span>
                                </button>
                                @if (order.Status == OrderStatus.Pending)
                                {
                                    <button type="button" class="btn-order-action btn-order-cancel" @onclick="() => CancelPendingOrder(order.OrderID)">
                                        <iconify-icon icon="solar:close-circle-bold"></iconify-icon>
                                        <span>Hủy đơn</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (currentTab == "profile")
    {
        <!-- Customer Member Profile Tab -->
        <div style="padding: 14px 18px 24px;">
            @{
                var customer = CustomerSession.CurrentCustomer;
                var totalSpent = customerOrders.Where(o => o.Status != OrderStatus.Cancelled).Sum(o => o.FinalAmount);
                var rewardPoints = (int)(totalSpent / 10000m);
                var vipTier = GetVipTier(totalSpent);
            }

                <!-- VIP Member Profile Card -->
                <div style="background: linear-gradient(135deg, #2B2118 0%, #463428 100%); border-radius: 20px; padding: 20px; color: white; margin-bottom: 16px; box-shadow: 0 10px 25px rgba(43,33,24,0.25);">
                    <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 14px;">
                        <div style="width: 54px; height: 54px; border-radius: 50%; background: #F4A261; color: #2B2118; font-weight: 800; font-size: 19px; display: flex; align-items: center; justify-content: center; border: 2.5px solid rgba(255,255,255,0.25); box-shadow: 0 4px 10px rgba(0,0,0,0.2);">
                            @GetCustomerInitials(customer?.FullName)
                        </div>
                        <div style="flex: 1; min-width: 0;">
                            <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                                <h5 style="margin: 0; font-size: 17px; font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @customer?.FullName
                                </h5>
                                <span style="background: #F4A261; color: #2B2118; font-size: 10px; font-weight: 800; padding: 2px 7px; border-radius: 10px; letter-spacing: 0.3px;">
                                    @vipTier
                                </span>
                            </div>
                            <p style="margin: 3px 0 0; font-size: 12px; color: #D5C8BD;">
                                @(string.IsNullOrEmpty(customer?.Phone) ? "Chưa cập nhật SĐT" : customer.Phone) • @customer?.Username
                            </p>
                        </div>
                        <button type="button" @onclick="OpenEditProfileModal" title="Chỉnh sửa hồ sơ"
                                style="border: none; background: rgba(255,255,255,0.12); color: white; width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer;">
                            <iconify-icon icon="solar:pen-new-square-linear" style="font-size: 16px;"></iconify-icon>
                        </button>
                    </div>

                    <!-- 3 Stats metrics -->
                    <div style="display: flex; justify-content: space-around; background: rgba(255,255,255,0.08); border-radius: 14px; padding: 12px 10px;">
                        <div style="text-align: center;">
                            <span style="font-size: 11px; color: #C0B4A9;">Điểm tích lũy</span>
                            <div style="font-size: 16px; font-weight: 800; color: #F4A261;">@($"{rewardPoints:N0} đ")</div>
                        </div>
                        <div style="width: 1px; background: rgba(255,255,255,0.15);"></div>
                        <div style="text-align: center; cursor: pointer;" @onclick='() => OpenVouchersTab("profile")'>
                            <span style="font-size: 11px; color: #C0B4A9;">Voucher có sẵn</span>
                            <div style="font-size: 16px; font-weight: 800; color: #E76F51;">@($"{promotions.Count:D2} mã")</div>
                        </div>
                        <div style="width: 1px; background: rgba(255,255,255,0.15);"></div>
                        <div style="text-align: center; cursor: pointer;" @onclick='() => SwitchTab("orders")'>
                            <span style="font-size: 11px; color: #C0B4A9;">Đơn đã mua</span>
                            <div style="font-size: 16px; font-weight: 800; color: #2A9D8F;">@customerOrders.Count đơn</div>
                        </div>
                    </div>
                </div>

                <!-- Profile Menu Options -->
                <div style="background: white; border-radius: 16px; border: 1px solid var(--bk-border); overflow: hidden; margin-bottom: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
                    <!-- 1. Cập nhật thông tin cá nhân -->
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid #F4EFEA; cursor: pointer;" @onclick="OpenEditProfileModal">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 34px; height: 34px; border-radius: 10px; background: #F0FDF4; color: #16A34A; display: flex; align-items: center; justify-content: center; font-size: 18px;">
                                <iconify-icon icon="solar:user-id-bold"></iconify-icon>
                            </div>
                            <div>
                                <span style="font-size: 13px; font-weight: 700; color: #2B2118;">Thông Tin Cá Nhân & Nhận Hàng</span>
                                <div style="font-size: 11px; color: #9C8E84; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @(string.IsNullOrEmpty(customer?.Address) ? "Chưa có địa chỉ mặc định" : customer.Address)
                                </div>
                            </div>
                        </div>
                        <iconify-icon icon="solar:alt-arrow-right-linear" style="color: #9C8E84;"></iconify-icon>
                    </div>

                    <!-- 2. Lịch sử đơn hàng shortcut -->
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid #F4EFEA; cursor: pointer;" @onclick='() => SwitchTab("orders")'>
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 34px; height: 34px; border-radius: 10px; background: #EEF2FF; color: #4F46E5; display: flex; align-items: center; justify-content: center; font-size: 18px;">
                                <iconify-icon icon="solar:bill-list-bold"></iconify-icon>
                            </div>
                            <div>
                                <span style="font-size: 13px; font-weight: 700; color: #2B2118;">Lịch Sử Đơn Hàng</span>
                                <div style="font-size: 11px; color: #9C8E84;">@customerOrders.Count đơn hàng đã ghi nhận</div>
                            </div>
                        </div>
                        <iconify-icon icon="solar:alt-arrow-right-linear" style="color: #9C8E84;"></iconify-icon>
                    </div>

                    <!-- 3. Kho Voucher -->
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid #F4EFEA; cursor: pointer;" @onclick='() => OpenVouchersTab("profile")'>
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 34px; height: 34px; border-radius: 10px; background: #FFF5EE; color: #E76F51; display: flex; align-items: center; justify-content: center; font-size: 18px;">
                                <iconify-icon icon="solar:ticket-sale-bold"></iconify-icon>
                            </div>
                            <div>
                                <span style="font-size: 13px; font-weight: 700; color: #2B2118;">Kho Voucher Của Tôi</span>
                                <div style="font-size: 11px; color: #9C8E84;">@promotions.Count mã ưu đãi khả dụng</div>
                            </div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <span style="font-size: 11px; font-weight: 700; color: #E76F51;">Xem ngay</span>
                            <iconify-icon icon="solar:alt-arrow-right-linear" style="color: #9C8E84; font-size: 14px;"></iconify-icon>
                        </div>
                    </div>

                    <!-- 4. Đổi mật khẩu -->
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid #F4EFEA; cursor: pointer;" @onclick="OpenChangePasswordModal">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 34px; height: 34px; border-radius: 10px; background: #FEF3C7; color: #D97706; display: flex; align-items: center; justify-content: center; font-size: 18px;">
                                <iconify-icon icon="solar:lock-password-bold"></iconify-icon>
                            </div>
                            <div>
                                <span style="font-size: 13px; font-weight: 700; color: #2B2118;">Đổi Mật Khẩu Tài Khoản</span>
                                <div style="font-size: 11px; color: #9C8E84;">Bảo vệ an toàn tài khoản thành viên</div>
                            </div>
                        </div>
                        <iconify-icon icon="solar:alt-arrow-right-linear" style="color: #9C8E84;"></iconify-icon>
                    </div>

                    <!-- 5. Hotline hỗ trợ -->
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid #F4EFEA; cursor: pointer;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 34px; height: 34px; border-radius: 10px; background: #F3E8FF; color: #9333EA; display: flex; align-items: center; justify-content: center; font-size: 18px;">
                                <iconify-icon icon="solar:phone-calling-bold"></iconify-icon>
                            </div>
                            <div>
                                <span style="font-size: 13px; font-weight: 700; color: #2B2118;">Hotline Hỗ Trợ Đặt Bánh</span>
                                <div style="font-size: 11px; color: #9C8E84;">1900 8888 (07:00 - 22:00)</div>
                            </div>
                        </div>
                        <iconify-icon icon="solar:alt-arrow-right-linear" style="color: #9C8E84;"></iconify-icon>
                    </div>

                    <!-- 6. Đăng xuất -->
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; cursor: pointer;" @onclick="HandleLogout">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 34px; height: 34px; border-radius: 10px; background: #FEE2E2; color: #DC2626; display: flex; align-items: center; justify-content: center; font-size: 18px;">
                                <iconify-icon icon="solar:logout-2-bold"></iconify-icon>
                            </div>
                            <div>
                                <span style="font-size: 13px; font-weight: 700; color: #DC2626;">Đăng Xuất Tài Khoản</span>
                                <div style="font-size: 11px; color: #9C8E84;">Khóa phiên và quay về màn hình đăng nhập</div>
                            </div>
                        </div>
                        <iconify-icon icon="solar:alt-arrow-right-linear" style="color: #DC2626;"></iconify-icon>
                    </div>
                </div>

                <!-- App info footer -->
                <div style="text-align: center; padding: 10px; color: #9C8E84; font-size: 11px;">
                    Bakery Mobile Customer v1.0.0<br />
                    .NET 10 MAUI Blazor Hybrid
                </div>
        </div>
    }

    else if (currentTab == "vouchers")
    {
        <!-- Kho Voucher & Khuyến Mãi Tab -->
        <div style="background: var(--bk-bg); min-height: 100%;">
            <!-- Header with Back Button -->
            <div class="voucher-page-header">
                <button class="voucher-back-btn" @onclick="BackFromVouchers" title="Quay lại">
                    <iconify-icon icon="solar:alt-arrow-left-linear"></iconify-icon>
                </button>
                <div style="flex: 1;">
                    <h5 style="margin: 0; font-size: 16px; font-weight: 800; color: #2B2118;">Kho Voucher & Khuyến Mãi</h5>
                    <span style="font-size: 11px; color: #9C8E84;">@promotions.Count mã ưu đãi khả dụng</span>
                </div>
            </div>

            <!-- Quick Voucher Code Input -->
            <div style="padding: 14px 18px 6px;">
                <div style="display: flex; gap: 8px; background: white; padding: 6px 6px 6px 12px; border-radius: 14px; border: 1px solid var(--bk-border); box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
                    <div style="display: flex; align-items: center; gap: 8px; flex: 1;">
                        <iconify-icon icon="solar:ticket-sale-linear" style="color: #E76F51; font-size: 18px;"></iconify-icon>
                        <input type="text" placeholder="Nhập mã voucher (VD: BAKERY2026)..."
                               style="border: none; outline: none; width: 100%; font-size: 12px; color: #2B2118; background: transparent;"
                               @bind="quickVoucherCode" />
                    </div>
                    <button style="background: var(--bk-primary); color: white; border: none; border-radius: 10px; padding: 8px 16px; font-size: 12px; font-weight: 700; cursor: pointer; white-space: nowrap;"
                            @onclick="ApplyQuickVoucherFromWallet">
                        Áp dụng
                    </button>
                </div>
            </div>

            <!-- Active Applied Voucher Banner -->
            @if (!string.IsNullOrEmpty(CartService.AppliedVoucherCode))
            {
                <div style="margin: 8px 18px 10px; padding: 12px 14px; background: #FFFAF8; border-radius: 14px; border: 1.5px dashed #E76F51; display: flex; align-items: center; justify-content: space-between;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <div style="width: 36px; height: 36px; border-radius: 10px; background: #FDF0ED; color: #E76F51; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                            <iconify-icon icon="solar:verified-check-bold"></iconify-icon>
                        </div>
                        <div>
                            <div style="font-size: 13px; font-weight: 800; color: #2B2118;">
                                Đang chọn: <span style="color: #E76F51;">@CartService.AppliedVoucherCode</span>
                            </div>
                            <div style="font-size: 11px; color: #6E6259;">
                                Giảm @($"{CartService.DiscountPercent:0}%") @(CartService.MaxDiscountAmount > 0 ? $"(tối đa {CartService.MaxDiscountAmount:N0}đ)" : "")
                            </div>
                        </div>
                    </div>
                    <button class="btn-voucher-remove" @onclick="RemoveAppliedVoucher" title="Bỏ chọn voucher">
                        <iconify-icon icon="solar:close-circle-bold" style="font-size: 13px;"></iconify-icon>
                        <span>Bỏ chọn</span>
                    </button>
                </div>
            }

            <!-- Ticket List -->
            <div style="padding: 6px 18px 24px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                    <span style="font-size: 12px; font-weight: 700; color: #6E6259; text-transform: uppercase; letter-spacing: 0.5px;">Mã Ưu Đãi Có Thể Dùng</span>
                    <span style="font-size: 11px; color: #9C8E84;">Chạm mã để sao chép</span>
                </div>

                @if (!promotions.Any())
                {
                    <div style="text-align: center; padding: 40px 10px; color: #9C8E84;">
                        <iconify-icon icon="solar:ticket-sale-linear" style="font-size: 48px; color: #D5C8BD; margin-bottom: 8px;"></iconify-icon>
                        <h6 style="font-weight: 700; color: #2B2118;">Kho voucher đang trống</h6>
                        <p style="font-size: 12px; margin: 0;">Các chương trình ưu đãi mới nhất sẽ sớm được cập nhật!</p>
                    </div>
                }
                else
                {
                    @foreach (var promo in promotions)
                    {
                        var isApplied = CartService.AppliedVoucherCode.Equals(promo.PromotionCode, StringComparison.OrdinalIgnoreCase);
                        var discountPct = promo.PromotionInvoice?.DiscountPercent ?? 10;
                        var minOrder = promo.PromotionInvoice?.MinOrderAmount ?? 0;
                        var maxDiscount = promo.PromotionInvoice?.MaxDiscountAmount ?? 50000;

                        <div class="voucher-ticket @(isApplied ? "active-applied" : "")">
                            <div class="voucher-stub">
                                <span class="voucher-stub-percent">@($"{discountPct:0}%")</span>
                                <span class="voucher-stub-label">GIẢM</span>
                            </div>
                            <div class="voucher-details">
                                <h6 class="voucher-title">@promo.PromotionName</h6>
                                <p class="voucher-cond">Đơn tối thiểu: <strong>@($"{minOrder:N0}đ")</strong></p>
                                <p class="voucher-cond">Giảm tối đa: <strong>@($"{maxDiscount:N0}đ")</strong></p>
                                <div class="voucher-expiry">
                                    <iconify-icon icon="solar:clock-circle-linear" style="font-size: 11px;"></iconify-icon>
                                    <span>HSD: @promo.EndDate.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="voucher-code-pill" @onclick="() => CopyVoucherCode(promo.PromotionCode)" title="Sao chép mã">
                                    <span>@promo.PromotionCode</span>
                                    <iconify-icon icon="solar:copy-linear" style="font-size: 11px; color: #E76F51;"></iconify-icon>
                                </div>
                            </div>
                            <div class="voucher-action-col">
                                @if (isApplied)
                                {
                                    <div class="btn-voucher-applied">
                                        <iconify-icon icon="solar:check-circle-bold"></iconify-icon>
                                        <span>Đang dùng</span>
                                    </div>
                                    <button class="btn-voucher-remove" @onclick="RemoveAppliedVoucher" title="Bỏ chọn voucher này">
                                        <iconify-icon icon="solar:close-circle-bold" style="font-size: 13px;"></iconify-icon>
                                        <span>Bỏ chọn</span>
                                    </button>
                                }
                                else
                                {
                                    <button class="btn-voucher-use" @onclick="() => UseVoucherFromWallet(promo)">
                                        Dùng ngay
                                    </button>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }

</div>

<!-- 3. Floating Cart Bar (khi có sản phẩm trong giỏ) -->
@if (CartService.TotalItemsCount > 0 && !isCartOpen)
{
    <div class="floating-cart-bar" @onclick="OpenCart">
        <div class="floating-cart-info">
            <div class="floating-cart-badge">@CartService.TotalItemsCount</div>
            <div class="floating-cart-text">
                <h6>Giỏ hàng • @($"{CartService.FinalAmount:N0}đ")</h6>
                <p>@GetCartSummaryText()</p>
            </div>
        </div>
        <button class="floating-cart-btn">
            <span>Xem giỏ hàng</span>
            <iconify-icon icon="solar:alt-arrow-right-linear"></iconify-icon>
        </button>
    </div>
}

<!-- 4. Fixed Bottom Navigation Bar -->
<nav class="mobile-bottom-nav">
    <div class="nav-tab-item @(currentTab == "home" ? "active" : "")" @onclick='() => SwitchTab("home")'>
        <iconify-icon icon="@(currentTab == "home" ? "solar:home-smile-bold" : "solar:home-smile-linear")"></iconify-icon>
        <span>Trang chủ</span>
    </div>

    <div class="nav-tab-item @(currentTab == "menu" ? "active" : "")" @onclick='() => SwitchTab("menu")'>
        <iconify-icon icon="@(currentTab == "menu" ? "solar:cup-bold" : "solar:cup-linear")"></iconify-icon>
        <span>Thực đơn</span>
    </div>

    <div class="nav-tab-item" @onclick="OpenCart">
        <div style="position: relative;">
            <iconify-icon icon="solar:bag-2-linear"></iconify-icon>
            @if (CartService.TotalItemsCount > 0)
            {
                <span class="badge-counter" style="top: -6px; right: -8px;">@CartService.TotalItemsCount</span>
            }
        </div>
        <span>Giỏ hàng</span>
    </div>

    <div class="nav-tab-item @(currentTab == "orders" ? "active" : "")" @onclick='() => SwitchTab("orders")'>
        <iconify-icon icon="@(currentTab == "orders" ? "solar:bill-list-bold" : "solar:bill-list-linear")"></iconify-icon>
        <span>Đơn hàng</span>
    </div>

    <div class="nav-tab-item @(currentTab == "profile" || currentTab == "vouchers" ? "active" : "")" @onclick='() => SwitchTab("profile")'>
        <iconify-icon icon="@(currentTab == "profile" || currentTab == "vouchers" ? "solar:user-bold" : "solar:user-linear")"></iconify-icon>
        <span>Tài khoản</span>
    </div>
</nav>

<!-- 5. Product Detail Modal (Bottom Sheet) -->
@if (selectedProduct != null)
{
    <div class="bottom-sheet-backdrop" @onclick="CloseProductModal">
        <div class="bottom-sheet-panel" @onclick:stopPropagation="true">
            <div class="sheet-handle"></div>
            <div class="sheet-header">
                <h5>Chi Tiết Món Bánh</h5>
                <button class="sheet-close-btn" @onclick="CloseProductModal">&times;</button>
            </div>

            <div class="sheet-body">
                <div style="width: 100%; height: 210px; border-radius: 16px; overflow: hidden; background: #FFF5EE; margin-bottom: 14px;">
                    <img src="@GetProductImageUrl(selectedProduct)" alt="@selectedProduct?.ProductName" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/assets/images/products/default-bakery.svg';" />
                </div>

                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px;">
                    <div>
                        <span style="font-size: 11px; font-weight: 700; color: #E76F51; text-transform: uppercase;">@selectedProduct?.Category?.CategoryName</span>
                        <h4 style="margin: 2px 0 0; font-size: 17px; font-weight: 800; color: #2B2118;">@selectedProduct?.ProductName</h4>
                    </div>
                    <span style="font-size: 18px; font-weight: 800; color: #E76F51;">@($"{selectedProduct?.Price ?? 0:N0}đ")</span>
                </div>

                <p style="font-size: 13px; color: #6E6259; line-height: 1.5; margin-bottom: 16px;">
                    @selectedProduct?.Description
                </p>


                <!-- Quantity selector -->
                <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 10px; border-top: 1px solid var(--bk-border);">
                    <div>
                        <span style="font-size: 13px; font-weight: 700; color: #2B2118; display: block;">Số lượng:</span>
                        @if (selectedProduct != null)
                        {
                            @if (selectedProduct.Quantity <= 0)
                            {
                                <span style="font-size: 11px; font-weight: 700; color: #E63946;">⚠️ Tạm hết bánh hôm nay</span>
                            }
                            else if (selectedProduct.Quantity <= 5)
                            {
                                <span style="font-size: 11px; font-weight: 700; color: #D97706;">🔥 Chỉ còn @selectedProduct.Quantity cái trong ngày</span>
                            }
                            else
                            {
                                <span style="font-size: 11px; font-weight: 600; color: #9C8E84;">(Còn @selectedProduct.Quantity cái trong ngày)</span>
                            }
                        }
                    </div>

                    @if (selectedProduct != null && selectedProduct.Quantity > 0)
                    {
                        <div class="quantity-stepper">
                            <button class="stepper-btn" @onclick="() => modalQuantity = Math.Max(1, modalQuantity - 1)" disabled="@(modalQuantity <= 1)">-</button>
                            <span class="stepper-value">@modalQuantity</span>
                            <button class="stepper-btn" 
                                    @onclick="IncreaseModalQuantity" 
                                    disabled="@(modalQuantity >= selectedProduct.Quantity)"
                                    style="@(modalQuantity >= selectedProduct.Quantity ? "opacity: 0.35; cursor: not-allowed;" : "")">+</button>
                        </div>
                    }
                    else
                    {
                        <span style="font-size: 12px; font-weight: 700; color: #9C8E84; background: #F3EFEA; padding: 4px 10px; border-radius: 8px;">Tạm hết hàng</span>
                    }
                </div>
            </div>

            <div class="sheet-footer">
                @if (selectedProduct != null && selectedProduct.Quantity > 0)
                {
                    <button class="btn-bk-primary" @onclick="AddToCartFromModal">
                        Thêm vào giỏ hàng • @($"{((selectedProduct.Price) * modalQuantity):N0}đ")
                    </button>
                }
                else
                {
                    <button class="btn-bk-primary" disabled style="background: #D1C7BD; color: #FFFFFF; cursor: not-allowed; box-shadow: none;">
                        Tạm Hết Bánh Hôm Nay
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- 6. Cart & Checkout Bottom Sheet -->
@if (isCartOpen)
{
    <div class="bottom-sheet-backdrop" @onclick="CloseCart">
        <div class="bottom-sheet-panel" @onclick:stopPropagation="true">
            <div class="sheet-handle"></div>
            <div class="sheet-header">
                <h5>Giỏ Hàng Của Bạn (@CartService.TotalItemsCount)</h5>
                <button class="sheet-close-btn" @onclick="CloseCart">&times;</button>
            </div>

            <div class="sheet-body">
                @if (!CartService.Items.Any())
                {
                    <div style="text-align: center; padding: 30px 10px; color: #9C8E84;">
                        <iconify-icon icon="solar:cart-cross-linear" style="font-size: 48px; color: #C0B4A9; margin-bottom: 8px;"></iconify-icon>
                        <h6 style="font-weight: 700; color: #2B2118; margin-bottom: 4px;">Giỏ hàng đang trống</h6>

                        @if (!string.IsNullOrEmpty(CartService.AppliedVoucherCode))
                        {
                            <div style="background: #FFFAF8; border: 1.5px dashed #E76F51; border-radius: 14px; padding: 12px 14px; margin: 12px 0 16px; text-align: left;">
                                <div style="display: flex; align-items: center; justify-content: space-between;">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <div style="width: 34px; height: 34px; border-radius: 10px; background: #FDF0ED; color: #E76F51; display: flex; align-items: center; justify-content: center; font-size: 18px;">
                                            <iconify-icon icon="solar:ticket-sale-bold"></iconify-icon>
                                        </div>
                                        <div>
                                            <span style="font-size: 12px; font-weight: 800; color: #2B2118;">Đã lưu mã: @CartService.AppliedVoucherCode</span>
                                            <div style="font-size: 11px; color: #6E6259;">Giảm @($"{CartService.DiscountPercent:0}%") khi thêm bánh vào giỏ!</div>
                                        </div>
                                    </div>
                                    <button style="border: none; background: #FEE2E2; color: #DC2626; border-radius: 6px; padding: 4px 8px; font-size: 11px; font-weight: 700; cursor: pointer;"
                                            @onclick="RemoveAppliedVoucher" title="Bỏ mã">✕</button>
                                </div>
                            </div>
                        }

                        <p style="font-size: 12px; margin: 0 0 16px;">Hãy chọn những chiếc bánh thơm ngon để tận hưởng ưu đãi giảm giá nhé!</p>
                        <button class="btn-bk-primary" style="width: auto; padding: 10px 24px;" @onclick='() => { CloseCart(); SwitchTab("menu"); }'>
                            Khám phá thực đơn ngay
                        </button>
                    </div>
                }
                else
                {
                    <!-- Items List -->
                    <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px;">
                        @foreach (var item in CartService.Items)
                        {
                            <div style="display: flex; align-items: center; justify-content: space-between; background: #FAF7F2; border-radius: 14px; padding: 10px 12px;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <img src="@item.ImageURL" alt="@item.ProductName" style="width: 44px; height: 44px; border-radius: 10px; object-fit: cover;" onerror="this.src='/assets/images/products/default-bakery.svg';" />
                                    <div>
                                        <h6 style="margin: 0; font-size: 13px; font-weight: 700; color: #2B2118;">@item.ProductName</h6>
                                        <div style="font-size: 12px; font-weight: 800; color: #E76F51; margin-top: 2px;">@($"{item.UnitPrice:N0}đ")</div>
                                    </div>
                                </div>

                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <div class="quantity-stepper">
                                        <button class="stepper-btn" @onclick="() => CartService.UpdateQuantity(item.ProductID, -1)">-</button>
                                        <span class="stepper-value">@item.Quantity</span>
                                        <button class="stepper-btn" 
                                                @onclick="() => CartService.UpdateQuantity(item.ProductID, 1)"
                                                disabled="@(item.Quantity >= item.MaxStock)"
                                                style="@(item.Quantity >= item.MaxStock ? "opacity: 0.35; cursor: not-allowed;" : "")">+</button>
                                    </div>
                                    <button style="border: none; background: transparent; color: #E63946; font-size: 16px; cursor: pointer;" @onclick="() => CartService.RemoveItem(item.ProductID)">
                                        <iconify-icon icon="solar:trash-bin-trash-linear"></iconify-icon>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Voucher Promo Code -->
                    <div style="margin-bottom: 16px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                            <label style="font-size: 12px; font-weight: 700; color: #2B2118; margin: 0;">Mã Khuyến Mãi / Voucher:</label>
                            <span style="font-size: 11px; font-weight: 700; color: #E76F51; cursor: pointer; display: flex; align-items: center; gap: 2px;"
                                  @onclick='() => OpenVouchersTab("cart")'>
                                <span>Kho voucher (@promotions.Count)</span>
                                <iconify-icon icon="solar:alt-arrow-right-linear" style="font-size: 12px;"></iconify-icon>
                            </span>
                        </div>

                        @if (!string.IsNullOrEmpty(CartService.AppliedVoucherCode))
                        {
                            <div style="background: #FFFAF8; border: 1.5px dashed #E76F51; border-radius: 12px; padding: 10px 12px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <iconify-icon icon="solar:ticket-sale-bold" style="font-size: 20px; color: #E76F51;"></iconify-icon>
                                    <div>
                                        <div style="font-size: 12px; font-weight: 800; color: #2B2118;">Mã: @CartService.AppliedVoucherCode</div>
                                        <div style="font-size: 11px; color: #6E6259;">
                                            Giảm @($"{CartService.DiscountPercent:0}%") @(CartService.MaxDiscountAmount > 0 ? $"(tối đa {CartService.MaxDiscountAmount:N0}đ)" : "")
                                            @if (CartService.MinOrderAmount > 0)
                                            {
                                                <span> • Đơn từ @($"{CartService.MinOrderAmount:N0}đ")</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <button style="border: 1px solid #E76F51; background: white; color: #E76F51; font-size: 11px; font-weight: 700; border-radius: 8px; padding: 3px 8px; cursor: pointer;"
                                            @onclick='() => OpenVouchersTab("cart")'>
                                        Đổi mã
                                    </button>
                                    <button class="btn-voucher-remove" style="padding: 3px 8px; font-size: 10px; border-radius: 8px;"
                                            @onclick="RemoveAppliedVoucher" title="Bỏ voucher">
                                        <iconify-icon icon="solar:close-circle-bold" style="font-size: 12px;"></iconify-icon>
                                        <span>Bỏ</span>
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div style="background: #FFF5EE; border: 1px dashed #E76F51; border-radius: 12px; padding: 10px 12px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; cursor: pointer;"
                                 @onclick='() => OpenVouchersTab("cart")'>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <iconify-icon icon="solar:ticket-sale-bold" style="font-size: 18px; color: #E76F51;"></iconify-icon>
                                    <span style="font-size: 12px; font-weight: 700; color: #E76F51;">Chọn từ kho voucher (@promotions.Count mã có sẵn)</span>
                                </div>
                                <iconify-icon icon="solar:alt-arrow-right-linear" style="font-size: 14px; color: #E76F51;"></iconify-icon>
                            </div>
                        }

                        <div style="display: flex; gap: 8px;">
                            <input type="text" class="form-control" placeholder="Hoặc nhập mã voucher..."
                                   style="border-radius: 12px; font-size: 12px; border-color: var(--bk-border);"
                                   @bind="voucherInput" />
                            <button style="background: #2B2118; color: white; border: none; border-radius: 12px; padding: 0 16px; font-size: 12px; font-weight: 700; cursor: pointer; white-space: nowrap;"
                                    @onclick="ApplyVoucher">
                                Áp dụng
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(voucherMessage))
                        {
                            <span style="font-size: 11px; font-weight: 600; color: @(voucherMessage.Contains("thành công") ? "#16A34A" : "#E63946"); margin-top: 4px; display: block;">
                                @voucherMessage
                            </span>
                        }
                    </div>

                    <!-- Delivery & Contact Information Form -->
                    <div style="background: white; border: 1px solid var(--bk-border); border-radius: 14px; padding: 14px; margin-bottom: 16px;">
                        <h6 style="margin: 0 0 10px; font-size: 13px; font-weight: 800; color: #2B2118;">Thông Tin Nhận Bánh</h6>
                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            <div>
                                <label style="font-size: 11px; color: #6E6259;">Họ và tên người nhận:</label>
                                <input type="text" class="form-control form-control-sm" style="border-radius: 8px;" @bind="receiverName" />
                            </div>
                            <div>
                                <label style="font-size: 11px; color: #6E6259;">Số điện thoại:</label>
                                <input type="text" class="form-control form-control-sm" style="border-radius: 8px;" @bind="receiverPhone" />
                            </div>
                            <div>
                                <label style="font-size: 11px; color: #6E6259;">Địa chỉ giao bánh:</label>
                                <input type="text" class="form-control form-control-sm" style="border-radius: 8px;" @bind="receiverAddress" />
                            </div>
                            <div>
                                <label style="font-size: 11px; color: #6E6259;">Ghi chú đơn hàng (ví dụ: giao trước 17h, kèm nến):</label>
                                <input type="text" class="form-control form-control-sm" style="border-radius: 8px;" @bind="orderNote" />
                            </div>
                        </div>
                    </div>

                    <!-- Payment Method Selector -->
                    <div style="margin-bottom: 16px;">
                        <label style="font-size: 12px; font-weight: 700; color: #2B2118; margin-bottom: 6px; display: block;">Phương Thức Thanh Toán:</label>
                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            <label style="display: flex; align-items: center; justify-content: space-between; background: @(selectedPaymentMethod == PaymentMethod.COD ? "#FDF0ED" : "#FFFFFF"); border: 1.5px solid @(selectedPaymentMethod == PaymentMethod.COD ? "#E76F51" : "#EFE8DE"); border-radius: 12px; padding: 10px 14px; cursor: pointer;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <input type="radio" name="paymentMethod" checked="@(selectedPaymentMethod == PaymentMethod.COD)" @onchange="() => selectedPaymentMethod = PaymentMethod.COD" />
                                    <span style="font-size: 12px; font-weight: 700; color: #2B2118;">Tiền mặt khi nhận bánh (COD)</span>
                                </div>
                                <iconify-icon icon="solar:wallet-money-bold" style="font-size: 18px; color: #E76F51;"></iconify-icon>
                            </label>

                            <label style="display: flex; align-items: center; justify-content: space-between; background: @(selectedPaymentMethod == PaymentMethod.BankTransfer ? "#FDF0ED" : "#FFFFFF"); border: 1.5px solid @(selectedPaymentMethod == PaymentMethod.BankTransfer ? "#E76F51" : "#EFE8DE"); border-radius: 12px; padding: 10px 14px; cursor: pointer;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <input type="radio" name="paymentMethod" checked="@(selectedPaymentMethod == PaymentMethod.BankTransfer)" @onchange="() => selectedPaymentMethod = PaymentMethod.BankTransfer" />
                                    <span style="font-size: 12px; font-weight: 700; color: #2B2118;">Chuyển khoản VietQR</span>
                                </div>
                                <iconify-icon icon="solar:card-transfer-bold" style="font-size: 18px; color: #0284C7;"></iconify-icon>
                            </label>

                            <label style="display: flex; align-items: center; justify-content: space-between; background: @(selectedPaymentMethod == PaymentMethod.VNPAY ? "#FDF0ED" : "#FFFFFF"); border: 1.5px solid @(selectedPaymentMethod == PaymentMethod.VNPAY ? "#E76F51" : "#EFE8DE"); border-radius: 12px; padding: 10px 14px; cursor: pointer;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <input type="radio" name="paymentMethod" checked="@(selectedPaymentMethod == PaymentMethod.VNPAY)" @onchange="() => selectedPaymentMethod = PaymentMethod.VNPAY" />
                                    <span style="font-size: 12px; font-weight: 700; color: #2B2118;">Ví điện tử VNPAY</span>
                                </div>
                                <iconify-icon icon="solar:smartphone-bold" style="font-size: 18px; color: #16A34A;"></iconify-icon>
                            </label>
                        </div>
                    </div>

                    <!-- Pricing Summary -->
                    <div style="background: #FAF7F2; border-radius: 14px; padding: 12px 14px; margin-bottom: 12px;">
                        <div style="display: flex; justify-content: space-between; font-size: 12px; color: #6E6259; margin-bottom: 4px;">
                            <span>Tạm tính tiền bánh:</span>
                            <span style="font-weight: 700;">@($"{CartService.SubTotalAmount:N0}đ")</span>
                        </div>
                        @if (CartService.DiscountAmount > 0)
                        {
                            <div style="display: flex; justify-content: space-between; font-size: 12px; color: #E76F51; margin-bottom: 4px;">
                                <span>Giảm giá voucher (@CartService.AppliedVoucherCode):</span>
                                <span style="font-weight: 700;">-@($"{CartService.DiscountAmount:N0}đ")</span>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(CartService.AppliedVoucherCode) && CartService.RemainingForVoucher > 0)
                        {
                            <div style="font-size: 11px; color: #D97706; margin-bottom: 4px; font-weight: 600; background: #FEF3C7; padding: 4px 8px; border-radius: 6px;">
                                ⚠️ Cần mua thêm @($"{CartService.RemainingForVoucher:N0}đ") để áp dụng mã @CartService.AppliedVoucherCode!
                            </div>
                        }
                        <div style="display: flex; justify-content: space-between; font-size: 12px; color: #6E6259; margin-bottom: 6px;">
                            <span>Phí giao hàng:</span>
                            <span style="color: #16A34A; font-weight: 700;">Miễn phí (Freeship)</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: 14px; color: #2B2118; font-weight: 800; padding-top: 6px; border-top: 1px dashed #E0D7CD;">
                            <span>Tổng thanh toán:</span>
                            <span style="color: #E76F51; font-size: 16px;">@($"{CartService.FinalAmount:N0}đ")</span>
                        </div>
                    </div>
                }
            </div>

            @if (CartService.Items.Any())
            {
                <div class="sheet-footer">
                    <button class="btn-bk-primary" @onclick="PlaceOrder" disabled="@isSubmittingOrder">
                        @if (isSubmittingOrder)
                        {
                            <span>Đang gửi đơn hàng vào hệ thống...</span>
                        }
                        else
                        {
                            <span>Xác Nhận Đặt Bánh Ngay • @($"{CartService.FinalAmount:N0}đ")</span>
                        }
                    </button>
                </div>
            }
        </div>
    </div>
}

<!-- 7. Order Success Modal -->
@if (justPlacedOrder != null)
