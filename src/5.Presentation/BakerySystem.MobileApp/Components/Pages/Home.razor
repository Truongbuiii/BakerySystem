    private string IsStepActiveOrCompleted(string currentStatus, string stepStatus)
    {
        int currentRank = GetStatusRank(currentStatus);
        int stepRank = GetStatusRank(stepStatus);

        if (currentRank > stepRank) return "completed";
        if (currentRank == stepRank) return "active";
        return string.Empty;
    }

    private int GetStatusRank(string status) => status switch
    {
        OrderStatus.Pending => 1,
        OrderStatus.Confirmed => 2,
        OrderStatus.InProgress => 3,
        OrderStatus.Shipping => 4,
        OrderStatus.Completed => 5,
        _ => 0
    };

    private string GetVipTier(decimal totalSpent)
    {
        if (totalSpent >= 3000000m) return "VIP KIM CƯƠNG";
        if (totalSpent >= 1500000m) return "VIP VÀNG";
        if (totalSpent >= 500000m) return "VIP BẠC";
        return "THÀNH VIÊN";
    }

    private string GetCustomerInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "KH";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Length >= 2 ? parts[0][..2].ToUpper() : parts[0].ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private string GetStatusText(string status) => status switch
    {
        OrderStatus.Pending => "Chờ duyệt",
        OrderStatus.Confirmed => "Đã duyệt",
        OrderStatus.InProgress => "Đang làm bánh",
        OrderStatus.Shipping => "Đang giao",
        OrderStatus.Completed => "Hoàn tất",
        OrderStatus.Cancelled => "Đã hủy",
