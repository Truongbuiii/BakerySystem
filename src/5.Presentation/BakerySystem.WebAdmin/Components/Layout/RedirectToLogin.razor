@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var currentRelative = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (string.IsNullOrEmpty(currentRelative) || currentRelative.Equals("login", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        else
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(currentRelative)}", forceLoad: true);
        }
    }
}

