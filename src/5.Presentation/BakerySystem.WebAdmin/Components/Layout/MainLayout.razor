@implements IDisposable
@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@inject IServiceScopeFactory ScopeFactory

<div class="bakery-layout-root">
    <!-- Backdrop for mobile drawer -->
    <div id="sidebar-backdrop" onclick="window.bakeryAdmin.closeSidebar()" class="fixed inset-0 bg-black/50 z-40 hidden transition-opacity"></div>

    <!-- Sidebar: Fixed 260px on desktop (>=1024px), slide-over drawer on mobile/tablet (<1024px) -->
    <aside id="admin-sidebar" class="bakery-sidebar">
        <!-- Brand Logo Header with Crisp Bottom Divider -->
        <div class="bakery-sidebar-brand">
            <a href="" class="flex items-center gap-2">
                <img src="/assets/images/logos/dark-logo.svg" alt="BakeryAdmin" class="h-8 dark:hidden block" />
                <img src="/assets/images/logos/light-logo.svg" alt="BakeryAdmin" class="h-8 dark:block hidden" />
            </a>
            <button onclick="window.bakeryAdmin.toggleSidebarCollapse()" class="bakery-sidebar-collapse-toggle p-1.5 rounded-lg text-bodytext hover:text-primary hover:bg-lightprimary transition-colors cursor-pointer" title="Thu gọn menu" aria-label="Thu gọn menu">
                <iconify-icon icon="solar:sidebar-minimalistic-linear" class="text-xl"></iconify-icon>
            </button>
            <button onclick="window.bakeryAdmin.closeSidebar()" class="bakery-sidebar-close p-1.5 rounded-lg text-bodytext hover:text-primary hover:bg-lightprimary transition-colors cursor-pointer" title="Đóng menu">
                <iconify-icon icon="solar:close-circle-linear" class="text-2xl"></iconify-icon>
            </button>
        </div>

        <!-- Sidebar Navigation Menu -->
        <NavMenu />
    </aside>

    <!-- Page Body Wrapper -->
    <div class="bakery-page-wrapper">
        <!-- Topbar / Header -->
        <header class="bakery-topbar">
            <!-- Left: Mobile toggle & Search bar -->
            <div class="flex items-center gap-3">
                <button onclick="window.bakeryAdmin.toggleSidebar()" class="bakery-mobile-toggle p-2 rounded-lg hover:bg-lightprimary text-bodytext hover:text-primary transition-colors cursor-pointer" title="Mở menu">
                    <iconify-icon icon="solar:hamburger-menu-linear" class="text-2xl"></iconify-icon>
                </button>

                <!-- Search Input -->
                <div class="relative hidden sm:flex items-center">
                    <iconify-icon icon="solar:minimalistic-magnifer-linear" class="absolute left-3.5 text-lg text-bodytext"></iconify-icon>
                    <input type="text" placeholder="Tìm kiếm đơn hàng, bánh, khách..." class="form-control ps-10 pr-4 py-2 w-72 md:w-80 bg-white dark:bg-dark border border-border dark:border-darkborder rounded-lg text-sm focus:outline-none focus:border-primary transition-all placeholder:text-bodytext/60" />
                </div>
            </div>

            <!-- Right: Header Actions -->
            <div class="flex items-center gap-2 sm:gap-3">
                <!-- Thông tin Thu ngân & Thời gian trực tiếp trên Header thanh điều hướng -->
                <AuthorizeView>
                    <Authorized>
                        @{
                            var empName = context.User.FindFirst("FullName")?.Value ?? context.User.Identity?.Name ?? "Nhân viên";
                            var empRoleLabel = context.User.IsInRole("Shipper") ? "Shipper" : "Thu ngân";
                        }
                        <div class="hidden md:flex items-center gap-2 mr-1">
                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300 text-xs font-semibold border border-blue-200 dark:border-blue-800 shadow-xs">
                                <iconify-icon icon="solar:user-circle-bold" class="text-sm text-blue-600 dark:text-blue-400"></iconify-icon>
                                <span>@empRoleLabel: <strong>@empName</strong></span>
                            </span>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-xs font-mono border border-slate-200 dark:border-slate-700">
                                <iconify-icon icon="solar:clock-circle-linear" class="text-xs"></iconify-icon>
                                <span>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                            </span>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <!-- Notifications Dropdown -->
                <div class="relative">
                    <button data-dropdown-trigger onclick="window.bakeryAdmin.toggleDropdown('notif-dropdown')" class="h-10 w-10 rounded-full hover:bg-lightprimary text-bodytext dark:text-darklink hover:text-primary transition-colors relative flex items-center justify-center cursor-pointer" title="Thông báo">
                        <iconify-icon icon="solar:bell-linear" class="text-xl"></iconify-icon>
                        @if (notificationCount > 0)
                        {
                            <span class="absolute top-2 right-2 w-2 h-2 bg-primary rounded-full"></span>
                        }
                    </button>
                    <div id="notif-dropdown" data-admin-dropdown class="bakery-notification-dropdown hidden absolute right-0 mt-2 bg-white dark:bg-dark border border-border dark:border-darkborder rounded-xl shadow-lg py-3 z-50">
                        <div class="px-5 pb-2.5 border-b border-border dark:border-darkborder flex justify-between items-center">
                            <span class="font-semibold text-sm text-dark dark:text-white">Thông báo mới</span>
                            <span class="bakery-badge bakery-badge-primary">@notificationCount mới</span>
                        </div>
                        <div class="divide-y divide-border dark:divide-darkborder max-h-64 overflow-y-auto">
                            @if (lowStockProducts.Count == 0 && recentCompletedOrders.Count == 0)
                            {
                                <div class="px-4 py-6 text-center text-xs text-bodytext">Chưa có thông báo mới.</div>
                            }
                            @foreach (var product in lowStockProducts)
                            {
                                <a href="/products" class="px-4 py-3 hover:bg-lightprimary/40 cursor-pointer flex items-start gap-3 transition-colors">
                                    <span class="p-2 rounded-lg bg-lightwarning text-warning shrink-0"><iconify-icon icon="solar:danger-triangle-linear" class="text-lg"></iconify-icon></span>
                                    <div>
                                        <p class="text-xs font-semibold text-dark dark:text-white">Sắp hết hàng: @product.ProductName</p>
                                        <p class="text-[11px] text-bodytext">Tồn kho còn @product.Quantity cái</p>
                                        <span class="text-[10px] text-bodytext/70">Cần chú ý bổ sung</span>
                                    </div>
                                </a>
                            }
                            @foreach (var order in recentCompletedOrders)
                            {
                                <a href="/orders" class="px-4 py-3 hover:bg-lightprimary/40 cursor-pointer flex items-start gap-3 transition-colors">
                                    <span class="p-2 rounded-lg bg-lightsuccess text-success shrink-0"><iconify-icon icon="solar:cart-check-linear" class="text-lg"></iconify-icon></span>
                                    <div>
                                        <p class="text-xs font-semibold text-dark dark:text-white">Đơn hàng #@order.OrderID đã giao</p>
                                        <p class="text-[11px] text-bodytext">@order.FinalAmount.ToString("N0")đ · @(order.Customer?.FullName ?? "Khách lẻ")</p>
                                        <span class="text-[10px] text-bodytext/70">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                </div>

                <!-- User Profile Dropdown -->
                <AuthorizeView>
                    <Authorized>
                        @{
                            var displayName = context.User.FindFirst("FullName")?.Value ?? context.User.Identity?.Name ?? "Quản trị viên";
                            var roleValue = context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                            var userRole = roleValue switch
                            {
                                "Admin" => "Quản trị viên",
                                "Shipper" => "Nhân viên giao hàng",
                                _ => "Nhân viên"
                            };
                            var username = context.User.Identity?.Name ?? "admin";
                            var initials = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries) is { Length: > 1 } words 
                                ? $"{words[0][0]}{words[^1][0]}".ToUpper() 
                                : (displayName.Length >= 2 ? displayName[..2].ToUpper() : "NV");
                        }
                        <div class="relative bakery-profile-menu-wrap">
                            <button data-dropdown-trigger onclick="window.bakeryAdmin.toggleDropdown('profile-dropdown')" class="bakery-profile-trigger" title="Hồ sơ tài khoản: @displayName" aria-label="Mở menu tài khoản">
                                <span class="bakery-avatar-initials">@initials</span>
                                <span class="bakery-profile-trigger-copy">
                                    <span class="bakery-profile-trigger-name">@displayName</span>
                                    <span class="bakery-profile-trigger-role">@userRole</span>
                                </span>
                                <iconify-icon icon="solar:alt-arrow-down-linear" class="bakery-profile-chevron"></iconify-icon>
                            </button>
                            <div id="profile-dropdown" data-admin-dropdown class="bakery-profile-dropdown hidden absolute right-0 mt-2 w-60 bg-white dark:bg-dark border border-border dark:border-darkborder py-2 z-50">
                                <div class="bakery-profile-dropdown-heading">
                                    <span class="bakery-avatar-initials-lg">@initials</span>
                                    <div class="min-w-0">
                                        <p class="bakery-profile-dropdown-name">@displayName</p>
                                        <div class="flex items-center gap-1.5 mt-0.5">
                                            <span class="bakery-badge @(context.User.IsInRole("Admin") ? "bakery-badge-primary" : "bakery-badge-success") text-[10px] py-0.5 px-1.5">
                                                @userRole
                                            </span>
                                            <span class="text-[11px] text-slate-400 font-mono">@@@username</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="bakery-profile-dropdown-links">
                                    <a href="profile" class="bakery-profile-dropdown-link">
                                        <span class="bakery-profile-link-icon"><iconify-icon icon="solar:user-circle-linear"></iconify-icon></span>
                                        <span><strong>Hồ sơ cá nhân</strong><small>Thông tin và bảo mật</small></span>
                                        <iconify-icon icon="solar:alt-arrow-right-linear" class="bakery-profile-link-arrow"></iconify-icon>
                                    </a>
                                </div>
                                <div class="bakery-profile-dropdown-footer">
                                    <button onclick="window.bakeryAuth.logout()" class="bakery-profile-logout">
                                        <iconify-icon icon="solar:logout-2-linear"></iconify-icon>
                                        <span>Đăng xuất</span>
                                        <iconify-icon icon="solar:alt-arrow-right-linear" class="bakery-profile-link-arrow"></iconify-icon>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="bakery-btn bakery-btn-primary bakery-btn-sm text-xs">
                            Đăng nhập
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <!-- Main Content Area: Responsive bounded container -->
        <main class="bakery-main">
            <div class="bakery-container">
                @Body
            </div>
        </main>

        <!-- Footer -->
        <footer class="bakery-footer">
            &copy; @DateTime.Now.Year BakerySystem - Hệ thống quản lý cửa hàng bán bánh mì & bánh ngọt.
        </footer>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Đã xảy ra lỗi không mong muốn.
    <a href="." class="reload font-semibold underline ml-2">Tải lại</a>
    <span class="dismiss ml-2 cursor-pointer font-bold">✕</span>
</div>

@code {
    private List<ProductDto> lowStockProducts = [];
    private List<Order> recentCompletedOrders = [];
    private int notificationCount;
    private readonly SemaphoreSlim notificationLoadGate = new(1, 1);
    private bool isDisposed;
    private bool notificationsLoaded;

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await LoadNotificationsAsync();
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        var authenticationState = await authenticationStateTask;
        if (authenticationState.User.Identity?.IsAuthenticated != true)
        {
            lowStockProducts = [];
            recentCompletedOrders = [];
            notificationCount = 0;
            await InvokeAsync(StateHasChanged);
            return;
        }

        await LoadNotificationsAsync();
    }

    private async Task LoadNotificationsAsync()
    {
        var authenticationState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authenticationState.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        await notificationLoadGate.WaitAsync();
        try
        {
            if (isDisposed || notificationsLoaded)
            {
                return;
            }

            using var scope = ScopeFactory.CreateScope();
            var productService = scope.ServiceProvider.GetRequiredService<IProductService>();
            var orderManager = scope.ServiceProvider.GetRequiredService<OrderService>();
            lowStockProducts = await productService.GetLowStockProductsAsync();
            recentCompletedOrders = await orderManager.GetRecentCompletedAsync();
            notificationCount = lowStockProducts.Count + recentCompletedOrders.Count;
            notificationsLoaded = true;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            notificationLoadGate.Release();
        }
    }

    public void Dispose()
    {
        isDisposed = true;
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        notificationLoadGate.Dispose();
    }
}
