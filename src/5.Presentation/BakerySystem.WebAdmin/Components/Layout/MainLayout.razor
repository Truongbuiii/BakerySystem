@inherits LayoutComponentBase

<div class="bakery-layout-root">
    <!-- Backdrop for mobile drawer -->
    <div id="sidebar-backdrop" onclick="window.bakeryAdmin.closeSidebar()" class="fixed inset-0 bg-black/50 z-40 hidden transition-opacity"></div>

    <!-- Sidebar: Fixed 260px on desktop (>=1024px), slide-over drawer on mobile/tablet (<1024px) -->
    <aside id="admin-sidebar" class="bakery-sidebar">
        <!-- Brand Logo Header with Crisp Bottom Divider -->
        <div class="bakery-sidebar-brand">
            <a href="" class="flex items-center gap-2">
                <img src="/assets/images/logos/dark-logo.svg" alt="BakeryAdmin" class="h-8 dark:hidden block" />
                <img src="/assets/images/logos/light-logo.svg" alt="BakeryAdmin" class="h-8 dark:block hidden" />
            </a>
            <button onclick="window.bakeryAdmin.closeSidebar()" class="bakery-sidebar-close p-1.5 rounded-lg text-bodytext hover:text-primary hover:bg-lightprimary transition-colors cursor-pointer" title="Đóng menu">
                <iconify-icon icon="solar:close-circle-linear" class="text-2xl"></iconify-icon>
            </button>
        </div>

        <!-- Sidebar Navigation Menu -->
        <NavMenu />
    </aside>

    <!-- Page Body Wrapper -->
    <div class="bakery-page-wrapper">
        <!-- Topbar / Header -->
        <header class="bakery-topbar">
            <!-- Left: Mobile toggle & Search bar -->
            <div class="flex items-center gap-3">
                <button onclick="window.bakeryAdmin.toggleSidebar()" class="bakery-mobile-toggle p-2 rounded-lg hover:bg-lightprimary text-bodytext hover:text-primary transition-colors cursor-pointer" title="Mở menu">
                    <iconify-icon icon="solar:hamburger-menu-linear" class="text-2xl"></iconify-icon>
                </button>

                <!-- Search Input -->
                <div class="relative hidden sm:flex items-center">
                    <iconify-icon icon="solar:minimalistic-magnifer-linear" class="absolute left-3.5 text-lg text-bodytext"></iconify-icon>
                    <input type="text" placeholder="Tìm kiếm đơn hàng, bánh, khách..." class="form-control ps-10 pr-4 py-2 w-72 md:w-80 bg-white dark:bg-dark border border-border dark:border-darkborder rounded-lg text-sm focus:outline-none focus:border-primary transition-all placeholder:text-bodytext/60" />
                </div>
            </div>

            <!-- Right: Header Actions -->
            <div class="flex items-center gap-2 sm:gap-3">
                <!-- Light / Dark Theme Switcher -->
                <button onclick="window.bakeryAdmin.toggleTheme()" class="h-10 w-10 rounded-full hover:bg-lightprimary text-bodytext dark:text-darklink hover:text-primary transition-colors flex items-center justify-center cursor-pointer" title="Chuyển chế độ Sáng / Tối">
                    <iconify-icon icon="solar:moon-linear" class="text-xl dark:hidden block"></iconify-icon>
                    <iconify-icon icon="solar:sun-2-linear" class="text-xl dark:block hidden text-warning"></iconify-icon>
                </button>

                <!-- Notifications Dropdown -->
                <div class="relative">
                    <button data-dropdown-trigger onclick="window.bakeryAdmin.toggleDropdown('notif-dropdown')" class="h-10 w-10 rounded-full hover:bg-lightprimary text-bodytext dark:text-darklink hover:text-primary transition-colors relative flex items-center justify-center cursor-pointer" title="Thông báo">
                        <iconify-icon icon="solar:bell-linear" class="text-xl"></iconify-icon>
                        <span class="absolute top-2 right-2 w-2 h-2 bg-primary rounded-full"></span>
                    </button>
                    <div id="notif-dropdown" data-admin-dropdown class="hidden absolute right-0 mt-2 w-80 bg-white dark:bg-dark border border-border dark:border-darkborder rounded-xl shadow-lg py-3 z-50">
                        <div class="px-5 pb-2.5 border-b border-border dark:border-darkborder flex justify-between items-center">
                            <span class="font-semibold text-sm text-dark dark:text-white">Thông báo mới</span>
                            <span class="bakery-badge bakery-badge-primary">2 mới</span>
                        </div>
                        <div class="divide-y divide-border dark:divide-darkborder max-h-64 overflow-y-auto">
                            <div class="px-4 py-3 hover:bg-lightprimary/40 cursor-pointer flex items-start gap-3 transition-colors">
                                <span class="p-2 rounded-lg bg-lightsuccess text-success shrink-0"><iconify-icon icon="solar:cart-check-linear" class="text-lg"></iconify-icon></span>
                                <div>
                                    <p class="text-xs font-semibold text-dark dark:text-white">Đơn đặt bánh mới #BK-1042</p>
                                    <p class="text-[11px] text-bodytext">Bánh Tiramisu Ý Hoàng Gia - 350.000đ</p>
                                    <span class="text-[10px] text-bodytext/70">5 phút trước</span>
                                </div>
                            </div>
                            <div class="px-4 py-3 hover:bg-lightprimary/40 cursor-pointer flex items-start gap-3 transition-colors">
                                <span class="p-2 rounded-lg bg-lightwarning text-warning shrink-0"><iconify-icon icon="solar:box-minimalistic-linear" class="text-lg"></iconify-icon></span>
                                <div>
                                    <p class="text-xs font-semibold text-dark dark:text-white">Cảnh báo nguyên liệu</p>
                                    <p class="text-[11px] text-bodytext">Bột hạnh nhân trong kho còn dưới 5kg</p>
                                    <span class="text-[10px] text-bodytext/70">15 phút trước</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- User Profile Dropdown -->
                <div class="relative">
                    <button data-dropdown-trigger onclick="window.bakeryAdmin.toggleDropdown('profile-dropdown')" class="flex items-center gap-2 p-0.5 rounded hover:bg-slate-100 transition-colors cursor-pointer" title="Hồ sơ quản trị">
                        <span class="bakery-avatar-initials">AD</span>
                    </button>
                    <div id="profile-dropdown" data-admin-dropdown class="hidden absolute right-0 mt-2 w-56 bg-white dark:bg-dark border border-border dark:border-darkborder rounded-md shadow-sm py-2 z-50">
                        <div class="px-4 py-2.5 border-b border-border dark:border-darkborder flex items-center gap-3">
                            <span class="bakery-avatar-initials-lg">AD</span>
                            <div>
                                <p class="text-xs font-semibold text-slate-800 dark:text-white mb-0">Quản trị viên</p>
                                <p class="text-[11px] text-slate-500 mb-0">admin@bakerysystem.com</p>
                            </div>
                        </div>
                        <div class="py-1">
                            <a href="settings" class="flex items-center gap-2.5 px-4 py-2 text-xs text-slate-700 dark:text-white hover:bg-slate-50 hover:text-primary transition-colors">
                                <iconify-icon icon="solar:user-circle-linear" class="text-base"></iconify-icon>
                                Hồ sơ & Cài đặt
                            </a>
                        </div>
                        <div class="p-2.5 border-t border-border dark:border-darkborder">
                            <button class="bakery-btn bakery-btn-outline w-full text-xs" style="height: 30px;">
                                Đăng xuất
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Content Area: Responsive bounded container -->
        <main class="bakery-main">
            <div class="bakery-container">
                @Body
            </div>
        </main>

        <!-- Footer -->
        <footer class="bakery-footer">
            &copy; @DateTime.Now.Year BakerySystem - Hệ thống quản lý cửa hàng bán bánh mì & bánh ngọt.
        </footer>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Đã xảy ra lỗi không mong muốn.
    <a href="." class="reload font-semibold underline ml-2">Tải lại</a>
    <span class="dismiss ml-2 cursor-pointer font-bold">✕</span>
</div>
