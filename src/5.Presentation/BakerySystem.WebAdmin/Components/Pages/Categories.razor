@page "/categories"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject IProductService ProductService
@inject NavigationManager Navigation

<PageTitle>Quản Lý Loại Sản Phẩm | BakeryAdmin</PageTitle>

<div>
    <!-- Breadcrumb & Header -->
    <div class="bakery-page-header">
        <div style="max-width: 650px;">
            <div class="flex items-center gap-2 text-xs font-medium text-slate-500 mb-1">
                <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
                    <iconify-icon icon="solar:home-2-linear" class="text-sm"></iconify-icon>
                    Tổng quan
                </a>
                <span>/</span>
                <span class="text-slate-800 dark:text-slate-200 font-semibold">Loại sản phẩm</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold text-dark dark:text-white mb-1">Quản Lý Loại Sản Phẩm Bánh</h2>
            <p class="text-xs sm:text-sm text-bodytext mb-0">Quản lý các nhóm bánh, sửa tên, ẩn hoặc xóa phân loại thực đơn theo quy định dữ liệu.</p>
        </div>

        <div class="bakery-page-actions">
            <a href="/products" class="bakery-btn bakery-btn-outline bakery-btn-sm">
                <iconify-icon icon="solar:bag-5-linear" class="text-base"></iconify-icon>
                <span>Xem tất cả món bánh</span>
            </a>
            <button class="bakery-btn bakery-btn-primary bakery-btn-sm shadow-sm" @onclick="OpenCreateModal">
                <iconify-icon icon="solar:add-circle-linear" class="text-base"></iconify-icon>
                <span>+ Thêm loại mới</span>
            </button>
        </div>
    </div>

    <!-- Alert / Status Banner -->
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="mb-4 bakery-info-box @(alertIsSuccess ? "bakery-info-box-success" : "bakery-info-box-danger") flex flex-row items-center justify-between shadow-sm transition-all">
            <div class="flex items-center gap-2.5 text-xs sm:text-sm font-medium">
                <iconify-icon icon="@(alertIsSuccess ? "solar:check-circle-bold" : "solar:danger-triangle-bold")" class="text-lg @(alertIsSuccess ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400")"></iconify-icon>
                <span>@alertMessage</span>
            </div>
            <button type="button" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1" @onclick="() => alertMessage = null">
                <iconify-icon icon="solar:close-circle-linear" class="text-base"></iconify-icon>
            </button>
        </div>
    }

    <!-- Modern Metric Overview Cards (Bo góc 18px, đổ bóng nhẹ, gradient icon) -->
    <div class="bakery-stats-grid">
        <div class="bakery-stat-card">
            <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Tổng loại bánh</span>
                <h3 class="text-2xl font-bold text-slate-800 dark:text-white mb-0">@categories.Count</h3>
            </div>
            <div class="bakery-stat-icon-wrapper" style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); color: #2563eb; border: 1px solid #bfdbfe;">
                <iconify-icon icon="solar:folder-with-files-bold"></iconify-icon>
            </div>
        </div>

        <div class="bakery-stat-card">
            <div>
                <span class="text-xs font-semibold text-emerald-600 uppercase tracking-wider block mb-1">Đang hoạt động</span>
                <h3 class="text-2xl font-bold text-emerald-600 mb-0">@categories.Count(c => c.IsActive)</h3>
            </div>
            <div class="bakery-stat-icon-wrapper" style="background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%); color: #059669; border: 1px solid #a7f3d0;">
                <iconify-icon icon="solar:check-circle-bold"></iconify-icon>
            </div>
        </div>

        <div class="bakery-stat-card">
            <div>
                <span class="text-xs font-semibold text-amber-600 uppercase tracking-wider block mb-1">Đang tạm ẩn</span>
                <h3 class="text-2xl font-bold text-amber-600 mb-0">@categories.Count(c => !c.IsActive)</h3>
            </div>
            <div class="bakery-stat-icon-wrapper" style="background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); color: #d97706; border: 1px solid #fde68a;">
                <iconify-icon icon="solar:eye-closed-bold"></iconify-icon>
            </div>
        </div>

        <div class="bakery-stat-card">
            <div>
                <span class="text-xs font-semibold text-purple-600 uppercase tracking-wider block mb-1">Tổng món bánh</span>
                <h3 class="text-2xl font-bold text-purple-700 dark:text-purple-300 mb-0">@categories.Sum(c => c.ProductCount)</h3>
            </div>
            <div class="bakery-stat-icon-wrapper" style="background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%); color: #7c3aed; border: 1px solid #e9d5ff;">
                <iconify-icon icon="solar:bag-heart-bold"></iconify-icon>
            </div>
        </div>
    </div>

    <!-- Modern Filter & Search Bar (Bo góc 18px, segmented pill control) -->
    <div class="bakery-filter-toolbar">
        <!-- Search Input -->
        <div class="bakery-filter-search-box">
            <iconify-icon icon="solar:magnifer-linear" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-base pointer-events-none"></iconify-icon>
            <input type="text"
                   class="w-full"
                   placeholder="Tìm kiếm loại sản phẩm theo tên..."
                   @bind="searchTerm"
                   @bind:event="oninput" />
        </div>

        <!-- Filter Status Tabs (Pill style) -->
        <div class="bakery-pill-tabs">
            <button type="button"
                    class="bakery-pill-tab @(statusFilter == "all" ? "active" : "")"
                    @onclick='() => statusFilter = "all"'>
                Tất cả (@categories.Count)
            </button>
            <button type="button"
                    class="bakery-pill-tab @(statusFilter == "active" ? "active" : "")"
                    @onclick='() => statusFilter = "active"'>
                Hoạt động (@categories.Count(c => c.IsActive))
            </button>
            <button type="button"
                    class="bakery-pill-tab @(statusFilter == "inactive" ? "active" : "")"
                    @onclick='() => statusFilter = "inactive"'>
                Đang ẩn (@categories.Count(c => !c.IsActive))
            </button>
        </div>
    </div>

    <!-- Category Grid Cards (Ô vuông vắn, bo góc 20px, viền và shadow hiện đại) -->
    @if (isLoading)
    {
        <div class="p-16 flex flex-col items-center justify-center gap-3">
            <div class="w-9 h-9 border-4 border-primary border-t-transparent rounded-full animate-spin"></div>
            <p class="text-xs sm:text-sm text-bodytext mb-0">Đang tải danh sách loại sản phẩm từ cơ sở dữ liệu...</p>
        </div>
    }
    else if (!FilteredCategories.Any())
    {
        <div class="p-12 text-center bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="w-14 h-14 mx-auto rounded-2xl bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center mb-3">
                <iconify-icon icon="solar:folder-with-files-linear" class="text-3xl"></iconify-icon>
            </div>
            <h4 class="text-base font-semibold text-slate-800 dark:text-white mb-1">Không tìm thấy loại sản phẩm phù hợp</h4>
            <p class="text-xs text-slate-500 mb-4">Thử thay đổi từ khóa tìm kiếm hoặc bấm nút đặt lại bộ lọc bên dưới.</p>
            <button type="button" class="bakery-btn bakery-btn-outline bakery-btn-sm" @onclick='() => { searchTerm = string.Empty; statusFilter = "all"; }'>
                Đặt lại bộ lọc
            </button>
        </div>
    }
    else
    {
        <div class="bakery-category-grid">
            @foreach (var cat in FilteredCategories)
            {
                <div class="bakery-category-card @(!cat.IsActive ? "is-inactive" : "")">
                    <!-- Top section: Avatar Icon, Status Pill & Product Count -->
                    <div>
                        <div class="flex items-start justify-between mb-3.5">
                            <!-- Icon Box with gradient -->
                            <div class="bakery-cat-icon-box @(cat.IsActive ? "active" : "inactive")">
                                <iconify-icon icon="solar:folder-with-files-bold"></iconify-icon>
                            </div>
                            
                            <div class="flex flex-col items-end gap-1.5">
                                <!-- Status Pill -->
                                @if (cat.IsActive)
                                {
                                    <span class="bakery-badge bakery-badge-success text-[11px] font-semibold flex items-center gap-1.5">
                                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                        Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="bakery-badge bakery-badge-secondary text-[11px] font-semibold flex items-center gap-1.5 text-slate-600 dark:text-slate-300">
                                        <span class="w-2 h-2 rounded-full bg-slate-400"></span>
                                        Đang ẩn
                                    </span>
                                }

                                <!-- Product Count Badge -->
                                <span class="bakery-badge @(cat.ProductCount > 0 ? "bakery-badge-primary" : "bakery-badge-secondary") text-[11px] font-medium">
                                    <iconify-icon icon="solar:bag-5-linear" class="text-xs mr-0.5"></iconify-icon>
                                    @cat.ProductCount món
                                </span>
                            </div>
                        </div>

                        <!-- Name & Category Metadata -->
                        <h4 class="text-base font-bold text-slate-900 dark:text-white mb-1.5 tracking-tight line-clamp-1" title="@cat.CategoryName">
                            @cat.CategoryName
                        </h4>
                        
                        <div class="flex items-center gap-2 text-xs text-slate-500">
                            <span class="font-mono bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-md text-[11px] text-slate-600 dark:text-slate-400">#CAT-@cat.CategoryID.ToString("D2")</span>
                            <span class="text-slate-300 dark:text-slate-700">•</span>
                            <span>@(cat.ProductCount > 0 ? $"{cat.ProductCount} món trong thực đơn" : "Chưa có món bánh")</span>
                        </div>
                    </div>

                    <!-- Bottom section: Navigation Link & Modern Action Buttons -->
                    <div class="pt-3.5 mt-3 border-t border-slate-100 dark:border-slate-800 space-y-2.5">
                        <!-- Link to view items in this category -->
                        <div class="flex items-center justify-between text-xs">
                            <a href="/products?categoryId=@cat.CategoryID" class="font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-700 flex items-center gap-1 transition-colors group">
                                <span>Xem danh sách bánh</span>
                                <iconify-icon icon="solar:arrow-right-linear" class="text-sm transition-transform group-hover:translate-x-0.5"></iconify-icon>
                            </a>
                            
                            @if (cat.ProductCount == 0)
                            {
                                <span class="text-[11px] text-slate-400 italic">Trống</span>
                            }
                        </div>

                        <!-- Action Buttons Group (Sửa - Ẩn/Hiện - Xóa) -->
                        <div class="flex items-center gap-1.5 pt-1">
                            <!-- Nút Sửa (Edit) -->
                            <button type="button"
                                    class="bakery-cat-action-btn edit flex-1"
                                    title="Chỉnh sửa tên loại sản phẩm"
                                    @onclick="() => OpenEditModal(cat)">
                                <iconify-icon icon="solar:pen-2-linear" class="text-sm"></iconify-icon>
                                <span>Sửa</span>
                            </button>

                            <!-- Nút Ẩn / Hiện lại (Toggle IsActive) -->
                            @if (cat.IsActive)
                            {
                                <button type="button"
                                        class="bakery-cat-action-btn hide flex-1"
                                        title="Ẩn loại sản phẩm này và ngưng bán toàn bộ sản phẩm liên quan"
                                        @onclick="() => ToggleCategoryStatusAsync(cat)">
                                    <iconify-icon icon="solar:eye-closed-linear" class="text-sm"></iconify-icon>
                                    <span>Ẩn</span>
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="bakery-cat-action-btn unhide flex-1"
                                        title="Bỏ ẩn - Kích hoạt lại loại sản phẩm và mở bán lại các món bánh"
                                        @onclick="() => ToggleCategoryStatusAsync(cat)">
                                    <iconify-icon icon="solar:eye-bold" class="text-sm"></iconify-icon>
                                    <span>Hiện lại</span>
                                </button>
                            }

                            <!-- Nút Xóa (Delete / Archive Business Rule Dialog) -->
                            @if (cat.ProductCount == 0)
                            {
                                <button type="button"
                                        class="bakery-cat-action-btn delete px-2.5"
                                        title="Chưa có món bánh nào - Cho phép Xóa vĩnh viễn"
                                        @onclick="() => OpenConfirmDialog(cat)">
                                    <iconify-icon icon="solar:trash-bin-trash-linear" class="text-sm"></iconify-icon>
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="bakery-cat-action-btn archive-warning px-2.5"
                                        title="Đang có @cat.ProductCount món bánh - Theo quy định chỉ được Ẩn, không xóa vĩnh viễn"
                                        @onclick="() => OpenConfirmDialog(cat)">
                                    <iconify-icon icon="solar:shield-warning-linear" class="text-sm"></iconify-icon>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ================= MODAL 1: THÊM LOẠI SẢN PHẨM MỚI ================= -->
@if (isCreateModalOpen)
{
    <div class="bakery-modal-backdrop" @onclick="() => isCreateModalOpen = false">
        <div class="bakery-modal-card max-w-md" @onclick:stopPropagation="true">
            <div class="bakery-modal-header">
                <div class="flex items-center gap-2.5">
                    <div class="bakery-modal-icon-badge blue">
                        <iconify-icon icon="solar:folder-with-files-linear"></iconify-icon>
                    </div>
                    <div>
                        <h4 class="text-base font-bold text-dark dark:text-white mb-0">Thêm Loại Sản Phẩm Mới</h4>
                        <p class="text-xs text-slate-500 mb-0">Tạo nhóm danh mục bánh mới cho thực đơn tiệm.</p>
                    </div>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 text-lg" @onclick="() => isCreateModalOpen = false">
                    <iconify-icon icon="solar:close-circle-linear"></iconify-icon>
                </button>
            </div>

            <div class="bakery-modal-body space-y-4">
                @if (!string.IsNullOrEmpty(createModalError))
                {
                    <div class="bakery-info-box bakery-info-box-danger text-xs font-medium flex items-center gap-2">
                        <iconify-icon icon="solar:danger-triangle-bold" class="text-base shrink-0"></iconify-icon>
                        <span>@createModalError</span>
                    </div>
                }

                <div>
                    <label class="bakery-label">Tên loại sản phẩm <span class="text-rose-500">*</span></label>
                    <input type="text"
                           class="bakery-input"
                           placeholder="Ví dụ: Bánh Mì Truyền Thống, Bánh Ngọt Pháp, Bánh Kem Sinh Nhật..."
                           @bind="newCategoryName"
                           @onkeyup="@(async e => { if (e.Key == "Enter") await SaveCreateCategoryAsync(); })"
                           autofocus />
                    <span class="text-[11px] text-slate-400 mt-1 block">Tên loại bánh phải là duy nhất và chưa tồn tại trong danh sách.</span>
                </div>
            </div>

            <div class="bakery-modal-footer">
                <button type="button" class="bakery-btn bakery-btn-outline" @onclick="() => isCreateModalOpen = false" disabled="@isSubmitting">Hủy bỏ</button>
                <button type="button" class="bakery-btn bakery-btn-primary" @onclick="SaveCreateCategoryAsync" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin mr-1.5"></span>
                        <span>Đang lưu...</span>
                    }
                    else
                    {
                        <iconify-icon icon="solar:check-circle-linear" class="text-base"></iconify-icon>
                        <span>Tạo loại sản phẩm</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= MODAL 2: CHỈNH SỬA TÊN LOẠI SẢN PHẨM ================= -->
@if (isEditModalOpen && selectedCategory != null)
{
    <div class="bakery-modal-backdrop" @onclick="() => isEditModalOpen = false">
        <div class="bakery-modal-card max-w-md" @onclick:stopPropagation="true">
            <div class="bakery-modal-header">
                <div class="flex items-center gap-2.5">
                    <div class="bakery-modal-icon-badge blue">
                        <iconify-icon icon="solar:pen-2-bold"></iconify-icon>
                    </div>
                    <div>
                        <h4 class="text-base font-bold text-dark dark:text-white mb-0">Chỉnh Sửa Loại Sản Phẩm</h4>
                        <p class="text-xs text-slate-500 mb-0">Mã danh mục: #CAT-@selectedCategory.CategoryID.ToString("D2")</p>
                    </div>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 text-lg" @onclick="() => isEditModalOpen = false">
                    <iconify-icon icon="solar:close-circle-linear"></iconify-icon>
                </button>
            </div>

            <div class="bakery-modal-body space-y-4">
                @if (!string.IsNullOrEmpty(editModalError))
                {
                    <div class="bakery-info-box bakery-info-box-danger text-xs font-medium flex items-center gap-2">
                        <iconify-icon icon="solar:danger-triangle-bold" class="text-base shrink-0"></iconify-icon>
                        <span>@editModalError</span>
                    </div>
                }

                <div class="bakery-info-box bakery-info-box-neutral text-xs space-y-2">
                    <div class="flex items-center justify-between text-slate-600 dark:text-slate-300">
                        <span>Số món bánh đang thuộc nhóm này:</span>
                        <span class="font-bold text-slate-900 dark:text-white">@selectedCategory.ProductCount món</span>
                    </div>
                    <div class="flex items-center justify-between text-slate-600 dark:text-slate-300">
                        <span>Trạng thái hiển thị:</span>
                        <span class="font-semibold @(selectedCategory.IsActive ? "text-emerald-600" : "text-amber-600")">
                            @(selectedCategory.IsActive ? "Đang hoạt động" : "Đang tạm ẩn")
                        </span>
                    </div>
                </div>

                <div>
                    <label class="bakery-label">Tên loại sản phẩm <span class="text-rose-500">*</span></label>
                    <input type="text"
                           class="bakery-input"
                           placeholder="Nhập tên mới cho loại sản phẩm..."
                           @bind="editingCategoryName"
                           @onkeyup="@(async e => { if (e.Key == "Enter") await SaveEditCategoryAsync(); })"
                           autofocus />
                </div>
            </div>

            <div class="bakery-modal-footer">
                <button type="button" class="bakery-btn bakery-btn-outline" @onclick="() => isEditModalOpen = false" disabled="@isSubmitting">Hủy bỏ</button>
                <button type="button" class="bakery-btn bakery-btn-primary" @onclick="SaveEditCategoryAsync" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin mr-1.5"></span>
                        <span>Đang lưu...</span>
                    }
                    else
                    {
                        <iconify-icon icon="solar:check-circle-linear" class="text-base"></iconify-icon>
                        <span>Lưu thay đổi</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= MODAL 3: XÁC NHẬN XÓA HOẶC ẨN (BUSINESS RULE ENFORCED) ================= -->
@if (isConfirmModalOpen && selectedCategory != null)
{
    <div class="bakery-modal-backdrop" @onclick="() => isConfirmModalOpen = false">
        <div class="bakery-modal-card max-w-md" @onclick:stopPropagation="true">
            <!-- Header Modal -->
            <div class="bakery-modal-header">
                <div class="flex items-center gap-2.5">
                    @if (selectedCategory.ProductCount == 0)
                    {
                        <div class="bakery-modal-icon-badge danger">
                            <iconify-icon icon="solar:trash-bin-trash-bold"></iconify-icon>
                        </div>
                        <div>
                            <h4 class="text-base font-bold text-slate-900 dark:text-white mb-0">Xác Nhận Xóa Vĩnh Viễn</h4>
                            <p class="text-xs text-slate-500 mb-0">Thao tác xóa loại sản phẩm không có món bánh</p>
                        </div>
                    }
                    else
                    {
                        <div class="bakery-modal-icon-badge warning">
                            <iconify-icon icon="solar:shield-warning-bold"></iconify-icon>
                        </div>
                        <div>
                            <h4 class="text-base font-bold text-slate-900 dark:text-white mb-0">Quy Định Bảo Toàn Dữ Liệu</h4>
                            <p class="text-xs text-slate-500 mb-0">Loại sản phẩm đang chứa sản phẩm</p>
                        </div>
                    }
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 text-lg" @onclick="() => isConfirmModalOpen = false">
                    <iconify-icon icon="solar:close-circle-linear"></iconify-icon>
                </button>
            </div>

            <!-- Body Modal -->
            <div class="bakery-modal-body space-y-3.5">
                @if (selectedCategory.ProductCount == 0)
                {
                    <!-- Case 0 products: Hard Delete Allowed -->
                    <div class="bakery-info-box bakery-info-box-danger text-xs space-y-1.5">
                        <div class="font-semibold flex items-center gap-1.5 text-rose-700 dark:text-rose-400">
                            <iconify-icon icon="solar:info-circle-bold" class="text-base"></iconify-icon>
                            <span>Đủ điều kiện xóa vĩnh viễn:</span>
                        </div>
                        <p class="mb-0 leading-relaxed">
                            Loại sản phẩm <strong class="text-slate-900 dark:text-white font-bold">"@selectedCategory.CategoryName"</strong> hiện <strong>chưa có bất kỳ món bánh nào</strong> trong cơ sở dữ liệu.
                        </p>
                    </div>

                    <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-0">
                        Bạn có chắc chắn muốn <span class="text-rose-600 font-bold">xóa hoàn toàn</span> loại sản phẩm này khỏi hệ thống không? Dữ liệu này sẽ không thể khôi phục sau khi xóa.
                    </p>
                }
                else
                {
                    <!-- Case > 0 products: Soft Archive Only Rule -->
                    <div class="bakery-info-box bakery-info-box-warning text-xs space-y-1.5">
                        <div class="font-semibold flex items-center gap-1.5 text-amber-800 dark:text-amber-300">
                            <iconify-icon icon="solar:shield-check-bold" class="text-base"></iconify-icon>
                            <span>Luật hệ thống bảo vệ dữ liệu:</span>
                        </div>
                        <p class="mb-0 leading-relaxed">
                            Loại sản phẩm <strong class="text-slate-900 dark:text-white font-bold">"@selectedCategory.CategoryName"</strong> hiện đang có <strong class="text-amber-800 dark:text-amber-300 font-bold">@selectedCategory.ProductCount món bánh</strong> liên kết.
                        </p>
                    </div>

                    <div class="bakery-info-box bakery-info-box-neutral text-xs space-y-2">
                        <div class="flex items-start gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500 mt-1.5 shrink-0"></span>
                            <span><strong>Không thể xóa vĩnh viễn:</strong> Để bảo vệ lịch sử hóa đơn bán hàng và các đơn đặt hàng đã diễn ra.</span>
                        </div>
                        <div class="flex items-start gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 mt-1.5 shrink-0"></span>
                            <span><strong>Ngưng hoạt động đồng bộ:</strong> Hệ thống sẽ chuyển loại sản phẩm sang <strong>ẨN</strong> và đồng thời <strong>ngưng hoạt động toàn bộ @selectedCategory.ProductCount món bánh thuộc nhóm</strong> để tránh bán nhầm.</span>
                        </div>
                        <div class="flex items-start gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mt-1.5 shrink-0"></span>
                            <span><strong>Mở bán lại dễ dàng:</strong> Khi bạn bấm "Hiện lại", toàn bộ các món bánh thuộc loại này sẽ tự động được kích hoạt mở bán lại.</span>
                        </div>
                    </div>

                    @if (selectedCategory.IsActive)
                    {
                        <p class="text-xs text-slate-600 dark:text-slate-400 mb-0">
                            Bạn có đồng ý <strong>chuyển sang trạng thái Ẩn và ngưng hoạt động toàn bộ @selectedCategory.ProductCount món bánh</strong> không?
                        </p>
                    }
                    else
                    {
                        <div class="bakery-info-box bakery-info-box-neutral text-xs flex items-center gap-2">
                            <iconify-icon icon="solar:info-circle-linear" class="text-base text-slate-400 shrink-0"></iconify-icon>
                            <span>Loại sản phẩm này hiện <strong>đang ở trạng thái Ẩn</strong>. Bấm "Hiện lại" ở danh sách khi cần kích hoạt mở bán lại.</span>
                        </div>
                    }
                }
            </div>

            <!-- Footer Modal -->
            <div class="bakery-modal-footer">
                <button type="button" class="bakery-btn bakery-btn-outline" @onclick="() => isConfirmModalOpen = false" disabled="@isSubmitting">
                    @(selectedCategory.ProductCount > 0 && !selectedCategory.IsActive ? "Đóng" : "Hủy bỏ")
                </button>

                @if (selectedCategory.ProductCount == 0)
                {
                    <button type="button" class="bakery-btn bakery-btn-danger" @onclick="ExecuteDeleteOrArchiveAsync" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin mr-1.5"></span>
                            <span>Đang xóa...</span>
                        }
                        else
                        {
                            <iconify-icon icon="solar:trash-bin-trash-bold" class="text-base"></iconify-icon>
                            <span>Xóa vĩnh viễn</span>
                        }
                    </button>
                }
                else if (selectedCategory.IsActive)
                {
                    <button type="button" class="bakery-btn bakery-btn-primary" style="background-color: #d97706; border-color: #d97706;" @onclick="ExecuteDeleteOrArchiveAsync" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin mr-1.5"></span>
                            <span>Đang xử lý...</span>
                        }
                        else
                        {
                            <iconify-icon icon="solar:eye-closed-bold" class="text-base"></iconify-icon>
                            <span>Đồng ý chuyển sang ẨN</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isSubmitting = false;

    // Data lists & filters
    private List<CategoryDto> categories = new();
    private string searchTerm = string.Empty;
    private string statusFilter = "all"; // "all" | "active" | "inactive"

    // Alert feedback
    private string? alertMessage = null;
    private bool alertIsSuccess = true;

    // Modals state
    private bool isCreateModalOpen = false;
    private string newCategoryName = string.Empty;
    private string? createModalError = null;

    private bool isEditModalOpen = false;
    private CategoryDto? selectedCategory = null;
    private string editingCategoryName = string.Empty;
    private string? editModalError = null;

    private bool isConfirmModalOpen = false;

    private IEnumerable<CategoryDto> FilteredCategories
    {
        get
        {
            var list = categories.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim().ToLower();
                list = list.Where(c => c.CategoryName.ToLower().Contains(term));
            }

            if (statusFilter == "active")
            {
                list = list.Where(c => c.IsActive);
            }
            else if (statusFilter == "inactive")
            {
                list = list.Where(c => !c.IsActive);
            }

            return list;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        isLoading = true;
        try
        {
            // Lấy toàn bộ danh sách loại sản phẩm (cả active lẫn inactive để admin quản lý)
            categories = await ProductService.GetCategoriesAsync();
        }
        catch (Exception ex)
        {
            ShowAlert("Không thể tải danh sách loại sản phẩm: " + ex.Message, false);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAlert(string message, bool isSuccess)
    {
        alertMessage = message;
        alertIsSuccess = isSuccess;
    }

    // ================= CREATE CATEGORY =================
    private void OpenCreateModal()
    {
        newCategoryName = string.Empty;
        createModalError = null;
        isCreateModalOpen = true;
    }

    private async Task SaveCreateCategoryAsync()
    {
        if (string.IsNullOrWhiteSpace(newCategoryName))
        {
            createModalError = "Vui lòng nhập tên loại sản phẩm.";
            return;
        }

        isSubmitting = true;
        createModalError = null;

        try
        {
            var created = await ProductService.CreateCategoryAsync(newCategoryName.Trim());
            isCreateModalOpen = false;
            newCategoryName = string.Empty;
            ShowAlert($"Đã thêm loại sản phẩm mới '{created.CategoryName}' thành công!", true);
            await LoadCategoriesAsync();
        }
        catch (Exception ex)
        {
            createModalError = "Lỗi khi tạo loại sản phẩm: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    // ================= EDIT CATEGORY =================
    private void OpenEditModal(CategoryDto cat)
    {
        selectedCategory = cat;
        editingCategoryName = cat.CategoryName;
        editModalError = null;
        isEditModalOpen = true;
    }

    private async Task SaveEditCategoryAsync()
    {
        if (selectedCategory == null) return;

        if (string.IsNullOrWhiteSpace(editingCategoryName))
        {
            editModalError = "Tên loại sản phẩm không được để trống.";
            return;
        }

        isSubmitting = true;
        editModalError = null;

        try
        {
            var result = await ProductService.UpdateCategoryAsync(selectedCategory.CategoryID, editingCategoryName.Trim());
            if (result.Success)
            {
                isEditModalOpen = false;
                ShowAlert(result.Message, true);
                await LoadCategoriesAsync();
            }
            else
            {
                editModalError = result.Message;
            }
        }
        catch (Exception ex)
        {
            editModalError = "Lỗi cập nhật: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    // ================= TOGGLE ACTIVE STATUS =================
    private async Task ToggleCategoryStatusAsync(CategoryDto cat)
    {
        try
        {
            var result = await ProductService.ToggleCategoryStatusAsync(cat.CategoryID);
            if (result.Success)
            {
                ShowAlert(result.Message, true);
                await LoadCategoriesAsync();
            }
            else
            {
                ShowAlert(result.Message, false);
            }
        }
        catch (Exception ex)
        {
            ShowAlert("Lỗi khi thay đổi trạng thái: " + ex.Message, false);
        }
    }

    // ================= DELETE OR ARCHIVE (RULE ENFORCEMENT) =================
    private void OpenConfirmDialog(CategoryDto cat)
    {
        selectedCategory = cat;
        isConfirmModalOpen = true;
    }

    private async Task ExecuteDeleteOrArchiveAsync()
    {
        if (selectedCategory == null) return;

        isSubmitting = true;

        try
        {
            var result = await ProductService.DeleteOrArchiveCategoryAsync(selectedCategory.CategoryID);
            isConfirmModalOpen = false;
            ShowAlert(result.Message, result.Success);
            await LoadCategoriesAsync();
        }
        catch (Exception ex)
        {
            ShowAlert("Lỗi khi xử lý loại sản phẩm: " + ex.Message, false);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
