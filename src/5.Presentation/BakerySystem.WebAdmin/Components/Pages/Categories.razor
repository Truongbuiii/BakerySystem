@page "/categories"
@rendermode InteractiveServer
@inject IProductService ProductService
@inject NavigationManager Navigation

<PageTitle>Loại Sản Phẩm | BakeryAdmin</PageTitle>

<div>
    <!-- Breadcrumb & Header -->
    <div class="bakery-page-header">
        <div style="max-width: 650px;">
            <div class="flex items-center gap-2 text-xs font-medium text-slate-500 mb-1">
                <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
                    <iconify-icon icon="solar:home-2-linear" class="text-sm"></iconify-icon>
                    Tổng quan
                </a>
                <span>/</span>
                <span class="text-slate-800 dark:text-slate-200 font-semibold">Loại sản phẩm</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold text-dark dark:text-white mb-1">Quản Lý Loại Sản Phẩm Bánh</h2>
            <p class="text-xs sm:text-sm text-bodytext mb-0">Quản lý các nhóm bánh, số lượng món thuộc từng loại sản phẩm và phân loại thực đơn.</p>
        </div>

        <div class="bakery-page-actions">
            <a href="/products" class="bakery-btn bakery-btn-outline bakery-btn-sm">
                <iconify-icon icon="solar:bag-5-linear" class="text-base"></iconify-icon>
                <span>Xem tất cả món bánh</span>
            </a>
            <button class="bakery-btn bakery-btn-primary bakery-btn-sm shadow-sm" @onclick="() => isCreateModalOpen = true">
                <iconify-icon icon="solar:add-circle-linear" class="text-base"></iconify-icon>
                <span>+ Thêm loại sản phẩm mới</span>
            </button>
        </div>
    </div>

    <!-- Category Grid Cards -->
    @if (isLoading)
    {
        <div class="p-12 flex flex-col items-center justify-center gap-3">
            <div class="w-8 h-8 border-4 border-primary border-t-transparent rounded-full animate-spin"></div>
            <p class="text-sm text-bodytext mb-0">Đang tải dữ liệu từ cơ sở dữ liệu...</p>
        </div>
    }
    else
    {
        <div class="bakery-category-grid">
            @foreach (var cat in categories)
            {
                <div class="bakery-category-card">
                    <div>
                        <div class="flex items-start justify-between mb-3">
                            <div class="w-11 h-11 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 flex items-center justify-center border border-blue-100 dark:border-blue-900/50">
                                <iconify-icon icon="solar:folder-with-files-bold" class="text-xl"></iconify-icon>
                            </div>
                            <span class="bakery-badge bakery-badge-primary text-xs font-semibold">
                                @cat.ProductCount món
                            </span>
                        </div>

                        <h4 class="text-base font-bold text-slate-900 dark:text-white mb-1">@cat.CategoryName</h4>
                        <span class="text-xs font-mono text-slate-500">Mã phân loại: #CAT-@cat.CategoryID.ToString("D2")</span>
                    </div>

                    <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <a href="/products?categoryId=@cat.CategoryID" class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-700 flex items-center gap-1.5 transition-colors">
                            <span>Quản lý danh sách món</span>
                            <iconify-icon icon="solar:arrow-right-linear" class="text-sm"></iconify-icon>
                        </a>
                        <span class="text-[11px] font-medium text-emerald-600 flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                            Hoạt động
                        </span>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal Thêm Loại Sản Phẩm -->
@if (isCreateModalOpen)
{
    <div class="bakery-modal-backdrop" @onclick="() => isCreateModalOpen = false">
        <div class="bakery-modal-card max-w-md" @onclick:stopPropagation="true">
            <div class="bakery-modal-header">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center">
                        <iconify-icon icon="solar:folder-with-files-linear" class="text-base"></iconify-icon>
                    </div>
                    <div>
                        <h4 class="text-base font-bold text-dark dark:text-white mb-0">Thêm Loại Sản Phẩm Mới</h4>
                        <p class="text-xs text-slate-500 mb-0">Khai báo nhóm loại sản phẩm bánh mới.</p>
                    </div>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 text-lg" @onclick="() => isCreateModalOpen = false">
                    <iconify-icon icon="solar:close-circle-linear"></iconify-icon>
                </button>
            </div>

            <div class="bakery-modal-body space-y-4">
                @if (!string.IsNullOrEmpty(modalError))
                {
                    <div class="p-3 rounded-lg bg-rose-50 text-rose-600 text-xs font-medium">@modalError</div>
                }

                <div>
                    <label class="bakery-label">Tên loại sản phẩm <span class="text-rose-500">*</span></label>
                    <input type="text" class="bakery-input" placeholder="Ví dụ: Bánh Mì Việt Nam, Kem Tươi, Bánh Kem..." @bind="newCategoryName" />
                </div>
            </div>

            <div class="bakery-modal-footer">
                <button type="button" class="bakery-btn bakery-btn-outline" @onclick="() => isCreateModalOpen = false">Hủy bỏ</button>
                <button type="button" class="bakery-btn bakery-btn-primary" @onclick="SaveCategoryAsync">Tạo loại sản phẩm</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isCreateModalOpen = false;
    private string newCategoryName = string.Empty;
    private string? modalError = null;
    private List<CategoryDto> categories = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        isLoading = true;
        try
        {
            categories = await ProductService.GetCategoriesAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveCategoryAsync()
    {
        if (string.IsNullOrWhiteSpace(newCategoryName))
        {
            modalError = "Vui lòng nhập tên loại sản phẩm.";
            return;
        }

        try
        {
            await ProductService.CreateCategoryAsync(newCategoryName);
            newCategoryName = string.Empty;
            isCreateModalOpen = false;
            await LoadCategoriesAsync();
        }
        catch (Exception ex)
        {
            modalError = "Lỗi khi lưu loại sản phẩm: " + ex.Message;
        }
    }
}
