@page "/orders"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Employee,Shipper")]
@implements IDisposable
@inject BakerySystem.Application.Features.Orders.OrderService OrderService
@inject BakerySystem.Application.Features.Orders.OrderNotificationService NotifService
@inject BakerySystem.Application.Common.Interfaces.IBakeryDbContext DbContext
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@(isShipper ? "Giao Hàng (Nhân Viên BakerySystem)" : "Quản Lý Đơn Đặt Hàng") | BakerySystem</PageTitle>

<div class="w-full bg-slate-50 min-h-screen pb-20 space-y-4 @(isShipper ? "shipper-orders-page max-w-5xl mx-auto px-2 sm:px-4" : "")">
    <!-- 1. Header Trang -->
    <div class="bakery-page-header pb-2 border-b border-border dark:border-darkborder flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <div class="flex items-center gap-2 text-xs text-slate-500 mb-0.5">
                <a href="/" class="hover:text-primary flex items-center gap-1">
                    <iconify-icon icon="solar:home-2-linear"></iconify-icon> Trang chủ
                </a>
                <span>/</span>
                <span class="text-slate-800 dark:text-slate-200 font-semibold">@(isShipper ? "Giao hàng nội bộ tiệm" : "Đơn đặt hàng")</span>
            </div>
            <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2 mb-0">
                <iconify-icon icon="@(isShipper ? "solar:delivery-bold" : "solar:bill-list-bold")" class="text-primary"></iconify-icon>
                @(isShipper ? "Giao Hàng Bánh Tươi - Nhân Viên Tiệm Bánh" : "Quản Lý Đơn Đặt Hàng & Giao Hàng")
            </h2>
            @if (isShipper)
            {
                <p class="text-xs text-slate-500 mb-0 mt-0.5">Đội ngũ nhân viên giao hàng nội bộ của tiệm BakerySystem - Nhận bánh trực tiếp từ tiệm và giao tận tay khách hàng</p>
            }
        </div>

        <div class="flex items-center gap-2">
            <button class="bakery-btn bakery-btn-secondary @(isShipper ? "shipper-refresh-button" : "bakery-btn-sm")" @onclick="LoadOrdersAsync">
                <iconify-icon icon="solar:restart-linear" class="text-base"></iconify-icon>
                <span>Tải lại</span>
            </button>
            @if (!isShipper)
            {
                <button class="bakery-btn bakery-btn-outline bakery-btn-sm" @onclick="ExportOrdersToExcel">
                    <iconify-icon icon="solar:file-download-linear" class="text-base text-emerald-600"></iconify-icon>
                    <span>Xuất Excel</span>
                </button>
                <button class="bakery-btn bakery-btn-secondary bakery-btn-sm" @onclick="PrintOrdersToPdf">
                    <iconify-icon icon="solar:printer-linear" class="text-base"></iconify-icon>
                    <span>In / Xuất PDF</span>
                </button>
                <a href="pos" class="bakery-btn bakery-btn-primary bakery-btn-sm shadow-sm inline-flex items-center gap-1.5">
                    <iconify-icon icon="solar:cart-large-minimalistic-bold" class="text-base"></iconify-icon>
                    <span>Tạo đơn tại quầy (POS)</span>
                </a>
            }
        </div>
    </div>

    <!-- 2. PHÂN BIỆT RÕ RỆT GIAO DIỆN SHIPPER (FOCUS MODE & FIFO) VS ADMIN/QUẦY -->
    @if (isShipper)
    {
        <!-- ========================================================
             GIAO DIỆN CHUYÊN DỤNG CHO SHIPPER (FOCUS CONSOLE & FIFO)
             Tập trung 1 đơn duy nhất, ưu tiên đơn đặt trước giao trước,
             loại bỏ 100% đơn bán lẻ tại quầy POS.
             ======================================================== -->
        
        <!-- 1. Bộ Tab Chuyển đổi chính -->
        <div class="shipper-console-tabs">
            <button type="button" 
                    class="shipper-console-tab-btn @(shipperActiveTab == "Workspace" ? "active" : "")"
                    @onclick='() => shipperActiveTab = "Workspace"'>
                <iconify-icon icon="solar:delivery-bold" class="text-lg"></iconify-icon>
                <span>Tác Nghiệp Giao Hàng</span>
                @if (deliveringOrder != null)
                {
                    <span class="shipper-console-pill shipper-console-pill-purple">
                        <span class="shipper-pulse-dot shipper-pulse-purple mr-1"></span> Đang đi giao
                    </span>
                }
                else if (nextPriorityOrder != null)
                {
                    <span class="shipper-console-pill shipper-console-pill-active">
                        <span class="shipper-pulse-dot shipper-pulse-blue mr-1"></span> Có đơn cần giao
                    </span>
                }
                else
                {
                    <span class="shipper-console-pill" style="background: #e2e8f0; color: #475569;">
                        Sẵn sàng
                    </span>
                }
            </button>

            <button type="button" 
                    class="shipper-console-tab-btn @(shipperActiveTab == "History" ? "active" : "")"
                    @onclick='() => shipperActiveTab = "History"'>
                <iconify-icon icon="solar:history-bold" class="text-lg"></iconify-icon>
                <span>Lịch Sử & Bàn Giao Tiền COD</span>
                <span class="shipper-console-pill" style="background: #e2e8f0; color: #475569;">
                    @completedOrders.Count đơn
                </span>
            </button>
        </div>

        @if (shipperActiveTab == "Workspace")
        {
            <!-- ========================================================
                 TAB 1: TÁC NGHIỆP GIAO HÀNG (ACTIVE WORKSPACE - FIFO)
                 ======================================================== -->
            
            <!-- Banner Trạng thái -->
            @if (deliveringOrder != null)
            {
                <div class="shipper-status-banner shipper-status-delivering">
                    <div class="flex items-center gap-3">
                        <span class="shipper-pulse-dot shipper-pulse-purple"></span>
                        <div>
                            <strong class="font-bold">Hành trình giao hàng đang diễn ra:</strong>
                            <span class="text-xs ml-1">Bạn đang vận chuyển đơn #HD-@deliveringOrder.OrderID.ToString("D4"). Hãy giao tới nơi an toàn!</span>
                        </div>
                    </div>
                    <div class="text-xs font-mono font-bold bg-white/60 dark:bg-slate-800/60 px-2.5 py-1 rounded-lg">
                        #HD-@deliveringOrder.OrderID.ToString("D4")
                    </div>
                </div>
            }
            else if (nextPriorityOrder != null)
            {
                <div class="shipper-status-banner shipper-status-ready">
                    <div class="flex items-center gap-3">
                        <span class="shipper-pulse-dot shipper-pulse-blue"></span>
                        <div>
                            <strong class="font-bold">Hệ thống điều phối theo thứ tự đặt (FIFO):</strong>
                            <span class="text-xs ml-1">Đơn đặt sớm nhất được ưu tiên giao trước để bánh tươi ngon và đúng hẹn.</span>
                        </div>
                    </div>
                    <div class="text-xs font-semibold bg-white/60 dark:bg-slate-800/60 px-2.5 py-1 rounded-lg">
                        @pendingDeliveryOrders.Count đơn chờ giao
                    </div>
                </div>
            }
            else
            {
                <div class="shipper-status-banner shipper-status-idle">
                    <div class="flex items-center gap-3">
                        <span class="shipper-pulse-dot shipper-pulse-green"></span>
                        <div>
                            <strong class="font-bold">Bạn đang sẵn sàng:</strong>
                            <span class="text-xs ml-1">Hiện không có đơn giao hàng online nào cần nhận. Chờ quầy duyệt đơn mới!</span>
                        </div>
                    </div>
                    <button type="button" class="text-xs font-bold underline hover:opacity-80" @onclick="LoadOrdersAsync">
                        Làm mới
                    </button>
                </div>
            }

            <!-- KỊCH BẢN A: ĐANG ĐI GIAO 1 ĐƠN (FOCUS HERO CARD) -->
            @if (deliveringOrder != null)
            {
                var order = deliveringOrder;
                var receiverName = order.ReceiverName ?? order.Customer?.FullName ?? "Khách nhận bánh";
                var receiverPhone = !string.IsNullOrWhiteSpace(order.ReceiverPhone)
                    ? order.ReceiverPhone
                    : (order.Customer != null && order.Customer.FullName != "Khách vãng lai" ? order.Customer.Phone : null);
                var isPaid = order.PaymentStatus == PaymentStatus.Paid;
                var totalQty = order.OrderDetails?.Sum(d => d.Quantity) ?? 0;

                <div class="shipper-hero-delivering">
                    <!-- Eyebrow -->
                    <div class="shipper-hero-eyebrow">
                        <div class="flex items-center gap-2">
                            <span class="shipper-hero-badge shipper-hero-badge-delivering">
                                <span class="shipper-pulse-dot shipper-pulse-purple"></span>
                                <span>Đang Đi Giao Bánh</span>
                            </span>
                            <span class="font-mono font-bold text-slate-800 dark:text-white text-base">#HD-@order.OrderID.ToString("D4")</span>
                        </div>
                        <div class="text-xs text-slate-500 flex items-center gap-1 font-medium">
                            <iconify-icon icon="solar:calendar-linear"></iconify-icon>
                            <span>Đặt lúc @order.OrderDate.ToString("HH:mm - dd/MM/yyyy")</span>
                        </div>
                    </div>

                    <!-- Khối Khách hàng & Gọi điện 1 chạm -->
                    <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 mb-4">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3 pb-3 border-b border-slate-200 dark:border-slate-700">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 rounded-xl bg-purple-100 dark:bg-purple-950 text-purple-700 dark:text-purple-300 flex items-center justify-center text-xl shrink-0">
                                    <iconify-icon icon="solar:user-bold"></iconify-icon>
                                </div>
                                <div>
                                    <div class="text-base font-bold text-slate-900 dark:text-white">@receiverName</div>
                                    <div class="text-xs text-slate-500">Khách hàng nhận bánh</div>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(receiverPhone))
                            {
                                <div class="flex items-center gap-2">
                                    <a href="tel:@receiverPhone" class="shipper-btn-call-large" title="Bấm để gọi khách ngay">
                                        <iconify-icon icon="solar:phone-calling-bold" class="text-lg"></iconify-icon>
                                        <span>Gọi khách: @receiverPhone</span>
                                    </a>
                                    <button type="button" @onclick="() => CopyPhone(receiverPhone)" class="shipper-btn-copy p-2.5" title="Sao chép số điện thoại">
                                        <iconify-icon icon="solar:copy-linear" class="text-base"></iconify-icon>
                                    </button>
                                </div>
                            }
                        </div>

                        <!-- Địa chỉ giao & Nút Google Maps lớn -->
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                            <div class="flex items-start gap-2.5 flex-1 min-w-0">
                                <iconify-icon icon="solar:map-point-wave-bold" class="text-rose-500 text-xl shrink-0 mt-0.5"></iconify-icon>
                                <div>
                                    <div class="text-xs text-slate-400 font-semibold uppercase">Địa chỉ giao bánh tận nơi:</div>
                                    <div class="text-sm font-bold text-slate-800 dark:text-slate-100 leading-snug mt-0.5">
                                        @order.ShippingAddress
                                    </div>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(order.ShippingAddress))
                            {
                                <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(order.ShippingAddress)" 
                                   target="_blank" 
                                   class="shipper-btn-map-large shrink-0" 
                                   title="Mở Google Maps dẫn đường">
                                    <iconify-icon icon="solar:routing-2-bold" class="text-lg"></iconify-icon>
                                    <span>Chỉ Đường Maps</span>
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Ghi chú nếu có -->
                    @if (!string.IsNullOrWhiteSpace(order.Note))
                    {
                        <div class="mb-4 p-3 rounded-xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/50 flex items-start gap-2.5 text-xs text-amber-900 dark:text-amber-200">
                            <iconify-icon icon="solar:notes-bold" class="text-amber-600 text-base shrink-0 mt-0.5"></iconify-icon>
                            <div>
                                <strong class="font-bold uppercase text-[11px] tracking-wide">Dặn dò của khách:</strong>
                                <p class="mt-0.5 mb-0 font-medium">@order.Note</p>
                            </div>
                        </div>
                    }

                    <!-- Món bánh cần giao -->
                    <div class="mb-4">
                        <div class="flex items-center justify-between text-xs font-bold text-slate-600 dark:text-slate-300 mb-2">
                            <span class="flex items-center gap-1.5">
                                <iconify-icon icon="solar:bag-5-bold" class="text-primary text-base"></iconify-icon>
                                <span>Danh sách món bánh cần bàn giao (@totalQty món):</span>
                            </span>
                        </div>
                        <div class="space-y-1.5 max-h-48 overflow-y-auto">
                            @if (order.OrderDetails != null && order.OrderDetails.Any())
                            {
                                @foreach (var detail in order.OrderDetails)
                                {
                                    <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-700/60 text-xs">
                                        <div class="min-w-0 pr-2">
                                            <div class="font-bold text-slate-900 dark:text-slate-100 truncate">@detail.Product?.ProductName</div>
                                            <div class="text-[11px] text-slate-400">@(detail.Product?.Category?.CategoryName ?? "-") &bull; @($"{detail.UnitPrice:N0} đ")</div>
                                        </div>
                                        <div class="shrink-0">
                                            <span class="px-2.5 py-1 rounded-lg bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 font-bold font-mono border border-blue-200 dark:border-blue-900">
                                                x @detail.Quantity
                                            </span>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <!-- Tiền cần thu -->
                    <div class="mb-4">
                        @if (isPaid)
                        {
                            <div class="shipper-payment-box shipper-payment-paid">
                                <div>
                                    <div class="text-xs font-bold flex items-center gap-1.5 text-emerald-800 dark:text-emerald-300">
                                        <iconify-icon icon="solar:check-circle-bold" class="text-base text-emerald-600"></iconify-icon>
                                        <span>ĐÃ THANH TOÁN ONLINE (@order.PaymentMethod)</span>
                                    </div>
                                    <div class="text-[11px] text-emerald-700 dark:text-emerald-400 mt-0.5 font-medium">
                                        Khách đã thanh toán trước. Không thu thêm tiền khi giao bánh!
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="text-base font-black font-mono text-emerald-800 dark:text-emerald-300">
                                        @($"{order.FinalAmount:N0} đ")
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="shipper-payment-box shipper-payment-cod">
                                <div>
                                    <div class="text-xs font-black flex items-center gap-1.5 text-amber-900 dark:text-amber-200">
                                        <iconify-icon icon="solar:wallet-money-bold" class="text-lg text-amber-600"></iconify-icon>
                                        <span>CẦN THU TIỀN MẶT KHI GIAO (COD):</span>
                                    </div>
                                    <div class="text-[11px] text-amber-800 dark:text-amber-300 mt-0.5 font-semibold">
                                        Thu đúng số tiền mặt này khi giao bánh tận tay khách
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="text-xl font-black font-mono text-rose-600 dark:text-rose-400">
                                        @($"{order.FinalAmount:N0} đ")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Nút hành động chính -->
                    <div class="space-y-2 pt-2 border-t border-slate-200 dark:border-slate-700">
                        <button type="button" 
                                class="shipper-btn-action-primary shipper-btn-deliver text-base py-3.5 shadow-lg"
                                @onclick='() => ChangeOrderStatus(order, OrderStatus.Delivered)'
                                title="Bấm khi đã giao bánh tận tay khách">
                            <iconify-icon icon="solar:box-minimalistic-bold" class="text-xl"></iconify-icon>
                            <span>BÁO ĐÃ GIAO BÁNH TỚI NƠI CHO KHÁCH</span>
                        </button>
                        
                        <button type="button" 
                                class="bakery-btn bakery-btn-outline text-xs w-full justify-center py-2"
                                @onclick="() => OpenDetailModal(order)">
                            <iconify-icon icon="solar:bill-check-linear" class="text-sm text-primary"></iconify-icon>
                            <span>Xem chi tiết hóa đơn (bill)</span>
                        </button>
                    </div>

                    <!-- Khóa nhận thêm đơn -->
                    <div class="mt-4 p-3 rounded-xl bg-purple-50 dark:bg-purple-950/20 border border-purple-200 dark:border-purple-900/40 text-xs text-purple-800 dark:text-purple-300 flex items-center gap-2">
                        <iconify-icon icon="solar:shield-warning-bold" class="text-base text-purple-600 shrink-0"></iconify-icon>
                        <span>Bạn đang thực hiện chuyến giao này. Sau khi báo đã giao xong, hệ thống sẽ tự động mở đơn tiếp theo để bạn nhận!</span>
                    </div>
                </div>
            }
            else if (nextPriorityOrder != null)
            {
                <!-- KỊCH BẢN B: KHÔNG CÓ ĐƠN ĐANG GIAO & CÓ ĐƠN CẦN GIAO GẤP THEO FIFO -->
                var order = nextPriorityOrder;
                var receiverName = order.ReceiverName ?? order.Customer?.FullName ?? "Khách nhận bánh";
                var receiverPhone = !string.IsNullOrWhiteSpace(order.ReceiverPhone)
                    ? order.ReceiverPhone
                    : (order.Customer != null && order.Customer.FullName != "Khách vãng lai" ? order.Customer.Phone : null);
                var isPaid = order.PaymentStatus == PaymentStatus.Paid;
                var totalQty = order.OrderDetails?.Sum(d => d.Quantity) ?? 0;
                var waitMinutes = (int)Math.Max(1, (DateTime.Now - order.OrderDate).TotalMinutes);

                <div class="shipper-hero-next">
                    <!-- Eyebrow -->
                    <div class="shipper-hero-eyebrow">
                        <div class="flex items-center gap-2">
                            <span class="shipper-hero-badge shipper-hero-badge-priority">
                                <span class="shipper-pulse-dot shipper-pulse-blue"></span>
                                <span>Đơn Cần Giao Ngay Bây Giờ (Ưu Tiên #1)</span>
                            </span>
                            <span class="font-mono font-bold text-slate-800 dark:text-white text-base">#HD-@order.OrderID.ToString("D4")</span>
                        </div>
                        <div class="shipper-wait-timer" title="Đơn đặt trước cần giao trước theo nguyên tắc FIFO">
                            <iconify-icon icon="solar:clock-circle-bold"></iconify-icon>
                            <span>Khách đã chờ @waitMinutes phút</span>
                        </div>
                    </div>

                    <!-- Thông tin khách & Địa chỉ -->
                    <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 mb-4">
                        <div class="flex items-center justify-between mb-3 pb-3 border-b border-slate-200 dark:border-slate-700">
                            <div class="flex items-center gap-3">
                                <div class="w-11 h-11 rounded-xl bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300 flex items-center justify-center text-lg shrink-0">
                                    <iconify-icon icon="solar:user-bold"></iconify-icon>
                                </div>
                                <div>
                                    <div class="text-sm font-bold text-slate-900 dark:text-white">@receiverName</div>
                                    <div class="text-xs text-slate-500">
                                        @(string.IsNullOrWhiteSpace(receiverPhone) ? "Chưa có SĐT" : receiverPhone)
                                    </div>
                                </div>
                            </div>

                            <span class="text-xs text-slate-500">
                                Đặt lúc: <strong>@order.OrderDate.ToString("HH:mm")</strong>
                            </span>
                        </div>

                        <!-- Địa chỉ giao -->
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex items-start gap-2.5 flex-1 min-w-0">
                                <iconify-icon icon="solar:map-point-wave-bold" class="text-rose-500 text-lg shrink-0 mt-0.5"></iconify-icon>
                                <div>
                                    <div class="text-[11px] text-slate-400 font-semibold uppercase">Địa chỉ giao bánh:</div>
                                    <div class="text-sm font-bold text-slate-800 dark:text-slate-100 leading-snug mt-0.5">
                                        @order.ShippingAddress
                                    </div>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(order.ShippingAddress))
                            {
                                <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(order.ShippingAddress)" 
                                   target="_blank" 
                                   class="bakery-btn bakery-btn-outline bakery-btn-sm shrink-0" 
                                   title="Xem vị trí trên bản đồ">
                                    <iconify-icon icon="solar:routing-2-bold" class="text-primary"></iconify-icon>
                                    <span>Xem đường đi</span>
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Món bánh & Tiền thu -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700 text-xs">
                            <div class="text-slate-400 font-semibold mb-1">Chi tiết bánh:</div>
                            <div class="font-bold text-slate-800 dark:text-slate-200">
                                @totalQty món bánh
                                @if (order.OrderDetails != null && order.OrderDetails.Any())
                                {
                                    <span class="text-slate-500 font-normal">(@string.Join(", ", order.OrderDetails.Take(2).Select(d => $"{d.Product?.ProductName} x{d.Quantity}"))@(order.OrderDetails.Count > 2 ? "..." : ""))</span>
                                }
                            </div>
                        </div>

                        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700 text-xs flex items-center justify-between">
                            <div>
                                <div class="text-slate-400 font-semibold">Hình thức thanh toán:</div>
                                <div class="font-bold @(isPaid ? "text-emerald-600" : "text-amber-600")">
                                    @(isPaid ? "Đã trả online (Không thu tiền)" : "Thu tiền mặt COD")
                                </div>
                            </div>
                            <div class="text-right font-black font-mono text-sm text-slate-900 dark:text-white">
                                @($"{order.FinalAmount:N0} đ")
                            </div>
                        </div>
                    </div>

                    <!-- Nút to NHẬN GIAO ĐƠN NÀY NGAY -->
                    <button type="button" 
                            class="shipper-btn-action-primary shipper-btn-accept text-base py-3.5 shadow-lg"
                            @onclick='() => ChangeOrderStatus(order, OrderStatus.Shipping)'
                            title="Bấm để nhận đơn hàng ưu tiên này đi giao">
                        <iconify-icon icon="solar:delivery-bold" class="text-xl"></iconify-icon>
                        <span>NHẬN GIAO ĐƠN NÀY NGAY BÂY GIỜ</span>
                    </button>
                </div>

                <!-- HÀNG ĐỢI CÁC ĐƠN KẾ TIẾP (QUEUE) -->
                @if (queueOrders.Any())
                {
                    <div class="shipper-queue-section">
                        <div class="shipper-queue-header">
                            <div class="flex items-center gap-2">
                                <iconify-icon icon="solar:list-bold" class="text-primary text-base"></iconify-icon>
                                <h4 class="text-xs font-bold text-slate-800 dark:text-slate-100 uppercase tracking-wider mb-0">
                                    Hàng Đợi Giao Tiếp Theo (Còn @queueOrders.Count đơn đang chờ)
                                </h4>
                            </div>
                            <span class="text-[11px] text-slate-400">Tự động đẩy lên khi bạn hoàn thành đơn trên</span>
                        </div>

                        <div class="shipper-queue-list">
                            @{ int qIndex = 2; }
                            @foreach (var qOrder in queueOrders)
                            {
                                var qReceiver = qOrder.ReceiverName ?? qOrder.Customer?.FullName ?? "Khách nhận bánh";
                                var qQty = qOrder.OrderDetails?.Sum(d => d.Quantity) ?? 0;
                                var qWait = (int)Math.Max(1, (DateTime.Now - qOrder.OrderDate).TotalMinutes);

                                <div class="shipper-queue-item">
                                    <div class="flex items-center gap-3 min-w-0">
                                        <div class="shipper-queue-order-num">#@qIndex</div>
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-2">
                                                <span class="font-mono font-bold text-xs text-slate-800 dark:text-slate-200">#HD-@qOrder.OrderID.ToString("D4")</span>
                                                <span class="text-[11px] text-slate-400">&bull; Đặt lúc @qOrder.OrderDate.ToString("HH:mm") (Chờ @qWait p)</span>
                                            </div>
                                            <div class="text-xs text-slate-600 dark:text-slate-300 truncate mt-0.5">
                                                📍 @qOrder.ShippingAddress
                                            </div>
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-3 shrink-0">
                                        <div class="text-right hidden sm:block">
                                            <div class="text-xs font-mono font-bold text-slate-800 dark:text-white">@($"{qOrder.FinalAmount:N0} đ")</div>
                                            <div class="text-[10px] text-slate-400">@qQty món</div>
                                        </div>
                                        <span class="shipper-queue-tag-locked" title="Bạn cần nhận và giao đơn ưu tiên #1 trước">
                                            <iconify-icon icon="solar:lock-bold"></iconify-icon>
                                            <span>Chờ lượt sau</span>
                                        </span>
                                    </div>
                                </div>
                                qIndex++;
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- KỊCH BẢN C: HOÀN TOÀN KHÔNG CÓ ĐƠN CHỜ GIAO NÀO -->
                <div class="bakery-card p-12 text-center text-slate-400" style="padding: 3.5rem 1rem; text-align: center; margin-top: 1rem;">
                    <div class="w-20 h-20 mx-auto rounded-3xl bg-emerald-50 dark:bg-emerald-950/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-3 text-3xl">
                        <iconify-icon icon="solar:check-circle-bold"></iconify-icon>
                    </div>
                    <h4 class="text-base font-bold text-slate-800 dark:text-slate-100 mb-1">Hiện không có đơn giao hàng online nào cần nhận</h4>
                    <p class="text-xs text-slate-500 mb-4 max-w-md mx-auto">
                        Tất cả các đơn online đã được xử lý hoặc chưa có đơn mới. Bạn đang ở trạng thái sẵn sàng nhận việc.
                    </p>
                    <button type="button" class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick="LoadOrdersAsync">
                        <iconify-icon icon="solar:restart-linear"></iconify-icon>
                        <span>Kiểm tra đơn mới</span>
                    </button>
                </div>
            }

            <!-- KỊCH BẢN D: CÁC ĐƠN ĐANG CHỜ KHÁCH BẤM XÁC NHẬN TRÊN MOBILE APP -->
            @if (waitingConfirmOrders.Any())
            {
                <div class="mt-6 p-4 rounded-2xl bg-sky-50 dark:bg-sky-950/20 border border-sky-200 dark:border-sky-900/40">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2">
                            <iconify-icon icon="solar:clock-circle-bold" class="text-sky-600 text-base"></iconify-icon>
                            <h4 class="text-xs font-bold text-sky-900 dark:text-sky-200 uppercase tracking-wider mb-0">
                                Đơn Đã Giao Tới Nơi - Chờ Khách Xác Nhận (@waitingConfirmOrders.Count đơn)
                            </h4>
                        </div>
                        <span class="text-[11px] text-sky-600 dark:text-sky-400 font-medium">Khách sẽ bấm xác nhận trên Mobile App</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                        @foreach (var wOrder in waitingConfirmOrders)
                        {
                            var wReceiver = wOrder.ReceiverName ?? wOrder.Customer?.FullName ?? "Khách nhận bánh";
                            <div class="p-3 rounded-xl bg-white dark:bg-slate-800 border border-sky-100 dark:border-slate-700 flex items-center justify-between text-xs">
                                <div>
                                    <div class="font-bold text-slate-800 dark:text-white">#HD-@wOrder.OrderID.ToString("D4") - @wReceiver</div>
                                    <div class="text-[11px] text-slate-400 truncate max-w-xs mt-0.5">📍 @wOrder.ShippingAddress</div>
                                </div>
                                <div class="text-right shrink-0">
                                    <span class="bakery-badge" style="background: #e0f2fe; color: #0369a1; font-weight: 700; font-size: 10px;">
                                        Chờ khách bấm
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <!-- ========================================================
                 TAB 2: LỊCH SỬ GIAO HÀNG & ĐỐI SOÁT TIỀN COD
                 ======================================================== -->
            <!-- Thống kê nhanh trong ngày -->
            <div class="shipper-summary-grid">
                <div class="shipper-summary-card">
                    <div>
                        <div class="shipper-summary-label">Đơn Hoàn Tất Hôm Nay</div>
                        <div class="shipper-summary-val text-emerald-600">@totalCompletedToday <span class="text-xs font-normal text-slate-500">đơn</span></div>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-emerald-50 dark:bg-emerald-950 text-emerald-600 flex items-center justify-center text-2xl">
                        <iconify-icon icon="solar:check-circle-bold"></iconify-icon>
                    </div>
                </div>

                <div class="shipper-summary-card">
                    <div>
                        <div class="shipper-summary-label">Tiền Mặt COD Cần Bàn Giao Thu Ngân Tiệm Bánh</div>
                        <div class="shipper-summary-val text-rose-600">@($"{totalCodCollectedToday:N0} đ")</div>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-rose-50 dark:bg-rose-950 text-rose-600 flex items-center justify-center text-2xl">
                        <iconify-icon icon="solar:wallet-money-bold"></iconify-icon>
                    </div>
                </div>

                <div class="shipper-summary-card">
                    <div>
                        <div class="shipper-summary-label">Tổng Đơn Đã Giao Ca Này</div>
                        <div class="shipper-summary-val text-blue-600">@completedOrders.Count <span class="text-xs font-normal text-slate-500">đơn</span></div>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-950 text-blue-600 flex items-center justify-center text-2xl">
                        <iconify-icon icon="solar:box-minimalistic-bold"></iconify-icon>
                    </div>
                </div>
            </div>

            <!-- Danh sách đơn đã giao hoàn tất -->
            <div class="bakery-card p-4">
                <div class="flex items-center justify-between mb-4">
                    <h4 class="text-sm font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2 mb-0">
                        <iconify-icon icon="solar:history-bold" class="text-primary"></iconify-icon>
                        <span>Lịch Sử Các Đơn Giao Hàng Thành Công</span>
                    </h4>
                    <div class="bakery-search-input-wrap" style="min-width: 200px; max-width: 260px;">
                        <iconify-icon icon="solar:magnifer-linear"></iconify-icon>
                        <input type="text" class="bakery-search-input" placeholder="Tìm mã đơn, tên, SĐT..." @bind="searchQuery" @bind:event="oninput" />
                    </div>
                </div>

                @{
                    var historyList = completedOrders
                        .Where(o => string.IsNullOrWhiteSpace(searchQuery) ||
                                    o.OrderID.ToString().Contains(searchQuery) ||
                                    (o.ReceiverName != null && o.ReceiverName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                                    (o.ReceiverPhone != null && o.ReceiverPhone.Contains(searchQuery)) ||
                                    (o.ShippingAddress != null && o.ShippingAddress.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)))
                        .ToList();
                }

                @if (historyList.Count == 0)
                {
                    <div class="text-center py-10 text-slate-400 text-xs">
                        <iconify-icon icon="solar:inbox-line-linear" class="text-3xl text-slate-300 mb-1"></iconify-icon>
                        <p class="mb-0">Chưa có đơn hàng nào hoàn tất trong danh sách.</p>
                    </div>
                }
                else
                {
                    <div class="space-y-2.5">
                        @foreach (var hOrder in historyList)
                        {
                            var hName = hOrder.ReceiverName ?? hOrder.Customer?.FullName ?? "Khách nhận bánh";
                            var isCod = hOrder.PaymentMethod == PaymentMethod.COD;

                            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-700/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
                                <div class="space-y-1">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono font-bold text-slate-900 dark:text-white">#HD-@hOrder.OrderID.ToString("D4")</span>
                                        <span class="text-slate-400">&bull;</span>
                                        <span class="text-slate-500">@hOrder.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                                        <span class="bakery-badge bakery-badge-success text-[10px] py-0.5">✓ Hoàn tất</span>
                                    </div>
                                    <div class="font-semibold text-slate-800 dark:text-slate-200">
                                        @hName @(string.IsNullOrWhiteSpace(hOrder.ReceiverPhone) ? "" : $"({hOrder.ReceiverPhone})")
                                    </div>
                                    <div class="text-slate-500 truncate max-w-lg">
                                        📍 @hOrder.ShippingAddress
                                    </div>
                                </div>

                                <div class="flex items-center justify-between sm:justify-end gap-3 shrink-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-200 dark:border-slate-700">
                                    <div class="text-right">
                                        <div class="font-mono font-bold text-sm @(isCod ? "text-amber-600" : "text-emerald-600")">
                                            @($"{hOrder.FinalAmount:N0} đ")
                                        </div>
                                        <div class="text-[10px] text-slate-400">
                                            @(isCod ? "Tiền mặt COD" : "Đã trả Online")
                                        </div>
                                    </div>
                                    <button type="button" class="bakery-btn bakery-btn-outline bakery-btn-sm" @onclick="() => OpenDetailModal(hOrder)">
                                        Xem bill
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
    else
    {
        <!-- ========================================================
             GIAO DIỆN DÀNH CHO ADMIN & NHÂN VIÊN QUẦY
             Hiển thị đầy đủ KPI, bộ lọc 7 trạng thái, POS, In/Xuất Excel
             ======================================================== -->
        <!-- 2. Thẻ KPI Chuẩn Dashboard cho Admin & Quầy -->
        <div class="bakery-kpi-grid">
            <!-- KPI 1: Chờ duyệt -->
            <div class="bakery-kpi-card" @onclick='() => FilterByStatus(OrderStatus.Pending)' style="cursor: pointer;" title="Xem các đơn chờ duyệt">
                <div class="bakery-kpi-content">
                    <span class="bakery-kpi-label">Chờ duyệt đơn</span>
                    <div class="bakery-kpi-val text-amber-600">@orders.Count(o => o.Status == OrderStatus.Pending) đơn</div>
                    <div class="bakery-kpi-subtext">Cần xác nhận từ quầy</div>
                </div>
                <div class="bakery-kpi-iconbox bakery-kpi-amber">
                    <iconify-icon icon="solar:clock-circle-bold"></iconify-icon>
                </div>
            </div>

            <!-- KPI 2: Đã duyệt / Chờ giao -->
            <div class="bakery-kpi-card" @onclick='() => FilterByStatus(OrderStatus.Confirmed)' style="cursor: pointer;" title="Xem các đơn đã duyệt">
                <div class="bakery-kpi-content">
                    <span class="bakery-kpi-label">Đã duyệt / Sẵn sàng</span>
                    <div class="bakery-kpi-val text-blue-600">@orders.Count(o => o.Status == OrderStatus.Confirmed) đơn</div>
                    <div class="bakery-kpi-subtext">Chờ shipper nhận giao</div>
                </div>
                <div class="bakery-kpi-iconbox bakery-kpi-blue">
                    <iconify-icon icon="solar:box-minimalistic-bold"></iconify-icon>
                </div>
            </div>

            <!-- KPI 3: Đang giao -->
            <div class="bakery-kpi-card" @onclick='() => FilterByStatus(OrderStatus.Shipping)' style="cursor: pointer;" title="Xem các đơn đang giao">
                <div class="bakery-kpi-content">
                    <span class="bakery-kpi-label">Đang giao cho khách</span>
                    <div class="bakery-kpi-val text-purple-600">@orders.Count(o => o.Status == OrderStatus.Shipping) đơn</div>
                    <div class="bakery-kpi-subtext">Shipper đang vận chuyển</div>
                </div>
                <div class="bakery-kpi-iconbox bakery-kpi-purple">
                    <iconify-icon icon="solar:delivery-bold"></iconify-icon>
                </div>
            </div>

            <!-- KPI 4: Hoàn tất -->
            <div class="bakery-kpi-card" @onclick='() => FilterByStatus(OrderStatus.Completed)' style="cursor: pointer;" title="Xem các đơn hoàn tất">
                <div class="bakery-kpi-content">
                    <span class="bakery-kpi-label">Đã hoàn tất</span>
                    <div class="bakery-kpi-val text-emerald-600">@orders.Count(o => o.Status == OrderStatus.Completed) đơn</div>
                    <div class="bakery-kpi-subtext">Đã thu tiền & giao xong</div>
                </div>
                <div class="bakery-kpi-iconbox bakery-kpi-green">
                    <iconify-icon icon="solar:check-circle-bold"></iconify-icon>
                </div>
            </div>
        </div>

        <!-- 3. Thanh Lọc Trạng Thái & Tìm Kiếm cho Admin & Quầy -->
        <div class="bakery-card p-3">
            <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
                <div class="bakery-order-tab-bar">
                    <button type="button" 
                            class="bakery-order-tab @(selectedStatus == "All" ? "active" : "")"
                            @onclick='() => FilterByStatus("All")'>
                        <span>Tất cả</span>
                        <span class="bakery-order-tab-badge">@orders.Count</span>
                    </button>
                    <button type="button" 
                            class="bakery-order-tab @(selectedStatus == OrderStatus.Pending ? "active" : "")"
                            @onclick='() => FilterByStatus(OrderStatus.Pending)'>
                        <iconify-icon icon="solar:clock-circle-linear" class="text-amber-500"></iconify-icon>
                        <span>Chờ duyệt</span>
                        <span class="bakery-order-tab-badge">@orders.Count(o => o.Status == OrderStatus.Pending)</span>
                    </button>
                    <button type="button" 
                            class="bakery-order-tab @(selectedStatus == OrderStatus.Confirmed ? "active" : "")"
                            @onclick='() => FilterByStatus(OrderStatus.Confirmed)'>
                        <iconify-icon icon="solar:check-circle-linear" class="text-blue-500"></iconify-icon>
                        <span>Đã duyệt / Chờ shipper</span>
                        <span class="bakery-order-tab-badge">@orders.Count(o => o.Status == OrderStatus.Confirmed)</span>
                    </button>
                    <button type="button" 
                            class="bakery-order-tab @(selectedStatus == OrderStatus.Shipping ? "active" : "")"
                            @onclick='() => FilterByStatus(OrderStatus.Shipping)'>
                        <iconify-icon icon="solar:delivery-linear" class="text-purple-500"></iconify-icon>
                        <span>Đang giao</span>
                        <span class="bakery-order-tab-badge">@orders.Count(o => o.Status == OrderStatus.Shipping)</span>
                    </button>
                    <button type="button" 
                            class="bakery-order-tab @(selectedStatus == OrderStatus.Delivered ? "active" : "")"
                            @onclick='() => FilterByStatus(OrderStatus.Delivered)'>
                        <iconify-icon icon="solar:box-minimalistic-bold" class="text-sky-500"></iconify-icon>
                        <span>Chờ khách nhận</span>
                        <span class="bakery-order-tab-badge">@orders.Count(o => o.Status == OrderStatus.Delivered)</span>
                    </button>
                    <button type="button" 
                            class="bakery-order-tab @(selectedStatus == OrderStatus.Completed ? "active" : "")"
                            @onclick='() => FilterByStatus(OrderStatus.Completed)'>
                        <iconify-icon icon="solar:check-circle-linear" class="text-emerald-500"></iconify-icon>
                        <span>Hoàn tất</span>
                        <span class="bakery-order-tab-badge">@orders.Count(o => o.Status == OrderStatus.Completed)</span>
                    </button>
                    <button type="button" 
                            class="bakery-order-tab @(selectedStatus == OrderStatus.Cancelled ? "active" : "")"
                            @onclick='() => FilterByStatus(OrderStatus.Cancelled)'>
                        <iconify-icon icon="solar:close-circle-linear" class="text-red-500"></iconify-icon>
                        <span>Đã hủy</span>
                        <span class="bakery-order-tab-badge">@orders.Count(o => o.Status == OrderStatus.Cancelled)</span>
                    </button>
                </div>

                <!-- Ô tìm kiếm đơn hàng chuẩn Wrapper -->
                <div class="flex flex-wrap items-center gap-2">
                    <div class="bakery-search-input-wrap" style="min-width: 240px; max-width: 320px;">
                        <iconify-icon icon="solar:magnifer-linear"></iconify-icon>
                        <input type="text" 
                               class="bakery-search-input"
                               placeholder="Mã đơn, tên khách, SĐT..."
                               @bind="searchQuery" 
                               @bind:event="oninput" />
                    </div>
                    <select class="bakery-input" style="width: auto;" @bind="selectedPaymentStatus">
                        <option value="All">Tất cả thanh toán</option>
                        <option value="Paid">Đã thanh toán</option>
                        <option value="Unpaid">Chưa thanh toán</option>
                    </select>
                    <label class="text-xs text-slate-500 flex items-center gap-1">Từ <input class="bakery-input" style="width: 130px;" type="date" @bind="dateFrom" /></label>
                    <label class="text-xs text-slate-500 flex items-center gap-1">Đến <input class="bakery-input" style="width: 130px;" type="date" @bind="dateTo" /></label>
                    <button class="bakery-btn bakery-btn-outline bakery-btn-sm" @onclick="ResetAdvancedSearch">Đặt lại</button>
                </div>
            </div>
        </div>
        <!-- ========================================================
             BẢNG DỮ LIỆU ĐƠN HÀNG DÀNH CHO ADMIN & NHÂN VIÊN QUẦY
             Đã loại bỏ hoàn toàn chữ "Bắt đầu làm" / "Bếp làm bánh".
             Sản phẩm nhập sẵn chỉ cần duyệt -> đóng gói / xuất giao shipper.
             ======================================================== -->
        <div class="bakery-card overflow-hidden">
            <div class="bakery-table-responsive">
                <table id="orders-table" class="bakery-table">
                    <thead>
                        <tr>
                            <th style="width: 110px;">Mã Đơn</th>
                            <th style="width: 125px;">Thời Gian</th>
                            <th style="min-width: 220px;">Khách Hàng / Nhận Bánh</th>
                            <th class="text-center" style="width: 85px;">Số Món</th>
                            <th class="text-right" style="width: 135px;">Tổng Tiền</th>
                            <th class="text-center" style="width: 120px;">Thanh Toán</th>
                            <th class="text-center" style="width: 125px;">Trạng Thái</th>
                            <th class="text-right" style="width: 240px; min-width: 240px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (filteredOrders.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-12 text-slate-400">
                                    <iconify-icon icon="solar:box-minimalistic-linear" class="text-4xl text-slate-300 mb-2"></iconify-icon>
                                    <p class="text-xs font-semibold mb-0">Không có đơn hàng nào trong danh mục này</p>
                                    <p class="text-[11px] mb-0">Thử chọn tab trạng thái khác hoặc xóa tìm kiếm.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var order in filteredOrders)
                            {
                                <tr>
                                    <!-- Mã đơn -->
                                    <td>
                                        <span class="bakery-code-badge">#HD-@order.OrderID.ToString("D4")</span>
                                    </td>

                                    <!-- Thời gian -->
                                    <td class="text-xs text-slate-500">
                                        <div class="font-medium text-slate-700 dark:text-slate-300">@order.OrderDate.ToString("dd/MM/yyyy")</div>
                                        <div class="text-[11px] font-mono text-slate-400">@order.OrderDate.ToString("HH:mm")</div>
                                    </td>

                                    <!-- Khách hàng -->
                                    <td>
                                        <div class="font-semibold text-xs text-slate-900 dark:text-white mb-0.5">
                                            @(order.ReceiverName ?? order.Customer?.FullName ?? "Khách tại quầy")
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(order.ReceiverPhone))
                                        {
                                            <div class="text-[11px] text-slate-500 flex items-center gap-1 mb-0.5">
                                                <iconify-icon icon="solar:phone-linear" class="text-xs text-slate-400"></iconify-icon>
                                                <span class="font-mono">@order.ReceiverPhone</span>
                                            </div>
                                        }
                                        else if (order.Customer != null && order.Customer.FullName != "Khách vãng lai" && !string.IsNullOrWhiteSpace(order.Customer.Phone))
                                        {
                                            <div class="text-[11px] text-slate-500 flex items-center gap-1 mb-0.5">
                                                <iconify-icon icon="solar:phone-linear" class="text-xs text-slate-400"></iconify-icon>
                                                <span class="font-mono">@order.Customer.Phone</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-[11px] text-slate-400 dark:text-slate-500 flex items-center gap-1 mb-0.5">
                                                <iconify-icon icon="solar:user-linear" class="text-xs text-slate-300 dark:text-slate-600"></iconify-icon>
                                                <span>Không có SĐT</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(order.ShippingAddress))
                                        {
                                            <div class="text-[11px] text-slate-500 truncate max-w-xs flex items-center gap-1" title="@order.ShippingAddress">
                                                <iconify-icon icon="solar:map-point-linear" class="text-xs text-slate-400 shrink-0"></iconify-icon>
                                                <span>@order.ShippingAddress</span>
                                            </div>
                                        }
                                    </td>

                                    <!-- Số món -->
                                    <td class="text-center">
                                        <button type="button" 
                                                class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-bold transition-colors"
                                                @onclick="() => OpenDetailModal(order)"
                                                title="Bấm để xem danh sách món">
                                            <span>@(order.OrderDetails?.Sum(d => d.Quantity) ?? 0)</span>
                                            <span class="text-[11px] font-medium text-slate-500">món</span>
                                        </button>
                                    </td>

                                    <!-- Tổng tiền -->
                                    <td class="text-right">
                                        <div class="text-xs font-bold text-slate-900 dark:text-white">
                                            @($"{order.FinalAmount:N0} đ")
                                        </div>
                                        @if (order.DiscountAmount > 0)
                                        {
                                            <div class="text-[10px] text-emerald-600 font-medium">
                                                -@($"{order.DiscountAmount:N0}đ")
                                            </div>
                                        }
                                    </td>

                                    <!-- Thanh toán -->
                                    <td class="text-center">
                                        <span class="bakery-badge @(order.PaymentStatus == "Paid" ? "bakery-badge-success" : "bakery-badge-warning") text-[10px] py-0.5 px-2">
                                            @(order.PaymentStatus == "Paid" ? "Đã trả" : "Chưa trả")
                                        </span>
                                        <div class="text-[10px] text-slate-400 mt-1 font-medium">@order.PaymentMethod</div>
                                    </td>

                                    <!-- Trạng thái -->
                                    <td class="text-center">
                                        @switch (order.Status)
                                        {
                                            case OrderStatus.Pending:
                                                <span class="bakery-badge bakery-badge-warning text-xs font-semibold">Chờ duyệt</span>
                                                break;
                                            case OrderStatus.Confirmed:
                                                <span class="bakery-badge bakery-badge-primary text-xs font-semibold">Đã duyệt (Chờ shipper nhận)</span>
                                                break;
                                            case OrderStatus.InProgress:
                                                <span class="bakery-badge bakery-badge-warning text-xs font-semibold">Đang đóng gói</span>
                                                break;
                                            case OrderStatus.Shipping:
                                                <span class="bakery-badge bakery-badge-secondary text-xs font-semibold" style="background-color: #f3e8ff; color: #7e22ce;">Shipper đang giao</span>
                                                break;
                                            case OrderStatus.Delivered:
                                                <span class="bakery-badge text-xs font-semibold" style="background-color: #e0f2fe; color: #0369a1;">Đã giao (Chờ khách nhận)</span>
                                                break;
                                            case OrderStatus.Completed:
                                                <span class="bakery-badge bakery-badge-success text-xs font-semibold">Hoàn tất</span>
                                                break;
                                            case OrderStatus.Cancelled:
                                                <span class="bakery-badge bakery-badge-error text-xs font-semibold">Đã hủy</span>
                                                break;
                                            default:
                                                <span class="bakery-badge text-xs">@order.Status</span>
                                                break;
                                        }
                                    </td>

                                    <!-- Thao tác Xử lý đơn hàng của Quầy / Admin -->
                                    <td class="text-right">
                                        <div class="bakery-order-actions-wrap">
                                            @if (order.Status == OrderStatus.Pending)
                                            {
                                                <button type="button" 
                                                        class="bakery-order-btn-action bakery-order-btn-blue"
                                                        title="Duyệt đơn và giữ tồn kho bánh"
                                                        @onclick='() => ChangeOrderStatus(order, OrderStatus.Confirmed)'>
                                                    <iconify-icon icon="solar:check-circle-linear"></iconify-icon>
                                                    <span>Duyệt</span>
                                                </button>
                                                <button type="button" 
                                                        class="bakery-order-btn-action bakery-order-btn-cancel"
                                                        title="Hủy đơn hàng này khi chưa duyệt"
                                                        @onclick="() => CancelOrder(order)">
                                                    <iconify-icon icon="solar:close-circle-linear"></iconify-icon>
                                                    <span>Hủy</span>
                                                </button>
                                            }

                                            <!-- Nút xem chi tiết / In hóa đơn -->
                                            <button type="button" 
                                                    class="bakery-order-btn-action bakery-order-btn-view"
                                                    title="Xem chi tiết các món trong đơn"
                                                    @onclick="() => OpenDetailModal(order)">
                                                <iconify-icon icon="solar:eye-linear"></iconify-icon>
                                                <span>Xem bill</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile View dành cho Admin/Nhân viên trên điện thoại -->
            <div class="orders-mobile-list">
                @if (filteredOrders.Count == 0)
                {
                    <div class="order-mobile-empty">
                        <iconify-icon icon="solar:box-minimalistic-linear"></iconify-icon>
                        <p>Không có đơn hàng nào trong danh mục này</p>
                    </div>
                }
                else
                {
                    @foreach (var order in filteredOrders)
                    {
                        var receiverName = order.ReceiverName ?? order.Customer?.FullName ?? "Khách tại quầy";
                        var receiverPhone = !string.IsNullOrWhiteSpace(order.ReceiverPhone)
                            ? order.ReceiverPhone
                            : (order.Customer != null && order.Customer.FullName != "Khách vãng lai" ? order.Customer.Phone : null);

                        <article class="order-mobile-card">
                            <div class="order-mobile-head">
                                <span class="bakery-code-badge">#HD-@order.OrderID.ToString("D4")</span>
                                <span class="bakery-badge @GetStatusBadgeClass(order.Status) text-[10px]">@GetStatusLabel(order.Status)</span>
                            </div>

                            <div class="order-mobile-main">
                                <div class="order-mobile-customer">@receiverName</div>
                                <div class="order-mobile-amount">@($"{order.FinalAmount:N0} đ")</div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(receiverPhone))
                            {
                                <a class="order-mobile-phone" href="tel:@receiverPhone">
                                    <iconify-icon icon="solar:phone-bold"></iconify-icon>
                                    <span>@receiverPhone</span>
                                </a>
                            }
                            else
                            {
                                <div class="order-mobile-phone is-muted">
                                    <iconify-icon icon="solar:user-linear"></iconify-icon>
                                    <span>Không có SĐT</span>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(order.ShippingAddress))
                            {
                                <div class="order-mobile-address">
                                    <iconify-icon icon="solar:map-point-linear"></iconify-icon>
                                    <span>@order.ShippingAddress</span>
                                </div>
                            }

                            <div class="order-mobile-meta">
                                <span><iconify-icon icon="solar:calendar-linear"></iconify-icon> @order.OrderDate.ToString("dd/MM HH:mm")</span>
                                <span><iconify-icon icon="solar:bag-5-linear"></iconify-icon> @(order.OrderDetails?.Sum(d => d.Quantity) ?? 0) món</span>
                                <span class="bakery-badge @(order.PaymentStatus == "Paid" ? "bakery-badge-success" : "bakery-badge-warning") text-[10px]">
                                    @(order.PaymentStatus == "Paid" ? "Đã trả" : "Chưa trả")
                                </span>
                                <span class="order-mobile-payment-method">@order.PaymentMethod</span>
                            </div>

                            <div class="order-mobile-actions">
                                @if (order.Status == OrderStatus.Pending)
                                {
                                    <button type="button" class="bakery-order-btn-action bakery-order-btn-blue"
                                            @onclick='() => ChangeOrderStatus(order, OrderStatus.Confirmed)'>
                                        <iconify-icon icon="solar:check-circle-linear"></iconify-icon>
                                        <span>Duyệt</span>
                                    </button>
                                    <button type="button" class="bakery-order-btn-action bakery-order-btn-cancel"
                                            @onclick="() => CancelOrder(order)">
                                        <span>Hủy</span>
                                    </button>
                                }

                                <button type="button" class="bakery-order-btn-action bakery-order-btn-view"
                                        @onclick="() => OpenDetailModal(order)">
                                    <iconify-icon icon="solar:eye-linear"></iconify-icon>
                                    <span>Xem bill</span>
                                </button>
                            </div>
                        </article>
                    }
                }
            </div>
        </div>
    }
</div>

<!-- ================= MODAL CHI TIẾT HÓA ĐƠN (MODERN POP-UP E-COMMERCE STYLE) ================= -->
@if (selectedOrder != null)
{
    var customer = selectedOrder.Customer;
    var customerName = !string.IsNullOrWhiteSpace(customer?.FullName) ? customer.FullName : "Khách vãng lai";
    var customerPhone = !string.IsNullOrWhiteSpace(customer?.Phone) ? customer.Phone : "Không có SĐT";
    var receiverName = !string.IsNullOrWhiteSpace(selectedOrder.ReceiverName) ? selectedOrder.ReceiverName : customerName;
    var receiverPhone = !string.IsNullOrWhiteSpace(selectedOrder.ReceiverPhone)
        ? selectedOrder.ReceiverPhone
        : (customerPhone != "Không có SĐT" ? customerPhone : "Không có SĐT");
    var shippingAddress = !string.IsNullOrWhiteSpace(selectedOrder.ShippingAddress)
        ? selectedOrder.ShippingAddress
        : "Nhận tại quầy BakerySystem (Không ship)";
    var isShipping = !string.IsNullOrWhiteSpace(selectedOrder.ShippingAddress);
    var isPaid = selectedOrder.PaymentStatus == PaymentStatus.Paid;
    var totalQuantity = selectedOrder.OrderDetails?.Sum(d => d.Quantity) ?? 0;

    <div class="bakery-modal-backdrop" @onclick="() => selectedOrder = null">
        <div class="bakery-bill-card" @onclick:stopPropagation="true">
            <!-- 1. Header modal với icon xanh nổi bật, tiêu đề & badge trạng thái -->
            <div class="bakery-bill-header">
                <div class="bakery-bill-header-left">
                    <div class="bakery-bill-icon-box">
                        <iconify-icon icon="solar:bill-check-bold"></iconify-icon>
                    </div>
                    <div class="bakery-bill-title-wrap">
                        <h3 class="bakery-bill-title">
                            <span>Chi Tiết Hóa Đơn</span>
                            <span class="text-primary font-mono">#HD-@selectedOrder.OrderID.ToString("D4")</span>
                            
                            <!-- Badge Trạng thái đơn -->
                            @switch (selectedOrder.Status)
                            {
                                case OrderStatus.Pending:
                                    <span class="bakery-badge bakery-badge-warning text-xs font-semibold">Chờ duyệt</span>
                                    break;
                                case OrderStatus.Confirmed:
                                    <span class="bakery-badge bakery-badge-primary text-xs font-semibold">Đã duyệt (Chờ shipper nhận)</span>
                                    break;
                                case OrderStatus.InProgress:
                                    <span class="bakery-badge bakery-badge-warning text-xs font-semibold">Đang đóng gói</span>
                                    break;
                                case OrderStatus.Shipping:
                                    <span class="bakery-badge bakery-badge-secondary text-xs font-semibold" style="background-color: #f3e8ff; color: #7e22ce;">Shipper đang giao</span>
                                    break;
                                case OrderStatus.Delivered:
                                    <span class="bakery-badge text-xs font-semibold" style="background-color: #e0f2fe; color: #0369a1;">Đã giao (Chờ khách nhận)</span>
                                    break;
                                case OrderStatus.Completed:
                                    <span class="bakery-badge bakery-badge-success text-xs font-semibold">Hoàn tất</span>
                                    break;
                                case OrderStatus.Cancelled:
                                    <span class="bakery-badge bakery-badge-error text-xs font-semibold">Đã hủy</span>
                                    break;
                                default:
                                    <span class="bakery-badge text-xs">@selectedOrder.Status</span>
                                    break;
                            }
                        </h3>
                        <p class="bakery-bill-time">
                            <iconify-icon icon="solar:clock-circle-linear"></iconify-icon>
                            <span>Thời gian tạo đơn: @selectedOrder.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </p>
                    </div>
                </div>

                <button type="button" class="bakery-bill-close-btn" @onclick="() => selectedOrder = null" title="Đóng cửa sổ">
                    <iconify-icon icon="solar:close-circle-bold"></iconify-icon>
                </button>
            </div>

            <!-- 2. Nội dung chi tiết hóa đơn (cuộn độc lập) -->
            <div class="bakery-bill-body">
                
                <!-- 2 Cột thông tin gọn gàng: Người đặt hàng & Người nhận bánh -->
                <div class="bakery-bill-info-grid mb-3" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; margin-bottom: 0.75rem;">
                    
                    <!-- Cột 1: Người đặt hàng (Tài khoản) -->
                    <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/70" style="padding: 0.75rem; border-radius: 0.75rem;">
                        <div class="flex items-center justify-between pb-1.5 mb-2 border-b border-slate-200 dark:border-slate-700" style="padding-bottom: 0.375rem; margin-bottom: 0.5rem;">
                            <div class="flex items-center gap-1.5 text-xs font-bold text-slate-800 dark:text-slate-100 uppercase tracking-wide">
                                <iconify-icon icon="solar:user-bold" class="text-blue-600 text-sm"></iconify-icon>
                                <span>Người đặt hàng</span>
                            </div>
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700 dark:bg-blue-950/40 dark:text-blue-300 border border-blue-200 dark:border-blue-900/40">
                                <iconify-icon icon="solar:smartphone-linear"></iconify-icon> @(isShipping ? "Mobile App" : "Tại quầy")
                            </span>
                        </div>

                        <div class="space-y-1.5 text-xs" style="display: flex; flex-direction: column; gap: 0.375rem;">
                            <div>
                                <div class="text-[11px] text-slate-400 font-medium">Họ và tên khách đặt:</div>
                                <div class="text-sm font-bold text-slate-900 dark:text-white mt-0.5">@customerName</div>
                            </div>

                            <div>
                                <div class="text-[11px] text-slate-400 font-medium">Số điện thoại tài khoản:</div>
                                @if (customerPhone != "Không có SĐT")
                                {
                                    <div class="flex items-center gap-1.5 mt-0.5">
                                        <a href="tel:@customerPhone" class="font-mono font-bold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1">
                                            <iconify-icon icon="solar:phone-calling-bold"></iconify-icon> @customerPhone
                                        </a>
                                        <button type="button" @onclick="() => CopyPhone(customerPhone)" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200" title="Sao chép số điện thoại">
                                            <iconify-icon icon="solar:copy-linear"></iconify-icon>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-slate-400 italic mt-0.5">Không có SĐT</div>
                                }
                            </div>

                            <div>
                                <div class="text-[11px] text-slate-400 font-medium">Mã khách hàng:</div>
                                <div class="font-mono font-semibold text-slate-600 dark:text-slate-400 mt-0.5">#KH-@selectedOrder.CustomerID.ToString("D4")</div>
                            </div>
                        </div>
                    </div>

                    <!-- Cột 2: Người nhận bánh & Địa chỉ giao -->
                    <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/70 flex flex-col justify-between" style="padding: 0.75rem; border-radius: 0.75rem;">
                        <div>
                            <div class="flex items-center justify-between pb-1.5 mb-2 border-b border-slate-200 dark:border-slate-700" style="padding-bottom: 0.375rem; margin-bottom: 0.5rem;">
                                <div class="flex items-center gap-1.5 text-xs font-bold text-slate-800 dark:text-slate-100 uppercase tracking-wide">
                                    <iconify-icon icon="solar:map-point-wave-bold" class="text-rose-500 text-sm"></iconify-icon>
                                    <span>Người nhận bánh</span>
                                </div>
                                @if (isShipping)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-50 text-purple-700 dark:bg-purple-950/40 dark:text-purple-300 border border-purple-200 dark:border-purple-900/40">
                                        <iconify-icon icon="solar:delivery-bold"></iconify-icon> Shipper giao
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200">
                                        Tại quầy
                                    </span>
                                }
                            </div>

                            <div class="space-y-1.5 text-xs" style="display: flex; flex-direction: column; gap: 0.375rem;">
                                <div>
                                    <div class="text-[11px] text-slate-400 font-medium">Người nhận hàng:</div>
                                    <div class="text-sm font-bold text-slate-900 dark:text-white mt-0.5">@receiverName</div>
                                </div>

                                <div>
                                    <div class="text-[11px] text-slate-400 font-medium">Số điện thoại nhận:</div>
                                    @if (receiverPhone != "Không có SĐT")
                                    {
                                        <div class="flex items-center gap-1.5 mt-0.5">
                                            <a href="tel:@receiverPhone" class="font-mono font-bold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1">
                                                <iconify-icon icon="solar:phone-calling-bold"></iconify-icon> @receiverPhone
                                            </a>
                                            <button type="button" @onclick="() => CopyPhone(receiverPhone)" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200" title="Sao chép số điện thoại">
                                                <iconify-icon icon="solar:copy-linear"></iconify-icon>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-slate-400 italic mt-0.5">Không có SĐT</div>
                                    }
                                </div>

                                <div>
                                    <div class="text-[11px] text-slate-400 font-medium">Địa chỉ giao bánh:</div>
                                    <div class="font-medium text-slate-800 dark:text-slate-200 leading-snug mt-0.5">@shippingAddress</div>
                                </div>
                            </div>
                        </div>

                        @if (isShipping)
                        {
                            <div class="mt-2 pt-1.5 border-t border-slate-200 dark:border-slate-700" style="margin-top: 0.5rem; padding-top: 0.375rem;">
                                <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(selectedOrder.ShippingAddress!)" 
                                   target="_blank" 
                                   class="inline-flex items-center gap-1 text-[11px] font-bold text-blue-600 dark:text-blue-400 hover:underline">
                                    <iconify-icon icon="solar:routing-2-bold" class="text-xs"></iconify-icon>
                                    <span>Mở Google Maps chỉ đường</span>
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- Dòng thông tin Thanh toán & Thu ngân thanh thoát -->
                <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/70 mb-3 flex flex-wrap items-center justify-between gap-3 text-xs" style="padding: 0.5rem 0.75rem; border-radius: 0.75rem; margin-bottom: 0.75rem;">
                    <div class="flex items-center gap-2">
                        <iconify-icon icon="solar:wallet-money-bold" class="text-emerald-600 text-base"></iconify-icon>
                        <span class="text-slate-400">Hình thức:</span>
                        <strong class="text-slate-800 dark:text-slate-200">@selectedOrder.PaymentMethod</strong>
                        <span class="bakery-badge @(isPaid ? "bakery-badge-success" : "bakery-badge-warning") text-[10px] py-0.5 px-2 font-bold ml-1">
                            @(isPaid ? "✓ Đã thanh toán" : "⚠ Chưa thanh toán (Thu COD)")
                        </span>
                    </div>
                    <div class="flex items-center gap-3 text-slate-500">
                        <div>
                            <span class="text-slate-400">Nguồn lập:</span>
                            <strong class="text-slate-700 dark:text-slate-300 ml-1">@(selectedOrder.Employee?.FullName ?? "Hệ thống Mobile App")</strong>
                        </div>
                        <div class="text-slate-300">|</div>
                        <div>
                            <span class="text-slate-400">Tổng số lượng bánh:</span>
                            <strong class="text-primary font-mono ml-1">@totalQuantity cái</strong>
                        </div>
                    </div>
                </div>

                <!-- Ghi chú & Dặn dò bánh từ khách hàng nếu có -->
                @if (!string.IsNullOrWhiteSpace(selectedOrder.Note))
                {
                    <div class="mb-3 p-3 rounded-xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/50 flex items-start gap-2.5 text-xs text-amber-900 dark:text-amber-200">
                        <div class="w-7 h-7 rounded-lg bg-amber-100 text-amber-700 dark:bg-amber-900/50 dark:text-amber-300 flex items-center justify-center shrink-0 mt-0.5">
                            <iconify-icon icon="solar:notes-bold" class="text-base"></iconify-icon>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="font-bold text-amber-900 dark:text-amber-200 uppercase text-[11px] tracking-wide">Lưu ý & Dặn dò từ khách:</div>
                            <div class="mt-0.5 font-medium leading-relaxed">@selectedOrder.Note</div>
                        </div>
                    </div>
                }

                <!-- Bảng danh sách các món bánh trong đơn hàng (Chuẩn bakery-bill-table) -->
                <div class="bakery-bill-table-wrap mb-3" style="border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; background: #ffffff;">
                    <div class="flex items-center justify-between" style="padding: 0.625rem 1rem; border-bottom: 1px solid #e2e8f0; background: #f8fafc; display: flex; align-items: center; justify-content: space-between;">
                        <div class="flex items-center gap-2" style="font-weight: 700; font-size: 0.75rem; color: #1e293b; display: flex; align-items: center; gap: 0.5rem;">
                            <iconify-icon icon="solar:bag-5-bold" class="text-primary" style="font-size: 1rem;"></iconify-icon>
                            <span>Danh sách món bánh (@totalQuantity sản phẩm)</span>
                        </div>
                        <span style="font-size: 0.6875rem; color: #64748b; font-weight: 500;">Chi tiết từng món trong hóa đơn</span>
                    </div>

                    <div style="overflow-x: auto; width: 100%;">
                        <table class="bakery-bill-table" style="width: 100%; border-collapse: collapse; font-size: 0.75rem;">
                            <thead>
                                <tr style="background: #f1f5f9; border-bottom: 1px solid #e2e8f0; text-transform: uppercase; font-size: 0.6875rem; color: #475569; letter-spacing: 0.03em;">
                                    <th style="padding: 0.5rem 0.75rem; text-align: center; width: 45px;">STT</th>
                                    <th style="padding: 0.5rem 0.75rem; text-align: left; min-width: 180px;">Món Bánh</th>
                                    <th style="padding: 0.5rem 0.75rem; text-align: left; width: 140px;">Danh Mục</th>
                                    <th style="padding: 0.5rem 0.75rem; text-align: center; width: 85px;">Số Lượng</th>
                                    <th style="padding: 0.5rem 0.75rem; text-align: right; width: 110px;">Đơn Giá</th>
                                    <th style="padding: 0.5rem 0.75rem; text-align: right; width: 120px;">Thành Tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (selectedOrder.OrderDetails != null && selectedOrder.OrderDetails.Any())
                                {
                                    int index = 1;
                                    @foreach (var detail in selectedOrder.OrderDetails)
                                    {
                                        var prodImage = string.IsNullOrWhiteSpace(detail.Product?.ImageURL) 
                                            ? "/assets/images/products/default-bakery.svg" 
                                            : detail.Product.ImageURL;
                                        <tr style="border-bottom: 1px solid #f1f5f9;">
                                            <td style="padding: 0.6rem 0.75rem; text-align: center; color: #94a3b8; font-family: monospace;">@index</td>
                                            <td style="padding: 0.6rem 0.75rem;">
                                                <div style="display: flex; align-items: center; gap: 0.625rem;">
                                                    <img src="@prodImage" 
                                                         alt="@detail.Product?.ProductName" 
                                                         style="width: 36px; height: 36px; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0; flex-shrink: 0;"
                                                         onerror="this.src='/assets/images/products/default-bakery.svg'" />
                                                    <div>
                                                        <div style="font-weight: 700; color: #0f172a; line-height: 1.25;">@detail.Product?.ProductName</div>
                                                        <div style="font-size: 0.6875rem; color: #94a3b8; font-family: monospace; margin-top: 2px;">Mã SP: #SP-@detail.ProductID.ToString("D3")</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td style="padding: 0.6rem 0.75rem; color: #64748b;">
                                                <span style="display: inline-block; padding: 2px 8px; border-radius: 9999px; background: #f1f5f9; font-size: 0.6875rem; font-weight: 600;">
                                                    @(detail.Product?.Category?.CategoryName ?? "-")
                                                </span>
                                            </td>
                                            <td style="padding: 0.6rem 0.75rem; text-align: center;">
                                                <span style="display: inline-flex; align-items: center; justify-content: center; min-width: 28px; padding: 2px 6px; border-radius: 6px; background: #eff6ff; color: #1d4ed8; font-weight: 700; font-family: monospace; font-size: 0.8125rem; border: 1px solid #bfdbfe;">
                                                    @detail.Quantity
                                                </span>
                                            </td>
                                            <td style="padding: 0.6rem 0.75rem; text-align: right; font-family: monospace; color: #475569;">
                                                @($"{detail.UnitPrice:N0} đ")
                                            </td>
                                            <td style="padding: 0.6rem 0.75rem; text-align: right; font-weight: 700; font-family: monospace; color: #0f172a;">
                                                @($"{detail.SubTotal:N0} đ")
                                            </td>
                                        </tr>
                                        index++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" style="text-align: center; padding: 1.5rem; color: #94a3b8;">Không có dữ liệu chi tiết món bánh</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tổng kết tiền đơn hàng (Receipt Summary Box) -->
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80">
                    <div class="text-xs text-slate-500 space-y-1">
                        <div class="flex items-center gap-1.5">
                            <iconify-icon icon="solar:shield-check-bold" class="text-emerald-600 text-sm"></iconify-icon>
                            <span class="font-medium">Hóa đơn hợp lệ theo hệ thống BakerySystem</span>
                        </div>
                        <div class="text-[11px] text-slate-400">
                            Ngày lập: @selectedOrder.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")
                        </div>
                    </div>
                    <div class="w-full sm:w-80 space-y-2 text-xs">
                        <div class="flex items-center justify-between">
                            <span class="text-slate-500">Tổng tiền hàng:</span>
                            <span class="font-mono font-semibold text-slate-800 dark:text-slate-200">@($"{selectedOrder.TotalAmount:N0} đ")</span>
                        </div>
                        @if (selectedOrder.DiscountAmount > 0)
                        {
                            <div class="flex items-center justify-between text-emerald-600 font-semibold">
                                <span>Ưu đãi / Giảm giá:</span>
                                <span class="font-mono">-@($"{selectedOrder.DiscountAmount:N0} đ")</span>
                            </div>
                        }
                        <div class="flex items-center justify-between text-slate-500">
                            <span>Phí giao hàng:</span>
                            <span class="text-emerald-600 font-semibold">Miễn phí (Freeship)</span>
                        </div>
                        <div class="pt-2 border-t border-slate-200 dark:border-slate-700 flex items-center justify-between">
                            <span class="text-sm font-bold text-slate-900 dark:text-white">Khách cần thanh toán:</span>
                            <span class="text-lg font-black font-mono text-rose-600 dark:text-rose-400">@($"{selectedOrder.FinalAmount:N0} đ")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. Footer thao tác (In ấn, Chuyển trạng thái, Đóng) -->
            <div class="bakery-bill-footer">
                <div>
                    <button type="button" 
                            class="bakery-btn bakery-btn-outline text-xs flex items-center gap-1.5"
                            @onclick="PrintInvoice"
                            title="In hóa đơn ra máy in">
                        <iconify-icon icon="solar:printer-linear" class="text-base"></iconify-icon>
                        <span>In Hóa Đơn</span>
                    </button>
                </div>

                <div class="flex items-center gap-2">
                    @if (selectedOrder.Status == OrderStatus.Pending && !isShipper)
                    {
                        <button type="button" 
                                class="bakery-order-btn-action bakery-order-btn-blue text-xs px-3 py-1.5"
                                @onclick='() => ChangeSelectedOrderStatus(OrderStatus.Confirmed)'>
                            <iconify-icon icon="solar:check-circle-linear"></iconify-icon>
                            <span>Duyệt đơn</span>
                        </button>
                    }
                    else if (selectedOrder.Status == OrderStatus.Confirmed && isShipper)
                    {
                        <button type="button" 
                                class="bakery-order-btn-action bakery-order-btn-blue text-xs px-3 py-1.5"
                                @onclick='() => ChangeSelectedOrderStatus(OrderStatus.Shipping)'>
                            <iconify-icon icon="solar:delivery-linear"></iconify-icon>
                            <span>Nhận giao đơn</span>
                        </button>
                    }
                    else if (selectedOrder.Status == OrderStatus.Shipping && isShipper)
                    {
                        <button type="button" 
                                class="bakery-order-btn-action text-xs px-3 py-1.5 bg-amber-600 hover:bg-amber-700 text-white font-bold"
                                style="background-color: #d97706; color: white;"
                                @onclick='() => ChangeSelectedOrderStatus(OrderStatus.Delivered)'>
                            <iconify-icon icon="solar:box-minimalistic-bold"></iconify-icon>
                            <span>Báo đã giao bánh</span>
                        </button>
                    }

                    <button type="button" 
                            class="bakery-btn bakery-btn-secondary text-xs px-4"
                            @onclick="() => selectedOrder = null">
                        Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<div class="admin-print-report" data-report="orders">
    <div class="admin-print-header"><div><div class="admin-print-eyebrow">BAKERYSYSTEM</div><h1>Danh sách đơn đặt hàng</h1><p>Báo cáo theo bộ lọc hiện tại · Ngày in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p></div><div class="admin-print-summary"><strong>@filteredOrders.Count</strong><span>đơn hàng</span></div></div>
    <table><thead><tr><th>Mã đơn</th><th>Thời gian</th><th>Khách hàng</th><th class="print-number">Số món</th><th class="print-number">Tổng tiền</th><th>Thanh toán</th><th>Trạng thái</th></tr></thead><tbody>
    @foreach (var order in filteredOrders)
    {
        <tr><td>#HD-@order.OrderID.ToString("D4")</td><td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td><td>@(order.ReceiverName ?? order.Customer?.FullName ?? "Khách tại quầy")@(string.IsNullOrWhiteSpace(order.ReceiverPhone) ? "" : $" · {order.ReceiverPhone}")</td><td class="print-number">@order.OrderDetails.Count</td><td class="print-number">@order.TotalAmount.ToString("N0") đ</td><td>@order.PaymentStatus</td><td>@order.Status</td></tr>
    }
    </tbody></table>
    <div class="admin-print-footer"><span>Không bao gồm thao tác quản trị.</span><span>Người lập: ____________________</span></div>
</div>

@code {
    private List<Order> orders = new();
    private string selectedStatus = "All";
    private string searchQuery = "";
    private string selectedPaymentStatus = "All";
    private DateTime? dateFrom;
    private DateTime? dateTo;
    private Order? selectedOrder;
    private string currentRole = AccountRole.Employee;
    private bool isShipper;
    private int? currentEmployeeId;
    private string shipperActiveTab = "Workspace";
    private PeriodicTimer? periodicTimer;
    private CancellationTokenSource? cts;
    private bool isDisposed;

    private Order? deliveringOrder => isShipper 
        ? orders.FirstOrDefault(o => o.Status == OrderStatus.Shipping) 
        : null;

    private List<Order> pendingDeliveryOrders => isShipper
        ? orders.Where(o => o.Status == OrderStatus.Confirmed).OrderBy(o => o.OrderDate).ToList()
        : new();

    private Order? nextPriorityOrder => pendingDeliveryOrders.FirstOrDefault();

    private List<Order> queueOrders => pendingDeliveryOrders.Skip(1).ToList();

    private List<Order> waitingConfirmOrders => isShipper
        ? orders.Where(o => o.Status == OrderStatus.Delivered).OrderByDescending(o => o.OrderDate).ToList()
        : new();

    private List<Order> completedOrders => isShipper
        ? orders.Where(o => o.Status == OrderStatus.Completed).OrderByDescending(o => o.OrderDate).ToList()
        : new();

    private decimal totalCodCollectedToday => isShipper
        ? completedOrders
            .Where(o => o.OrderDate.Date == DateTime.Today && o.PaymentMethod == PaymentMethod.COD)
            .Sum(o => o.FinalAmount)
        : 0;

    private int totalCompletedToday => isShipper
        ? completedOrders.Count(o => o.OrderDate.Date == DateTime.Today)
        : 0;

    [SupplyParameterFromQuery(Name = "order")]
    public int? OrderIdFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "customer")]
    public int? CustomerIdFromQuery { get; set; }

    private List<Order> filteredOrders => orders
        .Where(o => !CustomerIdFromQuery.HasValue || o.CustomerID == CustomerIdFromQuery.Value)
        .Where(o => selectedStatus == "All" || o.Status == selectedStatus)
        .Where(o => selectedPaymentStatus == "All" || o.PaymentStatus == selectedPaymentStatus)
        .Where(o => !dateFrom.HasValue || o.OrderDate.Date >= dateFrom.Value.Date)
        .Where(o => !dateTo.HasValue || o.OrderDate.Date <= dateTo.Value.Date)
        .Where(o => string.IsNullOrWhiteSpace(searchQuery) ||
                    o.OrderID.ToString().Contains(searchQuery) ||
                    (o.ReceiverName != null && o.ReceiverName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                    (o.ReceiverPhone != null && o.ReceiverPhone.Contains(searchQuery)) ||
                    (o.ShippingAddress != null && o.ShippingAddress.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private void ResetAdvancedSearch()
    {
        CustomerIdFromQuery = null;
        searchQuery = string.Empty;
        selectedStatus = "All";
        selectedPaymentStatus = "All";
        dateFrom = null;
        dateTo = null;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentRole = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? AccountRole.Employee;
        isShipper = currentRole == AccountRole.Shipper;

        var username = authState.User.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(username))
        {
            var emp = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.FirstOrDefaultAsync(
                DbContext.Employees.Include(e => e.Account), 
                e => e.Account.Username == username);
            currentEmployeeId = emp?.EmployeeID;
        }

        await LoadOrdersAsync();
        if (OrderIdFromQuery is int orderId)
            selectedOrder = orders.FirstOrDefault(o => o.OrderID == orderId);

        NotifService.OnOrderChanged += HandleOrderNotification;
        cts = new CancellationTokenSource();
        _ = StartPeriodicRefreshAsync(cts.Token);
    }

    private void HandleOrderNotification()
    {
        _ = InvokeAsync(async () =>
        {
            if (isDisposed) return;
            await LoadOrdersAsync();
            StateHasChanged();
        });
    }

    private async Task StartPeriodicRefreshAsync(CancellationToken token)
    {
        periodicTimer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await periodicTimer.WaitForNextTickAsync(token))
            {
                if (isDisposed) break;
                await LoadOrdersAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected upon disposal
        }
    }

    private async Task LoadOrdersAsync()
    {
        orders = isShipper
            ? await OrderService.GetShipperOnlineOrdersAsync()
            : await OrderService.GetOrdersAsync();
    }

    private async Task ExportOrdersToExcel()
    {
        await JS.InvokeVoidAsync("bakeryExcel.exportToExcel", "orders-table",
            $"Danh_Sach_Don_Hang_Bakery_{DateTime.Now:yyyyMMdd_HHmmss}");
    }

    private async Task PrintOrdersToPdf()
    {
        await JS.InvokeVoidAsync("bakeryPdf.printReportToPdf", "Danh_Sach_Don_Hang_BakerySystem", "print-orders");
    }

    private void FilterByStatus(string status)
    {
        selectedStatus = status;
    }

    private async Task ChangeOrderStatus(Order order, string newStatus)
    {
        if (order.Status is OrderStatus.Cancelled or OrderStatus.Completed) return;

        if (isShipper &&
            !((order.Status == OrderStatus.Confirmed && newStatus == OrderStatus.Shipping) ||
              (order.Status == OrderStatus.Shipping && newStatus == OrderStatus.Delivered)))
        {
            await JS.InvokeVoidAsync("alert", "Bạn không có quyền thực hiện thao tác này trên đơn hàng.");
            return;
        }

        if (isShipper && newStatus == OrderStatus.Delivered)
        {
            var confirmMsg = order.PaymentStatus == PaymentStatus.Paid
                ? $"Xác nhận bạn đã giao đơn #HD-{order.OrderID:D4} tới nơi cho khách?\nKhách sẽ nhận thông báo bấm 'Xác nhận đã nhận bánh' trên Mobile App."
                : $"Xác nhận bạn đã giao đơn #HD-{order.OrderID:D4} và thu đủ {order.FinalAmount:N0} đ tiền mặt (COD)?\nKhách sẽ nhận thông báo bấm 'Xác nhận đã nhận bánh' trên Mobile App.";
            bool ok = await JS.InvokeAsync<bool>("confirm", confirmMsg);
            if (!ok) return;
        }

        if (!await OrderService.ChangeStatusAsync(order, newStatus, currentRole, currentEmployeeId))
        {
            var message = isShipper
                ? $"Không thể cập nhật đơn hàng #{order.OrderID} ở trạng thái hiện tại."
                : $"Không đủ tồn kho cho đơn hàng #{order.OrderID}.";
            await JS.InvokeVoidAsync("alert", message);
            return;
        }

        await LoadOrdersAsync();
        NotifService.NotifyOrderChanged();
    }

    private async Task ChangeSelectedOrderStatus(string newStatus)
    {
        if (selectedOrder == null) return;
        await ChangeOrderStatus(selectedOrder, newStatus);
    }

    private async Task PrintInvoice()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task CancelOrder(Order order)
    {
        if (isShipper) return;
        if (order.Status != OrderStatus.Pending)
        {
            await JS.InvokeVoidAsync("alert", "Chỉ có thể hủy đơn hàng khi đang ở trạng thái 'Chờ duyệt'. Đơn đã duyệt không được phép hủy.");
            return;
        }
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Bạn có chắc muốn từ chối/hủy đơn hàng #HD-{order.OrderID:D4}?");
        if (!confirmed) return;

        var reason = await JS.InvokeAsync<string?>("prompt", "Nhập lý do từ chối/hủy đơn hàng:");
        if (reason == null) return;
        reason = reason.Trim();
        if (string.IsNullOrWhiteSpace(reason))
        {
            await JS.InvokeVoidAsync("alert", "Vui lòng nhập lý do hủy đơn.");
            return;
        }

        bool ok = await OrderService.CancelAsync(order, reason);
        if (!ok)
        {
            await JS.InvokeVoidAsync("alert", "Không thể hủy đơn hàng ở trạng thái hiện tại.");
            return;
        }

        await LoadOrdersAsync();
        NotifService.NotifyOrderChanged();
    }

    private void OpenDetailModal(Order order)
    {
        selectedOrder = order;
    }

    private async Task CopyPhone(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", phone);
            await JS.InvokeVoidAsync("alert", $"Đã sao chép số điện thoại: {phone}");
        }
        catch
        {
            // Ignore
        }
    }

    private static string GetStatusLabel(string status) => status switch
    {
        OrderStatus.Pending => "Chờ duyệt",
        OrderStatus.Confirmed => "Đã duyệt",
        OrderStatus.InProgress => "Đang đóng gói",
        OrderStatus.Shipping => "Đang giao",
        OrderStatus.Delivered => "Chờ khách nhận",
        OrderStatus.Completed => "Hoàn tất",
        OrderStatus.Cancelled => "Đã hủy",
        _ => status
    };

    private static string GetStatusBadgeClass(string status) => status switch
    {
        OrderStatus.Pending => "bakery-badge-warning",
        OrderStatus.Confirmed => "bakery-badge-primary",
        OrderStatus.InProgress => "bakery-badge-warning",
        OrderStatus.Shipping => "bakery-badge-secondary",
        OrderStatus.Delivered => "bakery-badge-primary",
        OrderStatus.Completed => "bakery-badge-success",
        OrderStatus.Cancelled => "bakery-badge-error",
        _ => "bakery-badge-secondary"
    };

    public void Dispose()
    {
        isDisposed = true;
        NotifService.OnOrderChanged -= HandleOrderNotification;
        cts?.Cancel();
        cts?.Dispose();
        periodicTimer?.Dispose();
    }
}
