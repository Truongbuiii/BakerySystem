@page "/suppliers/{SupplierId:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject NavigationManager Navigation

<PageTitle>Lịch sử phiếu nhập nhà cung cấp | BakerySystem</PageTitle>

@code {
    [Parameter] public int SupplierId { get; set; }

    protected override void OnParametersSet()
    {
        Navigation.NavigateTo($"/import-receipt-management?supplier={SupplierId}", replace: true);
    }
}
