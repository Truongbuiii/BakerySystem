@page "/import-receipt-management"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Employee")]
@using BakerySystem.Domain.Entities
@using BakerySystem.Domain.Enums
@inject InventoryService Inventory
@inject IJSRuntime JS

<PageTitle>Quản lý phiếu nhập kho | BakerySystem</PageTitle>

<div class="bakery-page-header">
    <div>
        <h2 class="text-2xl font-bold">Quản lý phiếu nhập kho</h2>
        <p class="text-bodytext">Tra cứu, xem chi tiết, xác nhận nhập kho và hủy phiếu.</p>
    </div>
    <div class="bakery-page-actions">
        <button class="bakery-btn bakery-btn-secondary bakery-btn-sm" @onclick="LoadAsync">Làm mới</button>
        <button class="bakery-btn bakery-btn-outline bakery-btn-sm" @onclick="ExportAsync">Xuất Excel</button>
        <button class="bakery-btn bakery-btn-secondary bakery-btn-sm" @onclick="PrintAsync">In / Xuất PDF</button>
        <a class="bakery-btn bakery-btn-primary bakery-btn-sm" href="/import-receipts">+ Lập phiếu nhập</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(actionMessage))
{
    <div class="mb-4 rounded-lg border @(actionSuccess ? "border-emerald-300 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300" : "border-rose-300 bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-300") p-3 flex items-center justify-between gap-3 text-sm">
        <div class="flex items-center gap-2">
            <iconify-icon icon="@(actionSuccess ? "solar:check-circle-bold" : "solar:danger-triangle-bold")" class="text-lg"></iconify-icon>
            <span>@actionMessage</span>
        </div>
        <button type="button" class="text-slate-400 hover:text-slate-600 font-bold" @onclick="() => actionMessage = null">×</button>
    </div>
}

<div class="bakery-filter-card mb-4">
    <div class="receipt-filter-bar">
        <div class="receipt-search-wrap">
            <span class="receipt-search-icon">
                <iconify-icon icon="solar:magnifer-linear"></iconify-icon>
            </span>
            <input type="text"
                   class="bakery-input receipt-search-input"
                   placeholder="Tìm mã phiếu, tên bánh, nhân viên..."
                   @bind="search"
                   @bind:event="oninput"
                   @bind:after="EnsureSelectedMatchesFilter" />
        </div>

        <div class="receipt-supplier-wrap">
            <select class="bakery-input receipt-supplier-select" @bind="supplierFilter" @bind:after="EnsureSelectedMatchesFilter">
                <option value="0">Tất cả nhà cung cấp</option>
                @foreach (var supplier in suppliers)
                {
                    <option value="@supplier.SupplierID">@supplier.SupplierCode - @supplier.SupplierName</option>
                }
            </select>
        </div>

        <label class="receipt-date-box">
            <span class="receipt-date-label">Từ ngày</span>
            <input class="receipt-date-input" type="date" @bind="from" @bind:after="EnsureSelectedMatchesFilter" />
        </label>

        <label class="receipt-date-box">
            <span class="receipt-date-label">Đến ngày</span>
            <input class="receipt-date-input" type="date" @bind="to" @bind:after="EnsureSelectedMatchesFilter" />
        </label>

        <div class="receipt-actions-wrap">
            <button type="button"
                    class="bakery-btn @(advancedOpen ? "bakery-btn-primary" : "bakery-btn-outline") receipt-toolbar-btn"
                    @onclick="() => advancedOpen = !advancedOpen">
                <iconify-icon icon="solar:tuning-square-2-linear"></iconify-icon>
                <span>@(advancedOpen ? "Thu gọn" : "Lọc nâng cao")</span>
                @if (employeeFilter != 0 || minTotal.HasValue || maxTotal.HasValue || minLines.HasValue || maxLines.HasValue)
                {
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                }
            </button>
            <button type="button" class="bakery-btn bakery-btn-outline receipt-toolbar-btn" @onclick="Reset">
                <iconify-icon icon="solar:refresh-linear"></iconify-icon>
                <span>Đặt lại</span>
            </button>
        </div>
    </div>

    @if (advancedOpen)
    {
        <div class="receipt-adv-panel">
            <div class="receipt-adv-field">
                <span class="receipt-adv-label">Nhân viên lập phiếu</span>
                <select class="bakery-input w-full" @bind="employeeFilter" @bind:after="EnsureSelectedMatchesFilter">
                    <option value="0">Tất cả nhân viên</option>
                    @foreach (var employee in EmployeesWithReceipts)
                    {
                        <option value="@employee.EmployeeID">@employee.FullName</option>
                    }
                </select>
            </div>

            <div class="receipt-adv-field">
                <span class="receipt-adv-label">Khoảng tổng tiền (VNĐ)</span>
                <div class="receipt-adv-range">
                    <input class="bakery-input w-full" type="number" min="0" step="10000" placeholder="Từ..." @bind="minTotal" @bind:after="EnsureSelectedMatchesFilter" />
                    <input class="bakery-input w-full" type="number" min="0" step="10000" placeholder="Đến..." @bind="maxTotal" @bind:after="EnsureSelectedMatchesFilter" />
                </div>
            </div>

            <div class="receipt-adv-field">
                <span class="receipt-adv-label">Số dòng sản phẩm</span>
                <div class="receipt-adv-range">
                    <input class="bakery-input w-full" type="number" min="0" placeholder="Từ..." @bind="minLines" @bind:after="EnsureSelectedMatchesFilter" />
                    <input class="bakery-input w-full" type="number" min="0" placeholder="Đến..." @bind="maxLines" @bind:after="EnsureSelectedMatchesFilter" />
                </div>
            </div>
        </div>
    }
</div>

@if (supplierFilter > 0)
{
    var activeSupplier = suppliers.FirstOrDefault(s => s.SupplierID == supplierFilter);
    if (activeSupplier is not null)
    {
        <div class="mb-4 rounded-xl border border-blue-200 bg-blue-50/70 dark:bg-blue-950/30 dark:border-blue-800 px-4 py-2.5 flex flex-wrap items-center justify-between gap-2 text-xs">
            <div class="flex items-center gap-2 text-slate-700 dark:text-slate-200">
                <iconify-icon icon="solar:buildings-2-bold-duotone" class="text-base text-primary"></iconify-icon>
                <span>
                    Đang xem lịch sử phiếu nhập của nhà cung cấp:
                    <strong class="text-primary">@activeSupplier.SupplierCode - @activeSupplier.SupplierName</strong>
                    (@FilteredReceiptList.Count phiếu · Tổng @FilteredReceiptList.Sum(x => x.TotalAmount).ToString("N0") đ)
                </span>
            </div>
            <div class="flex items-center gap-3">
                <a href="/suppliers" class="font-semibold text-slate-600 hover:text-primary">← Quay lại Nhà cung cấp</a>
                <button type="button" class="font-semibold text-rose-600 hover:underline" @onclick="ClearSupplierFilter">
                    × Bỏ lọc nhà cung cấp
                </button>
            </div>
        </div>
    }
}

<!-- Status Filter Tabs -->
<div class="flex flex-wrap items-center gap-2 mb-4">
    <button type="button" class="receipt-filter-chip @(statusFilter == "All" ? "active" : "")" @onclick='() => SetStatusTab("All")'>
        Tất cả (@ReceiptsForStatusCount.Count())
    </button>
    <button type="button" class="receipt-filter-chip @(statusFilter == ImportReceiptStatus.Pending ? "active" : "")" @onclick='() => SetStatusTab(ImportReceiptStatus.Pending)'>
        <span class="inline-block w-2 h-2 rounded-full bg-amber-500 mr-1.5"></span>
        Chờ nhập kho (@ReceiptsForStatusCount.Count(r => r.Status == ImportReceiptStatus.Pending))
    </button>
    <button type="button" class="receipt-filter-chip @(statusFilter == ImportReceiptStatus.Completed ? "active" : "")" @onclick='() => SetStatusTab(ImportReceiptStatus.Completed)'>
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 mr-1.5"></span>
        Đã nhập kho (@ReceiptsForStatusCount.Count(r => r.Status == ImportReceiptStatus.Completed))
    </button>
    <button type="button" class="receipt-filter-chip @(statusFilter == ImportReceiptStatus.Cancelled ? "active" : "")" @onclick='() => SetStatusTab(ImportReceiptStatus.Cancelled)'>
        <span class="inline-block w-2 h-2 rounded-full bg-rose-500 mr-1.5"></span>
        Đã hủy (@ReceiptsForStatusCount.Count(r => r.Status == ImportReceiptStatus.Cancelled))
    </button>
</div>

<div class="receipt-management-layout">
    <div class="bakery-split-list bakery-filter-card !p-0 overflow-hidden">
        <div class="p-4 border-b border-slate-200 dark:border-slate-700">
            <div class="flex items-center justify-between gap-2">
                <h3 class="font-bold mb-0">Danh sách phiếu nhập</h3>
                <span class="bakery-badge bakery-badge-secondary">@FilteredReceiptList.Count phiếu</span>
            </div>
        </div>
        @if (FilteredReceiptList.Count == 0)
        {
            <p class="p-6 text-center text-slate-500">Không tìm thấy phiếu nhập phù hợp.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table id="import-receipts-management-table" class="bakery-table w-full text-sm">
                    <thead><tr><th>Mã phiếu</th><th>Ngày</th><th>Trạng thái</th><th class="text-right">Tổng tiền</th></tr></thead>
                    <tbody>
                        @foreach (var receipt in FilteredReceiptList)
                        {
                            <tr class="bakery-row-clickable @(selected?.ReceiptID == receipt.ReceiptID ? "bakery-row-selected" : "")"
                                @onclick="() => selected = receipt">
                                <td class="font-mono font-semibold">PN-@receipt.ReceiptID.ToString("D6")</td>
                                <td>@receipt.ReceiptDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="bakery-badge @ImportReceiptStatus.GetBadgeClass(receipt.Status) text-[11px] py-0.5 px-2">
                                        @ImportReceiptStatus.GetLabel(receipt.Status)
                                    </span>
                                </td>
                                <td class="text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <span class="font-semibold">@receipt.TotalAmount.ToString("N0") đ</span>
                                        @if (receipt.Status == ImportReceiptStatus.Pending)
                                        {
                                            <button type="button" class="bakery-btn bakery-btn-primary text-[10px] py-0.5 px-2 font-bold"
                                                    title="Duyệt và cộng tồn kho"
                                                    @onclick="() => PromptComplete(receipt)" @onclick:stopPropagation="true">
                                                Duyệt
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="bakery-split-detail">
        @if (selected is null)
        {
            <div class="bakery-filter-card h-full flex items-center justify-center text-center text-slate-500">
                Chọn một phiếu nhập để xem chi tiết.
            </div>
        }
        else
        {
            <div class="receipt-document">
                <div class="receipt-document-topline"></div>
                <div class="receipt-document-header">
                    <div>
                        <p class="receipt-document-label">BAKERYSYSTEM · CHỨNG TỪ KHO</p>
                        <h3>PHIẾU NHẬP KHO</h3>
                        <div class="flex items-center gap-2 mt-1">
                            <p class="receipt-document-code mb-0">PN-@selected.ReceiptID.ToString("D6")</p>
                            <span class="bakery-badge @ImportReceiptStatus.GetBadgeClass(selected.Status) text-xs">
                                @ImportReceiptStatus.GetLabel(selected.Status)
                            </span>
                        </div>
                    </div>
                    <div class="receipt-document-date">
                        <span>Ngày lập phiếu</span>
                        <strong>@selected.ReceiptDate.ToString("dd/MM/yyyy")</strong>
                        <small>@selected.ReceiptDate.ToString("HH:mm")</small>
                    </div>
                </div>
                <div class="receipt-document-info">
                    <div><span>Nhà cung cấp</span><strong>@selected.Supplier?.SupplierName</strong><small>@selected.Supplier?.SupplierCode</small></div>
                    <div><span>Nhân viên lập phiếu</span><strong>@selected.Employee?.FullName</strong><small>Mã nhân viên: @selected.EmployeeID</small></div>
                    <div><span>Trạng thái phiếu</span><strong class="@(selected.Status == ImportReceiptStatus.Completed ? "text-emerald-700 dark:text-emerald-400" : selected.Status == ImportReceiptStatus.Pending ? "text-amber-700 dark:text-amber-400" : "text-rose-700 dark:text-rose-400")">@ImportReceiptStatus.GetLabel(selected.Status)</strong><small>@selected.ImportReceiptDetails.Count dòng sản phẩm</small></div>
                </div>
                <div class="receipt-document-section-title">Chi tiết hàng hóa</div>
                <div class="overflow-x-auto">
                    <table class="receipt-document-table">
                        <thead><tr><th style="width: 7%;">STT</th><th>Sản phẩm</th><th class="text-right">Số lượng</th><th class="text-right">Đơn giá</th><th class="text-right">Thành tiền</th></tr></thead>
                        <tbody>
                            @{ var lineNumber = 0; }
                            @foreach (var detail in selected.ImportReceiptDetails)
                            {
                                lineNumber++;
                                <tr><td>@lineNumber</td><td><strong>@detail.Product?.ProductName</strong></td><td class="text-right">@detail.Quantity</td><td class="text-right">@detail.UnitPrice.ToString("N0") đ</td><td class="text-right font-semibold">@detail.SubTotal.ToString("N0") đ</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="receipt-document-total"><span>TỔNG GIÁ TRỊ PHIẾU NHẬP</span><strong>@selected.TotalAmount.ToString("N0") đ</strong></div>
                <div class="receipt-document-note"><strong>Ghi chú</strong><span>@(string.IsNullOrWhiteSpace(selected.Note) ? "Không có ghi chú." : selected.Note)</span></div>

                <!-- Action Toolbar for Receipt Lifecycle -->
                <div class="mt-4 pt-4 border-t border-slate-200 dark:border-slate-700 flex flex-wrap items-center justify-between gap-3">
                    @if (selected.Status == ImportReceiptStatus.Pending)
                    {
                        <div class="text-xs text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/30 px-3 py-2 rounded-lg border border-amber-200 dark:border-amber-800 flex-1">
                            <iconify-icon icon="solar:info-circle-linear" class="mr-1"></iconify-icon>
                            Phiếu đang ở trạng thái <strong>Chờ duyệt nhập</strong> (tồn kho chưa cộng). Sau khi kiểm đếm thực tế, hãy bấm <strong>"Duyệt &amp; Nhập kho"</strong>.
                        </div>
                        <div class="flex items-center gap-2">
                            <button class="bakery-btn bakery-btn-danger bakery-btn-sm" @onclick="() => PromptCancel(selected)" disabled="@isProcessing">
                                Hủy phiếu
                            </button>
                            <button class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick="() => PromptComplete(selected)" disabled="@isProcessing">
                                <iconify-icon icon="solar:check-circle-bold" class="mr-1"></iconify-icon>
                                Duyệt &amp; Nhập kho
                            </button>
                        </div>
                    }
                    else if (selected.Status == ImportReceiptStatus.Completed)
                    {
                        <div class="text-xs text-slate-500">
                            Phiếu đã nhập kho thành công. Nếu phát hiện lập nhầm số lượng, bạn có thể hủy phiếu để hoàn tác tồn kho.
                        </div>
                        <button class="bakery-btn bakery-btn-danger bakery-btn-sm" @onclick="() => PromptCancel(selected)" disabled="@isProcessing">
                            <iconify-icon icon="solar:trash-bin-trash-linear" class="mr-1"></iconify-icon>
                            Hủy phiếu (Hoàn tác kho)
                        </button>
                    }
                    else if (selected.Status == ImportReceiptStatus.Cancelled)
                    {
                        <div class="w-full text-xs text-rose-700 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/30 px-3 py-2 rounded-lg border border-rose-200 dark:border-rose-800">
                            <iconify-icon icon="solar:close-circle-bold" class="mr-1"></iconify-icon>
                            Phiếu này đã bị hủy. Tồn kho của các mặt hàng không bị ảnh hưởng.
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<table id="import-receipts-export-table" class="export-only-table" aria-hidden="true">
    <thead><tr><th>Mã phiếu</th><th>Ngày nhập</th><th>Trạng thái</th><th>Nhà cung cấp</th><th>Nhân viên</th><th>Chi tiết sản phẩm</th><th>Số dòng hàng</th><th>Tổng tiền</th><th>Ghi chú</th></tr></thead>
    <tbody>
        @foreach (var receipt in FilteredReceiptList)
        {
            <tr>
                <td>PN-@receipt.ReceiptID.ToString("D6")</td>
                <td>@receipt.ReceiptDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@ImportReceiptStatus.GetLabel(receipt.Status)</td>
                <td>@receipt.Supplier?.SupplierCode - @receipt.Supplier?.SupplierName</td>
                <td>@receipt.Employee?.FullName</td>
                <td>@string.Join("; ", receipt.ImportReceiptDetails.Select(detail => $"{detail.Product?.ProductName} x{detail.Quantity} @ {detail.UnitPrice:N0} đ"))</td>
                <td>@receipt.ImportReceiptDetails.Count</td>
                <td>@receipt.TotalAmount.ToString("N0") đ</td>
                <td>@(string.IsNullOrWhiteSpace(receipt.Note) ? "" : receipt.Note)</td>
            </tr>
        }
    </tbody>
</table>

<div class="admin-print-report" data-report="import-receipt-management">
    <div class="admin-print-header"><div><div class="admin-print-eyebrow">BAKERYSYSTEM</div><h1>Danh sách phiếu nhập kho</h1><p>Báo cáo theo bộ lọc hiện tại · Ngày in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p></div><div class="admin-print-summary"><strong>@FilteredReceiptList.Count</strong><span>phiếu nhập</span></div></div>
    <table><thead><tr><th>Mã phiếu</th><th>Ngày</th><th>Trạng thái</th><th>Nhà cung cấp</th><th>Nhân viên</th><th>Chi tiết sản phẩm</th><th class="print-number">Thành tiền</th></tr></thead><tbody>
    @foreach (var receipt in FilteredReceiptList)
    {
        <tr>
            <td>PN-@receipt.ReceiptID.ToString("D6")</td>
            <td>@receipt.ReceiptDate.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@ImportReceiptStatus.GetLabel(receipt.Status)</td>
            <td>@receipt.Supplier?.SupplierCode - @receipt.Supplier?.SupplierName</td>
            <td>@receipt.Employee?.FullName</td>
            <td>@string.Join("; ", receipt.ImportReceiptDetails.Select(detail => $"{detail.Product?.ProductName} x{detail.Quantity}"))</td>
            <td class="print-number">@receipt.TotalAmount.ToString("N0") đ</td>
        </tr>
    }
    </tbody></table>
</div>

<!-- Modal Xác nhận Hủy phiếu -->
@if (showCancelModal && receiptToCancel is not null)
{
    <div class="bakery-modal-backdrop" @onclick="CloseCancelModal">
        <div class="bakery-modal-card max-w-md" @onclick:stopPropagation="true">
            <div class="bakery-modal-header">
                <div class="flex items-center gap-2.5">
                    <div class="bakery-modal-icon-badge danger">
                        <iconify-icon icon="solar:shield-warning-bold"></iconify-icon>
                    </div>
                    <div>
                        <h4 class="text-base font-bold text-slate-900 dark:text-white mb-0">Xác nhận hủy phiếu nhập</h4>
                        <p class="text-xs text-slate-500 mb-0">PN-@receiptToCancel.ReceiptID.ToString("D6")</p>
                    </div>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 text-lg" @onclick="CloseCancelModal">×</button>
            </div>
            <div class="bakery-modal-body space-y-3">
                @if (receiptToCancel.Status == ImportReceiptStatus.Completed)
                {
                    <div class="p-3 rounded-lg bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-300 text-xs border border-rose-200 dark:border-rose-800">
                        <strong>Lưu ý quan trọng:</strong> Phiếu này đã từng cộng tồn kho. Khi hủy, hệ thống sẽ <strong>trừ ngược lại</strong> số lượng tương ứng của các sản phẩm trong kho.
                    </div>
                }
                else
                {
                    <p class="text-sm text-slate-600 dark:text-slate-300 mb-0">
                        Bạn có chắc chắn muốn hủy phiếu nhập tạm này không? Phiếu sẽ chuyển sang trạng thái "Đã hủy".
                    </p>
                }
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                    Lý do hủy
                    <input class="bakery-input mt-1 w-full" placeholder="Ví dụ: Nhập nhầm số lượng, sai nhà cung cấp..." @bind="cancelReason" />
                </label>
                @if (!string.IsNullOrEmpty(cancelError))
                {
                    <p class="text-xs text-rose-600 mb-0">@cancelError</p>
                }
            </div>
            <div class="bakery-modal-footer">
                <button type="button" class="bakery-btn bakery-btn-outline" @onclick="CloseCancelModal" disabled="@isProcessing">Đóng</button>
                <button type="button" class="bakery-btn bakery-btn-danger" @onclick="ExecuteCancelReceipt" disabled="@isProcessing">
                    @(isProcessing ? "Đang xử lý..." : "Xác nhận hủy phiếu")
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal Xác nhận Nhập kho -->
@if (showCompleteModal && receiptToComplete is not null)
{
    <div class="bakery-modal-backdrop" @onclick="CloseCompleteModal">
        <div class="bakery-modal-card max-w-md" @onclick:stopPropagation="true">
            <div class="bakery-modal-header">
                <div class="flex items-center gap-2.5">
                    <div class="bakery-modal-icon-badge blue">
                        <iconify-icon icon="solar:box-minimalistic-bold"></iconify-icon>
                    </div>
                    <div>
                        <h4 class="text-base font-bold text-slate-900 dark:text-white mb-0">Xác nhận duyệt &amp; nhập kho</h4>
                        <p class="text-xs text-slate-500 mb-0">PN-@receiptToComplete.ReceiptID.ToString("D6")</p>
                    </div>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 text-lg" @onclick="CloseCompleteModal">×</button>
            </div>
            <div class="bakery-modal-body space-y-3">
                <p class="text-sm text-slate-600 dark:text-slate-300 mb-0">
                    Bạn đã kiểm đếm xong hàng thực tế từ nhà cung cấp <strong>@receiptToComplete.Supplier?.SupplierName</strong>?
                </p>
                <div class="p-3 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 text-xs border border-emerald-200 dark:border-emerald-800">
                    Hệ thống sẽ <strong>cộng tồn kho</strong> cho @receiptToComplete.ImportReceiptDetails.Count sản phẩm trong phiếu này và chuyển trạng thái sang <strong>Đã nhập kho</strong>.
                </div>
                @if (!string.IsNullOrEmpty(completeError))
                {
                    <p class="text-xs text-rose-600 mb-0">@completeError</p>
                }
            </div>
            <div class="bakery-modal-footer">
                <button type="button" class="bakery-btn bakery-btn-outline" @onclick="CloseCompleteModal" disabled="@isProcessing">Đóng</button>
                <button type="button" class="bakery-btn bakery-btn-primary" @onclick="ExecuteCompleteReceipt" disabled="@isProcessing">
                    @(isProcessing ? "Đang xử lý..." : "Duyệt & Nhập kho")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "id")]
    public int? Id { get; set; }

    [SupplyParameterFromQuery(Name = "supplier")]
    public int? SupplierQueryId { get; set; }

    private List<ImportReceipt> receipts = [];
    private List<Supplier> suppliers = [];
    private ImportReceipt? selected;
    private string search = string.Empty;
    private DateTime? from;
    private DateTime? to;
    private bool advancedOpen;
    private string? activeAdvancedFilter;
    private string statusFilter = "All";
    private int supplierFilter;
    private int employeeFilter;
    private decimal? minTotal;
    private decimal? maxTotal;
    private int? minLines;
    private int? maxLines;

    // Action state
    private bool isProcessing;
    private string? actionMessage;
    private bool actionSuccess;

    // Cancel modal state
    private bool showCancelModal;
    private ImportReceipt? receiptToCancel;
    private string cancelReason = string.Empty;
    private string? cancelError;

    // Complete modal state
    private bool showCompleteModal;
    private ImportReceipt? receiptToComplete;
    private string? completeError;

    private IEnumerable<Employee> EmployeesWithReceipts => receipts
        .Where(receipt => receipt.Employee is not null)
        .Select(receipt => receipt.Employee!)
        .GroupBy(employee => employee.EmployeeID)
        .Select(group => group.First())
        .OrderBy(employee => employee.FullName);

    private IEnumerable<ImportReceipt> ReceiptsForStatusCount => receipts.Where(receipt =>
        (supplierFilter == 0 || receipt.SupplierID == supplierFilter) &&
        (employeeFilter == 0 || receipt.EmployeeID == employeeFilter) &&
        (!from.HasValue || receipt.ReceiptDate.Date >= from.Value.Date) &&
        (!to.HasValue || receipt.ReceiptDate.Date <= to.Value.Date) &&
        (!minTotal.HasValue || receipt.TotalAmount >= minTotal.Value) &&
        (!maxTotal.HasValue || receipt.TotalAmount <= maxTotal.Value) &&
        (!minLines.HasValue || receipt.ImportReceiptDetails.Count >= minLines.Value) &&
        (!maxLines.HasValue || receipt.ImportReceiptDetails.Count <= maxLines.Value) &&
        (string.IsNullOrWhiteSpace(search) ||
         ($"PN-{receipt.ReceiptID:D6} {receipt.Supplier?.SupplierCode} {receipt.Supplier?.SupplierName} {receipt.Employee?.FullName} " +
          $"{string.Join(" ", receipt.ImportReceiptDetails.Select(detail => detail.Product?.ProductName))}")
            .Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<ImportReceipt> FilteredReceipts => ReceiptsForStatusCount.Where(receipt =>
        statusFilter == "All" || receipt.Status == statusFilter);

    private List<ImportReceipt> FilteredReceiptList => FilteredReceipts.ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (SupplierQueryId.HasValue && SupplierQueryId.Value > 0)
        {
            supplierFilter = SupplierQueryId.Value;
        }

        if (Id.HasValue && Id.Value > 0 && receipts.Count > 0)
        {
            statusFilter = "All";
            var match = receipts.FirstOrDefault(receipt => receipt.ReceiptID == Id.Value);
            if (match is not null)
            {
                selected = match;
                return;
            }
        }

        EnsureSelectedMatchesFilter();
    }

    private async Task LoadAsync()
    {
        receipts = await Inventory.GetReceiptsAsync();
        suppliers = await Inventory.GetSuppliersAsync();

        if (SupplierQueryId.HasValue && SupplierQueryId.Value > 0)
        {
            supplierFilter = SupplierQueryId.Value;
        }

        if (Id.HasValue && Id.Value > 0)
        {
            statusFilter = "All";
            selected = receipts.FirstOrDefault(receipt => receipt.ReceiptID == Id.Value);
        }

        EnsureSelectedMatchesFilter();
    }

    private void SetStatusTab(string status)
    {
        statusFilter = status;
        EnsureSelectedMatchesFilter();
    }

    private void ClearSupplierFilter()
    {
        supplierFilter = 0;
        EnsureSelectedMatchesFilter();
    }

    private void EnsureSelectedMatchesFilter()
    {
        var list = FilteredReceiptList;
        if (list.Count == 0)
        {
            selected = null;
            return;
        }

        if (selected is null || !list.Any(r => r.ReceiptID == selected.ReceiptID))
        {
            selected = list[0];
        }
        else
        {
            selected = list.First(r => r.ReceiptID == selected.ReceiptID);
        }
    }

    private void Reset()
    {
        search = string.Empty;
        from = null;
        to = null;
        statusFilter = "All";
        supplierFilter = 0;
        employeeFilter = 0;
        minTotal = null;
        maxTotal = null;
        minLines = null;
        maxLines = null;
        advancedOpen = false;
        activeAdvancedFilter = null;
        EnsureSelectedMatchesFilter();
    }

    private void ToggleAdvancedFilter(string filter)
    {
        activeAdvancedFilter = activeAdvancedFilter == filter ? null : filter;
    }

    private void PromptComplete(ImportReceipt receipt)
    {
        receiptToComplete = receipt;
        completeError = null;
        showCompleteModal = true;
    }

    private void CloseCompleteModal()
    {
        showCompleteModal = false;
        receiptToComplete = null;
        completeError = null;
    }

    private async Task ExecuteCompleteReceipt()
    {
        if (receiptToComplete is null || isProcessing)
            return;

        isProcessing = true;
        completeError = null;
        try
        {
            await Inventory.CompleteReceiptAsync(receiptToComplete.ReceiptID);
            actionMessage = $"Đã xác nhận nhập kho phiếu PN-{receiptToComplete.ReceiptID:D6} và cộng tồn kho thành công.";
            actionSuccess = true;
            CloseCompleteModal();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            completeError = ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void PromptCancel(ImportReceipt receipt)
    {
        receiptToCancel = receipt;
        cancelReason = string.Empty;
        cancelError = null;
        showCancelModal = true;
    }

    private void CloseCancelModal()
    {
        showCancelModal = false;
        receiptToCancel = null;
        cancelError = null;
    }

    private async Task ExecuteCancelReceipt()
    {
        if (receiptToCancel is null || isProcessing)
            return;

        isProcessing = true;
        cancelError = null;
        try
        {
            await Inventory.CancelReceiptAsync(receiptToCancel.ReceiptID, cancelReason);
            actionMessage = receiptToCancel.Status == ImportReceiptStatus.Completed
                ? $"Đã hủy phiếu PN-{receiptToCancel.ReceiptID:D6} và hoàn tác trừ tồn kho thành công."
                : $"Đã hủy phiếu tạm PN-{receiptToCancel.ReceiptID:D6}.";
            actionSuccess = true;
            CloseCancelModal();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            cancelError = ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ExportAsync() => await JS.InvokeVoidAsync("bakeryExcel.exportToExcel", "import-receipts-export-table", $"Danh_Sach_Phieu_Nhap_Bakery_{DateTime.Now:yyyyMMdd_HHmmss}");

    private async Task PrintAsync() => await JS.InvokeVoidAsync("bakeryPdf.printReportToPdf", "Danh_Sach_Phieu_Nhap_BakerySystem", "print-import-receipt-management");
}
