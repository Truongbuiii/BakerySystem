@page "/import-receipts"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject InventoryService Inventory
@inject EmployeeService EmployeeManager
<PageTitle>Phiếu nhập kho | BakerySystem</PageTitle>
<div class="bakery-page-header"><div><h2 class="text-2xl font-bold">Lập phiếu nhập kho</h2><p class="text-bodytext">Lưu phiếu nhập sẽ tự động cộng số lượng vào tồn kho.</p></div></div>
<div class="bakery-filter-card mb-5"><div class="grid md:grid-cols-3 gap-3"><label>Nhà cung cấp<select class="bakery-input w-full" @bind="supplierId"><option value="0">Chọn nhà cung cấp</option>@foreach(var s in suppliers){<option value="@s.SupplierID">@s.SupplierName</option>}</select></label><label>Nhân viên lập phiếu<select class="bakery-input w-full" @bind="employeeId"><option value="0">Chọn nhân viên</option>@foreach(var e in employees){<option value="@e.EmployeeID">@e.FullName</option>}</select></label><label>Ghi chú<input class="bakery-input w-full" @bind="note" /></label></div>
@foreach(var line in lines){<div class="grid md:grid-cols-4 gap-3 mt-3 items-end"><label>Sản phẩm<select class="bakery-input w-full" @bind="line.ProductID"><option value="0">Chọn sản phẩm</option>@foreach(var p in products){<option value="@p.ProductID">@p.ProductName (tồn @p.Quantity)</option>}</select></label><label>Số lượng<input class="bakery-input w-full" type="number" min="1" @bind="line.Quantity" /></label><label>Đơn giá vốn<input class="bakery-input w-full" type="number" min="0" step="1000" @bind="line.UnitPrice" /></label><button class="bakery-btn bakery-btn-secondary" @onclick="()=>lines.Remove(line)" disabled="@(lines.Count==1)">Xóa dòng</button></div>}
<div class="flex flex-wrap justify-between items-center mt-4 gap-3"><button class="bakery-btn bakery-btn-secondary" @onclick="()=>lines.Add(new())">+ Thêm sản phẩm</button><div class="flex items-center gap-4"><strong>Tổng tiền: @Total.ToString("N0") đ</strong><button class="bakery-btn bakery-btn-primary" @onclick="Save">Lưu phiếu nhập</button></div></div>@if(!string.IsNullOrEmpty(message)){<p class="mt-3 text-sm @(saved ? "text-emerald-600" : "text-rose-600")">@message</p>}</div>
<div class="bakery-filter-card overflow-x-auto"><h3 class="font-bold mb-3">Lịch sử nhập hàng <span class="font-normal text-slate-500">· Tổng đã chi @receipts.Sum(x=>x.TotalAmount).ToString("N0") đ</span></h3><table class="w-full text-sm"><thead><tr><th class="text-left p-3">Ngày</th><th class="text-left p-3">Nhà cung cấp</th><th class="text-left p-3">Nhân viên</th><th class="text-left p-3">Sản phẩm</th><th class="text-right p-3">Thành tiền</th></tr></thead><tbody>@foreach(var r in receipts){<tr class="border-t"><td class="p-3">@r.ReceiptDate.ToString("dd/MM/yyyy HH:mm")</td><td class="p-3">@r.Supplier?.SupplierName</td><td class="p-3">@r.Employee?.FullName</td><td class="p-3">@string.Join(", ",r.ImportReceiptDetails.Select(d=>d.Product?.ProductName+" × "+d.Quantity))</td><td class="p-3 text-right">@r.TotalAmount.ToString("N0") đ</td></tr>}</tbody></table></div>
@code { List<Supplier> suppliers=[];List<Employee> employees=[];List<Product> products=[];List<ImportReceipt> receipts=[];List<ImportLineInput> lines=[new()];int supplierId;int employeeId;string? note,message;bool saved;decimal Total=>lines.Sum(x=>x.Quantity*x.UnitPrice);protected override async Task OnInitializedAsync()=>await Load();async Task Load(){suppliers=await Inventory.GetActiveSuppliersAsync();employees=await EmployeeManager.GetAllAsync();products=await Inventory.GetProductsAsync();receipts=await Inventory.GetReceiptsAsync();}async Task Save(){try{await Inventory.SaveReceiptAsync(new(){SupplierID=supplierId,EmployeeID=employeeId,Note=note,Lines=lines});message="Đã lưu phiếu và cập nhật tồn kho.";saved=true;supplierId=0;employeeId=0;note=null;lines=[new()];await Load();}catch(Exception ex){message=ex.Message;saved=false;}} }
