@page "/import-receipts"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Employee")]
@using BakerySystem.Domain.Enums
@inject InventoryService Inventory
@inject EmployeeService EmployeeManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Phiếu nhập kho | BakerySystem</PageTitle>

<div class="bakery-page-header">
    <div>
        <h2 class="text-2xl font-bold">Lập phiếu nhập kho</h2>
        <p class="text-bodytext">Tạo phiếu nhập mới, tự động đối chiếu giá vốn và cập nhật tồn kho.</p>
    </div>
    <div class="bakery-page-actions">
        <a class="bakery-btn bakery-btn-outline bakery-btn-sm" href="/import-receipt-management">
            <iconify-icon icon="solar:clipboard-list-linear" class="text-base"></iconify-icon>
            <span>Quản lý phiếu đã nhập</span>
        </a>
    </div>
</div>

<div class="import-page-card max-w-6xl mx-auto">
    <!-- 1. Thông tin chung của phiếu nhập -->
    <div class="import-header-grid">
        <div class="import-field-group">
            <div class="import-field-label-row">
                <span class="import-field-label">Nhà cung cấp <span class="text-rose-500">*</span></span>
                <AuthorizeView Roles="Admin">
                    <button type="button"
                            class="import-assign-link"
                            @onclick="OpenProductAssignment"
                            disabled="@(saving || supplierId <= 0)"
                            title="@(supplierId <= 0 ? "Chọn nhà cung cấp trước để phân công bánh" : "Chọn các loại bánh nhà cung cấp này giao")">
                        <iconify-icon icon="solar:widget-add-linear"></iconify-icon>
                        <span>@(supplierId > 0 ? $"Chọn bánh cung cấp ({products.Count} bánh)" : "Chọn bánh cung cấp")</span>
                    </button>
                </AuthorizeView>
            </div>
            <select class="bakery-input w-full line-control-height" value="@supplierId" @onchange="SupplierChanged" disabled="@saving">
                <option value="0">-- Chọn nhà cung cấp --</option>
                @foreach (var supplier in suppliers)
                {
                    <option value="@supplier.SupplierID">@supplier.SupplierCode - @supplier.SupplierName</option>
                }
            </select>
        </div>

        <div class="import-field-group">
            <div class="import-field-label-row">
                <span class="import-field-label">Nhân viên lập phiếu</span>
            </div>
            <input class="bakery-input w-full line-control-height" value="@employeeName" readonly />
        </div>

        <div class="import-field-group" style="grid-column: 1 / -1;">
            <div class="import-field-label-row">
                <span class="import-field-label">Ghi chú phiếu nhập</span>
            </div>
            <input class="bakery-input w-full line-control-height" placeholder="Ghi chú về lô hàng, số hóa đơn giao hàng hoặc tình trạng kiểm nhận..." @bind="note" disabled="@saving" />
        </div>
    </div>

    <!-- 2. Danh sách mặt hàng nhập kho -->
    <div class="import-section-divider">
        <div class="import-section-header">
            <div>
                <h3 class="font-bold text-base mb-0">Danh sách sản phẩm nhập</h3>
                <p class="text-xs text-slate-500 mb-0">
                    Chọn <strong>Giá nhập trước</strong> để dùng lại giá vốn cũ hoặc bấm <strong>Nhập giá mới</strong> nếu nhà cung cấp thay đổi giá.
                </p>
            </div>
            @if (supplierId > 0 && products.Count > 0)
            {
                <span class="bakery-badge bakery-badge-secondary">@lines.Count dòng hàng</span>
            }
        </div>

        @if (supplierId <= 0)
        {
            <div class="import-empty-box">
                <iconify-icon icon="solar:buildings-2-linear" class="text-3xl text-slate-400 mb-2"></iconify-icon>
                <p class="font-semibold text-slate-700 dark:text-slate-200 mb-1">Chưa chọn nhà cung cấp</p>
                <p class="text-xs text-slate-500 mb-0">Vui lòng chọn nhà cung cấp ở trên để hiển thị danh sách bánh và bắt đầu lập phiếu nhập.</p>
            </div>
        }
        else if (products.Count == 0)
        {
            <div class="import-empty-box">
                <iconify-icon icon="solar:box-minimalistic-linear" class="text-3xl text-amber-500 mb-2"></iconify-icon>
                <p class="font-semibold text-slate-800 dark:text-slate-100 mb-1">Nhà cung cấp này chưa có bánh nào được phân công</p>
                <p class="text-xs text-slate-500 mb-3">Hãy tick chọn những loại bánh mà nhà cung cấp này giao trước khi lập phiếu.</p>
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <button type="button" class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick="OpenProductAssignment">
                            + Chọn bánh cho nhà cung cấp này
                        </button>
                    </Authorized>
                    <NotAuthorized>
                        <span class="text-xs text-amber-700">Vui lòng nhờ Quản trị viên phân công bánh cho nhà cung cấp này.</span>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        }
        else
        {
            <div class="import-lines-list">
                @foreach (var line in lines)
                {
                    var selectedProduct = products.FirstOrDefault(p => p.ProductID == line.ProductID);
                    var hasPreviousPrice = line.ProductID > 0 && purchasePrices.TryGetValue(line.ProductID, out var prevPriceVal) && prevPriceVal > 0;
                    var previousPrice = hasPreviousPrice ? purchasePrices[line.ProductID] : 0m;
                    var mode = GetPriceMode(line, hasPreviousPrice);
                    var isLossWarning = selectedProduct is not null && selectedProduct.Price > 0 && line.UnitPrice >= selectedProduct.Price;

                    <div class="import-line-card @(isLossWarning ? "has-loss-warning" : "")">
                        <div class="import-line-grid">
                            <!-- Cột 1: Chọn sản phẩm -->
                            <div class="import-field-group">
                                <div class="line-col-header">
                                    <span class="import-field-label">Sản phẩm</span>
                                </div>
                                <select class="bakery-input w-full line-control-height"
                                        @bind="line.ProductID"
                                        @bind:after="() => ApplyPurchasePrice(line)"
                                        disabled="@saving">
                                    <option value="0">-- Chọn bánh cần nhập --</option>
                                    @foreach (var product in products)
                                    {
                                        var isChosen = lines.Any(l => l != line && l.ProductID == product.ProductID);
                                        <option value="@product.ProductID" disabled="@isChosen">
                                            @product.ProductName (Tồn: @product.Quantity)@(isChosen ? " — Đã chọn" : "")
                                        </option>
                                    }
                                </select>
                            </div>

                            <!-- Cột 2: Số lượng -->
                            <div class="import-field-group">
                                <div class="line-col-header">
                                    <span class="import-field-label">Số lượng</span>
                                </div>
                                <input class="bakery-input w-full line-control-height"
                                       type="number"
                                       min="1"
                                       placeholder="SL"
                                       @bind="line.Quantity"
                                       @bind:event="oninput"
                                       disabled="@(saving || line.ProductID <= 0)" />
                            </div>

                            <!-- Cột 3: Đơn giá vốn (2 Button chọn luôn hiển thị cố định tránh nhảy layout) -->
                            <div class="import-field-group">
                                <div class="line-col-header">
                                    <span class="import-field-label">Đơn giá vốn</span>
                                    <div class="price-mode-tabs">
                                        <button type="button"
                                                class="price-mode-btn @(line.ProductID > 0 && mode == "saved" ? "active" : "")"
                                                disabled="@(line.ProductID <= 0 || !hasPreviousPrice || saving)"
                                                title="@(hasPreviousPrice ? $"Dùng lại mức giá {previousPrice:N0} đ từ lần nhập trước" : "Sản phẩm này chưa có giá vốn lưu từ trước")"
                                                @onclick='() => SwitchPriceMode(line, "saved")'>
                                            @(line.ProductID > 0 && hasPreviousPrice ? $"Giá trước ({previousPrice:N0}đ)" : "Giá trước")
                                        </button>
                                        <button type="button"
                                                class="price-mode-btn @(line.ProductID > 0 && mode == "custom" ? "active" : "")"
                                                disabled="@(line.ProductID <= 0 || saving)"
                                                @onclick='() => SwitchPriceMode(line, "custom")'>
                                            Nhập giá mới
                                        </button>
                                    </div>
                                </div>

                                @if (line.ProductID <= 0)
                                {
                                    <input class="bakery-input w-full line-control-height" type="text" value="Chọn sản phẩm trước" disabled />
                                }
                                else if (mode == "saved" && hasPreviousPrice)
                                {
                                    <div class="saved-price-display line-control-height">
                                        <span class="saved-price-amount">@line.UnitPrice.ToString("N0") đ / bánh</span>
                                        <span class="saved-price-tag">Giá lần nhập trước</span>
                                    </div>
                                }
                                else
                                {
                                    <input class="bakery-input w-full line-control-height"
                                           type="text"
                                           inputmode="numeric"
                                           placeholder="Nhập đơn giá vốn mới (VNĐ)..."
                                           value="@GetUnitPriceText(line)"
                                           @oninput="args => UnitPriceChanged(line, args)"
                                           @onblur="() => FormatUnitPrice(line)"
                                           disabled="@saving" />
                                }
                            </div>

                            <!-- Cột 4: Thành tiền -->
                            <div class="import-field-group">
                                <div class="line-col-header">
                                    <span class="import-field-label">Thành tiền</span>
                                </div>
                                <div class="import-subtotal-box line-control-height">
                                    <span class="import-subtotal-val">@((line.Quantity * line.UnitPrice).ToString("#,##0", PriceCulture)) đ</span>
                                </div>
                            </div>

                            <!-- Cột 5: Nút Xóa dòng -->
                            <div class="import-field-group">
                                <div class="line-col-header">
                                    <span class="import-field-label">&nbsp;</span>
                                </div>
                                <button type="button"
                                        class="import-remove-btn line-control-height"
                                        title="Xóa dòng sản phẩm này"
                                        @onclick="() => RemoveLine(line)"
                                        disabled="@(saving || lines.Count == 1)">
                                    <iconify-icon icon="solar:trash-bin-trash-linear" class="text-base"></iconify-icon>
                                    <span>Xóa</span>
                                </button>
                            </div>
                        </div>

                        <!-- Thanh trạng thái cố định ở đáy thẻ (Zero Layout Shift khi chọn/đổi bánh) -->
                        <div class="import-line-statusbar">
                            @if (selectedProduct is null)
                            {
                                <div class="status-meta-group">
                                    <span class="text-slate-400">Chọn sản phẩm để tự động tra cứu giá vốn lần nhập trước và đối chiếu lãi gộp với giá bán lẻ.</span>
                                </div>
                                <span class="status-feedback-badge neutral">Chờ chọn bánh</span>
                            }
                            else
                            {
                                <div class="status-meta-group">
                                    <span class="status-meta-item">
                                        Giá bán lẻ: <strong class="text-slate-800 dark:text-slate-100">@selectedProduct.Price.ToString("N0") đ</strong>
                                    </span>
                                    <span class="status-meta-dot">•</span>
                                    <span class="status-meta-item">
                                        Tồn hiện tại: <strong>@selectedProduct.Quantity bánh</strong>
                                    </span>
                                    <span class="status-meta-dot">•</span>
                                    @if (hasPreviousPrice)
                                    {
                                        <span class="status-meta-item">
                                            Giá vốn cũ: <strong class="text-emerald-700 dark:text-emerald-400">@previousPrice.ToString("N0") đ</strong>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-meta-item text-amber-700 dark:text-amber-400">
                                            Chưa có lịch sử giá vốn
                                        </span>
                                    }
                                </div>

                                @if (line.UnitPrice <= 0)
                                {
                                    <span class="status-feedback-badge danger">
                                        Vui lòng nhập đơn giá vốn &gt; 0
                                    </span>
                                }
                                else if (selectedProduct.Price > 0 && line.UnitPrice >= selectedProduct.Price)
                                {
                                    var lossPerUnit = line.UnitPrice - selectedProduct.Price;
                                    <span class="status-feedback-badge danger">
                                        ⚠️ Cảnh báo bán lỗ: Giá vốn @(lossPerUnit == 0 ? "bằng" : $"cao hơn {lossPerUnit:N0} đ so với") giá bán lẻ!
                                    </span>
                                }
                                else if (selectedProduct.Price > 0)
                                {
                                    var margin = selectedProduct.Price - line.UnitPrice;
                                    var marginPct = Math.Round(margin * 100m / selectedProduct.Price, 0);
                                    <span class="status-feedback-badge profit">
                                        ✓ Lãi gộp dự kiến: +@margin.ToString("N0") đ/bánh (@marginPct%) · Tự động lưu cho lần sau
                                    </span>
                                }
                            }
                        </div>
                    </div>
                }
            </div>

            @if (LossWarningLinesCount > 0)
            {
                <div class="mt-4 rounded-xl border border-amber-300 bg-amber-50 p-3.5 text-xs text-amber-800 flex items-start justify-between gap-3">
                    <div>
                        <strong class="block text-sm text-amber-900 mb-0.5">
                            ⚠️ Phát hiện @LossWarningLinesCount sản phẩm có Giá vốn cao hơn hoặc bằng Giá bán lẻ!
                        </strong>
                        <span>Vui lòng kiểm tra kỹ xem bạn có gõ dư số 0 hay không trước khi lưu phiếu nhập kho.</span>
                    </div>
                </div>
            }

            <!-- 3. Thanh công cụ cuối phiếu -->
            <div class="import-footer-bar">
                <button type="button"
                        class="bakery-btn bakery-btn-secondary"
                        @onclick="AddLine"
                        disabled="@(saving || lines.Count >= products.Count)">
                    + Thêm dòng sản phẩm
                </button>

                <div class="import-total-summary">
                    <div class="import-total-box">
                        <span class="import-total-label">Tổng cộng (@lines.Where(l => l.ProductID > 0).Sum(l => l.Quantity) bánh)</span>
                        <span class="import-total-value">@Total.ToString("#,##0", PriceCulture) đ</span>
                    </div>

                    <div class="flex flex-wrap items-center gap-2.5">
                        <button type="button"
                                class="bakery-btn bakery-btn-outline"
                                @onclick='() => Save(ImportReceiptStatus.Pending)'
                                disabled="@(!CanSave)">
                            <iconify-icon icon="solar:clock-circle-linear" class="mr-1"></iconify-icon>
                            @(saving ? "Đang lưu..." : "Lưu phiếu chờ duyệt")
                        </button>
                        <button type="button"
                                class="bakery-btn bakery-btn-primary"
                                @onclick='() => Save(ImportReceiptStatus.Completed)'
                                disabled="@(!CanSave)">
                            <iconify-icon icon="solar:box-minimalistic-bold" class="mr-1"></iconify-icon>
                            @(saving ? "Đang lưu..." : "Duyệt & Nhập kho ngay")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        @if (saved && lastCreatedReceiptId > 0)
        {
            <div class="mt-4 rounded-xl border border-emerald-300 bg-emerald-50 dark:bg-emerald-950/40 p-4 text-emerald-800 dark:text-emerald-300 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <iconify-icon icon="solar:check-circle-bold" class="text-2xl text-emerald-600 shrink-0"></iconify-icon>
                    <div>
                        <strong class="text-sm">@message</strong>
                        <p class="text-xs text-emerald-700 dark:text-emerald-400 mb-0">
                            Mã phiếu: <strong class="font-mono">PN-@lastCreatedReceiptId.ToString("D6")</strong> ·
                            Trạng thái: <strong>@ImportReceiptStatus.GetLabel(savedStatus)</strong>
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                    <a class="bakery-btn bakery-btn-primary bakery-btn-sm" href="/import-receipt-management?id=@lastCreatedReceiptId">
                        Xem chi tiết phiếu
                    </a>
                    <button type="button" class="bakery-btn bakery-btn-secondary bakery-btn-sm" @onclick="() => { saved = false; lastCreatedReceiptId = 0; message = null; }">
                        Tiếp tục lập phiếu
                    </button>
                </div>
            </div>
        }
        else
        {
            <p class="mt-3 text-sm @(saved ? "text-emerald-600" : "text-rose-600")">@message</p>
        }
    }
</div>

<!-- Modal Chọn bánh nhà cung cấp có thể giao (Chỉ tick chọn bánh, KHÔNG bắt nhập giá vốn) -->
@if (productAssignmentOpen)
{
    var selectedSupplier = suppliers.FirstOrDefault(supplier => supplier.SupplierID == supplierId);
    <div class="bakery-modal-backdrop" @onclick="CloseProductAssignment">
        <div class="bakery-modal-card max-w-2xl" @onclick:stopPropagation="true">
            <div class="bakery-modal-header">
                <div>
                    <h4 class="text-base font-bold text-slate-900 dark:text-white mb-0">Chọn bánh nhà cung cấp có thể giao</h4>
                    <p class="text-xs text-slate-500 mb-0">@(selectedSupplier is null ? "" : $"{selectedSupplier.SupplierCode} - {selectedSupplier.SupplierName}")</p>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 text-lg" @onclick="CloseProductAssignment" aria-label="Đóng">×</button>
            </div>
            <div class="bakery-modal-body">
                <div class="mb-4 flex flex-wrap items-center justify-between gap-2 rounded-lg bg-slate-50 p-3 text-xs text-slate-600">
                    <span>Tick chọn các loại bánh mà nhà cung cấp này phân phối. Giá vốn sẽ được chọn hoặc nhập trực tiếp khi lập phiếu.</span>
                    <div class="flex gap-2">
                        <a class="bakery-btn bakery-btn-secondary bakery-btn-sm" href="/products" target="_blank" rel="noopener">Mở Menu &amp; Bánh ngọt</a>
                        <button type="button" class="bakery-btn bakery-btn-secondary bakery-btn-sm" @onclick="RefreshProductCatalog">Tải lại</button>
                    </div>
                </div>

                @if (productCatalog.Count == 0)
                {
                    <p class="py-4 text-center text-sm text-slate-500">Chưa có sản phẩm đang kinh doanh. Hãy tạo bánh trong Menu &amp; Bánh ngọt trước.</p>
                }
                else
                {
                    <div class="assign-product-grid">
                        @foreach (var product in productCatalog)
                        {
                            var hasOtherSuppliers = otherSuppliersByProduct.TryGetValue(product.ProductID, out var otherSuppliers) && otherSuppliers.Count > 0;
                            var isChecked = assignedProductIds.Contains(product.ProductID);
                            var savedPrice = assignmentPrices.GetValueOrDefault(product.ProductID);

                            <label class="assign-product-item @(isChecked ? "selected" : "") @(savingProductAssignment ? "disabled" : "")">
                                <input type="checkbox"
                                       class="mt-1"
                                       checked="@isChecked"
                                       disabled="@savingProductAssignment"
                                       @onchange="() => SelectAssignedProduct(product.ProductID)" />
                                <div class="flex-1 min-w-0">
                                    <div class="font-semibold text-sm text-slate-800 dark:text-slate-100">@product.ProductName</div>
                                    <div class="text-xs text-slate-500 mt-0.5">
                                        Giá bán lẻ: <strong>@product.Price.ToString("N0") đ</strong>
                                        @if (savedPrice > 0)
                                        {
                                            <span> · Giá vốn cũ: <strong class="text-emerald-600">@savedPrice.ToString("N0") đ</strong></span>
                                        }
                                    </div>
                                    @if (hasOtherSuppliers)
                                    {
                                        <div class="text-xs text-slate-400 mt-0.5">Cùng cung cấp bởi: @string.Join(", ", otherSuppliers!)</div>
                                    }
                                </div>
                            </label>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(assignmentMessage))
                {
                    <p class="mt-3 text-sm text-rose-600">@assignmentMessage</p>
                }
            </div>
            <div class="bakery-modal-footer">
                <button type="button" class="bakery-btn bakery-btn-outline" @onclick="CloseProductAssignment" disabled="@savingProductAssignment">Đóng</button>
                <button type="button" class="bakery-btn bakery-btn-primary" @onclick="SaveProductAssignment" disabled="@(savingProductAssignment || productCatalog.Count == 0)">
                    @(savingProductAssignment ? "Đang lưu..." : $"Lưu danh sách ({assignedProductIds.Count} bánh)")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo PriceCulture = System.Globalization.CultureInfo.GetCultureInfo("en-US");
    private List<Supplier> suppliers = [];
    private List<Product> products = [];
    private Dictionary<int, decimal> purchasePrices = [];
    private List<ImportLineInput> lines = [new()];
    private readonly Dictionary<ImportLineInput, string> unitPriceText = [];
    private readonly Dictionary<ImportLineInput, string> linePriceModes = [];
    private int supplierId;
    private int employeeId;
    private string? note;
    private string employeeName = "Đang tải...";
    private string? message;
    private bool saved;
    private bool saving;

    private decimal Total => lines.Sum(line => line.Quantity * line.UnitPrice);

    private int LossWarningLinesCount => lines.Count(line =>
    {
        if (line.ProductID <= 0 || line.UnitPrice <= 0) return false;
        var p = products.FirstOrDefault(x => x.ProductID == line.ProductID);
        return p is not null && p.Price > 0 && line.UnitPrice >= p.Price;
    });

    private string GetPriceMode(ImportLineInput line, bool hasPreviousPrice)
    {
        if (linePriceModes.TryGetValue(line, out var mode))
        {
            if (mode == "saved" && !hasPreviousPrice)
                return "custom";
            return mode;
        }
        return hasPreviousPrice ? "saved" : "custom";
    }

    private void SwitchPriceMode(ImportLineInput line, string mode)
    {
        linePriceModes[line] = mode;
        if (mode == "saved" && line.ProductID > 0 && purchasePrices.TryGetValue(line.ProductID, out var savedPrice) && savedPrice > 0)
        {
            line.UnitPrice = savedPrice;
            unitPriceText[line] = FormatPrice(line.UnitPrice);
        }
        else if (mode == "custom")
        {
            unitPriceText[line] = line.UnitPrice > 0 ? FormatPrice(line.UnitPrice) : string.Empty;
        }
    }

    private string GetUnitPriceText(ImportLineInput line) => unitPriceText.TryGetValue(line, out var value)
        ? value
        : (line.UnitPrice > 0 ? FormatPrice(line.UnitPrice) : string.Empty);

    private static string FormatPrice(decimal value) => value.ToString("#,##0.##", PriceCulture);

    private static bool TryParsePrice(string? value, out decimal price) => decimal.TryParse(
        value?.Replace(",", string.Empty).Replace(".", string.Empty),
        System.Globalization.NumberStyles.Number,
        System.Globalization.CultureInfo.InvariantCulture,
        out price);

    private void UnitPriceChanged(ImportLineInput line, ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? string.Empty;
        unitPriceText[line] = value;
        line.UnitPrice = TryParsePrice(value, out var price) ? price : 0;
    }

    private void FormatUnitPrice(ImportLineInput line) =>
        unitPriceText[line] = line.UnitPrice > 0 ? FormatPrice(line.UnitPrice) : string.Empty;

    private bool CanSave => !saving &&
        employeeId > 0 &&
        supplierId > 0 &&
        lines.Count > 0 &&
        lines.All(line => line.ProductID > 0 && line.Quantity > 0 && line.UnitPrice > 0);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!int.TryParse(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var accountId))
        {
            employeeName = "Không xác định được tài khoản đăng nhập";
            message = "Không thể xác định tài khoản đang đăng nhập để lập phiếu.";
            saved = false;
            return;
        }

        var profile = await EmployeeManager.GetProfileAsync(accountId);
        if (profile is null)
        {
            employeeName = "Chưa có hồ sơ nhân viên";
            message = "Tài khoản hiện tại chưa được liên kết với hồ sơ nhân viên.";
            saved = false;
            return;
        }

        employeeId = profile.Value.Employee.EmployeeID;
        employeeName = profile.Value.Employee.FullName;
        await Load();
    }

    private async Task Load()
    {
        suppliers = await Inventory.GetActiveSuppliersAsync();
    }

    private async Task SupplierChanged(ChangeEventArgs args)
    {
        int.TryParse(args.Value?.ToString(), out supplierId);
        products = supplierId > 0
            ? await Inventory.GetProductsForSupplierAsync(supplierId)
            : [];
        purchasePrices = supplierId > 0
            ? await Inventory.GetSupplierProductPricesAsync(supplierId)
            : [];

        var allowedIds = products.Select(product => product.ProductID).ToHashSet();
        var clearedLineCount = 0;
        foreach (var line in lines.Where(line => line.ProductID > 0 && !allowedIds.Contains(line.ProductID)))
        {
            line.ProductID = 0;
            line.Quantity = 0;
            line.UnitPrice = 0;
            linePriceModes.Remove(line);
            unitPriceText.Remove(line);
            clearedLineCount++;
        }

        message = clearedLineCount > 0
            ? $"Đã làm mới {clearedLineCount} dòng không thuộc nhà cung cấp mới. Vui lòng chọn sản phẩm."
            : null;
        saved = false;
    }

    private bool productAssignmentOpen;
    private bool savingProductAssignment;
    private List<Product> productCatalog = [];
    private HashSet<int> assignedProductIds = [];
    private Dictionary<int, decimal> assignmentPrices = [];
    private Dictionary<int, List<string>> otherSuppliersByProduct = [];
    private string? assignmentMessage;

    private async Task OpenProductAssignment()
    {
        if (supplierId <= 0)
            return;

        assignmentMessage = null;
        productCatalog = await Inventory.GetProductsAsync();
        assignedProductIds = (await Inventory.GetSupplierProductIdsAsync(supplierId)).ToHashSet();
        assignmentPrices = await Inventory.GetSupplierProductPricesAsync(supplierId);
        otherSuppliersByProduct = await Inventory.GetOtherSuppliersByProductAsync(supplierId);
        productAssignmentOpen = true;
    }

    private async Task RefreshProductCatalog()
    {
        productCatalog = await Inventory.GetProductsAsync();
        otherSuppliersByProduct = await Inventory.GetOtherSuppliersByProductAsync(supplierId);
        assignmentMessage = "Đã tải lại danh sách bánh đang kinh doanh.";
    }

    private void SelectAssignedProduct(int productId)
    {
        if (!assignedProductIds.Add(productId))
            assignedProductIds.Remove(productId);
    }

    private async Task SaveProductAssignment()
    {
        if (supplierId <= 0 || savingProductAssignment)
            return;

        savingProductAssignment = true;
        try
        {
            await Inventory.SaveSupplierProductsAsync(supplierId, assignedProductIds, assignmentPrices);
            products = await Inventory.GetProductsForSupplierAsync(supplierId);
            purchasePrices = await Inventory.GetSupplierProductPricesAsync(supplierId);
            var allowedIds = products.Select(product => product.ProductID).ToHashSet();
            foreach (var line in lines.Where(line => line.ProductID > 0 && !allowedIds.Contains(line.ProductID)))
            {
                line.ProductID = 0;
                line.Quantity = 0;
                line.UnitPrice = 0;
                linePriceModes.Remove(line);
                unitPriceText.Remove(line);
            }
            message = "Đã cập nhật danh sách bánh của nhà cung cấp.";
            saved = true;
            productAssignmentOpen = false;
        }
        catch (Exception ex)
        {
            assignmentMessage = ex.Message;
        }
        finally
        {
            savingProductAssignment = false;
        }
    }

    private void CloseProductAssignment() => productAssignmentOpen = false;

    private void AddLine() => lines.Add(new());

    private void RemoveLine(ImportLineInput line)
    {
        lines.Remove(line);
        unitPriceText.Remove(line);
        linePriceModes.Remove(line);
    }

    private void ApplyPurchasePrice(ImportLineInput line)
    {
        if (line.ProductID > 0)
        {
            if (line.Quantity <= 0)
                line.Quantity = 1;

            if (purchasePrices.TryGetValue(line.ProductID, out var purchasePrice) && purchasePrice > 0)
            {
                line.UnitPrice = purchasePrice;
                linePriceModes[line] = "saved";
                unitPriceText[line] = FormatPrice(line.UnitPrice);
            }
            else
            {
                line.UnitPrice = 0;
                linePriceModes[line] = "custom";
                unitPriceText[line] = string.Empty;
            }
        }
        else
        {
            line.Quantity = 0;
            line.UnitPrice = 0;
            linePriceModes.Remove(line);
            unitPriceText.Remove(line);
        }
    }

    private int lastCreatedReceiptId;
    private string savedStatus = string.Empty;

    private async Task Save(string targetStatus = ImportReceiptStatus.Completed)
    {
        if (saving)
            return;

        saving = true;
        try
        {
            lastCreatedReceiptId = await Inventory.SaveReceiptAsync(new()
            {
                SupplierID = supplierId,
                EmployeeID = employeeId,
                Note = note,
                Status = targetStatus,
                Lines = lines
            });

            savedStatus = targetStatus;
            saved = true;
            message = targetStatus == ImportReceiptStatus.Pending
                ? $"Đã lưu phiếu chờ duyệt PN-{lastCreatedReceiptId:D6}. Tồn kho chưa thay đổi cho đến khi bạn duyệt phiếu."
                : $"Đã duyệt nhập kho PN-{lastCreatedReceiptId:D6} và cộng tồn kho thành công.";

            supplierId = 0;
            note = null;
            lines = [new()];
            unitPriceText.Clear();
            linePriceModes.Clear();
            products = [];
            await Load();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            saved = false;
            lastCreatedReceiptId = 0;
        }
        finally
        {
            saving = false;
        }
    }
}
