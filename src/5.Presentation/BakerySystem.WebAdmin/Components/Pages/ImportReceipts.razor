@page "/import-receipts"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Employee")]
@inject InventoryService Inventory
@inject EmployeeService EmployeeManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
<PageTitle>Phiếu nhập kho | BakerySystem</PageTitle>
<div class="bakery-page-header"><div><h2 class="text-2xl font-bold">Lập phiếu nhập kho</h2><p class="text-bodytext">Tạo phiếu nhập mới và cập nhật số lượng tồn kho.</p></div><div class="bakery-page-actions"><a class="bakery-btn bakery-btn-outline bakery-btn-sm" href="/import-receipt-management">Quản lý phiếu đã nhập</a></div></div>
<div class="grid grid-cols-1 xl:grid-cols-2 gap-5 items-start">
<div class="bakery-filter-card min-w-0">
    <div class="grid md:grid-cols-3 gap-3">
        <label>Nhà cung cấp
            <select class="bakery-input w-full" value="@supplierId" @onchange="SupplierChanged" disabled="@saving">
                <option value="0">Chọn nhà cung cấp</option>
                @foreach (var supplier in suppliers) { <option value="@supplier.SupplierID">@supplier.SupplierCode - @supplier.SupplierName</option> }
            </select>
            <AuthorizeView Roles="Admin">
                @if (supplierId > 0)
                {
                    <button type="button" class="mt-2 text-sm text-primary hover:underline" @onclick="OpenProductAssignment" disabled="@saving">
                        Gán / cập nhật bánh của nhà cung cấp này
                    </button>
                }
            </AuthorizeView>
        </label>
        <label>Nhân viên lập phiếu
            <input class="bakery-input w-full" value="@employeeName" readonly />
        </label>
        <label>Ghi chú<input class="bakery-input w-full" @bind="note" disabled="@saving" /></label>
    </div>

    @foreach (var line in lines)
    {
        <div class="grid grid-cols-2 gap-3 mt-3 items-end">
            <label class="col-span-2">Sản phẩm
                <select class="bakery-input w-full" @bind="line.ProductID" disabled="@saving">
                    <option value="0">Chọn sản phẩm</option>
                    @foreach (var product in products) { <option value="@product.ProductID">@product.ProductName (tồn @product.Quantity)</option> }
                </select>
            </label>
            <label>Số lượng<input class="bakery-input w-full" type="number" min="1" @bind="line.Quantity" disabled="@saving" /></label>
            <label>Đơn giá vốn<input class="bakery-input w-full" type="number" min="0" step="1000" @bind="line.UnitPrice" disabled="@saving" /></label>
            <div class="pb-2">
                <span class="block text-xs text-slate-500">Thành tiền</span>
                <strong>@((line.Quantity * line.UnitPrice).ToString("N0")) đ</strong>
            </div>
            <button class="bakery-btn bakery-btn-secondary" @onclick="() => lines.Remove(line)" disabled="@(saving || lines.Count == 1)">Xóa dòng</button>
        </div>
    }

    <div class="flex flex-wrap justify-between items-center mt-4 gap-3">
        <button class="bakery-btn bakery-btn-secondary" @onclick="AddLine" disabled="@saving">+ Thêm sản phẩm</button>
        <div class="flex items-center gap-4">
            <strong>Tổng tiền: @Total.ToString("N0") đ</strong>
            <button class="bakery-btn bakery-btn-primary" @onclick="Save" disabled="@(saving || employeeId <= 0)">
                @(saving ? "Đang lưu..." : "Lưu phiếu nhập")
            </button>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(message))
    {
        <p class="mt-3 text-sm @(saved ? "text-emerald-600" : "text-rose-600")">@message</p>
    }
</div>

</div>

@if (productAssignmentOpen)
{
    var selectedSupplier = suppliers.FirstOrDefault(supplier => supplier.SupplierID == supplierId);
    <div class="bakery-modal-backdrop" @onclick="CloseProductAssignment">
        <div class="bakery-modal-card max-w-2xl" @onclick:stopPropagation="true">
            <div class="bakery-modal-header">
                <div>
                    <h4 class="text-base font-bold text-slate-900 dark:text-white mb-0">Chọn bánh nhà cung cấp có thể giao</h4>
                    <p class="text-xs text-slate-500 mb-0">@(selectedSupplier is null ? "" : $"{selectedSupplier.SupplierCode} - {selectedSupplier.SupplierName}")</p>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 text-lg" @onclick="CloseProductAssignment" aria-label="Đóng">×</button>
            </div>
            <div class="bakery-modal-body">
                <div class="mb-4 flex flex-wrap items-center justify-between gap-2 rounded-lg bg-slate-50 p-3 text-sm">
                    <span>Mỗi bánh chỉ thuộc một nhà cung cấp. Chưa có bánh trong danh sách? Tạo bánh trước, rồi tải lại.</span>
                    <div class="flex gap-2">
                        <a class="bakery-btn bakery-btn-secondary bakery-btn-sm" href="/products" target="_blank" rel="noopener">Mở Menu &amp; Bánh ngọt</a>
                        <button type="button" class="bakery-btn bakery-btn-secondary bakery-btn-sm" @onclick="RefreshProductCatalog">Tải lại danh sách</button>
                    </div>
                </div>

                @if (productCatalog.Count == 0)
                {
                    <p class="py-4 text-center text-sm text-slate-500">Chưa có sản phẩm đang kinh doanh. Hãy tạo bánh trong Menu &amp; Bánh ngọt trước.</p>
                }
                else
                {
                    <div class="grid max-h-80 grid-cols-1 gap-2 overflow-y-auto sm:grid-cols-2">
                        @foreach (var product in productCatalog)
                        {
                            <label class="flex items-center gap-2 rounded-lg border border-slate-200 p-3">
                                <input type="radio" name="receipt-supplier-product" checked="@assignedProductIds.Contains(product.ProductID)" @onchange="() => SelectAssignedProduct(product.ProductID)" disabled="@savingProductAssignment" />
                                <span>@product.ProductName</span>
                            </label>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(assignmentMessage))
                {
                    <p class="mt-3 text-sm text-rose-600">@assignmentMessage</p>
                }
            </div>
            <div class="bakery-modal-footer">
                <button type="button" class="bakery-btn bakery-btn-outline" @onclick="CloseProductAssignment" disabled="@savingProductAssignment">Đóng</button>
                <button type="button" class="bakery-btn bakery-btn-primary" @onclick="SaveProductAssignment" disabled="@(savingProductAssignment || productCatalog.Count == 0)">
                    @(savingProductAssignment ? "Đang lưu..." : "Lưu và tiếp tục nhập")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Supplier> suppliers = [];
    private List<Product> products = [];
    private List<ImportReceipt> receipts = [];
    private List<ImportLineInput> lines = [new()];
    private int supplierId;
    private int employeeId;
    private string? note;
    private string employeeName = "Đang tải...";
    private string? message;
    private bool saved;
    private bool saving;
    private const int pageSize = 10;
    private int currentPage = 1;
    private string receiptSearch = string.Empty;
    private DateTime? receiptFrom;
    private DateTime? receiptTo;

    private decimal Total => lines.Sum(line => line.Quantity * line.UnitPrice);
    private IEnumerable<ImportReceipt> FilteredReceipts => receipts.Where(receipt =>
        (!receiptFrom.HasValue || receipt.ReceiptDate.Date >= receiptFrom.Value.Date) &&
        (!receiptTo.HasValue || receipt.ReceiptDate.Date <= receiptTo.Value.Date) &&
        (string.IsNullOrWhiteSpace(receiptSearch) ||
         ($"PN-{receipt.ReceiptID:D6} {receipt.Supplier?.SupplierCode} {receipt.Supplier?.SupplierName} {receipt.Employee?.FullName} " +
          $"{string.Join(" ", receipt.ImportReceiptDetails.Select(detail => detail.Product?.ProductName))}")
             .Contains(receiptSearch.Trim(), StringComparison.OrdinalIgnoreCase)));
    private int PageCount => Math.Max(1, (int)Math.Ceiling(FilteredReceipts.Count() / (double)pageSize));
    private IEnumerable<ImportReceipt> PagedReceipts => FilteredReceipts.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private void ResetReceiptPage() => currentPage = 1;

    private void ResetReceiptSearch()
    {
        receiptSearch = string.Empty;
        receiptFrom = null;
        receiptTo = null;
        currentPage = 1;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!int.TryParse(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var accountId))
        {
            employeeName = "Không xác định được tài khoản đăng nhập";
            message = "Không thể xác định tài khoản đang đăng nhập để lập phiếu.";
            saved = false;
            return;
        }

        var profile = await EmployeeManager.GetProfileAsync(accountId);
        if (profile is null)
        {
            employeeName = "Chưa có hồ sơ nhân viên";
            message = "Tài khoản hiện tại chưa được liên kết với hồ sơ nhân viên.";
            saved = false;
            return;
        }

        employeeId = profile.Value.Employee.EmployeeID;
        employeeName = profile.Value.Employee.FullName;
        await Load();
    }

    private async Task Load()
    {
        suppliers = await Inventory.GetActiveSuppliersAsync();
        receipts = await Inventory.GetReceiptsAsync();
    }

    private async Task SupplierChanged(ChangeEventArgs args)
    {
        int.TryParse(args.Value?.ToString(), out supplierId);
        products = supplierId > 0
            ? await Inventory.GetProductsForSupplierAsync(supplierId)
            : [];

        var allowedIds = products.Select(product => product.ProductID).ToHashSet();
        var clearedLineCount = 0;
        foreach (var line in lines.Where(line => line.ProductID > 0 && !allowedIds.Contains(line.ProductID)))
        {
            line.ProductID = 0;
            line.Quantity = 0;
            line.UnitPrice = 0;
            clearedLineCount++;
        }

        message = supplierId > 0 && products.Count == 0
            ? "Nhà cung cấp này chưa được gán bánh. Bấm “Gán / cập nhật bánh” ngay dưới ô nhà cung cấp để thiết lập."
            : clearedLineCount > 0
                ? $"Đã xóa sản phẩm và số liệu ở {clearedLineCount} dòng không thuộc nhà cung cấp mới. Vui lòng chọn lại sản phẩm."
                : null;
        saved = false;
    }

    private bool productAssignmentOpen;
    private bool savingProductAssignment;
    private List<Product> productCatalog = [];
    private HashSet<int> assignedProductIds = [];
    private string? assignmentMessage;

    private async Task OpenProductAssignment()
    {
        if (supplierId <= 0)
            return;

        assignmentMessage = null;
        productCatalog = await Inventory.GetProductsAsync();
        assignedProductIds = (await Inventory.GetSupplierProductIdsAsync(supplierId)).ToHashSet();
        productAssignmentOpen = true;
    }

    private async Task RefreshProductCatalog()
    {
        productCatalog = await Inventory.GetProductsAsync();
        assignmentMessage = "Đã tải lại danh sách bánh đang kinh doanh.";
    }

    private void SelectAssignedProduct(int productId) => assignedProductIds = [productId];

    private async Task SaveProductAssignment()
    {
        if (supplierId <= 0 || savingProductAssignment)
            return;

        savingProductAssignment = true;
        try
        {
            await Inventory.SaveSupplierProductsAsync(supplierId, assignedProductIds);
            products = await Inventory.GetProductsForSupplierAsync(supplierId);
            var allowedIds = products.Select(product => product.ProductID).ToHashSet();
            foreach (var line in lines.Where(line => line.ProductID > 0 && !allowedIds.Contains(line.ProductID)))
            {
                line.ProductID = 0;
                line.Quantity = 0;
                line.UnitPrice = 0;
            }
            message = "Đã cập nhật danh sách bánh. Bạn có thể tiếp tục chọn bánh để lập phiếu.";
            saved = true;
            productAssignmentOpen = false;
        }
        catch (Exception ex)
        {
            assignmentMessage = ex.Message;
        }
        finally
        {
            savingProductAssignment = false;
        }
    }

    private void CloseProductAssignment() => productAssignmentOpen = false;

    private void AddLine() => lines.Add(new());

    private void PreviousReceiptPage() => currentPage = Math.Max(1, currentPage - 1);

    private void NextReceiptPage() => currentPage = Math.Min(PageCount, currentPage + 1);

    private async Task Save()
    {
        if (saving)
            return;

        saving = true;
        try
        {
            await Inventory.SaveReceiptAsync(new()
            {
                SupplierID = supplierId,
                EmployeeID = employeeId,
                Note = note,
                Lines = lines
            });

            message = "Đã lưu phiếu và cập nhật tồn kho.";
            saved = true;
            supplierId = 0;
            note = null;
            lines = [new()];
            products = [];
            currentPage = 1;
            await Load();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            saved = false;
        }
        finally
        {
            saving = false;
        }
    }
}
