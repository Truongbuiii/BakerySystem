@page "/pos"
@rendermode InteractiveServer
@inject IBakeryDbContext Context
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Bán Hàng Tại Quầy (POS) | BakerySystem</PageTitle>

<div class="space-y-3">
    <!-- 1. Header trang POS -->
    <div class="bakery-page-header pb-2 border-b border-border dark:border-darkborder flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <div class="flex items-center gap-2 text-xs text-slate-500 mb-0.5">
                <a href="/" class="hover:text-primary flex items-center gap-1">
                    <iconify-icon icon="solar:home-2-linear"></iconify-icon> Trang chủ
                </a>
                <span>/</span>
                <span class="text-slate-800 dark:text-slate-200 font-semibold">Bán hàng tại quầy</span>
            </div>
            <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2 mb-0">
                <iconify-icon icon="solar:cart-large-minimalistic-bold" class="text-primary"></iconify-icon>
                Màn Hình Bán Hàng Tại Quầy (POS)
            </h2>
        </div>

        <div class="flex items-center gap-2.5">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300 text-xs font-medium border border-blue-200 dark:border-blue-800">
                <iconify-icon icon="solar:user-linear" class="text-sm"></iconify-icon>
                <span>Thu ngân: <strong>@currentUserName</strong></span>
            </span>
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-xs font-mono">
                @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </span>
        </div>
    </div>

    <!-- 2. Bố cục 2 Cột chuẩn POS: Trái 65% (Chọn bánh), Phải 35% (Hóa đơn) -->
    <div class="bakery-pos-container">
        
        <!-- ================= CỘT TRÁI: CHỌN MÓN BÁNH ================= -->
        <div class="bakery-pos-left">
            
            <!-- Bộ lọc & Tìm kiếm -->
            <div class="bakery-pos-filter-card">
                <div class="flex gap-2 items-center">
                    <div class="bakery-search-input-wrap">
                        <iconify-icon icon="solar:magnifer-linear"></iconify-icon>
                        <input type="text" 
                               class="bakery-search-input"
                               placeholder="Tìm nhanh tên món bánh, mã sản phẩm..."
                               @bind="searchQuery" 
                               @bind:event="oninput" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(searchQuery) || selectedCategoryId != 0)
                    {
                        <button type="button" 
                                class="bakery-btn bakery-btn-outline shrink-0 text-xs px-2.5" 
                                style="height: 38px;"
                                @onclick="ResetFilters"
                                title="Xóa bộ lọc">
                            <iconify-icon icon="solar:restart-linear"></iconify-icon>
                            <span>Xóa lọc</span>
                        </button>
                    }
                </div>

                <!-- Tabs chọn Loại sản phẩm -->
                <div class="bakery-pos-cats">
                    <button type="button" 
                            class="bakery-pos-cat-pill @(selectedCategoryId == 0 ? "active" : "")"
                            @onclick="() => SelectCategory(0)">
                        Tất cả (@products.Count)
                    </button>
                    @foreach (var cat in categories)
                    {
                        var count = products.Count(p => p.CategoryID == cat.CategoryID);
                        <button type="button" 
                                class="bakery-pos-cat-pill @(selectedCategoryId == cat.CategoryID ? "active" : "")"
                                @onclick="() => SelectCategory(cat.CategoryID)">
                            @cat.CategoryName (@count)
                        </button>
                    }
                </div>
            </div>

            <!-- Lưới danh sách món bánh -->
            @if (filteredProducts.Count == 0)
            {
                <div class="bakery-card p-10 text-center text-slate-400">
                    <iconify-icon icon="solar:box-minimalistic-linear" class="text-4xl text-slate-300 mb-2"></iconify-icon>
                    <p class="text-sm font-semibold mb-0">Không tìm thấy món bánh nào phù hợp</p>
                    <p class="text-xs mb-0">Vui lòng thử tìm kiếm với từ khóa khác.</p>
                </div>
            }
            else
            {
                <div class="bakery-pos-grid">
                    @foreach (var prod in filteredProducts)
                    {
                        bool isOutOfStock = prod.Quantity <= 0;
                        var inCartItem = cart.FirstOrDefault(i => i.Product.ProductID == prod.ProductID);

                        <div class="bakery-pos-card @(isOutOfStock ? "opacity-60" : "")">
                            <div>
                                <!-- Khung ảnh chuẩn khống chế kích thước cố định 120px -->
                                <div class="bakery-pos-img-box">
                                    <img src="@(string.IsNullOrWhiteSpace(prod.ImageURL) ? "/assets/images/products/default-bakery.svg" : prod.ImageURL)" 
                                         alt="@prod.ProductName"
                                         class="bakery-pos-img"
                                         onerror="this.src='/assets/images/products/default-bakery.svg'" />
                                    
                                    @if (isOutOfStock)
                                    {
                                        <div class="absolute inset-0 bg-black/60 flex items-center justify-center">
                                            <span class="px-2 py-0.5 rounded bg-red-600 text-white text-[10px] font-bold uppercase tracking-wider">
                                                Hết hàng
                                            </span>
                                        </div>
                                    }
                                    else if (inCartItem != null)
                                    {
                                        <span class="bakery-pos-cart-badge">
                                            Đã chọn: @inCartItem.Quantity
                                        </span>
                                    }
                                </div>

                                <!-- Tiêu đề & Loại bánh -->
                                <div class="bakery-pos-card-title" title="@prod.ProductName">
                                    @prod.ProductName
                                </div>
                                <div class="bakery-pos-card-cat">
                                    @prod.Category?.CategoryName
                                </div>
                            </div>

                            <div>
                                <!-- Giá & Tồn kho -->
                                <div class="bakery-pos-card-footer">
                                    <span class="bakery-pos-card-price">
                                        @($"{prod.Price:N0}đ")
                                    </span>
                                    <span class="bakery-pos-card-stock @(isOutOfStock ? "danger" : (prod.Quantity <= 5 ? "warning" : ""))">
                                        @(isOutOfStock ? "Hết" : $"Còn {prod.Quantity}")
                                    </span>
                                </div>

                                <!-- Nút chọn món -->
                                <button type="button" 
                                        class="bakery-pos-btn-add"
                                        disabled="@isOutOfStock"
                                        @onclick="() => AddToCart(prod)">
                                    <iconify-icon icon="solar:cart-plus-linear" class="text-sm"></iconify-icon>
                                    <span>@(isOutOfStock ? "Hết hàng" : "Chọn món")</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ================= CỘT PHẢI: HÓA ĐƠN & GIỎ HÀNG ================= -->
        <div class="bakery-pos-right">
            <div class="bakery-pos-cart-box">
                <!-- Tiêu đề hóa đơn -->
                <div class="bakery-pos-cart-header">
                    <div class="flex items-center gap-2">
                        <iconify-icon icon="solar:bill-check-bold" class="text-primary text-xl"></iconify-icon>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-0">Hóa Đơn Quầy</h3>
                        <span class="bakery-badge bakery-badge-primary text-[10px]">@cart.Sum(i => i.Quantity) món</span>
                    </div>

                    @if (cart.Count > 0)
                    {
                        <button type="button" 
                                class="text-xs text-red-600 hover:text-red-700 flex items-center gap-1 font-medium" 
                                @onclick="ClearCart"
                                title="Xóa toàn bộ giỏ">
                            <iconify-icon icon="solar:trash-bin-trash-linear"></iconify-icon>
                            <span>Hủy đơn</span>
                        </button>
                    }
                </div>

                <!-- Thông tin khách & Kênh bán (Card riêng biệt) -->
                <div class="bakery-pos-customer-banner">
                    <div class="bakery-pos-customer-row">
                        <span class="text-slate-500 font-medium">Khách hàng:</span>
                        <span class="font-bold text-slate-800 dark:text-white">Khách mua tại quầy</span>
                    </div>
                    <div class="bakery-pos-customer-row">
                        <span class="text-slate-500">Kênh bán:</span>
                        <span class="text-emerald-600 dark:text-emerald-400 font-semibold flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block"></span>
                            Trực tiếp tại quầy POS
                        </span>
                    </div>
                </div>

                <!-- Danh sách món đã chọn trong giỏ -->
                <div class="bakery-pos-cart-list scrollbar-thin">
                    @if (cart.Count == 0)
                    {
                        <div class="bakery-pos-cart-empty">
                            <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center">
                                <iconify-icon icon="solar:cart-large-minimalistic-linear" class="text-2xl"></iconify-icon>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-slate-700 dark:text-slate-300 mb-0.5">Giỏ hàng đang trống</p>
                                <p class="text-[11px] text-slate-400 mb-0">Bấm "Chọn món" bên trái để lên đơn.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in cart)
                        {
                            <div class="bakery-pos-cart-item">
                                <div class="min-w-0 flex-1">
                                    <div class="text-xs font-semibold text-slate-800 dark:text-white truncate mb-0.5" title="@item.Product.ProductName">
                                        @item.Product.ProductName
                                    </div>
                                    <div class="text-[11px] text-blue-600 dark:text-blue-400 font-medium">
                                        @($"{item.Product.Price:N0}đ")
                                    </div>
                                </div>

                                <!-- Bộ nút tăng / giảm số lượng -->
                                <div class="bakery-pos-qty-wrap shrink-0">
                                    <button type="button" 
                                            class="bakery-pos-qty-btn"
                                            @onclick="() => UpdateQuantity(item, -1)"
                                            title="Giảm">-</button>
                                    <span class="text-xs font-bold w-6 text-center text-slate-800 dark:text-white">@item.Quantity</span>
                                    <button type="button" 
                                            class="bakery-pos-qty-btn"
                                            @onclick="() => UpdateQuantity(item, 1)"
                                            title="Tăng">+</button>
                                </div>

                                <!-- Thành tiền & Nút xóa -->
                                <div class="text-right shrink-0 flex items-center gap-2">
                                    <span class="text-xs font-bold text-slate-900 dark:text-white">
                                        @($"{item.SubTotal:N0}đ")
                                    </span>
                                    <button type="button" 
                                            class="text-slate-400 hover:text-red-500 transition-colors p-0.5" 
                                            @onclick="() => RemoveFromCart(item)"
                                            title="Xóa món">
                                        <iconify-icon icon="solar:trash-bin-trash-linear" class="text-sm"></iconify-icon>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Nhập mã Voucher -->
                <div class="space-y-1.5">
                    <div class="bakery-pos-voucher-wrap">
                        <input type="text" 
                               class="bakery-pos-voucher-input uppercase"
                               placeholder="Mã voucher (VD: BAKERY2026)"
                               @bind="voucherCode" 
                               @onkeydown="@(async e => { if (e.Key == "Enter") await ApplyVoucher(); })" />
                        <button type="button" 
                                class="bakery-pos-voucher-btn"
                                @onclick="ApplyVoucher">
                            Áp dụng
                        </button>
                    </div>

                    <!-- Gợi ý các voucher đang có trong hệ thống -->
                    @if (availablePromotions.Any())
                    {
                        <div class="flex items-center gap-1.5 flex-wrap pt-0.5">
                            <span class="text-[10px] text-slate-400 font-medium">Mã có sẵn:</span>
                            @foreach (var promo in availablePromotions)
                            {
                                var isChosen = appliedPromo?.PromotionCode.Equals(promo.PromotionCode, StringComparison.OrdinalIgnoreCase) == true;
                                var discountPct = promo.PromotionInvoice?.DiscountPercent ?? 0;
                                <button type="button" 
                                        class="text-[10px] px-2 py-0.5 rounded-full border transition-all flex items-center gap-1 @(isChosen ? "bg-emerald-50 text-emerald-700 border-emerald-300 font-bold dark:bg-emerald-950/40 dark:text-emerald-300" : "bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-primary hover:text-primary")"
                                        @onclick="() => SelectPromotion(promo)">
                                    <iconify-icon icon="solar:ticket-sale-linear" class="text-xs"></iconify-icon>
                                    <span>@promo.PromotionCode</span>
                                    <span class="opacity-75">(-@($"{discountPct:0}%"))</span>
                                </button>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(voucherMessage))
                    {
                        <div class="text-[11px] @(discountAmount > 0 ? "text-emerald-600 font-semibold" : "text-red-500 font-medium") px-1 flex items-center justify-between">
                            <span>@voucherMessage</span>
                            @if (appliedPromo != null)
                            {
                                <button type="button" 
                                        class="text-red-500 hover:underline text-[10px] ml-2" 
                                        @onclick="RemoveVoucher">
                                    Bỏ chọn
                                </button>
                            }
                        </div>
                    }
                </div>

                <!-- Bảng tóm tắt tiền hóa đơn (Rộng rãi, tách biệt, dễ nhìn) -->
                <div class="bakery-pos-bill-summary">
                    <div class="bakery-pos-summary-row">
                        <span>Tạm tính tiền bánh:</span>
                        <span class="font-semibold text-slate-800 dark:text-white">@($"{totalAmount:N0} đ")</span>
                    </div>
                    @if (discountAmount > 0)
                    {
                        <div class="bakery-pos-summary-row" style="color: #059669 !important;">
                            <span>Giảm giá voucher:</span>
                            <span class="font-bold">-@($"{discountAmount:N0} đ")</span>
                        </div>
                    }
                    <div class="bakery-pos-summary-divider"></div>
                    <div class="bakery-pos-summary-total">
                        <span>Khách cần trả:</span>
                        <span class="bakery-pos-summary-total-val">
                            @($"{finalAmount:N0} đ")
                        </span>
                    </div>
                </div>

                <!-- Phương thức thanh toán -->
                <div class="bakery-pos-payment-wrap">
                    <label class="bakery-pos-payment-label">Phương thức thanh toán:</label>
                    <div class="bakery-pos-payment-grid">
                        <button type="button" 
                                class="bakery-pos-payment-btn @(paymentMethod == "Cash" ? "active" : "")"
                                @onclick='() => paymentMethod = "Cash"'>
                            <iconify-icon icon="solar:wallet-money-linear" class="text-base"></iconify-icon>
                            <span>Tiền mặt</span>
                        </button>
                        <button type="button" 
                                class="bakery-pos-payment-btn @(paymentMethod == "BankTransfer" ? "active" : "")"
                                @onclick='() => paymentMethod = "BankTransfer"'>
                            <iconify-icon icon="solar:qr-code-linear" class="text-base"></iconify-icon>
                            <span>Chuyển khoản QR</span>
                        </button>
                    </div>
                </div>

                <!-- Nút Thanh toán & In Hóa đơn -->
                <button type="button" 
                        class="bakery-pos-checkout-btn"
                        disabled="@(cart.Count == 0 || isProcessing)"
                        @onclick="HandleCheckout">
                    @if (isProcessing)
                    {
                        <span class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        <span>Đang lưu đơn hàng...</span>
                    }
                    else
                    {
                        <iconify-icon icon="solar:printer-linear" class="text-lg"></iconify-icon>
                        <span>Thanh toán & In hóa đơn</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL THANH TOÁN THÀNH CÔNG ================= -->
@if (isSuccessModalOpen)
{
    <div class="bakery-modal-backdrop" @onclick="() => isSuccessModalOpen = false">
        <div class="bakery-modal-card p-6 text-center" style="max-width: 440px;" @onclick:stopPropagation="true">
            <div class="w-14 h-14 rounded-full bg-emerald-100 text-emerald-600 mx-auto flex items-center justify-center mb-3">
                <iconify-icon icon="solar:check-circle-bold" class="text-3xl"></iconify-icon>
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1">Thanh toán thành công!</h3>
            <p class="text-xs text-slate-500 mb-3">
                Hóa đơn <strong class="text-primary font-mono font-bold">#HD-@lastCreatedOrderId.ToString("D4")</strong> đã được tạo thành công, tự động trừ số lượng tồn kho và lưu vào hệ thống.
            </p>

            <div class="bg-slate-50 dark:bg-slate-900 p-3 rounded-lg text-xs space-y-1.5 mb-4 text-left font-mono border border-slate-200 dark:border-slate-800">
                <div class="flex justify-between">
                    <span class="text-slate-500">Mã đơn:</span>
                    <span class="font-bold text-slate-800 dark:text-white">#HD-@lastCreatedOrderId.ToString("D4")</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-500">Số tiền:</span>
                    <span class="font-bold text-blue-600">@($"{lastFinalAmount:N0} đ")</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-500">Thanh toán:</span>
                    <span class="text-emerald-600 font-semibold">@(paymentMethod == "Cash" ? "Tiền mặt" : "Chuyển khoản QR") (Đã thu)</span>
                </div>
            </div>

            <div class="flex gap-2">
                <button type="button" 
                        class="bakery-btn bakery-btn-secondary flex-1 text-xs"
                        @onclick="() => isSuccessModalOpen = false">
                    Tạo đơn mới
                </button>
                <a href="orders" class="bakery-btn bakery-btn-primary flex-1 text-xs flex items-center justify-center gap-1">
                    <span>Xem danh sách đơn</span>
                </a>
            </div>
        </div>
    </div>
}

@code {
    private List<Category> categories = new();
    private List<Product> products = new();
    private List<PosCartItem> cart = new();
    private List<Promotion> availablePromotions = new();
    private Promotion? appliedPromo;

    private string searchQuery = "";
    private int selectedCategoryId = 0;
    private string voucherCode = "";
    private string? voucherMessage;
    private decimal discountAmount = 0;
    private string paymentMethod = "Cash";
    private bool isProcessing = false;
    private bool isSuccessModalOpen = false;
    private int lastCreatedOrderId = 0;
    private decimal lastFinalAmount = 0;
    private string currentUserName = "Nhân viên";

    private decimal totalAmount => cart.Sum(i => i.SubTotal);
    private decimal finalAmount => Math.Max(0, totalAmount - discountAmount);

    private List<Product> filteredProducts => products
        .Where(p => selectedCategoryId == 0 || p.CategoryID == selectedCategoryId)
        .Where(p => string.IsNullOrWhiteSpace(searchQuery) || 
                    p.ProductName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserName = authState.User.FindFirst("FullName")?.Value 
                          ?? authState.User.Identity?.Name 
                          ?? "Nhân viên";

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        categories = await Context.Categories.OrderBy(c => c.CategoryName).ToListAsync();
        products = await Context.Products
            .Include(p => p.Category)
            .Where(p => p.IsActive)
            .OrderBy(p => p.ProductName)
            .ToListAsync();

        availablePromotions = await Context.Promotions
            .Include(p => p.PromotionInvoice)
            .Where(p => p.Status == PromotionStatus.Active)
            .OrderByDescending(p => p.PromotionInvoice != null ? p.PromotionInvoice.DiscountPercent : 0)
            .ToListAsync();
    }

    private void SelectCategory(int categoryId)
    {
        selectedCategoryId = categoryId;
    }

    private void ResetFilters()
    {
        searchQuery = "";
        selectedCategoryId = 0;
    }

    private void AddToCart(Product product)
    {
        if (product.Quantity <= 0) return;

        var existing = cart.FirstOrDefault(i => i.Product.ProductID == product.ProductID);
        if (existing != null)
        {
            if (existing.Quantity < product.Quantity)
            {
                existing.Quantity++;
            }
        }
        else
        {
            cart.Add(new PosCartItem
            {
                Product = product,
                Quantity = 1
            });
        }
        RecalculateDiscount();
    }

    private void UpdateQuantity(PosCartItem item, int delta)
    {
        var newQty = item.Quantity + delta;
        if (newQty <= 0)
        {
            cart.Remove(item);
        }
        else if (newQty <= item.Product.Quantity)
        {
            item.Quantity = newQty;
        }
        RecalculateDiscount();
    }

    private void RemoveFromCart(PosCartItem item)
    {
        cart.Remove(item);
        RecalculateDiscount();
    }

    private void ClearCart()
    {
        cart.Clear();
        voucherCode = "";
        appliedPromo = null;
        discountAmount = 0;
        voucherMessage = null;
    }

    private async Task SelectPromotion(Promotion promo)
    {
        voucherCode = promo.PromotionCode;
        await ApplyVoucher();
    }

    private void RemoveVoucher()
    {
        voucherCode = "";
        appliedPromo = null;
        discountAmount = 0;
        voucherMessage = null;
    }

    private async Task ApplyVoucher()
    {
        if (string.IsNullOrWhiteSpace(voucherCode))
        {
            RemoveVoucher();
            return;
        }

        var code = voucherCode.Trim().ToUpper();
        var promo = await Context.Promotions
            .Include(p => p.PromotionInvoice)
            .FirstOrDefaultAsync(p => p.PromotionCode.ToUpper() == code && p.Status == PromotionStatus.Active);

        if (promo == null)
        {
            appliedPromo = null;
            discountAmount = 0;
            voucherMessage = "Mã ưu đãi không tồn tại hoặc đã hết hiệu lực.";
            return;
        }

        if (promo.StartDate > DateTime.Now || promo.EndDate < DateTime.Now)
        {
            appliedPromo = null;
            discountAmount = 0;
            voucherMessage = "Mã ưu đãi này chưa bắt đầu hoặc đã hết hạn sử dụng.";
            return;
        }

        appliedPromo = promo;
        RecalculateDiscount();
    }

    private void RecalculateDiscount()
    {
        if (appliedPromo?.PromotionInvoice == null)
        {
            discountAmount = 0;
            return;
        }

        var inv = appliedPromo.PromotionInvoice;
        if (totalAmount < inv.MinOrderAmount)
        {
            discountAmount = 0;
            voucherMessage = $"Mã {appliedPromo.PromotionCode} yêu cầu đơn từ {inv.MinOrderAmount:N0}đ (hiện có: {totalAmount:N0}đ).";
            return;
        }

        var discount = totalAmount * (inv.DiscountPercent / 100m);
        if (inv.MaxDiscountAmount.HasValue && inv.MaxDiscountAmount.Value > 0 && discount > inv.MaxDiscountAmount.Value)
        {
            discount = inv.MaxDiscountAmount.Value;
        }

        discountAmount = Math.Round(discount, 0);
        voucherMessage = $"Đã áp dụng mã {appliedPromo.PromotionCode}: Giảm {inv.DiscountPercent:0}% (-{discountAmount:N0}đ)";
    }

    private async Task HandleCheckout()
    {
        if (cart.Count == 0 || isProcessing) return;

        isProcessing = true;
        try
        {
            // 1. Tìm hoặc lấy khách hàng mua tại quầy
            var customer = await Context.Customers.FirstOrDefaultAsync(c => c.AccountID == null);
            if (customer == null)
            {
                customer = await Context.Customers.FirstOrDefaultAsync();
            }

            if (customer == null)
            {
                customer = new Customer
                {
                    FullName = "Khách mua tại quầy POS",
                    Phone = "0900000000",
                    Address = "Mua trực tiếp tại tiệm bánh"
                };
                Context.Customers.Add(customer);
                await Context.SaveChangesAsync();
            }

            // 2. Tìm EmployeeID nếu có
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name;
            int? employeeId = null;
            if (!string.IsNullOrEmpty(username))
            {
                var emp = await Context.Employees
                    .Include(e => e.Account)
                    .FirstOrDefaultAsync(e => e.Account.Username == username);
                if (emp != null) employeeId = emp.EmployeeID;
            }

            // 3. Tạo Order
            var order = new Order
            {
                CustomerID = customer.CustomerID,
                EmployeeID = employeeId,
                PromotionID = appliedPromo?.PromotionID,
                OrderDate = DateTime.Now,
                TotalAmount = totalAmount,
                DiscountAmount = discountAmount,
                FinalAmount = finalAmount,
                PaymentMethod = paymentMethod,
                PaymentStatus = "Paid",
                Status = "Completed",
                ReceiverName = "Khách tại quầy",
                ReceiverPhone = customer.Phone,
                ShippingAddress = "Nhận tại quầy BakerySystem",
                Note = "Bán lẻ tại quầy POS"
            };

            Context.Orders.Add(order);
            await Context.SaveChangesAsync();

            // 4. Tạo OrderDetails & Trừ tồn kho
            foreach (var item in cart)
            {
                var detail = new OrderDetail
                {
                    OrderID = order.OrderID,
                    ProductID = item.Product.ProductID,
                    Quantity = item.Quantity,
                    UnitPrice = item.Product.Price,
                    DiscountAmount = 0,
                    SubTotal = item.SubTotal
                };
                Context.OrderDetails.Add(detail);

                // Trừ tồn kho
                var dbProd = await Context.Products.FindAsync(item.Product.ProductID);
                if (dbProd != null)
                {
                    dbProd.Quantity = Math.Max(0, dbProd.Quantity - item.Quantity);
                }
            }

            await Context.SaveChangesAsync();

            lastCreatedOrderId = order.OrderID;
            lastFinalAmount = order.FinalAmount;
            isSuccessModalOpen = true;

            // Xóa giỏ hàng & tải lại tồn kho mới nhất
            ClearCart();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Lỗi trong quá trình thanh toán: " + ex.Message);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private class PosCartItem
    {
        public Product Product { get; set; } = null!;
        public int Quantity { get; set; } = 1;
        public decimal SubTotal => Product.Price * Quantity;
    }
}
