@page "/employees"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject EmployeeService EmployeeManager
<PageTitle>Quản lý nhân sự | BakerySystem</PageTitle>
<div class="bakery-page-header"><div><h2 class="text-2xl font-bold">Quản lý nhân sự</h2><p class="text-bodytext">Quản lý hồ sơ, vị trí và quyền truy cập tài khoản nhân viên.</p></div><button class="bakery-btn bakery-btn-primary" @onclick="NewEmployee">+ Thêm nhân viên</button></div>
@if(formOpen){<div class="bakery-filter-card mb-5"><h3 class="font-bold mb-4">@(form.EmployeeID == 0 ? "Tạo nhân viên và tài khoản" : "Chỉnh sửa nhân viên")</h3><div class="grid md:grid-cols-3 gap-4"><label>Họ tên<input class="bakery-input w-full" @bind="form.FullName" /></label><label>Số điện thoại<input class="bakery-input w-full" @bind="form.Phone" /></label><label>Vị trí<select class="bakery-input w-full" @bind="form.Position"><option>Bếp bánh</option><option>Thu ngân</option><option>Quản lý</option></select></label><label>Tên đăng nhập<input class="bakery-input w-full" autocomplete="off" @bind="form.Username" /></label><label>Mật khẩu @(form.EmployeeID == 0 ? "ban đầu" : "mới (để trống nếu giữ nguyên)")<input class="bakery-input w-full" type="password" autocomplete="new-password" @bind="form.Password" /></label>@if(form.EmployeeID != 0){<label>Trạng thái tài khoản<select class="bakery-input w-full" @bind="form.Status"><option value="Active">Đang hoạt động</option><option value="Inactive">Đã khóa</option></select></label>}</div>@if(!string.IsNullOrEmpty(message)){<p class="mt-3 text-sm text-rose-600">@message</p>}<div class="flex justify-end gap-2 mt-4"><button class="bakery-btn bakery-btn-secondary" @onclick="CloseForm">Hủy</button><button class="bakery-btn bakery-btn-primary" @onclick="Save">Lưu nhân viên</button></div></div>}
<div class="bakery-filter-card overflow-x-auto"><table class="w-full text-sm"><thead><tr><th class="text-left p-3">Nhân viên</th><th class="text-left p-3">Vị trí</th><th class="text-left p-3">Tài khoản</th><th class="text-left p-3">Số điện thoại</th><th class="text-left p-3">Trạng thái</th><th></th></tr></thead><tbody>@foreach(var e in staff){<tr class="border-t"><td class="p-3 font-semibold">@e.FullName</td><td class="p-3">@e.Position</td><td class="p-3">@e.Account?.Username (@(e.Account?.Role == "Admin" ? "Quản lý" : "Nhân viên"))</td><td class="p-3">@e.Phone</td><td class="p-3"><span class="bakery-badge @(e.Account?.Status == "Active" ? "bakery-badge-success" : "bakery-badge-error")">@(e.Account?.Status == "Active" ? "Đang hoạt động" : "Đã khóa")</span></td><td class="p-3 text-right"><button class="bakery-btn bakery-btn-secondary bakery-btn-sm" @onclick="()=>Edit(e)">Sửa</button></td></tr>}</tbody></table>@if(staff.Count == 0){<p class="p-6 text-center text-slate-500">Chưa có nhân viên.</p>}</div>
@code { List<Employee> staff=[];EmployeeInput form=new();bool formOpen;string? message;protected override async Task OnInitializedAsync()=>await Load();async Task Load()=>staff=await EmployeeManager.GetAllAsync();void NewEmployee(){form=new();message=null;formOpen=true;}void Edit(Employee e){form=new(){EmployeeID=e.EmployeeID,FullName=e.FullName,Phone=e.Phone,Position=e.Position,Username=e.Account.Username,Status=e.Account.Status};message=null;formOpen=true;}void CloseForm()=>formOpen=false;async Task Save(){try{await EmployeeManager.SaveAsync(form);formOpen=false;message=null;await Load();}catch(Exception ex){message=ex.Message;}} }
