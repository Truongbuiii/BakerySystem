@page "/employees"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject EmployeeService EmployeeManager
@inject IJSRuntime JS
<PageTitle>Quản lý nhân sự | BakerySystem</PageTitle>
<div class="bakery-page-header"><div><h2 class="text-2xl font-bold">Quản lý nhân sự</h2><p class="text-bodytext">Quản lý hồ sơ, vị trí và quyền truy cập tài khoản nhân viên.</p></div><div class="bakery-page-actions"><button class="bakery-btn bakery-btn-secondary bakery-btn-sm" @onclick="Load">Làm mới</button><button class="bakery-btn bakery-btn-outline bakery-btn-sm" @onclick="ExportEmployeesToExcel">Xuất Excel</button><button class="bakery-btn bakery-btn-secondary bakery-btn-sm" @onclick="PrintEmployeesToPdf">In / Xuất PDF</button><button class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick="NewEmployee">+ Thêm nhân viên</button></div></div>
@if(formOpen){<div class="bakery-filter-card mb-5"><h3 class="font-bold mb-4">@(form.EmployeeID == 0 ? "Tạo nhân viên và tài khoản" : "Chỉnh sửa nhân viên")</h3><div class="grid md:grid-cols-3 gap-4"><label>Họ tên<input class="bakery-input w-full" @bind="form.FullName" /></label><label>Số điện thoại<input class="bakery-input w-full" @bind="form.Phone" /></label><label>Vị trí<select class="bakery-input w-full" @bind="form.Position"><option>Bếp bánh</option><option>Thu ngân</option><option>Quản lý</option></select></label><label>Tên đăng nhập<input class="bakery-input w-full" autocomplete="off" @bind="form.Username" /></label><label>Mật khẩu @(form.EmployeeID == 0 ? "ban đầu" : "mới (để trống nếu giữ nguyên)")<input class="bakery-input w-full" type="password" autocomplete="new-password" @bind="form.Password" /></label>@if(form.EmployeeID != 0){<label>Trạng thái tài khoản<select class="bakery-input w-full" @bind="form.Status"><option value="Active">Đang hoạt động</option><option value="Inactive">Đã khóa</option></select></label>}</div>@if(!string.IsNullOrEmpty(message)){<p class="mt-3 text-sm text-rose-600">@message</p>}<div class="flex justify-end gap-2 mt-4"><button class="bakery-btn bakery-btn-secondary" @onclick="CloseForm">Hủy</button><button class="bakery-btn bakery-btn-primary" @onclick="Save">Lưu nhân viên</button></div></div>}
<div class="bakery-filter-card">
    <div class="bakery-filter-toolbar">
        <div class="bakery-filter-search-box"><iconify-icon icon="solar:magnifer-linear"></iconify-icon><input class="w-full" placeholder="Tìm tên, tài khoản hoặc số điện thoại..." @bind="searchTerm" @bind:event="oninput" /></div>
        <select class="bakery-input" @bind="positionFilter"><option value="">Tất cả vị trí</option><option>Bếp bánh</option><option>Thu ngân</option><option>Quản lý</option></select>
        <select class="bakery-input" @bind="accountStatusFilter"><option value="">Tất cả trạng thái</option><option value="Active">Đang hoạt động</option><option value="Inactive">Đã khóa</option></select>
        <button class="bakery-btn bakery-btn-outline" @onclick="ResetSearch">Đặt lại</button>
    </div>
</div>
<div class="bakery-filter-card overflow-x-auto"><table id="employees-table" class="w-full text-sm"><thead><tr><th class="text-left p-3">Nhân viên</th><th class="text-left p-3">Vị trí</th><th class="text-left p-3">Tài khoản</th><th class="text-left p-3">Số điện thoại</th><th class="text-left p-3">Trạng thái</th><th></th></tr></thead><tbody>@foreach(var e in FilteredStaff){<tr class="border-t"><td class="p-3 font-semibold">@e.FullName</td><td class="p-3">@e.Position</td><td class="p-3">@e.Account?.Username (@(e.Account?.Role == "Admin" ? "Quản lý" : "Nhân viên"))</td><td class="p-3">@e.Phone</td><td class="p-3"><span class="bakery-badge @(e.Account?.Status == "Active" ? "bakery-badge-success" : "bakery-badge-error")">@(e.Account?.Status == "Active" ? "Đang hoạt động" : "Đã khóa")</span></td><td class="p-3 text-right"><button class="bakery-btn bakery-btn-secondary bakery-btn-sm" @onclick="()=>Edit(e)">Sửa</button></td></tr>}</tbody></table>@if(!FilteredStaff.Any()){<p class="p-6 text-center text-slate-500">Không tìm thấy nhân viên phù hợp.</p>}</div>
<div class="admin-print-report" data-report="employees">
    <div class="admin-print-header"><div><div class="admin-print-eyebrow">BAKERYSYSTEM</div><h1>Danh sách nhân sự</h1><p>Báo cáo theo bộ lọc hiện tại · Ngày in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p></div><div class="admin-print-summary"><strong>@FilteredStaff.Count()</strong><span>nhân sự</span></div></div>
    <table><thead><tr><th>Họ tên</th><th>Vị trí</th><th>Tài khoản</th><th>Số điện thoại</th><th>Trạng thái</th></tr></thead><tbody>
    @foreach (var employee in FilteredStaff)
    {
        <tr><td><strong>@employee.FullName</strong></td><td>@employee.Position</td><td>@employee.Account?.Username (@(employee.Account?.Role == "Admin" ? "Quản lý" : "Nhân viên"))</td><td>@employee.Phone</td><td>@(employee.Account?.Status == "Active" ? "Đang hoạt động" : "Đã khóa")</td></tr>
    }
    </tbody></table><div class="admin-print-footer"><span>Không hiển thị thông tin mật khẩu.</span><span>Người lập: ____________________</span></div>
</div>

@code { List<Employee> staff=[];EmployeeInput form=new();bool formOpen;string? message;string searchTerm="";string positionFilter="";string accountStatusFilter="";
IEnumerable<Employee> FilteredStaff=>staff.Where(e=>(string.IsNullOrWhiteSpace(positionFilter)||e.Position==positionFilter)&&(string.IsNullOrWhiteSpace(accountStatusFilter)||e.Account?.Status==accountStatusFilter)&&(string.IsNullOrWhiteSpace(searchTerm)||$"{e.FullName} {e.Phone} {e.Account?.Username}".Contains(searchTerm.Trim(),StringComparison.OrdinalIgnoreCase)));
protected override async Task OnInitializedAsync()=>await Load();async Task Load()=>staff=await EmployeeManager.GetAllAsync();async Task ExportEmployeesToExcel()=>await JS.InvokeVoidAsync("bakeryExcel.exportToExcel","employees-table",$"Danh_Sach_Nhan_Su_Bakery_{DateTime.Now:yyyyMMdd_HHmmss}");async Task PrintEmployeesToPdf()=>await JS.InvokeVoidAsync("bakeryPdf.printReportToPdf","Danh_Sach_Nhan_Su_BakerySystem","print-employees");void ResetSearch(){searchTerm="";positionFilter="";accountStatusFilter="";}void NewEmployee(){form=new();message=null;formOpen=true;}void Edit(Employee e){form=new(){EmployeeID=e.EmployeeID,FullName=e.FullName,Phone=e.Phone,Position=e.Position,Username=e.Account.Username,Status=e.Account.Status};message=null;formOpen=true;}void CloseForm()=>formOpen=false;async Task Save(){try{await EmployeeManager.SaveAsync(form);formOpen=false;message=null;await Load();}catch(Exception ex){message=ex.Message;}} }
