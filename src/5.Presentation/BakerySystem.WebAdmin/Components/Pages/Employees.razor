@page "/employees"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject EmployeeService EmployeeManager
@inject IJSRuntime JS
<PageTitle>Quản lý nhân sự | BakerySystem</PageTitle>
<div class="bakery-page-header"><div><h2 class="text-2xl font-bold">Quản lý nhân sự</h2><p class="text-bodytext">Quản lý hồ sơ, vị trí và quyền truy cập tài khoản nhân viên.</p></div><div class="bakery-page-actions"><button class="bakery-btn bakery-btn-secondary bakery-btn-sm" @onclick="Load">Làm mới</button><button class="bakery-btn bakery-btn-outline bakery-btn-sm" @onclick="ExportEmployeesToExcel">Xuất Excel</button><button class="bakery-btn bakery-btn-secondary bakery-btn-sm" @onclick="PrintEmployeesToPdf">In / Xuất PDF</button><button class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick="NewEmployee">+ Thêm nhân viên</button></div></div>
@if(formOpen){<div class="bakery-filter-card mb-5"><h3 class="font-bold mb-4">@(form.EmployeeID == 0 ? "Tạo nhân viên và tài khoản" : "Chỉnh sửa nhân viên")</h3><div class="grid md:grid-cols-3 gap-4"><label>Họ tên<input class="bakery-input w-full" @bind="form.FullName" /></label><label>Số điện thoại<input class="bakery-input w-full" type="tel" maxlength="20" @bind="form.Phone" /><small class="text-slate-500">Có thể để trống; nếu nhập, dùng 8–15 chữ số.</small></label><label>Vị trí<select class="bakery-input w-full" @bind="form.Position"><option>Bếp bánh</option><option>Thu ngân</option><option>Quản lý</option></select></label><label>Tên đăng nhập<input class="bakery-input w-full" maxlength="50" autocomplete="off" @bind="form.Username" /></label><label>Mật khẩu @(form.EmployeeID == 0 ? "ban đầu" : "mới (để trống nếu giữ nguyên)")<input class="bakery-input w-full" type="password" autocomplete="new-password" @bind="form.Password" /></label>@if(form.EmployeeID != 0){<label>Trạng thái tài khoản<select class="bakery-input w-full" @bind="form.Status"><option value="Active">Đang hoạt động</option><option value="Inactive">Đã khóa</option></select></label>}</div>@if(!string.IsNullOrEmpty(message)){<p class="mt-3 text-sm text-rose-600">@message</p>}<div class="flex justify-end gap-2 mt-4"><button class="bakery-btn bakery-btn-secondary" @onclick="CloseForm">Hủy</button><button class="bakery-btn bakery-btn-primary" @onclick="RequestSave">Lưu nhân viên</button></div></div>}
@if(lockConfirmationOpen){<div class="bakery-modal-backdrop" @onclick="CancelLockConfirmation"><section class="bakery-modal-card max-w-md" role="alertdialog" aria-modal="true" @onclick:stopPropagation="true"><div class="bakery-modal-header"><h3 class="text-base font-bold mb-0">Xác nhận khóa tài khoản</h3></div><div class="bakery-modal-body"><p class="mb-0">Tài khoản <strong>@form.Username</strong> sẽ không thể đăng nhập sau khi bị khóa. Bạn có muốn tiếp tục?</p></div><div class="bakery-modal-footer"><button class="bakery-btn bakery-btn-outline" @onclick="CancelLockConfirmation">Quay lại</button><button class="bakery-btn bakery-btn-primary" @onclick="ConfirmLock">Xác nhận khóa</button></div></section></div>}
<div class="bakery-filter-card">
    <div class="bakery-filter-toolbar">
        <div class="bakery-filter-search-box"><iconify-icon icon="solar:magnifer-linear"></iconify-icon><input class="w-full" placeholder="Tìm tên, tài khoản hoặc số điện thoại..." @bind="searchTerm" @bind:event="oninput" /></div>
        <select class="bakery-input" @bind="positionFilter"><option value="">Tất cả vị trí</option><option>Bếp bánh</option><option>Thu ngân</option><option>Quản lý</option></select>
        <select class="bakery-input" @bind="accountStatusFilter"><option value="">Tất cả trạng thái</option><option value="Active">Đang hoạt động</option><option value="Inactive">Đã khóa</option></select>
        <button class="bakery-btn bakery-btn-outline" @onclick="ResetSearch">Đặt lại</button>
    </div>
</div>
<div class="bakery-split-container employee-management-layout">
    <div class="bakery-split-list bakery-filter-card !p-0 overflow-hidden">
        <div class="p-4 border-b border-slate-200 dark:border-slate-700">
            <div class="flex items-center justify-between gap-2">
                <h3 class="font-bold mb-0">Danh sách nhân viên</h3>
                <span class="bakery-badge bakery-badge-secondary">@FilteredStaff.Count() nhân viên</span>
            </div>
            <p class="text-xs text-slate-500 mt-1 mb-0">Bấm vào một nhân viên để xem thông tin chi tiết.</p>
        </div>
        @if(!FilteredStaff.Any())
        {
            <p class="p-6 text-center text-slate-500">Không tìm thấy nhân viên phù hợp.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table id="employees-table" class="bakery-table w-full text-sm">
                    <thead><tr><th class="text-left">Nhân viên</th><th class="text-left">Vị trí</th><th class="text-left">Trạng thái</th></tr></thead>
                    <tbody>
                    @foreach(var e in FilteredStaff)
                    {
                        <tr class="bakery-row-clickable @(selectedEmployee?.EmployeeID == e.EmployeeID ? "bakery-row-selected" : "")" @onclick="() => SelectEmployee(e)">
                            <td class="font-semibold">@e.FullName</td>
                            <td>@e.Position</td>
                            <td><span class="bakery-badge @(e.Account?.Status == "Active" ? "bakery-badge-success" : "bakery-badge-error")">@(e.Account?.Status == "Active" ? "Đang hoạt động" : "Đã khóa")</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="bakery-split-detail">
        @if (selectedEmployee is null)
        {
            <div class="bakery-detail-placeholder">
                <iconify-icon icon="solar:user-id-linear"></iconify-icon>
                <p>Chọn một nhân viên để xem thông tin chi tiết.</p>
            </div>
        }
        else
        {
            <div class="bakery-detail-header-card">
                <div>
                    <div class="bakery-detail-kv-label">HỒ SƠ NHÂN VIÊN</div>
                    <h4 class="text-base font-bold text-dark dark:text-white mb-0">@selectedEmployee.FullName</h4>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600" title="Đóng bảng chi tiết" @onclick="() => selectedEmployee = null">×</button>
            </div>
            <div class="bakery-detail-kv-grid mt-4">
                <div class="bakery-detail-kv-item"><div class="bakery-detail-kv-label">Vị trí</div><div class="bakery-detail-kv-val">@selectedEmployee.Position</div></div>
                <div class="bakery-detail-kv-item"><div class="bakery-detail-kv-label">Trạng thái</div><div class="bakery-detail-kv-val">@(selectedEmployee.Account?.Status == "Active" ? "Đang hoạt động" : "Đã khóa")</div></div>
                <div class="bakery-detail-kv-item"><div class="bakery-detail-kv-label">Tài khoản</div><div class="bakery-detail-kv-val">@selectedEmployee.Account?.Username</div></div>
                <div class="bakery-detail-kv-item"><div class="bakery-detail-kv-label">Quyền truy cập</div><div class="bakery-detail-kv-val">@(selectedEmployee.Account?.Role == "Admin" ? "Quản lý" : "Nhân viên")</div></div>
                <div class="bakery-detail-kv-item"><div class="bakery-detail-kv-label">Số điện thoại</div><div class="bakery-detail-kv-val">@(string.IsNullOrWhiteSpace(selectedEmployee.Phone) ? "Chưa cập nhật" : selectedEmployee.Phone)</div></div>
            </div>
            <div class="flex justify-end mt-5">
                <button class="bakery-btn bakery-btn-primary" @onclick="() => Edit(selectedEmployee)">Chỉnh sửa nhân viên</button>
            </div>
        }
    </div>
</div>
<table id="employees-export-table" class="export-only-table">
    <thead><tr><th>Họ tên</th><th>Vị trí</th><th>Tài khoản</th><th>Số điện thoại</th><th>Trạng thái</th></tr></thead>
    <tbody>
    @foreach(var e in FilteredStaff)
    {
        <tr><td>@e.FullName</td><td>@e.Position</td><td>@e.Account?.Username (@(e.Account?.Role == "Admin" ? "Quản lý" : "Nhân viên"))</td><td>@e.Phone</td><td>@(e.Account?.Status == "Active" ? "Đang hoạt động" : "Đã khóa")</td></tr>
    }
    </tbody>
</table>
<div class="admin-print-report" data-report="employees">
    <div class="admin-print-header"><div><div class="admin-print-eyebrow">BAKERYSYSTEM</div><h1>Danh sách nhân sự</h1><p>Báo cáo theo bộ lọc hiện tại · Ngày in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p></div><div class="admin-print-summary"><strong>@FilteredStaff.Count()</strong><span>nhân sự</span></div></div>
    <table><thead><tr><th>Họ tên</th><th>Vị trí</th><th>Tài khoản</th><th>Số điện thoại</th><th>Trạng thái</th></tr></thead><tbody>
    @foreach (var employee in FilteredStaff)
    {
        <tr><td><strong>@employee.FullName</strong></td><td>@employee.Position</td><td>@employee.Account?.Username (@(employee.Account?.Role == "Admin" ? "Quản lý" : "Nhân viên"))</td><td>@employee.Phone</td><td>@(employee.Account?.Status == "Active" ? "Đang hoạt động" : "Đã khóa")</td></tr>
    }
    </tbody></table><div class="admin-print-footer"><span>Không hiển thị thông tin mật khẩu.</span><span>Người lập: ____________________</span></div>
</div>

@code { List<Employee> staff=[];EmployeeInput form=new();Employee? selectedEmployee;bool formOpen;bool lockConfirmationOpen;string editingOriginalStatus="Active";string? message;string searchTerm="";string positionFilter="";string accountStatusFilter="";
IEnumerable<Employee> FilteredStaff=>staff.Where(e=>(string.IsNullOrWhiteSpace(positionFilter)||e.Position==positionFilter)&&(string.IsNullOrWhiteSpace(accountStatusFilter)||e.Account?.Status==accountStatusFilter)&&(string.IsNullOrWhiteSpace(searchTerm)||$"{e.FullName} {e.Phone} {e.Account?.Username}".Contains(searchTerm.Trim(),StringComparison.OrdinalIgnoreCase)));
protected override async Task OnInitializedAsync()=>await Load();async Task Load(){staff=await EmployeeManager.GetAllAsync();if(selectedEmployee is not null)selectedEmployee=staff.FirstOrDefault(e=>e.EmployeeID==selectedEmployee.EmployeeID);}async Task ExportEmployeesToExcel()=>await JS.InvokeVoidAsync("bakeryExcel.exportToExcel","employees-export-table",$"Danh_Sach_Nhan_Su_Bakery_{DateTime.Now:yyyyMMdd_HHmmss}");async Task PrintEmployeesToPdf()=>await JS.InvokeVoidAsync("bakeryPdf.printReportToPdf","Danh_Sach_Nhan_Su_BakerySystem","print-employees");void ResetSearch(){searchTerm="";positionFilter="";accountStatusFilter="";}void SelectEmployee(Employee e)=>selectedEmployee=e;void NewEmployee(){form=new();message=null;editingOriginalStatus="Active";formOpen=true;}void Edit(Employee e){selectedEmployee=e;form=new(){EmployeeID=e.EmployeeID,FullName=e.FullName,Phone=e.Phone,Position=e.Position,Username=e.Account.Username,Status=e.Account.Status};editingOriginalStatus=e.Account.Status;message=null;formOpen=true;}void CloseForm(){formOpen=false;lockConfirmationOpen=false;}async Task RequestSave(){if(form.EmployeeID!=0&&editingOriginalStatus=="Active"&&form.Status=="Inactive"){lockConfirmationOpen=true;return;}await Save();}void CancelLockConfirmation()=>lockConfirmationOpen=false;async Task ConfirmLock(){lockConfirmationOpen=false;await Save();}async Task Save(){try{await EmployeeManager.SaveAsync(form);formOpen=false;message=null;await Load();}catch(Exception ex){message=ex.Message;}} }
