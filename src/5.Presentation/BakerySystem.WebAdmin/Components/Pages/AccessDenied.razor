@page "/access-denied"
@attribute [AllowAnonymous]
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Không có quyền truy cập | BakerySystem</PageTitle>

<div class="p-8 text-center max-w-md mx-auto my-12 bg-white dark:bg-slate-800 rounded-xl border border-border dark:border-darkborder shadow-sm">
    <div class="inline-flex p-3 rounded-xl bg-red-50 dark:bg-red-950/40 text-red-600 mb-3">
        <iconify-icon icon="solar:shield-warning-linear" class="text-3xl"></iconify-icon>
    </div>
    <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-1">Không có quyền truy cập</h3>
    <p class="text-sm text-slate-500 mb-4">Tài khoản của bạn không có quyền truy cập phần này.</p>
    <a href="@(isAuthenticated ? (isCustomer ? "/shop" : "/") : "/login")" class="bakery-btn bakery-btn-primary bakery-btn-sm inline-flex items-center gap-1">
        @(isAuthenticated ? (isCustomer ? "Về cửa hàng bánh" : "Về bảng điều khiển") : "Đăng nhập")
    </a>
</div>

@code {
    private bool isAuthenticated;
    private bool isCustomer;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
        isCustomer = authState.User.IsInRole(AccountRole.Customer);
    }
}
