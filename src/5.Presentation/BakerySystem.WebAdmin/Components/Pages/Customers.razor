@code {
    private List<CustomerListItemDto> customers = [];
    private CustomerDetailDto? selectedCustomer;
    private CustomerInputModel inputForm = new();
    private bool isFormOpen;
    private bool saving;
    private string? formMessage;
    private bool formSuccess;
    private string? actionMessage;

    private string searchKeyword = string.Empty;
    private string selectedSourceFilter = "all";
    private string selectedStatusFilter = "all";

    private IEnumerable<CustomerListItemDto> FilteredCustomers => (customers ?? []).Where(c =>
        (selectedSourceFilter == "all" ||
            (selectedSourceFilter == "app" && c.HasAppAccount) ||
            (selectedSourceFilter == "pos" && (c.HasPosOrders || !c.HasAppAccount)) ||
            (selectedSourceFilter == "guest" && !c.HasAppAccount)) &&
        (selectedStatusFilter == "all" ||
            (selectedStatusFilter == "active" && (c.AccountStatus == "Active" || !c.HasAppAccount)) ||
            (selectedStatusFilter == "inactive" && c.AccountStatus == "Inactive")) &&
        (string.IsNullOrWhiteSpace(searchKeyword) ||
            (!string.IsNullOrEmpty(c.FullName) && c.FullName.Contains(searchKeyword.Trim(), StringComparison.OrdinalIgnoreCase)) ||
            (c.Phone != null && c.Phone.Contains(searchKeyword.Trim(), StringComparison.OrdinalIgnoreCase)) ||
            (c.Username != null && c.Username.Contains(searchKeyword.Trim(), StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(c.CustomerCode) && c.CustomerCode.Contains(searchKeyword.Trim(), StringComparison.OrdinalIgnoreCase))));

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomersAsync();
    }

    private async Task LoadCustomersAsync()
    {
        customers = await CustomerManager.GetCustomersAsync() ?? [];
        if (selectedCustomer != null)
        {
            var detail = await CustomerManager.GetCustomerDetailAsync(selectedCustomer.CustomerId);
            selectedCustomer = detail ?? (customers.Count > 0 ? await CustomerManager.GetCustomerDetailAsync(customers[0].CustomerId) : null);
        }
        else if (customers.Count > 0)
        {
            // Tự động nạp khách hàng đầu tiên cho Master-Detail trực quan
            await SelectCustomerAsync(customers[0].CustomerId);
        }
    }

    private async Task SelectCustomerAsync(int customerId)
    {
        isFormOpen = false;
        formMessage = null;
        actionMessage = null;
        selectedCustomer = await CustomerManager.GetCustomerDetailAsync(customerId);
    }

    private void OpenCreateForm()
    {
        inputForm = new CustomerInputModel
        {
            CustomerId = 0,
            AccountStatus = "Active",
            CreateAccount = false
        };
        formMessage = null;
        actionMessage = null;
        isFormOpen = true;
    }

    private void OpenEditForm(CustomerDetailDto customer)
    {
        inputForm = new CustomerInputModel
        {
            CustomerId = customer.CustomerId,
            FullName = customer.FullName,
            Phone = customer.Phone,
            Address = customer.Address,
            Username = customer.Username,
            AccountStatus = customer.AccountStatus == "None" ? "Active" : customer.AccountStatus,
            CreateAccount = customer.HasAppAccount
        };
        formMessage = null;
        actionMessage = null;
        isFormOpen = true;
    }

    private void OpenCreateAccountForCustomer(CustomerDetailDto customer)
    {
        inputForm = new CustomerInputModel
        {
            CustomerId = customer.CustomerId,
            FullName = customer.FullName,
            Phone = customer.Phone,
            Address = customer.Address,
            Username = !string.IsNullOrWhiteSpace(customer.Phone) ? $"kh_{customer.Phone}" : $"kh_{customer.CustomerId}",
            AccountStatus = "Active",
            CreateAccount = true
        };
        formMessage = null;
        actionMessage = null;
        isFormOpen = true;
    }

    private void CloseForm()
    {
        isFormOpen = false;
        formMessage = null;
    }

    private async Task SaveCustomerAsync()
    {
        saving = true;
        formMessage = null;
        try
        {
            var savedId = await CustomerManager.SaveCustomerAsync(inputForm);
            formSuccess = true;
            formMessage = inputForm.CustomerId == 0 ? "Thêm khách hàng thành công!" : "Cập nhật thông tin thành công!";
            await LoadCustomersAsync();
            selectedCustomer = await CustomerManager.GetCustomerDetailAsync(savedId);
            isFormOpen = false;
            actionMessage = "Đã lưu thông tin khách hàng.";
        }
        catch (Exception ex)
        {
            formSuccess = false;
            formMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ToggleAccountStatus(int customerId)
    {
        try
        {
            await CustomerManager.ToggleAccountStatusAsync(customerId);
            actionMessage = "Đã cập nhật trạng thái tài khoản khách hàng thành công.";
            await LoadCustomersAsync();
        }
        catch (Exception ex)
        {
            actionMessage = $"Lỗi: {ex.Message}";
        }
    }

    private void ResetFilters()
    {
        searchKeyword = string.Empty;
        selectedSourceFilter = "all";
        selectedStatusFilter = "all";
    }

    private async Task ExportToExcel() =>
        await JS.InvokeVoidAsync("bakeryExcel.exportToExcel", "customers-export-table", $"Danh_Sach_Khach_Hang_{DateTime.Now:yyyyMMdd_HHmmss}");

    private async Task PrintToPdf() =>
        await JS.InvokeVoidAsync("bakeryPdf.printReportToPdf", "Danh_Sach_Khach_Hang_BakerySystem", "print-customers");

    private static string GetOrderStatusText(string status) => status switch
    {
        "Completed" => "Hoàn tất",
        "Pending" => "Chờ xử lý",
        "Confirmed" => "Đã nhận đơn",
        "Baking" => "Đang nướng bánh",
        "Shipping" => "Đang giao",
        "Cancelled" => "Đã hủy",
        _ => status
    };

    private static string GetOrderStatusBadgeClass(string? status) => status switch
    {
        "Completed" => "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/40",
        "Cancelled" => "bg-rose-50 text-rose-700 dark:bg-rose-950/50 dark:text-rose-400 border border-rose-200 dark:border-rose-800/40",
        "Pending" => "bg-amber-50 text-amber-700 dark:bg-amber-950/50 dark:text-amber-400 border border-amber-200 dark:border-amber-800/40",
        "Confirmed" or "Baking" or "Shipping" => "bg-blue-50 text-blue-700 dark:bg-blue-950/50 dark:text-blue-400 border border-blue-200 dark:border-blue-800/40",
        _ => "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300"
    };

    private static string GetPaymentMethodText(string? method) => method switch
    {
        "Cash" or "Tiền mặt" => "Tiền mặt",
        "BankTransfer" or "Chuyển khoản" => "Chuyển khoản",
        "Momo" => "Ví MoMo",
        "VnPay" => "VNPAY",
        "CreditCard" => "Thẻ",
        _ => string.IsNullOrWhiteSpace(method) ? "Tiền mặt" : method
    };

    private static string GetPaymentIcon(string? method) => method switch
    {
        "BankTransfer" or "Chuyển khoản" => "solar:card-transfer-linear",
        "Momo" => "solar:smartphone-linear",
        "VnPay" => "solar:qr-code-linear",
        "CreditCard" => "solar:card-2-linear",
        _ => "solar:wallet-money-linear"
    };

    private static string GetLoyaltyTierName(decimal totalSpent) => CustomerLoyaltyTier.GetTierName(totalSpent);

    private static string GetLoyaltyBadgeClass(decimal totalSpent) => CustomerLoyaltyTier.GetBadgeClass(totalSpent);

    private static string GetLastOrderText(CustomerDetailDto customer)
    {
        var latest = customer.RecentOrders?.FirstOrDefault();
        if (latest == null) return "Chưa có đơn";
        var days = (DateTime.Now.Date - latest.OrderDate.Date).Days;
        return days switch
        {
            0 => "Hôm nay",
            1 => "Hôm qua",
            < 30 => $"{days} ngày trước",
            _ => latest.OrderDate.ToString("dd/MM/yyyy")
        };
    }

    private static string GetShoppingChannelText(CustomerDetailDto customer)
    {
        if (customer.HasAppOrders && customer.HasPosOrders) return "App & Quầy POS";
        if (customer.HasAppOrders) return "Mobile App";
        if (customer.HasPosOrders || !customer.HasAppAccount) return "Quầy POS";
        return "Chưa mua hàng";
    }

    private static string GetCustomerInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "KH";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Length >= 2 ? parts[0][..2].ToUpper() : parts[0].ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }
}
