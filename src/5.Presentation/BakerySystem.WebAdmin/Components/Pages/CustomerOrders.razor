@page "/my-orders"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Customer")]
@implements IDisposable
@using System.Security.Claims
@inject CustomerOrderService CustomerOrderService
@inject IAuthService AuthService
@inject WebCartService CartService
@inject OrderNotificationService NotifService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Đơn hàng của tôi | BakerySystem</PageTitle>

@if (!string.IsNullOrEmpty(toastMessage))
{
    <div class="myorders-toast" role="status">
        <iconify-icon icon="solar:check-circle-bold" style="color: #34d399; font-size: 1.1rem;"></iconify-icon>
        <span>@toastMessage</span>
    </div>
}

<div class="bakery-page-header">
    <div>
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-0.5">Đơn hàng của tôi</h2>
        <p class="text-xs text-slate-500 mb-0">
            Theo dõi tiến trình chuẩn bị bánh &amp; giao hàng theo thời gian thực (@orders.Count đơn hàng).
        </p>
    </div>

    <div class="bakery-page-actions">
        <button type="button" class="bakery-btn bakery-btn-secondary bakery-btn-sm" @onclick="RefreshOrdersAsync">
            <iconify-icon icon="solar:restart-linear"></iconify-icon>
            <span>Đồng bộ trạng thái</span>
        </button>
        <a href="/shop" class="bakery-btn bakery-btn-primary bakery-btn-sm">
            <iconify-icon icon="solar:shop-2-bold"></iconify-icon>
            <span>Đặt bánh mới</span>
        </a>
    </div>
</div>

<!-- Bộ lọc trạng thái & tìm kiếm -->
<div class="bakery-filter-card mb-4">
    <div class="flex flex-wrap items-center gap-3 mb-3">
        <div class="bakery-search-input-wrap" style="flex: 1 1 260px;">
            <iconify-icon icon="solar:magnifer-linear"></iconify-icon>
            <input type="text"
                   class="bakery-search-input"
                   placeholder="Tìm theo mã đơn (#HD-0001), tên người nhận, tên món bánh..."
                   @bind="searchQuery"
                   @bind:event="oninput" />
        </div>
        @if (!string.IsNullOrWhiteSpace(searchQuery) || selectedStatus != "All")
        {
            <button type="button" class="bakery-btn bakery-btn-outline bakery-btn-sm" @onclick="ResetFilters">
                <iconify-icon icon="solar:refresh-linear"></iconify-icon>
                <span>Đặt lại</span>
            </button>
        }
    </div>

    <div class="flex flex-wrap gap-2">
        <button type="button" class="bakery-pos-cat-pill @(selectedStatus == "All" ? "active" : "")"
                @onclick='() => selectedStatus = "All"'>
            Tất cả (@orders.Count)
        </button>
        <button type="button" class="bakery-pos-cat-pill @(selectedStatus == OrderStatus.Pending ? "active" : "")"
                @onclick='() => selectedStatus = OrderStatus.Pending'>
            Chờ duyệt (@orders.Count(o => o.Status == OrderStatus.Pending))
        </button>
        <button type="button" class="bakery-pos-cat-pill @(selectedStatus == OrderStatus.Confirmed ? "active" : "")"
                @onclick='() => selectedStatus = OrderStatus.Confirmed'>
            Đã duyệt (@orders.Count(o => o.Status == OrderStatus.Confirmed))
        </button>
        <button type="button" class="bakery-pos-cat-pill @(selectedStatus == OrderStatus.Delivered ? "active" : "")"
                @onclick='() => selectedStatus = OrderStatus.Delivered'>
            Giao hàng / Chờ nhận (@orders.Count(o => o.Status is OrderStatus.Delivered or OrderStatus.Shipping))
        </button>
        <button type="button" class="bakery-pos-cat-pill @(selectedStatus == OrderStatus.Completed ? "active" : "")"
                @onclick='() => selectedStatus = OrderStatus.Completed'>
            Hoàn tất (@orders.Count(o => o.Status == OrderStatus.Completed))
        </button>
        <button type="button" class="bakery-pos-cat-pill @(selectedStatus == OrderStatus.Cancelled ? "active" : "")"
                @onclick='() => selectedStatus = OrderStatus.Cancelled'>
            Đã hủy (@orders.Count(o => o.Status == OrderStatus.Cancelled))
        </button>
    </div>
</div>

@if (isLoading)
{
    <div class="bakery-card p-10 text-center">
        <div class="w-9 h-9 border-4 border-primary border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
        <p class="text-xs text-slate-500 mb-0">Đang tải danh sách đơn hàng...</p>
    </div>
}
else if (!FilteredOrders.Any())
{
    <div class="bakery-card p-10 text-center">
        <iconify-icon icon="solar:box-minimalistic-linear" class="text-4xl text-slate-300 mb-2"></iconify-icon>
        <h4 class="text-sm font-bold text-slate-800 mb-1">Chưa có đơn hàng nào</h4>
        <p class="text-xs text-slate-500 mb-4">
            @(string.IsNullOrWhiteSpace(searchQuery) && selectedStatus == "All"
                ? "Bạn chưa đặt đơn hàng nào. Hãy khám phá thực đơn bánh tươi ngay nhé!"
                : "Không tìm thấy đơn hàng phù hợp với bộ lọc hiện tại.")
        </p>
        <a href="/shop" class="bakery-btn bakery-btn-primary bakery-btn-sm">Khám phá thực đơn bánh</a>
    </div>
}
else
{
    <div class="myorders-list">
        @foreach (var order in FilteredOrders)
        {
            var isOnline = IsOnlineOrder(order);
            <div class="myorder-card">
                <div class="myorder-card-head">
                    <div>
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-mono text-sm font-bold text-slate-900">#HD-@order.OrderID.ToString("D4")</span>
                            <span class="text-xs text-slate-500">&bull; @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                            <span class="bakery-badge @(isOnline ? "bakery-badge-primary" : "bakery-badge-secondary") text-[10px]">
                                @(isOnline ? "Đặt Online" : "Mua tại quầy")
                            </span>
                        </div>
                        <div class="text-xs text-slate-600 mt-1">
                            Người nhận: <strong>@(order.ReceiverName ?? customerProfile?.FullName)</strong>
                            @if (!string.IsNullOrWhiteSpace(order.ReceiverPhone))
                            {
                                <span> (@order.ReceiverPhone)</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(order.ShippingAddress))
                            {
                                <span> &bull; @order.ShippingAddress</span>
                            }
                        </div>
                    </div>

                    <span class="bakery-badge @GetStatusBadgeClass(order.Status)">
                        @GetStatusLabel(order.Status)
                    </span>
                </div>

                @if (order.Status is OrderStatus.Delivered or OrderStatus.Shipping)
                {
                    <div class="myorder-delivered-box">
                        <iconify-icon icon="solar:delivery-bold" class="text-xl shrink-0"></iconify-icon>
                        <span>Nhân viên tiệm bánh đã giao bánh tươi đến nơi! Vui lòng kiểm tra bánh và bấm xác nhận đã nhận để hoàn tất đơn hàng.</span>
                    </div>
                }

                <div class="myorder-items">
                    @foreach (var detail in order.OrderDetails.Take(3))
                    {
                        <div class="myorder-item-row">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <img src="@WebCartService.ResolveProductImageUrl(detail.Product)"
                                     alt="@detail.Product?.ProductName"
                                     class="myorder-item-img"
                                     onerror="this.src='/assets/images/products/default-bakery.svg'" />
                                <div class="min-w-0">
                                    <div class="text-xs font-bold text-slate-800 truncate">@(detail.Product?.ProductName ?? $"Món #{detail.ProductID}")</div>
                                    <div class="text-[11px] text-slate-500">@detail.Quantity &times; @($"{detail.UnitPrice:N0}đ")</div>
                                </div>
                            </div>
                            <strong class="text-xs text-slate-800 shrink-0">@($"{detail.SubTotal:N0}đ")</strong>
                        </div>
                    }
                    @if (order.OrderDetails.Count > 3)
                    {
                        <button type="button" class="text-xs font-semibold text-primary border-0 bg-transparent cursor-pointer text-left"
                                @onclick="() => selectedOrder = order">
                            + Xem thêm @(order.OrderDetails.Count - 3) món bánh khác...
                        </button>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(order.Note))
                {
                    <div class="myorder-note">
                        <iconify-icon icon="solar:notes-bold" class="text-base shrink-0"></iconify-icon>
                        <span><strong>Ghi chú:</strong> @order.Note</span>
                    </div>
                }

                <div class="myorder-foot">
                    <div class="text-xs text-slate-600">
                        <span>PTTT: <strong>@GetPaymentMethodLabel(order.PaymentMethod)</strong></span>
                        <span class="ml-2 font-bold @(order.PaymentStatus == PaymentStatus.Paid ? "text-emerald-600" : "text-amber-600")">
                            (@(order.PaymentStatus == PaymentStatus.Paid ? "Đã thanh toán" : "Chưa thanh toán"))
                        </span>
                        @if (order.DiscountAmount > 0)
                        {
                            <span class="ml-2 text-rose-600 font-semibold">(Giảm @($"{order.DiscountAmount:N0}đ"))</span>
                        }
                    </div>

                    <div class="flex items-center gap-2 flex-wrap">
                        <div class="text-sm font-bold text-slate-900 mr-2">
                            Tổng cộng: <span class="text-primary">@($"{order.FinalAmount:N0}đ")</span>
                        </div>

                        @if (order.Status is OrderStatus.Delivered or OrderStatus.Shipping)
                        {
                            <button type="button" class="bakery-btn bakery-btn-primary bakery-btn-sm"
                                    style="background-color: #059669;"
                                    @onclick="() => ConfirmReceivedAsync(order.OrderID)">
                                <iconify-icon icon="solar:check-circle-bold"></iconify-icon>
                                <span>Xác nhận đã nhận bánh</span>
                            </button>
                        }

                        <button type="button" class="bakery-btn bakery-btn-secondary bakery-btn-sm"
                                @onclick="() => selectedOrder = order">
                            <iconify-icon icon="solar:eye-linear"></iconify-icon>
                            <span>Chi tiết &amp; Tiến trình</span>
                        </button>

                        <button type="button" class="bakery-btn bakery-btn-outline bakery-btn-sm"
                                @onclick="() => ReOrderAsync(order)">
                            <iconify-icon icon="solar:cart-large-2-bold"></iconify-icon>
                            <span>Đặt lại</span>
                        </button>

                        @if (order.Status == OrderStatus.Pending)
                        {
                            <button type="button" class="bakery-btn bakery-btn-danger bakery-btn-sm"
                                    @onclick="() => CancelOrderAsync(order.OrderID)">
                                <iconify-icon icon="solar:close-circle-bold"></iconify-icon>
                                <span>Hủy đơn</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- MODAL CHI TIẾT ĐƠN HÀNG & TIẾN TRÌNH 4 BƯỚC -->
@if (selectedOrder is not null)
{
    <div class="bakery-modal-backdrop" @onclick="() => selectedOrder = null">
        <div class="bakery-modal-card max-w-lg" @onclick:stopPropagation="true">
            <div class="bakery-modal-header">
                <div>
                    <h4 class="text-base font-bold text-slate-900 mb-0">Chi tiết đơn hàng #HD-@selectedOrder.OrderID.ToString("D4")</h4>
                    <span class="text-xs text-slate-500">Đặt lúc @selectedOrder.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 text-xl font-bold border-0 bg-transparent cursor-pointer"
                        @onclick="() => selectedOrder = null">&times;</button>
            </div>

            <div class="bakery-modal-body space-y-3" style="max-height: 68vh; overflow-y: auto;">
                @if (selectedOrder.Status == OrderStatus.Cancelled)
                {
                    <div class="p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-xs font-bold text-center">
                        Đơn hàng này đã bị hủy.
                    </div>
                }
                else
                {
                    <div class="myorder-stepper">
                        <div class="myorder-step is-done">
                            <span class="myorder-step-icon"><iconify-icon icon="solar:bag-check-bold"></iconify-icon></span>
                            <span class="myorder-step-label">Đặt hàng</span>
                        </div>
                        <div class="myorder-step @GetStepClass(selectedOrder.Status, 2)">
                            <span class="myorder-step-icon"><iconify-icon icon="solar:check-circle-bold"></iconify-icon></span>
                            <span class="myorder-step-label">Đã duyệt</span>
                        </div>
                        <div class="myorder-step @GetStepClass(selectedOrder.Status, 3)">
                            <span class="myorder-step-icon"><iconify-icon icon="solar:delivery-bold"></iconify-icon></span>
                            <span class="myorder-step-label">Giao hàng</span>
                        </div>
                        <div class="myorder-step @GetStepClass(selectedOrder.Status, 4)">
                            <span class="myorder-step-icon"><iconify-icon icon="solar:star-circle-bold"></iconify-icon></span>
                            <span class="myorder-step-label">Hoàn tất</span>
                        </div>
                    </div>
                }

                <div class="bakery-info-box bakery-info-box-neutral text-xs space-y-1">
                    <div><strong>Người nhận:</strong> @selectedOrder.ReceiverName (@selectedOrder.ReceiverPhone)</div>
                    <div><strong>Địa chỉ:</strong> @selectedOrder.ShippingAddress</div>
                    @if (!string.IsNullOrWhiteSpace(selectedOrder.Note))
                    {
                        <div><strong>Ghi chú:</strong> @selectedOrder.Note</div>
                    }
                </div>

                <div class="space-y-2">
                    @foreach (var detail in selectedOrder.OrderDetails)
                    {
                        <div class="myorder-item-row">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <img src="@WebCartService.ResolveProductImageUrl(detail.Product)"
                                     alt="@detail.Product?.ProductName"
                                     class="myorder-item-img"
                                     onerror="this.src='/assets/images/products/default-bakery.svg'" />
                                <div class="min-w-0">
                                    <div class="text-xs font-bold text-slate-800 truncate">@(detail.Product?.ProductName ?? $"Món #{detail.ProductID}")</div>
                                    <div class="text-[11px] text-slate-500">@detail.Quantity &times; @($"{detail.UnitPrice:N0}đ")</div>
                                </div>
                            </div>
                            <strong class="text-xs text-slate-800 shrink-0">@($"{detail.SubTotal:N0}đ")</strong>
                        </div>
                    }
                </div>

                <div class="bakery-info-box bakery-info-box-neutral text-xs space-y-1">
                    <div class="flex justify-between">
                        <span>Tạm tính:</span>
                        <strong>@($"{selectedOrder.TotalAmount:N0}đ")</strong>
                    </div>
                    @if (selectedOrder.DiscountAmount > 0)
                    {
                        <div class="flex justify-between text-rose-600">
                            <span>Giảm giá khuyến mãi:</span>
                            <strong>-@($"{selectedOrder.DiscountAmount:N0}đ")</strong>
                        </div>
                    }
                    <div class="flex justify-between text-sm font-bold pt-1 border-t border-slate-200">
                        <span>Tổng thanh toán:</span>
                        <span class="text-primary">@($"{selectedOrder.FinalAmount:N0}đ")</span>
                    </div>
                </div>
            </div>

            <div class="bakery-modal-footer">
                @if (selectedOrder.Status is OrderStatus.Delivered or OrderStatus.Shipping)
                {
                    <button type="button" class="bakery-btn bakery-btn-primary" style="background-color: #059669;"
                            @onclick="() => ConfirmReceivedAsync(selectedOrder.OrderID)">
                        Xác nhận đã nhận bánh
                    </button>
                }
                <button type="button" class="bakery-btn bakery-btn-secondary" @onclick="() => ReOrderAsync(selectedOrder)">
                    Đặt lại đơn này
                </button>
                <button type="button" class="bakery-btn bakery-btn-outline" @onclick="() => selectedOrder = null">
                    Đóng
                </button>
            </div>
        </div>
    </div>
}

@code {
    private CustomerDto? customerProfile;
    private List<Order> orders = [];
    private Order? selectedOrder;

    private bool isLoading = true;
    private string selectedStatus = "All";
    private string searchQuery = string.Empty;
    private string? toastMessage;

    private readonly CancellationTokenSource pollCts = new();
    private bool isDisposed;

    private IEnumerable<Order> FilteredOrders
    {
        get
        {
            var query = orders.AsEnumerable();
            if (selectedStatus != "All")
            {
                query = selectedStatus == OrderStatus.Delivered
                    ? query.Where(o => o.Status is OrderStatus.Delivered or OrderStatus.Shipping)
                    : query.Where(o => o.Status.Equals(selectedStatus, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var term = searchQuery.Trim();
                query = query.Where(o => o.OrderID.ToString().Contains(term, StringComparison.OrdinalIgnoreCase)
                    || $"#HD-{o.OrderID:D4}".Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (o.ReceiverName != null && o.ReceiverName.Contains(term, StringComparison.OrdinalIgnoreCase))
                    || o.OrderDetails.Any(d => d.Product != null && d.Product.ProductName.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        NotifService.OnOrderChanged += HandleOrderChanged;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        int.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var accountId);

        if (accountId > 0)
            customerProfile = await AuthService.GetCustomerByAccountIdAsync(accountId);

        await LoadOrdersAsync();
        isLoading = false;

        _ = PollOrdersAsync(pollCts.Token);
    }

    private async Task LoadOrdersAsync()
    {
        if (customerProfile is null)
        {
            orders = [];
            return;
        }

        orders = await CustomerOrderService.GetOrdersAsync(customerProfile.CustomerId, null);
        if (selectedOrder is not null)
            selectedOrder = orders.FirstOrDefault(o => o.OrderID == selectedOrder.OrderID);
    }

    private async Task RefreshOrdersAsync()
    {
        await LoadOrdersAsync();
        ShowToast("Đã đồng bộ trạng thái đơn hàng mới nhất!");
    }

    private void HandleOrderChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (isDisposed) return;
            await LoadOrdersAsync();
            StateHasChanged();
        });
    }

    private async Task PollOrdersAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (isDisposed) break;
                var hasOpenOrders = orders.Any(o => o.Status is OrderStatus.Pending or OrderStatus.Confirmed or OrderStatus.InProgress or OrderStatus.Shipping or OrderStatus.Delivered);
                if (!hasOpenOrders) continue;

                await LoadOrdersAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on dispose
        }
    }

    private void ResetFilters()
    {
        selectedStatus = "All";
        searchQuery = string.Empty;
    }

    private async Task CancelOrderAsync(int orderId)
    {
        if (customerProfile is null) return;
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Bạn có chắc chắn muốn hủy đơn hàng #HD-{orderId:D4}?");
        if (!confirmed) return;

        var ok = await CustomerOrderService.CancelOrderAsync(orderId, customerProfile.CustomerId);
        if (ok)
        {
            ShowToast($"Đã hủy đơn hàng #HD-{orderId:D4}.");
            await LoadOrdersAsync();
            NotifService.NotifyOrderChanged();
        }
        else
        {
            ShowToast("Không thể hủy đơn hàng ở trạng thái hiện tại.");
        }
    }

    private async Task ConfirmReceivedAsync(int orderId)
    {
        if (customerProfile is null) return;
        var ok = await CustomerOrderService.ConfirmReceivedOrderAsync(orderId, customerProfile.CustomerId);
        if (ok)
        {
            ShowToast($"Cảm ơn bạn! Đơn #HD-{orderId:D4} đã hoàn tất.");
            await LoadOrdersAsync();
            NotifService.NotifyOrderChanged();
        }
    }

    private async Task ReOrderAsync(Order order)
    {
        var activeProducts = await CustomerOrderService.GetActiveProductsAsync();
        var activeById = activeProducts.ToDictionary(p => p.ProductID);
        var added = CartService.ReOrder(order, activeById);
        if (added > 0)
        {
            Navigation.NavigateTo("/shop");
        }
        else
        {
            ShowToast("Các món bánh trong đơn này hiện đã hết hàng hoặc ngừng bán.");
        }
    }

    private static bool IsOnlineOrder(Order order) =>
        !string.IsNullOrWhiteSpace(order.ShippingAddress)
        && !order.ShippingAddress.Contains("Nhận tại quầy", StringComparison.OrdinalIgnoreCase)
        && !order.ShippingAddress.Contains("Mua trực tiếp tại", StringComparison.OrdinalIgnoreCase);

    private static string GetStatusLabel(string status) => status switch
    {
        OrderStatus.Pending => "Chờ tiệm duyệt",
        OrderStatus.Confirmed => "Đã duyệt",
        OrderStatus.InProgress => "Đang chuẩn bị",
        OrderStatus.Shipping or OrderStatus.Delivered => "Đã giao tới nơi (Chờ xác nhận)",
        OrderStatus.Completed => "Hoàn tất",
        OrderStatus.Cancelled => "Đã hủy",
        _ => status
    };

    private static string GetStatusBadgeClass(string status) => status switch
    {
        OrderStatus.Pending => "bakery-badge-warning",
        OrderStatus.Confirmed or OrderStatus.InProgress => "bakery-badge-primary",
        OrderStatus.Shipping or OrderStatus.Delivered => "bakery-badge-success",
        OrderStatus.Completed => "bakery-badge-success",
        OrderStatus.Cancelled => "bakery-badge-error",
        _ => "bakery-badge-secondary"
    };

    private static string GetPaymentMethodLabel(string method) => method switch
    {
        PaymentMethod.BankTransfer => "Chuyển khoản VietQR",
        PaymentMethod.COD => "Tiền mặt (COD)",
        "Cash" => "Tiền mặt tại quầy",
        _ => method
    };

    private static string GetStepClass(string status, int step)
    {
        var rank = status switch
        {
            OrderStatus.Pending => 1,
            OrderStatus.Confirmed or OrderStatus.InProgress => 2,
            OrderStatus.Shipping or OrderStatus.Delivered => 3,
            OrderStatus.Completed => 4,
            _ => 0
        };

        if (rank > step) return "is-done";
        if (rank == step) return rank == 4 ? "is-done" : "is-active";
        return string.Empty;
    }

    private void ShowToast(string message)
    {
        toastMessage = message;
        _ = Task.Run(async () =>
        {
            await Task.Delay(2600);
            if (isDisposed) return;
            toastMessage = null;
            await InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose()
    {
        isDisposed = true;
        NotifService.OnOrderChanged -= HandleOrderChanged;
        pollCts.Cancel();
        pollCts.Dispose();
    }
}
