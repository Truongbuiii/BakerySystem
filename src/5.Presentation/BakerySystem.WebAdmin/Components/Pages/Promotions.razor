@page "/promotions"
@rendermode InteractiveServer
@inject PromotionService PromotionManager
<PageTitle>Khuyến mãi | BakerySystem</PageTitle>
<div class="bakery-page-header"><div><h2 class="text-2xl font-bold">Chương trình khuyến mãi</h2><p class="text-bodytext">Thiết lập mã giảm giá hóa đơn có ngưỡng áp dụng và mức giảm tối đa.</p></div></div>
<div class="bakery-filter-card mb-5"><div class="grid md:grid-cols-3 gap-4"><label>Mã khuyến mãi<input class="bakery-input w-full" placeholder="BAKERY2026" @bind="campaign.PromotionCode" /></label><label>Tên chiến dịch<input class="bakery-input w-full" @bind="campaign.PromotionName" /></label><label>Giảm giá (%)<input class="bakery-input w-full" type="number" min="0.01" max="100" step="0.01" @bind="percent" /></label><label>Ngày bắt đầu<input class="bakery-input w-full" type="date" @bind="start" /></label><label>Ngày kết thúc<input class="bakery-input w-full" type="date" @bind="end" /></label><label>Đơn hàng tối thiểu<input class="bakery-input w-full" type="number" min="0" step="1000" @bind="minimum" /></label><label>Mức giảm tối đa (đ)<input class="bakery-input w-full" type="number" min="0" step="1000" @bind="cap" /></label><label class="md:col-span-2">Mô tả<input class="bakery-input w-full" @bind="campaign.Description" /></label></div><div class="mt-4 flex justify-between items-center"><p class="text-xs text-slate-500">Tiền giảm được giới hạn theo mức tối đa đã thiết lập.</p><button class="bakery-btn bakery-btn-primary" @onclick="Save">Tạo chiến dịch</button></div>@if(!string.IsNullOrEmpty(message)){<p class="mt-3 text-sm @(saved ? "text-emerald-600" : "text-rose-600")">@message</p>}</div>
<div class="bakery-filter-card overflow-x-auto"><table class="w-full text-sm"><thead><tr><th class="text-left p-3">Mã / chiến dịch</th><th class="text-left p-3">Thời hạn</th><th class="text-left p-3">Điều kiện</th><th class="text-left p-3">Trạng thái</th></tr></thead><tbody>@foreach(var p in campaigns){<tr class="border-t"><td class="p-3"><strong>@p.PromotionCode</strong><div>@p.PromotionName</div></td><td class="p-3">@p.StartDate.ToString("dd/MM/yyyy") – @p.EndDate.ToString("dd/MM/yyyy")</td><td class="p-3">@p.PromotionInvoice?.DiscountPercent% · đơn từ @p.PromotionInvoice?.MinOrderAmount.ToString("N0") đ · tối đa @p.PromotionInvoice?.MaxDiscountAmount?.ToString("N0") đ</td><td class="p-3">@p.Status</td></tr>}</tbody></table></div>
@code {List<Promotion> campaigns=[];Promotion campaign=new();decimal percent=10,minimum;decimal? cap=50000;DateTime start=DateTime.Today,end=DateTime.Today.AddDays(7);string? message;bool saved;protected override async Task OnInitializedAsync()=>campaigns=await PromotionManager.GetAsync();async Task Save(){try{campaign.StartDate=start;campaign.EndDate=end;if(string.IsNullOrWhiteSpace(campaign.PromotionName))campaign.PromotionName=campaign.PromotionCode;await PromotionManager.SaveAsync(campaign,percent,minimum,cap);message="Đã tạo chương trình khuyến mãi.";saved=true;campaign=new();start=DateTime.Today;end=DateTime.Today.AddDays(7);campaigns=await PromotionManager.GetAsync();}catch(Exception ex){message=ex.Message;saved=false;}}}
