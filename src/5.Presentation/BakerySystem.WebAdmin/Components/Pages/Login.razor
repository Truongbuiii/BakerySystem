@page "/login"
@layout LoginLayout
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@attribute [AllowAnonymous]
@rendermode InteractiveServer

<PageTitle>@(authMode == "register" ? "Đăng ký khách hàng" : "Đăng nhập") | BakerySystem</PageTitle>

<div class="bakery-login-card bakery-login-card-wide">
    <!-- Brand Logo & Header -->
    <div class="bakery-login-header">
        <div class="flex items-center justify-center mb-3">
            <img src="/assets/images/logos/dark-logo.svg" alt="BakerySystem" class="h-9 dark:hidden block" />
            <img src="/assets/images/logos/light-logo.svg" alt="BakerySystem" class="h-9 dark:block hidden" />
        </div>
        <h1 class="bakery-login-title">
            @(authMode == "register" ? "Đăng ký thành viên" : "Đăng nhập BakerySystem")
        </h1>
        <p class="bakery-login-subtitle">
            @(authMode == "register"
                ? "Tạo tài khoản khách hàng để đặt bánh tươi online & tích điểm thành viên"
                : "Cổng đặt bánh trực tuyến cho Khách hàng & Quản trị cửa hàng")
        </p>
    </div>

    <!-- Switcher: Đăng nhập / Đăng ký Khách hàng -->
    <div class="bakery-auth-tabs" role="tablist">
        <button type="button"
                role="tab"
                class="bakery-auth-tab @(authMode == "login" ? "active" : "")"
                @onclick='() => SwitchAuthMode("login")'>
            <iconify-icon icon="solar:login-2-linear"></iconify-icon>
            <span>Đăng nhập</span>
        </button>
        <button type="button"
                role="tab"
                class="bakery-auth-tab @(authMode == "register" ? "active" : "")"
                @onclick='() => SwitchAuthMode("register")'>
            <iconify-icon icon="solar:user-plus-rounded-linear"></iconify-icon>
            <span>Đăng ký khách hàng</span>
        </button>
    </div>

    @if (authMode == "login")
    {
        <!-- Dev Quick-Fill Helper Box: Quản trị, Nhân viên & Khách hàng -->
        <div class="bakery-login-devbox">
            <div class="flex items-center justify-between mb-1.5">
                <span class="text-[11px] font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wide">
                    Tài khoản thử nghiệm:
                </span>
                <span class="text-[10px] text-slate-500 font-mono">dev mode</span>
            </div>
            <div class="bakery-dev-chips-3">
                <button type="button"
                        class="bakery-dev-chip @(username == "admin" ? "active" : "")"
                        @onclick='() => SelectDevAccount("admin", "admin123")'
                        title="Chủ cửa hàng - Toàn quyền quản trị">
                    <span class="font-bold block">Quản trị viên</span>
                    <span class="text-[10px] opacity-75">admin</span>
                </button>
                <button type="button"
                        class="bakery-dev-chip @(username == "staffbakery" ? "active" : "")"
                        @onclick='() => SelectDevAccount("staffbakery", "staff123")'
                        title="Nhân viên cửa hàng">
                    <span class="font-bold block">Nhân viên</span>
                    <span class="text-[10px] opacity-75">staffbakery</span>
                </button>
                <button type="button"
                        class="bakery-dev-chip @(username == "hoanganh" ? "active" : "")"
                        @onclick='() => SelectDevAccount("hoanganh", "customer123")'
                        title="Khách hàng mua bánh trên Web & App">
                    <span class="font-bold block">Khách hàng</span>
                    <span class="text-[10px] opacity-75">hoanganh</span>
                </button>
            </div>
        </div>

        <!-- Login Form -->
        <div class="bakery-login-form">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="bakery-login-error">
                    <iconify-icon icon="solar:danger-triangle-linear" class="text-base shrink-0"></iconify-icon>
                    <span>@errorMessage</span>
                </div>
            }

            <!-- Username or Phone Input -->
            <div class="bakery-login-field">
                <label for="username" class="bakery-login-label">Tên đăng nhập hoặc SĐT (khách hàng)</label>
                <div class="bakery-login-input-wrap">
                    <iconify-icon icon="solar:user-linear" class="bakery-login-input-icon"></iconify-icon>
                    <input id="username"
                           type="text"
                           class="bakery-login-input"
                           placeholder="VD: hoanganh, 0912345678 hoặc admin"
                           @bind="username"
                           @bind:event="oninput"
                           @onkeydown="HandleLoginKeyDown"
                           disabled="@isLoading"
                           autocomplete="username" />
                </div>
            </div>

            <!-- Password Input -->
            <div class="bakery-login-field">
                <div class="flex items-center justify-between">
                    <label for="password" class="bakery-login-label">Mật khẩu</label>
                </div>
                <div class="bakery-login-input-wrap">
                    <iconify-icon icon="solar:lock-keyhole-linear" class="bakery-login-input-icon"></iconify-icon>
                    <input id="password"
                           type="@(showPassword ? "text" : "password")"
                           class="bakery-login-input"
                           placeholder="Nhập mật khẩu"
                           @bind="password"
                           @bind:event="oninput"
                           @onkeydown="HandleLoginKeyDown"
                           disabled="@isLoading"
                           autocomplete="current-password" />
                    <button type="button"
                            class="bakery-login-toggle-pw"
                            @onclick="() => showPassword = !showPassword"
                            tabindex="-1"
                            title="@(showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                        <iconify-icon icon="@(showPassword ? "solar:eye-closed-linear" : "solar:eye-linear")" class="text-base"></iconify-icon>
                    </button>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="button" class="bakery-login-btn" @onclick="HandleLogin" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="bakery-login-spinner"></span>
                    <span>Đang xác thực thông tin...</span>
                }
                else
                {
                    <span>Đăng nhập hệ thống</span>
                }
            </button>
        </div>
    }
    else
    {
        <!-- Customer Register Form -->
        <div class="bakery-login-form">
            @if (!string.IsNullOrEmpty(registerError))
            {
                <div class="bakery-login-error">
                    <iconify-icon icon="solar:danger-triangle-linear" class="text-base shrink-0"></iconify-icon>
                    <span>@registerError</span>
                </div>
            }

            <div class="bakery-login-field">
                <label for="reg-fullname" class="bakery-login-label">Họ và tên (*)</label>
                <div class="bakery-login-input-wrap">
                    <iconify-icon icon="solar:user-bold" class="bakery-login-input-icon"></iconify-icon>
                    <input id="reg-fullname"
                           type="text"
                           class="bakery-login-input"
                           placeholder="VD: Nguyễn Văn An"
                           @bind="regFullName"
                           @bind:event="oninput"
                           disabled="@isLoading" />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div class="bakery-login-field">
                    <label for="reg-username" class="bakery-login-label">Tên đăng nhập (*)</label>
                    <div class="bakery-login-input-wrap">
                        <iconify-icon icon="solar:user-id-linear" class="bakery-login-input-icon"></iconify-icon>
                        <input id="reg-username"
                               type="text"
                               class="bakery-login-input"
                               placeholder="Tối thiểu 3 ký tự"
                               @bind="regUsername"
                               @bind:event="oninput"
                               disabled="@isLoading"
                               autocomplete="username" />
                    </div>
                </div>

                <div class="bakery-login-field">
                    <label for="reg-phone" class="bakery-login-label">Số điện thoại (*)</label>
                    <div class="bakery-login-input-wrap">
                        <iconify-icon icon="solar:phone-linear" class="bakery-login-input-icon"></iconify-icon>
                        <input id="reg-phone"
                               type="tel"
                               class="bakery-login-input"
                               placeholder="VD: 0912345678"
                               @bind="regPhone"
                               @bind:event="oninput"
                               disabled="@isLoading" />
                    </div>
                </div>
            </div>

            <div class="bakery-login-field">
                <label for="reg-address" class="bakery-login-label">Địa chỉ giao bánh mặc định</label>
                <div class="bakery-login-input-wrap">
                    <iconify-icon icon="solar:map-point-linear" class="bakery-login-input-icon"></iconify-icon>
                    <input id="reg-address"
                           type="text"
                           class="bakery-login-input"
                           placeholder="VD: 123 Lê Lợi, Q.1, TP.HCM"
                           @bind="regAddress"
                           @bind:event="oninput"
                           disabled="@isLoading" />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div class="bakery-login-field">
                    <label for="reg-password" class="bakery-login-label">Mật khẩu (*)</label>
                    <div class="bakery-login-input-wrap">
                        <iconify-icon icon="solar:lock-keyhole-linear" class="bakery-login-input-icon"></iconify-icon>
                        <input id="reg-password"
                               type="@(showRegisterPassword ? "text" : "password")"
                               class="bakery-login-input"
                               placeholder="Ít nhất 6 ký tự"
                               @bind="regPassword"
                               @bind:event="oninput"
                               disabled="@isLoading"
                               autocomplete="new-password" />
                        <button type="button"
                                class="bakery-login-toggle-pw"
                                @onclick="() => showRegisterPassword = !showRegisterPassword"
                                tabindex="-1">
                            <iconify-icon icon="@(showRegisterPassword ? "solar:eye-closed-linear" : "solar:eye-linear")" class="text-base"></iconify-icon>
                        </button>
                    </div>
                </div>

                <div class="bakery-login-field">
                    <label for="reg-confirm" class="bakery-login-label">Xác nhận mật khẩu (*)</label>
                    <div class="bakery-login-input-wrap">
                        <iconify-icon icon="solar:check-circle-linear" class="bakery-login-input-icon"></iconify-icon>
                        <input id="reg-confirm"
                               type="@(showRegisterPassword ? "text" : "password")"
                               class="bakery-login-input"
                               placeholder="Nhập lại mật khẩu"
                               @bind="regConfirmPassword"
                               @bind:event="oninput"
                               @onkeydown="HandleRegisterKeyDown"
                               disabled="@isLoading"
                               autocomplete="new-password" />
                    </div>
                </div>
            </div>

            <button type="button" class="bakery-login-btn" @onclick="HandleRegister" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="bakery-login-spinner"></span>
                    <span>Đang tạo tài khoản...</span>
                }
                else
                {
                    <span>Tạo tài khoản &amp; Mua bánh ngay</span>
                }
            </button>
        </div>
    }

    <!-- Card Footer -->
    <div class="bakery-login-footer">
        <span>&copy; @DateTime.Now.Year BakerySystem. Đồng bộ tài khoản trên Web &amp; Mobile App.</span>
    </div>
</div>

<script>
    window.bakeryAuth = window.bakeryAuth || {};
    window.bakeryAuth.resolveTargetUrl = function (role, returnUrl) {
        const cleanReturn = returnUrl ? ('/' + returnUrl.replace(/^\/+/, '')) : '';
        if (role === 'Customer') {
            if (cleanReturn && (cleanReturn.startsWith('/shop') || cleanReturn.startsWith('/my-orders') || cleanReturn.startsWith('/profile'))) {
                return cleanReturn;
            }
            return '/shop';
        }
        if (role === 'Employee') {
            if (cleanReturn && cleanReturn !== '/' && !cleanReturn.startsWith('/login')) {
                return cleanReturn;
            }
            return '/pos';
        }
        if (cleanReturn && !cleanReturn.startsWith('/login')) {
            return cleanReturn;
        }
        return '/';
    };

    window.bakeryAuth.login = async function (username, password, returnUrl) {
        try {
            const resp = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username: username, password: password })
            });
            if (!resp.ok) {
                let errText = 'Lỗi máy chủ (' + resp.status + ')';
                try {
                    const errJson = await resp.json();
                    if (errJson.errorMessage) errText = errJson.errorMessage;
                    else if (errJson.title) errText = errJson.title;
                } catch (_) {}
                return { success: false, errorMessage: errText };
            }
            const data = await resp.json();
            if (data.success) {
                window.location.href = window.bakeryAuth.resolveTargetUrl(data.role, returnUrl);
                return { success: true };
            } else {
                return { success: false, errorMessage: data.errorMessage || 'Đăng nhập không thành công.' };
            }
        } catch (err) {
            return { success: false, errorMessage: 'Không thể kết nối đến máy chủ: ' + (err.message || 'Lỗi mạng') };
        }
    };

    window.bakeryAuth.register = async function (payload) {
        try {
            const resp = await fetch('/api/auth/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (!resp.ok) {
                return { success: false, errorMessage: 'Lỗi máy chủ (' + resp.status + ')' };
            }
            const data = await resp.json();
            if (data.success) {
                window.location.href = '/shop';
                return { success: true };
            }
            return { success: false, errorMessage: data.errorMessage || 'Đăng ký không thành công.' };
        } catch (err) {
            return { success: false, errorMessage: 'Không thể kết nối đến máy chủ: ' + (err.message || 'Lỗi mạng') };
        }
    };

    window.bakeryAuth.logout = async function () {
        try {
            await fetch('/api/auth/logout', { method: 'POST' });
        } finally {
            window.location.href = '/login';
        }
    };
</script>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string authMode = "login";

    // Login state
    private string username = "admin";
    private string password = "admin123";
    private string? errorMessage;
    private bool isLoading;
    private bool showPassword;

    // Register state
    private string regFullName = string.Empty;
    private string regUsername = string.Empty;
    private string regPhone = string.Empty;
    private string regAddress = string.Empty;
    private string regPassword = string.Empty;
    private string regConfirmPassword = string.Empty;
    private string? registerError;
    private bool showRegisterPassword;

    private void SwitchAuthMode(string mode)
    {
        authMode = mode;
        errorMessage = null;
        registerError = null;
    }

    private void SelectDevAccount(string u, string p)
    {
        username = u;
        password = p;
        errorMessage = null;
    }

    private async Task HandleLoginKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }

    private async Task HandleRegisterKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleRegister();
        }
    }

    private async Task HandleLogin()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Vui lòng nhập đầy đủ tên đăng nhập và mật khẩu.";
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var response = await JSRuntime.InvokeAsync<AuthJsResponse>("bakeryAuth.login", username.Trim(), password, ReturnUrl);
            if (!response.Success)
            {
                errorMessage = response.ErrorMessage ?? "Đăng nhập không thành công.";
                isLoading = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi kết nối: " + ex.Message;
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleRegister()
    {
        registerError = null;

        if (string.IsNullOrWhiteSpace(regFullName))
        {
            registerError = "Vui lòng nhập họ và tên của bạn.";
            return;
        }

        if (string.IsNullOrWhiteSpace(regUsername) || regUsername.Trim().Length < 3)
        {
            registerError = "Tên đăng nhập phải có ít nhất 3 ký tự.";
            return;
        }

        if (string.IsNullOrWhiteSpace(regPhone))
        {
            registerError = "Vui lòng nhập số điện thoại liên hệ nhận bánh.";
            return;
        }

        if (string.IsNullOrWhiteSpace(regPassword) || regPassword.Length < 6)
        {
            registerError = "Mật khẩu phải có ít nhất 6 ký tự.";
            return;
        }

        if (regPassword != regConfirmPassword)
        {
            registerError = "Xác nhận mật khẩu không trùng khớp.";
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var payload = new CustomerRegisterRequest
            {
                FullName = regFullName.Trim(),
                Username = regUsername.Trim(),
                Phone = regPhone.Trim(),
                Address = regAddress.Trim(),
                Password = regPassword,
                ConfirmPassword = regConfirmPassword
            };

            var response = await JSRuntime.InvokeAsync<AuthJsResponse>("bakeryAuth.register", payload);
            if (!response.Success)
            {
                registerError = response.ErrorMessage ?? "Đăng ký không thành công.";
                isLoading = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            registerError = "Lỗi kết nối: " + ex.Message;
            isLoading = false;
            StateHasChanged();
        }
    }

    private class AuthJsResponse
    {
        public bool Success { get; set; }
        public string? ErrorMessage { get; set; }
    }
}
