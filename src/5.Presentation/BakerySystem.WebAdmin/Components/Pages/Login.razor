@page "/login"
@layout LoginLayout
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@attribute [AllowAnonymous]
@rendermode InteractiveServer

<PageTitle>Đăng nhập | BakeryAdmin</PageTitle>

<div class="bakery-login-card">
    <!-- Brand Logo & Header -->
    <div class="bakery-login-header">
        <div class="flex items-center justify-center mb-3">
            <img src="/assets/images/logos/dark-logo.svg" alt="BakeryAdmin" class="h-9 dark:hidden block" />
            <img src="/assets/images/logos/light-logo.svg" alt="BakeryAdmin" class="h-9 dark:block hidden" />
        </div>
        <h1 class="bakery-login-title">Đăng nhập BakeryAdmin</h1>
        <p class="bakery-login-subtitle">Hệ thống quản lý bán hàng, kho &amp; vận hành nội bộ</p>
    </div>

    <!-- Dev Quick-Fill Helper Box: Admin & Employee only -->
    <div class="bakery-login-devbox">
        <div class="flex items-center justify-between mb-1.5">
            <span class="text-[11px] font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wide">
                Tài khoản nội bộ thử nghiệm:
            </span>
            <span class="text-[10px] text-slate-500 font-mono">dev mode</span>
        </div>
        <div class="bakery-dev-chips-2">
            <button type="button"
                    class="bakery-dev-chip @(username == "admin" ? "active" : "")"
                    @onclick='() => SelectDevAccount("admin", "admin123")'
                    title="Chủ cửa hàng - Toàn quyền quản trị">
                <span class="font-bold block">Quản trị viên</span>
                <span class="text-[10px] opacity-75">admin</span>
            </button>
            <button type="button"
                    class="bakery-dev-chip @(username == "staffbakery" ? "active" : "")"
                    @onclick='() => SelectDevAccount("staffbakery", "staff123")'
                    title="Nhân viên cửa hàng">
                <span class="font-bold block">Nhân viên</span>
                <span class="text-[10px] opacity-75">staffbakery</span>
            </button>
        </div>
    </div>

    <!-- Login Form -->
    <div class="bakery-login-form">
        @if (string.Equals(Reason, "timeout", StringComparison.OrdinalIgnoreCase))
        {
            <div class="bakery-login-error" style="background: #fffbeb; border-color: #fde68a; color: #92400e;">
                <iconify-icon icon="solar:clock-circle-linear" class="text-base shrink-0"></iconify-icon>
                <span>Phiên đăng nhập đã hết hạn để đảm bảo an toàn. Vui lòng đăng nhập lại.</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="bakery-login-error">
                <iconify-icon icon="solar:danger-triangle-linear" class="text-base shrink-0"></iconify-icon>
                <span>@errorMessage</span>
            </div>
        }

        <div class="bakery-login-field">
            <label for="username" class="bakery-login-label">Tên đăng nhập</label>
            <div class="bakery-login-input-wrap">
                <iconify-icon icon="solar:user-linear" class="bakery-login-input-icon"></iconify-icon>
                <input id="username"
                       type="text"
                       class="bakery-login-input"
                       placeholder="VD: admin hoặc staffbakery"
                       @bind="username"
                       @bind:event="oninput"
                       @onkeydown="HandleLoginKeyDown"
                       disabled="@isLoading"
                       autocomplete="username" />
            </div>
        </div>

        <div class="bakery-login-field">
            <label for="password" class="bakery-login-label">Mật khẩu</label>
            <div class="bakery-login-input-wrap">
                <iconify-icon icon="solar:lock-keyhole-linear" class="bakery-login-input-icon"></iconify-icon>
                <input id="password"
                       type="@(showPassword ? "text" : "password")"
                       class="bakery-login-input"
                       placeholder="Nhập mật khẩu"
                       @bind="password"
                       @bind:event="oninput"
                       @onkeydown="HandleLoginKeyDown"
                       disabled="@isLoading"
                       autocomplete="current-password" />
                <button type="button"
                        class="bakery-login-toggle-pw"
                        @onclick="() => showPassword = !showPassword"
                        tabindex="-1"
                        title="@(showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                    <iconify-icon icon="@(showPassword ? "solar:eye-closed-linear" : "solar:eye-linear")" class="text-base"></iconify-icon>
                </button>
            </div>
        </div>

        <button type="button" class="bakery-login-btn" @onclick="HandleLogin" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="bakery-login-spinner"></span>
                <span>Đang xác thực thông tin...</span>
            }
            else
            {
                <span>Đăng nhập hệ thống</span>
            }
        </button>
    </div>

    <!-- Card Footer -->
    <div class="bakery-login-footer">
        <span>&copy; @DateTime.Now.Year BakerySystem Admin Portal.</span>
    </div>
</div>

<script>
    window.bakeryAuth = window.bakeryAuth || {};
    if (window.bakeryAuth.stopIdleTimer) {
        window.bakeryAuth.stopIdleTimer();
    }
    window.bakeryAuth.resolveTargetUrl = function (role, returnUrl) {
        const cleanReturn = returnUrl ? ('/' + returnUrl.replace(/^\/+/, '')) : '';
        if (role === 'Employee') {
            if (cleanReturn && cleanReturn !== '/' && !cleanReturn.startsWith('/login')) {
                return cleanReturn;
            }
            return '/pos';
        }
        if (cleanReturn && !cleanReturn.startsWith('/login')) {
            return cleanReturn;
        }
        return '/';
    };

    window.bakeryAuth.login = async function (username, password, returnUrl) {
        try {
            const resp = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username: username, password: password })
            });
            if (!resp.ok) {
                let errText = 'Lỗi máy chủ (' + resp.status + ')';
                try {
                    const errJson = await resp.json();
                    if (errJson.errorMessage) errText = errJson.errorMessage;
                    else if (errJson.title) errText = errJson.title;
                } catch (_) {}
                return { success: false, errorMessage: errText };
            }
            const data = await resp.json();
            if (data.success) {
                window.location.href = window.bakeryAuth.resolveTargetUrl(data.role, returnUrl);
                return { success: true };
            } else {
                return { success: false, errorMessage: data.errorMessage || 'Đăng nhập không thành công.' };
            }
        } catch (err) {
            return { success: false, errorMessage: 'Không thể kết nối đến máy chủ: ' + (err.message || 'Lỗi mạng') };
        }
    };

    window.bakeryAuth.logout = async function () {
        try {
            await fetch('/api/auth/logout', { method: 'POST' });
        } finally {
            window.location.href = '/login';
        }
    };
</script>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "reason")]
    public string? Reason { get; set; }

    private string username = "admin";
    private string password = "admin123";
    private string? errorMessage;
    private bool isLoading;
    private bool showPassword;

    private void SelectDevAccount(string u, string p)
    {
        username = u;
        password = p;
        errorMessage = null;
    }

    private async Task HandleLoginKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }

    private async Task HandleLogin()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Vui lòng nhập đầy đủ tên đăng nhập và mật khẩu.";
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var response = await JSRuntime.InvokeAsync<AuthJsResponse>("bakeryAuth.login", username.Trim(), password, ReturnUrl);
            if (!response.Success)
            {
                errorMessage = response.ErrorMessage ?? "Đăng nhập không thành công.";
                isLoading = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi kết nối: " + ex.Message;
            isLoading = false;
            StateHasChanged();
        }
    }

    private class AuthJsResponse
    {
        public bool Success { get; set; }
        public string? ErrorMessage { get; set; }
    }
}
