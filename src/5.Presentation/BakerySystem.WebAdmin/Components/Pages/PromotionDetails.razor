@page "/promotions/{PromotionId:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject PromotionService PromotionManager
@inject NavigationManager Navigation

<PageTitle>Chi tiết khuyến mãi | BakerySystem</PageTitle>

<div class="bakery-page-header">
    <div class="promotion-detail-header">
        <a href="/promotions" class="promotion-back-link">← Danh sách khuyến mãi</a>
        @if (promotion is not null)
        {
            <div class="promotion-detail-title-row">
                <div>
                    <p class="promotion-detail-kicker">CHI TIẾT CHƯƠNG TRÌNH</p>
                    <h2>@promotion.PromotionName</h2>
                    <div class="promotion-detail-code-row">
                        <span>Mã khuyến mãi</span>
                        <strong>@promotion.PromotionCode</strong>
                        <span class="promotion-detail-type">@GetPromotionTypeText()</span>
                    </div>
                </div>
                <div class="promotion-header-statuses">
                    <span class="promotion-status @(promotion.Status == PromotionStatus.Active ? "promotion-status-active" : "")">@GetAdminStatusText()</span>
                    <span class="promotion-status promotion-validity-status @(IsPromotionCurrentlyValid() ? "promotion-status-active" : "")">@GetValidityText()</span>
                </div>
            </div>
        }
        else
        {
            <h2 class="mt-2 text-2xl font-bold">Chi tiết khuyến mãi</h2>
        }
    </div>
    @if (promotion is not null)
    {
        <div class="flex flex-wrap gap-2">
            <a class="bakery-btn bakery-btn-primary" href="/promotions?edit=@PromotionId">Sửa khuyến mãi</a>
            <button type="button" class="bakery-btn bakery-btn-secondary" @onclick="ToggleStatus">
                @(promotion.Status == PromotionStatus.Active ? "Tạm dừng" : "Kích hoạt")
            </button>
            @if (!hasBeenUsed &&
                (promotion.Status != PromotionStatus.Active || promotion.EndDate.Date < DateTime.Today))
            {
                <button type="button" class="bakery-btn bakery-btn-outline text-rose-600" @onclick="() => showDeleteConfirmation = true">Xóa (chưa sử dụng)</button>
            }
        </div>
    }
</div>

@if (showDeleteConfirmation && promotion is not null)
{
    <div class="promotion-confirm-backdrop" @onclick="CancelDelete">
        <section class="promotion-confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="promotion-detail-delete-title" @onclick:stopPropagation="true">
            <div class="promotion-confirm-icon"><iconify-icon icon="solar:trash-bin-trash-linear"></iconify-icon></div>
            <h3 id="promotion-detail-delete-title" class="promotion-confirm-title">Xóa khuyến mãi?</h3>
            <p class="promotion-confirm-copy">Bạn đang chuẩn bị xóa mã <strong>@promotion.PromotionCode</strong> – @promotion.PromotionName.</p>
            <div class="promotion-confirm-note"><iconify-icon icon="solar:info-circle-linear"></iconify-icon><span>Chỉ mã chưa được sử dụng mới có thể xóa. Thao tác này không thể hoàn tác.</span></div>
            @if (!string.IsNullOrWhiteSpace(deleteError))
            {
                <p class="promotion-confirm-error">@deleteError</p>
            }
            <div class="promotion-confirm-actions">
                <button type="button" class="bakery-btn bakery-btn-secondary" @onclick="CancelDelete" disabled="@deleting">Hủy</button>
                <button type="button" class="promotion-confirm-delete" @onclick="DeletePromotion" disabled="@deleting">
                    @if (deleting)
                    {
                        <span>Đang xóa...</span>
                    }
                    else
                    {
                        <iconify-icon icon="solar:trash-bin-trash-linear"></iconify-icon><span>Xóa khuyến mãi</span>
                    }
                </button>
            </div>
        </section>
    </div>
}

@if (!string.IsNullOrWhiteSpace(actionMessage))
{
    <div class="bakery-filter-card mb-4 text-sm">@actionMessage</div>
}

@if (promotion is null)
{
    <div class="bakery-filter-card text-center text-slate-500">Không tìm thấy chương trình khuyến mãi.</div>
}
else
{
    <div class="space-y-5">
        <section class="bakery-filter-card !p-6">
            <div class="promotion-section-heading">
                <div>
                    <h3 class="text-lg font-bold tracking-tight text-slate-800">Thông tin chương trình</h3>
                    <p>Tổng quan về thời hạn, trạng thái và giới hạn sử dụng.</p>
                </div>
            </div>

            <dl class="promotion-detail-overview-grid">
                <div>
                    <dt class="flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-slate-500"><iconify-icon icon="solar:calendar-date-linear" class="text-base text-blue-500"></iconify-icon>Thời gian áp dụng</dt>
                    <dd class="mt-2 text-sm font-semibold leading-6 text-slate-800">@promotion.StartDate.ToString("dd/MM/yyyy") – @promotion.EndDate.ToString("dd/MM/yyyy")</dd>
                </div>
                <div>
                    <dt class="flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-slate-500"><iconify-icon icon="solar:shield-check-linear" class="text-base text-emerald-500"></iconify-icon>Trạng thái quản trị</dt>
                    <dd class="mt-2 text-sm font-semibold leading-6 text-slate-800">@GetAdminStatusText()</dd>
                </div>
                <div>
                    <dt class="flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-slate-500"><iconify-icon icon="solar:document-text-linear" class="text-base text-violet-500"></iconify-icon>Mô tả</dt>
                    <dd class="mt-2 text-sm font-medium leading-6 text-slate-700">@(string.IsNullOrWhiteSpace(promotion.Description) ? "Chưa có mô tả" : promotion.Description)</dd>
                </div>
                @if (promotion.PromotionInvoice is { } invoice)
                {
                    <div class="promotion-overview-highlight">
                        <dt class="flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-slate-500"><iconify-icon icon="solar:ticket-sale-linear" class="text-base text-blue-600"></iconify-icon>Lượt sử dụng</dt>
                        <dd class="mt-2 text-lg font-bold leading-6 text-slate-900">@ordersUsing.Count <span class="text-sm font-medium text-slate-500">@(invoice.UsageLimit.HasValue ? $"/ {invoice.UsageLimit.Value}" : "lượt")</span></dd>
                    </div>
                }
                <div>
                    <dt class="flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-slate-500"><iconify-icon icon="solar:users-group-rounded-linear" class="text-base text-amber-500"></iconify-icon>Giới hạn mỗi khách</dt>
                    <dd class="mt-2 text-sm font-semibold leading-6 text-slate-700">Chưa cấu hình</dd>
                </div>
            </dl>
        </section>

        <section class="bakery-filter-card !p-6">
            <div class="promotion-section-heading">
                <h3 class="text-lg font-bold tracking-tight text-slate-800">Điều kiện ưu đãi</h3>
                <p>Quy tắc tính giảm giá của chương trình này.</p>
            </div>
            <div class="promotion-detail-condition-grid">
                @if (promotion.PromotionInvoice is { } invoiceRule)
                {
                    <div class="promotion-condition-card">
                        <h4 class="mb-3 flex items-center gap-2 font-semibold text-slate-800"><iconify-icon icon="solar:bill-list-linear" class="text-lg text-blue-500"></iconify-icon>Theo tổng đơn hàng</h4>
                        <p class="mb-2 text-sm leading-6 text-slate-600">Đơn từ <strong class="text-slate-900">@invoiceRule.MinOrderAmount.ToString("N0") đ</strong> được giảm <strong class="text-slate-900">@(invoiceRule.DiscountPercent.ToString("0.##"))%</strong>.</p>
                        @if (invoiceRule.MaxDiscountAmount is > 0)
                        {
                            <p class="mb-0 text-sm leading-6 text-slate-600">Mức giảm tối đa: <strong class="text-slate-900">@invoiceRule.MaxDiscountAmount.Value.ToString("N0") đ</strong>.</p>
                        }
                    </div>
                }

                @if (promotion.PromotionProducts.Count > 0)
                {
                    var productRule = promotion.PromotionProducts.First();
                    <div class="promotion-condition-card">
                        <h4 class="mb-3 flex items-center gap-2 font-semibold text-slate-800"><iconify-icon icon="solar:cup-star-linear" class="text-lg text-rose-500"></iconify-icon>Theo sản phẩm</h4>
                        <p class="mb-3 text-sm leading-6 text-slate-600">Giảm <strong class="text-slate-900">@(productRule.DiscountPercent.ToString("0.##"))%</strong> cho sản phẩm được chọn.</p>
                        @if (productRule.MaxDiscountAmount is > 0)
                        {
                        <p class="mb-3 text-sm leading-6 text-slate-600">Tối đa <strong class="text-slate-900">@productRule.MaxDiscountAmount.Value.ToString("N0") đ</strong> mỗi sản phẩm.</p>
                        }
                        <div class="flex flex-wrap gap-2">
                            @foreach (var item in promotion.PromotionProducts.OrderBy(item => item.Product?.ProductName).Take(6))
                            {
                                <span class="bakery-badge bakery-badge-success">@(item.Product?.ProductName ?? $"Sản phẩm {item.ProductID}")</span>
                            }
                            @if (promotion.PromotionProducts.Count > 6)
                            {
                                <span class="bakery-badge bakery-badge-secondary">+@(promotion.PromotionProducts.Count - 6) sản phẩm</span>
                            }
                        </div>
                    </div>
                    @if (promotion.PromotionInvoice is not null)
                    {
                        <p class="text-xs text-slate-500">Ưu đãi theo sản phẩm chỉ áp dụng cho các bánh trong danh sách; ưu đãi theo hóa đơn xét tổng giá trị đơn hàng.</p>
                    }
                }
                else if (promotion.PromotionInvoice is not null)
                {
                    <div class="promotion-condition-card">
                        <h4 class="mb-2 flex items-center gap-2 font-semibold text-slate-800"><iconify-icon icon="solar:info-circle-linear" class="text-lg text-blue-500"></iconify-icon>Phạm vi áp dụng</h4>
                        <p class="mb-0 text-sm leading-6 text-slate-600">Điều kiện hóa đơn áp dụng theo tổng giá trị đơn hàng; không giới hạn vào danh mục bánh cụ thể.</p>
                    </div>
                }

                @if (promotion.PromotionOrderTier is { } tier)
                {
                    <div class="promotion-condition-card">
                        <h4 class="mb-3 flex items-center gap-2 font-semibold text-slate-800"><iconify-icon icon="solar:wallet-money-linear" class="text-lg text-emerald-500"></iconify-icon>Theo mức đơn hàng</h4>
                        <p class="mb-0 text-sm leading-6 text-slate-600">Đơn từ <strong class="text-slate-900">@tier.MinOrderAmount.ToString("N0") đ</strong> được giảm <strong class="text-slate-900">@(tier.DiscountPercent.ToString("0.##"))%</strong>.</p>
                    </div>
                }

                @if (promotion.PromotionInvoice is null && promotion.PromotionProducts.Count == 0 && promotion.PromotionOrderTier is null)
                {
                    <p class="text-sm text-slate-500">Chương trình chưa có điều kiện ưu đãi.</p>
                }
            </div>
        </section>
    </div>

    <section class="bakery-filter-card promotion-usage-section !p-6 mt-5">
        <div class="promotion-section-heading promotion-usage-heading">
            <div>
                <h3 class="flex items-center gap-2 text-lg font-bold tracking-tight text-slate-800"><iconify-icon icon="solar:chart-2-linear" class="text-xl text-blue-500"></iconify-icon>Thống kê sử dụng</h3>
                <p>Số liệu tính từ các đơn hàng có liên kết trực tiếp với mã khuyến mãi.</p>
            </div>
            <a class="bakery-btn bakery-btn-secondary bakery-btn-sm" href="/orders">Mở quản lý đơn hàng</a>
        </div>
        <div class="promotion-usage-stats">
            <div><div>Đơn đã sử dụng</div><strong>@ordersUsing.Count</strong></div>
            <div><div>Tổng tiền giảm</div><strong>@ordersUsing.Sum(o => o.DiscountAmount).ToString("N0") <span>đ</span></strong></div>
            <div><div>Giới hạn chiến dịch</div><strong>@(promotion.PromotionInvoice?.UsageLimit?.ToString() ?? "Không giới hạn")</strong></div>
        </div>
        @if (promotion.PromotionInvoice is { } usageInfo && usageInfo.UsedCount != ordersUsing.Count)
        {
            <p class="mb-4 rounded-lg bg-amber-50 p-3 text-sm text-amber-800">
                Bộ đếm lưu trong mã là @usageInfo.UsedCount@(usageInfo.UsageLimit.HasValue ? $"/{usageInfo.UsageLimit.Value}" : "") lượt, nhưng có @ordersUsing.Count đơn liên kết thực tế. Số lượt hiển thị được tính theo các đơn đã liên kết; cần đồng bộ lại dữ liệu gốc nếu muốn hai giá trị bằng nhau.
            </p>
        }
        <div class="overflow-x-auto">
            <table class="promotion-history-table w-full text-sm">
                <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="text-left p-3">Mã đơn</th><th class="text-left p-3">Khách hàng</th><th class="text-left p-3">Thời gian</th><th class="text-right p-3">Số tiền giảm</th></tr></thead>
                <tbody>
                    @if (ordersUsing.Count == 0)
                    {
                        <tr><td colspan="4" class="p-8 text-center text-slate-500">Chưa có đơn hàng nào được liên kết với mã này.</td></tr>
                    }
                    else
                    {
                        @foreach (var order in ordersUsing)
                        {
                            <tr class="border-t border-slate-100"><td class="p-3 font-semibold"><a class="text-primary hover:underline" href="/orders?order=@order.OrderID">HD-@order.OrderID.ToString("D4")</a></td><td class="promotion-history-customer p-3" title="@(order.Customer?.FullName ?? "Khách hàng")">@(order.Customer?.FullName ?? "Khách hàng")</td><td class="p-3 text-slate-600">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td><td class="p-3 text-right font-semibold">@order.DiscountAmount.ToString("N0") đ</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (promotion.PromotionProducts.Count > 0)
        {
            <p class="mt-3 text-xs text-amber-700">Lưu ý: mô hình đơn hàng hiện chỉ lưu mã khuyến mãi hóa đơn; lượt giảm riêng theo sản phẩm không được liên kết riêng vào đơn, nên lịch sử này không thể thống kê đầy đủ phần giảm theo bánh.</p>
        }
    </section>
    <div class="mt-4"><a class="bakery-btn bakery-btn-secondary" href="/promotions">Quay về danh sách</a></div>
}

@code {
    [Parameter] public int PromotionId { get; set; }

    private Promotion? promotion;
    private List<Order> ordersUsing = [];
    private string? actionMessage;
    private bool hasBeenUsed;
    private bool showDeleteConfirmation;
    private bool deleting;
    private string? deleteError;

    private string GetAdminStatusText() => promotion?.Status switch
    {
        PromotionStatus.Active => "Đang bật",
        PromotionStatus.Draft => "Bản nháp",
        _ => "Đã tạm dừng"
    } ?? string.Empty;

    private string GetPromotionTypeText()
    {
        if (promotion is null)
            return string.Empty;
        if (promotion.PromotionInvoice is not null && promotion.PromotionProducts.Count > 0)
            return "Hóa đơn + sản phẩm";
        if (promotion.PromotionInvoice is not null)
            return "Theo hóa đơn";
        if (promotion.PromotionProducts.Count > 0)
            return "Theo sản phẩm";
        return "Chưa có điều kiện";
    }

    private bool IsPromotionCurrentlyValid() =>
        promotion?.Status == PromotionStatus.Active &&
        promotion.StartDate.Date <= DateTime.Today &&
        promotion.EndDate.Date >= DateTime.Today;

    private string GetValidityText()
    {
        if (promotion is null)
            return string.Empty;
        if (promotion.StartDate.Date > DateTime.Today)
            return "Sắp diễn ra";
        if (promotion.EndDate.Date < DateTime.Today)
            return "Đã hết hạn";
        if (promotion.Status != PromotionStatus.Active)
            return "Đang tạm dừng";
        return "Đang áp dụng";
    }

    protected override async Task OnParametersSetAsync()
    {
        promotion = await PromotionManager.GetByIdAsync(PromotionId);
        ordersUsing = await PromotionManager.GetOrdersUsingAsync(PromotionId);
        hasBeenUsed = await PromotionManager.HasBeenUsedAsync(PromotionId);
    }

    private async Task ToggleStatus()
    {
        if (promotion is null)
            return;
        var next = promotion.Status == PromotionStatus.Active ? PromotionStatus.Inactive : PromotionStatus.Active;
        try
        {
            await PromotionManager.SetStatusAsync(PromotionId, next);
            promotion.Status = next;
            actionMessage = next == PromotionStatus.Active ? "Đã kích hoạt khuyến mãi. Khách có thể dùng khi mã còn hạn và còn lượt." : "Đã tạm dừng khuyến mãi; khách không thể áp dụng cho đơn mới.";
        }
        catch (Exception ex)
        {
            actionMessage = $"Không thể cập nhật trạng thái: {GetExceptionMessage(ex)}";
        }
    }

    private async Task DeletePromotion()
    {
        if (hasBeenUsed || promotion is null || deleting)
            return;
        deleting = true;
        try
        {
            await PromotionManager.DeleteUnusedAsync(PromotionId);
            Navigation.NavigateTo("/promotions");
        }
        catch (Exception ex)
        {
            hasBeenUsed = await PromotionManager.HasBeenUsedAsync(PromotionId);
            deleteError = ex.Message;
        }
        finally
        {
            deleting = false;
        }
    }

    private void CancelDelete()
    {
        if (deleting)
            return;
        showDeleteConfirmation = false;
        deleteError = null;
    }

    private static string GetExceptionMessage(Exception exception)
    {
        var messages = new List<string>();
        for (var current = exception; current is not null; current = current.InnerException)
            messages.Add(current.Message);
        return string.Join(" → ", messages.Distinct());
    }

}
