@page "/suppliers"
@rendermode InteractiveServer
@inject InventoryService Inventory
<PageTitle>Nhà cung cấp | BakerySystem</PageTitle>
<div class="bakery-page-header"><div><h2 class="text-2xl font-bold">Nhà cung cấp</h2><p class="text-bodytext">Danh bạ đối tác nguyên liệu và xưởng bánh.</p></div></div>
<div class="bakery-filter-card mb-4"><div class="grid md:grid-cols-4 gap-3 items-end">
<label>Tên nhà cung cấp<input class="bakery-input w-full" @bind="form.SupplierName" /></label><label>Số điện thoại<input class="bakery-input w-full" @bind="form.Phone" /></label><label>Địa chỉ<input class="bakery-input w-full" @bind="form.Address" /></label>
<div class="flex gap-2"><button class="bakery-btn bakery-btn-primary" @onclick="Save">@(form.SupplierID == 0 ? "Thêm nhà cung cấp" : "Lưu thay đổi")</button>@if(form.SupplierID != 0){<button class="bakery-btn bakery-btn-secondary" @onclick="Reset">Hủy</button>}</div></div>@if(!string.IsNullOrEmpty(message)){<p class="mt-3 text-sm text-rose-600">@message</p>}</div>
<div class="bakery-filter-card overflow-x-auto"><table class="w-full text-sm"><thead><tr><th class="text-left p-3">Nhà cung cấp</th><th class="text-left p-3">Số điện thoại</th><th class="text-left p-3">Địa chỉ</th><th></th></tr></thead><tbody>@foreach(var supplier in suppliers){<tr class="border-t"><td class="p-3 font-semibold">@supplier.SupplierName</td><td class="p-3">@supplier.Phone</td><td class="p-3">@supplier.Address</td><td class="p-3 text-right"><button class="bakery-btn bakery-btn-secondary bakery-btn-sm" @onclick="() => Edit(supplier)">Sửa</button></td></tr>}</tbody></table>@if(suppliers.Count == 0){<p class="p-6 text-center text-slate-500">Chưa có nhà cung cấp.</p>}</div>
@code { List<Supplier> suppliers = []; Supplier form = new(); string? message; protected override async Task OnInitializedAsync()=>await Load(); async Task Load()=>suppliers=await Inventory.GetSuppliersAsync(); void Edit(Supplier s)=>form=new(){SupplierID=s.SupplierID,SupplierName=s.SupplierName,Phone=s.Phone,Address=s.Address}; void Reset()=>form=new(); async Task Save(){try{await Inventory.SaveSupplierAsync(form);message=null;Reset();await Load();}catch(Exception ex){message=ex.Message;}} }
