@page "/suppliers"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject InventoryService Inventory

<PageTitle>Nhà cung cấp | BakerySystem</PageTitle>

<div class="bakery-page-header">
    <div>
        <div class="flex items-center gap-2 text-xs font-medium text-slate-500 mb-1">
            <a href="/" class="hover:text-primary">Tổng quan</a>
            <span>/</span>
            <span class="font-semibold text-slate-800 dark:text-slate-200">Nhà cung cấp</span>
        </div>
        <h2 class="text-2xl font-bold">Quản lý nhà cung cấp</h2>
        <p class="text-bodytext">Quản lý đối tác, trạng thái hoạt động và bánh được phân công.</p>
    </div>
    <div class="bakery-page-actions">
        <button class="bakery-btn bakery-btn-secondary bakery-btn-sm" @onclick="Load">Làm mới</button>
        <button class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick="OpenCreateSupplierModal">Thêm nhà cung cấp</button>
    </div>
</div>

<div class="bakery-kpi-grid">
    <div class="bakery-kpi-card"><div class="bakery-kpi-content"><span class="bakery-kpi-label">Tổng nhà cung cấp</span><div class="bakery-kpi-val">@suppliers.Count</div></div></div>
    <div class="bakery-kpi-card"><div class="bakery-kpi-content"><span class="bakery-kpi-label">Đang hoạt động</span><div class="bakery-kpi-val text-emerald-600">@suppliers.Count(x => x.IsActive)</div></div></div>
    <div class="bakery-kpi-card"><div class="bakery-kpi-content"><span class="bakery-kpi-label">Đã ẩn</span><div class="bakery-kpi-val text-rose-500">@suppliers.Count(x => !x.IsActive)</div></div></div>
    <div class="bakery-kpi-card"><div class="bakery-kpi-content"><span class="bakery-kpi-label">Bánh đã phân công</span><div class="bakery-kpi-val">@suppliers.Sum(x => x.SupplierProducts.Count)</div></div></div>
</div>

<div class="bakery-filter-card">
    <div class="bakery-filter-toolbar">
        <div class="bakery-filter-search" style="flex: 1 1 320px; max-width: 440px;">
            <input type="text"
                   class="bakery-input"
                   style="padding-left: 2.25rem;"
                   placeholder="Tìm mã, tên, SĐT, địa chỉ..."
                   @bind="searchTerm"
                   @bind:event="oninput" />
            <div style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); pointer-events: none; color: #94a3b8; display: flex; align-items: center;">
                <iconify-icon icon="solar:magnifer-linear" style="font-size: 1.05rem;"></iconify-icon>
            </div>
        </div>
        <div class="bakery-filter-select" style="flex: 0 1 190px;">
            <select class="bakery-input" @bind="statusFilter">
            <option value="all">Tất cả trạng thái</option>
            <option value="active">Đang hoạt động</option>
            <option value="inactive">Đã ẩn</option>
            </select>
        </div>
        <div class="bakery-filter-btn">
            <button class="bakery-btn @(showAdvancedSearch ? "bakery-btn-primary" : "bakery-btn-outline") w-full flex items-center justify-center gap-1.5"
                    @onclick="() => showAdvancedSearch = !showAdvancedSearch">
                <iconify-icon icon="solar:tuning-square-2-linear" class="text-base"></iconify-icon>
                <span>Bộ lọc nâng cao</span>
                @if (HasActiveAdvancedFilters)
                {
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                }
            </button>
        </div>
        <div class="bakery-filter-btn">
            <button class="bakery-btn bakery-btn-outline w-full" @onclick="ResetSearch">
                <iconify-icon icon="solar:refresh-linear" class="text-base"></iconify-icon>
                <span>Đặt lại</span>
            </button>
        </div>
    </div>
    @if (showAdvancedSearch)
    {
        <div class="mt-3 pt-3 border-t border-slate-200 dark:border-slate-700 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 bg-slate-50/60 dark:bg-slate-800/40 p-3 rounded-xl">
            <div>
                <label class="bakery-label mb-1">Số bánh cung cấp từ</label>
                <input type="number" min="0" class="bakery-input w-full text-xs" placeholder="Tất cả"
                       @bind="minProductCount" @bind:after="ApplyAdvancedFilters" />
            </div>
            <div>
                <label class="bakery-label mb-1">Số bánh cung cấp đến</label>
                <input type="number" min="0" class="bakery-input w-full text-xs" placeholder="Không giới hạn"
                       @bind="maxProductCount" @bind:after="ApplyAdvancedFilters" />
            </div>
            <div>
                <label class="bakery-label mb-1">Lịch sử nhập hàng</label>
                <select class="bakery-input w-full text-xs" @bind="receiptFilter">
                    <option value="all">Tất cả nhà cung cấp</option>
                    <option value="with-receipts">Đã có phiếu nhập</option>
                    <option value="without-receipts">Chưa có phiếu nhập</option>
                </select>
            </div>
        </div>
    }
</div>

<div class="bakery-split-container">
    <div class="bakery-split-list bakery-filter-card !p-0 overflow-hidden">
        <div class="p-4 border-b border-slate-200 dark:border-slate-700">
            <div class="flex items-center justify-between gap-2">
                <h3 class="font-bold mb-0">Danh sách nhà cung cấp</h3>
                <span class="bakery-badge bakery-badge-secondary">@FilteredSuppliers.Count() NCC</span>
            </div>
            <p class="text-xs text-slate-500 mt-1 mb-0">Bấm vào một nhà cung cấp để xem thông tin chi tiết.</p>
        </div>
        @if (!FilteredSuppliers.Any())
        {
            <p class="p-6 text-center text-slate-500">Không tìm thấy nhà cung cấp.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="bakery-table w-full text-sm">
                    <thead>
                        <tr>
                            <th class="text-left">Mã NCC</th>
                            <th class="text-left">Nhà cung cấp</th>
                            <th class="text-left">Sản phẩm</th>
                            <th class="text-left">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var supplier in FilteredSuppliers)
                        {
                            <tr class="bakery-row-clickable @(selectedSupplier?.SupplierID == supplier.SupplierID ? "bakery-row-selected" : "")"
                                @onclick="() => SelectSupplier(supplier)">
                                <td class="font-mono font-semibold">@supplier.SupplierCode</td>
                                <td>
                                    <div class="font-semibold text-primary">@supplier.SupplierName</div>
                                    <div class="text-xs text-slate-500">@supplier.Phone</div>
                                </td>
                                <td>@supplier.SupplierProducts.Count</td>
                                <td>
                                    <span class="bakery-badge @(supplier.IsActive ? "bakery-badge-success" : "bakery-badge-error")">
                                        @(supplier.IsActive ? "Đang hoạt động" : "Đã ẩn")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="bakery-split-detail">
        @if (selectedSupplier is null)
        {
            <div class="bakery-detail-placeholder">
                <div class="w-16 h-16 mx-auto mb-3 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400">
                    <iconify-icon icon="solar:buildings-2-linear" class="text-3xl"></iconify-icon>
                </div>
                <h5 class="text-base font-bold text-dark dark:text-white mb-1">Chưa chọn nhà cung cấp</h5>
                <p class="text-xs text-bodytext mb-0">Bấm vào một nhà cung cấp trong danh sách bên trái để xem thông tin quản lý.</p>
            </div>
        }
        else
        {
            <div class="bakery-detail-header-card">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="bakery-code-badge">@selectedSupplier.SupplierCode</span>
                        <span class="bakery-badge @(selectedSupplier.IsActive ? "bakery-badge-success" : "bakery-badge-error") text-xs">
                            @(selectedSupplier.IsActive ? "Đang hoạt động" : "Đã ẩn")
                        </span>
                    </div>
                    <h4 class="text-base font-bold text-dark dark:text-white mb-0">@selectedSupplier.SupplierName</h4>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600" title="Đóng bảng chi tiết" @onclick="() => selectedSupplier = null">
                    <iconify-icon icon="solar:close-circle-linear" class="text-xl"></iconify-icon>
                </button>
            </div>

            <div class="bakery-detail-kv-grid mt-4">
                <div class="bakery-detail-kv-item">
                    <div class="bakery-detail-kv-label">Số điện thoại</div>
                    <div class="bakery-detail-kv-val text-sm">@(selectedSupplier.Phone ?? "Chưa cập nhật")</div>
                </div>
                <div class="bakery-detail-kv-item">
                    <div class="bakery-detail-kv-label">Phiếu nhập</div>
                    <div class="bakery-detail-kv-val">@selectedSupplier.ImportReceipts.Count</div>
                </div>
            </div>

            <div class="mt-4">
                <div class="bakery-detail-kv-label mb-1">Địa chỉ</div>
                <div class="rounded-lg border border-slate-200 dark:border-slate-700 p-3 text-sm">
                    @(string.IsNullOrWhiteSpace(selectedSupplier.Address) ? "Chưa cập nhật" : selectedSupplier.Address)
                </div>
            </div>

            <div class="mt-4">
                <div class="flex items-center justify-between mb-2">
                    <div class="bakery-detail-kv-label">Sản phẩm cung cấp</div>
                    <span class="text-xs text-slate-500">@selectedSupplier.SupplierProducts.Count sản phẩm</span>
                </div>
                @if (selectedSupplier.SupplierProducts.Count == 0)
                {
                    <p class="text-sm text-slate-500">Chưa gán sản phẩm.</p>
                }
                else
                {
                    <div class="flex flex-wrap gap-2">
                        @foreach (var link in selectedSupplier.SupplierProducts.OrderBy(x => x.Product.ProductName))
                        {
                            <span class="bakery-badge bakery-badge-success">@link.Product.ProductName</span>
                        }
                    </div>
                }
            </div>

            <div class="mt-5 grid grid-cols-2 gap-2">
                <button class="bakery-btn bakery-btn-primary" @onclick="() => ManageProducts(selectedSupplier)">Quản lý sản phẩm</button>
                <button class="bakery-btn bakery-btn-outline" @onclick="() => Edit(selectedSupplier)">Chỉnh sửa</button>
                <button class="bakery-btn bakery-btn-secondary" @onclick="() => ToggleStatus(selectedSupplier)">
                    @(selectedSupplier.IsActive ? "Ngừng hoạt động" : "Kích hoạt")
                </button>
                <button class="bakery-btn bakery-btn-danger" @onclick="() => RequestDelete(selectedSupplier)">Xóa</button>
            </div>
            <a class="mt-3 block text-center text-sm text-primary hover:underline" href="/suppliers/@selectedSupplier.SupplierID">Xem lịch sử phiếu nhập →</a>
        }
    </div>
</div>

@if (supplierFormOpen)
{
    <div class="bakery-modal-backdrop" @onclick="Reset">
        <div class="bakery-modal-card max-w-2xl" @onclick:stopPropagation="true">
            <div class="bakery-modal-header">
                <h4 class="text-base font-bold text-slate-900 dark:text-white mb-0">
                    @(form.SupplierID == 0 ? "Thêm nhà cung cấp" : "Cập nhật nhà cung cấp")
                </h4>
                <button type="button" class="text-slate-400 text-lg" @onclick="Reset" aria-label="Đóng">×</button>
            </div>
            <div class="bakery-modal-body">
                <div class="grid md:grid-cols-2 gap-3">
                    <label>Tên nhà cung cấp <span class="text-rose-500">*</span><input class="bakery-input w-full" maxlength="150" @bind="form.SupplierName" /></label>
                    <label>Số điện thoại <span class="text-rose-500">*</span><input class="bakery-input w-full" type="tel" maxlength="20" @bind="form.Phone" /></label>
                    <label class="md:col-span-2">Địa chỉ <span class="text-rose-500">*</span><input class="bakery-input w-full" maxlength="255" @bind="form.Address" /></label>
                </div>
                @if (!string.IsNullOrEmpty(message))
                {
                    <p class="mt-3 text-sm @(operationSucceeded ? "text-emerald-600" : "text-rose-600")">@message</p>
                }
            </div>
            <div class="bakery-modal-footer">
                <button class="bakery-btn bakery-btn-outline" @onclick="Reset">Hủy</button>
                <button class="bakery-btn bakery-btn-primary" @onclick="Save">Lưu nhà cung cấp</button>
            </div>
        </div>
    </div>
}

@if (supplierProductsTarget is not null)
{
    <div class="bakery-modal-backdrop" @onclick="CloseProductsModal">
        <div class="bakery-modal-card max-w-2xl" @onclick:stopPropagation="true">
            <div class="bakery-modal-header">
                <div>
                    <h4 class="text-base font-bold text-slate-900 dark:text-white mb-0">Sản phẩm của nhà cung cấp</h4>
                    <p class="text-xs text-slate-500 mb-0">@supplierProductsTarget.SupplierName · Mỗi bánh chỉ được gán cho một nhà cung cấp.</p>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 text-lg" @onclick="CloseProductsModal" aria-label="Đóng">×</button>
            </div>
            <div class="bakery-modal-body max-h-96 overflow-y-auto">
                @if (productCatalog.Count == 0)
                {
                    <p class="text-sm text-slate-500">Chưa có sản phẩm đang kinh doanh. Hãy thêm sản phẩm trước.</p>
                }
                else
                {
                    <div class="grid sm:grid-cols-2 gap-2">
                        @foreach (var product in productCatalog)
                        {
                            var assignedToOtherSupplier = productSupplierIds.TryGetValue(product.ProductID, out var ownerId)
                                && ownerId != supplierProductsTarget.SupplierID;
                            <label class="flex items-center gap-2 rounded-lg border border-slate-200 p-3 @(assignedToOtherSupplier ? "opacity-60" : "")">
                                <input type="radio"
                                       name="supplier-product"
                                       checked="@selectedProductIds.Contains(product.ProductID)"
                                       disabled="@assignedToOtherSupplier"
                                       @onchange="() => SelectSupplierProduct(product.ProductID)" />
                                <span>
                                    @product.ProductName
                                    @if (assignedToOtherSupplier)
                                    {
                                        <small class="block text-slate-500">Đã thuộc nhà cung cấp khác</small>
                                    }
                                </span>
                            </label>
                        }
                    </div>
                }
                @if (selectedProductIds.Count > 0)
                {
                    <button type="button" class="mt-3 text-sm text-slate-500 hover:text-primary" @onclick="ClearSupplierProduct">
                        Bỏ gán sản phẩm
                    </button>
                }
                @if (!string.IsNullOrEmpty(productMessage))
                {
                    <p class="mt-3 text-sm text-rose-600">@productMessage</p>
                }
            </div>
            <div class="bakery-modal-footer">
                <button type="button" class="bakery-btn bakery-btn-outline" @onclick="CloseProductsModal">Hủy</button>
                <button type="button" class="bakery-btn bakery-btn-primary" @onclick="SaveSupplierProducts">Lưu danh sách</button>
            </div>
        </div>
    </div>
}

@if (supplierDeletePrompt is not null)
{
    var hasReceipts = supplierDeletePrompt.ImportReceipts.Count > 0;
    <div class="bakery-modal-backdrop" @onclick="CloseDeletePrompt">
        <div class="bakery-modal-card max-w-md" @onclick:stopPropagation="true">
            <div class="bakery-modal-header">
                <div class="flex items-center gap-2.5">
                    <div class="bakery-modal-icon-badge @(hasReceipts ? "warning" : "danger")">
                        <iconify-icon icon="@(hasReceipts ? "solar:shield-warning-bold" : "solar:trash-bin-trash-bold")"></iconify-icon>
                    </div>
                    <div>
                        <h4 class="text-base font-bold text-slate-900 dark:text-white mb-0">
                            @(hasReceipts ? "Không thể xóa nhà cung cấp" : "Xác nhận xóa nhà cung cấp")
                        </h4>
                        <p class="text-xs text-slate-500 mb-0">@supplierDeletePrompt.SupplierName</p>
                    </div>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 text-lg" @onclick="CloseDeletePrompt" aria-label="Đóng">
                    <iconify-icon icon="solar:close-circle-linear"></iconify-icon>
                </button>
            </div>

            <div class="bakery-modal-body">
                @if (hasReceipts)
                {
                    <div class="bakery-info-box bakery-info-box-warning text-sm">
                        Nhà cung cấp này đã có <strong>@supplierDeletePrompt.ImportReceipts.Count phiếu nhập hàng</strong> liên kết.
                        Hệ thống giữ lại để bảo toàn lịch sử nhập kho và không cho xóa vĩnh viễn.
                    </div>
                    @if (supplierDeletePrompt.IsActive)
                    {
                        <p class="text-sm text-slate-600 dark:text-slate-300 mb-0">
                            Bạn có thể ngừng hoạt động nhà cung cấp này. Nhà cung cấp sẽ được ẩn khỏi danh sách chọn khi lập phiếu nhập mới.
                        </p>
                    }
                    else
                    {
                        <p class="text-sm text-slate-600 dark:text-slate-300 mb-0">
                            Nhà cung cấp này đã ngừng hoạt động và đang được ẩn khỏi danh sách chọn. Lịch sử phiếu nhập vẫn được giữ nguyên.
                        </p>
                    }
                }
                else
                {
                    <div class="bakery-info-box bakery-info-box-danger text-sm">
                        Nhà cung cấp này chưa có phiếu nhập hàng, nên có thể xóa an toàn.
                    </div>
                    <p class="text-sm text-slate-600 dark:text-slate-300 mb-0">
                        Bạn có chắc muốn xóa <strong>@supplierDeletePrompt.SupplierName</strong>? Thao tác này không thể hoàn tác.
                    </p>
                }
            </div>

            <div class="bakery-modal-footer">
                <button type="button" class="bakery-btn bakery-btn-outline" @onclick="CloseDeletePrompt">@(hasReceipts ? "Đóng" : "Hủy")</button>
                @if (hasReceipts && supplierDeletePrompt.IsActive)
                {
                    <button type="button" class="bakery-btn bakery-btn-primary" @onclick="DeactivateFromPrompt">Ngừng hoạt động</button>
                }
                else if (!hasReceipts)
                {
                    <button type="button" class="bakery-btn bakery-btn-danger" @onclick="ConfirmDelete">Xóa nhà cung cấp</button>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<Supplier> suppliers = [];
    private Supplier form = new();
    private Supplier? selectedSupplier;
    private bool supplierFormOpen;
    private Supplier? supplierDeletePrompt;
    private Supplier? supplierProductsTarget;
    private List<Product> productCatalog = [];
    private HashSet<int> selectedProductIds = [];
    private Dictionary<int, int> productSupplierIds = [];
    private string? productMessage;
    private string? message;
    private bool operationSucceeded;
    private string searchTerm = string.Empty;
    private string statusFilter = "all";
    private bool showAdvancedSearch;
    private int? minProductCount;
    private int? maxProductCount;
    private string receiptFilter = "all";

    private bool HasActiveAdvancedFilters =>
        minProductCount.HasValue || maxProductCount.HasValue || receiptFilter != "all";

    private IEnumerable<Supplier> FilteredSuppliers => suppliers.Where(s =>
        (statusFilter == "all" ||
         (statusFilter == "active" && s.IsActive) ||
         (statusFilter == "inactive" && !s.IsActive)) &&
        (receiptFilter == "all" ||
         (receiptFilter == "with-receipts" && s.ImportReceipts.Count > 0) ||
         (receiptFilter == "without-receipts" && s.ImportReceipts.Count == 0)) &&
        (!minProductCount.HasValue || s.SupplierProducts.Count >= minProductCount.Value) &&
        (!maxProductCount.HasValue || s.SupplierProducts.Count <= maxProductCount.Value) &&
        (string.IsNullOrWhiteSpace(searchTerm) ||
         $"{s.SupplierCode} {s.SupplierName} {s.Phone} {s.Address}"
             .Contains(searchTerm.Trim(), StringComparison.OrdinalIgnoreCase)));

    private void ResetSearch()
    {
        searchTerm = string.Empty;
        statusFilter = "all";
        minProductCount = null;
        maxProductCount = null;
        receiptFilter = "all";
        showAdvancedSearch = false;
    }

    private void ApplyAdvancedFilters()
    {
        if (minProductCount is < 0)
            minProductCount = 0;
        if (maxProductCount is < 0)
            maxProductCount = 0;
    }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        suppliers = await Inventory.GetSuppliersAsync();
        if (selectedSupplier is not null)
            selectedSupplier = suppliers.FirstOrDefault(x => x.SupplierID == selectedSupplier.SupplierID);
    }

    private void SelectSupplier(Supplier supplier) => selectedSupplier = supplier;

    private async Task ManageProducts(Supplier supplier)
    {
        supplierProductsTarget = supplier;
        productMessage = null;
        productCatalog = await Inventory.GetProductsAsync();
        selectedProductIds = (await Inventory.GetSupplierProductIdsAsync(supplier.SupplierID)).ToHashSet();
        productSupplierIds = await Inventory.GetProductSupplierIdsAsync();
    }

    private void SelectSupplierProduct(int productId) => selectedProductIds = [productId];

    private void ClearSupplierProduct() => selectedProductIds.Clear();

    private void CloseProductsModal() => supplierProductsTarget = null;

    private async Task SaveSupplierProducts()
    {
        if (supplierProductsTarget is null)
            return;
        try
        {
            await Inventory.SaveSupplierProductsAsync(supplierProductsTarget.SupplierID, selectedProductIds);
            message = $"Đã cập nhật danh sách sản phẩm của {supplierProductsTarget.SupplierName}.";
            operationSucceeded = true;
            supplierProductsTarget = null;
            await Load();
        }
        catch (Exception ex)
        {
            productMessage = ex.Message;
        }
    }

    private void Edit(Supplier supplier)
    {
        form = new()
        {
            SupplierID = supplier.SupplierID,
            SupplierName = supplier.SupplierName,
            Phone = supplier.Phone,
            Address = supplier.Address,
            IsActive = supplier.IsActive
        };
        message = null;
        supplierFormOpen = true;
    }

    private void Reset()
    {
        form = new();
        message = null;
        supplierFormOpen = false;
    }

    private void OpenCreateSupplierModal()
    {
        form = new();
        message = null;
        supplierFormOpen = true;
    }

    private async Task Save()
    {
        try
        {
            var isNew = form.SupplierID == 0;
            await Inventory.SaveSupplierAsync(form);
            form = new();
            supplierFormOpen = false;
            message = isNew ? "Đã thêm nhà cung cấp." : "Đã cập nhật nhà cung cấp.";
            operationSucceeded = true;
            await Load();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            operationSucceeded = false;
        }
    }

    private async Task ToggleStatus(Supplier supplier)
    {
        try
        {
            await Inventory.SetSupplierStatusAsync(supplier.SupplierID, !supplier.IsActive);
            message = supplier.IsActive
                ? "Đã ngừng hoạt động. Nhà cung cấp sẽ không xuất hiện khi lập phiếu nhập mới."
                : "Đã kích hoạt lại nhà cung cấp.";
            operationSucceeded = true;
            await Load();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            operationSucceeded = false;
        }
    }

    private void RequestDelete(Supplier supplier)
    {
        supplierDeletePrompt = supplier;
    }

    private void CloseDeletePrompt() => supplierDeletePrompt = null;

    private async Task ConfirmDelete()
    {
        if (supplierDeletePrompt is null || supplierDeletePrompt.ImportReceipts.Count > 0)
            return;

        try
        {
            await Inventory.DeleteSupplierAsync(supplierDeletePrompt.SupplierID);
            supplierDeletePrompt = null;
            message = "Đã xóa nhà cung cấp.";
            operationSucceeded = true;
            await Load();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            operationSucceeded = false;
        }
    }

    private async Task DeactivateFromPrompt()
    {
        if (supplierDeletePrompt is null || supplierDeletePrompt.ImportReceipts.Count == 0)
            return;

        try
        {
            await Inventory.SetSupplierStatusAsync(supplierDeletePrompt.SupplierID, false);
            supplierDeletePrompt = null;
            message = "Đã ngừng hoạt động. Nhà cung cấp sẽ không xuất hiện khi lập phiếu nhập mới.";
            operationSucceeded = true;
            await Load();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            operationSucceeded = false;
        }
    }
}
