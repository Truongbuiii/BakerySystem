@page "/profile"
@rendermode InteractiveServer
@attribute [Authorize]
@inject AuthenticationStateProvider AuthState
@inject EmployeeService Employees
@inject IAuthService AuthService
<PageTitle>Hồ sơ & bảo mật | BakerySystem</PageTitle>
<div class="bakery-page-header"><div><h2 class="text-2xl font-bold">Hồ sơ & bảo mật</h2><p class="text-bodytext">Cập nhật thông tin cá nhân và mật khẩu đăng nhập.</p></div></div>
<div class="grid lg:grid-cols-2 gap-5"><section class="bakery-filter-card"><h3 class="font-bold mb-4">Thông tin hồ sơ</h3><label class="block mb-3">Tên đăng nhập<input class="bakery-input w-full" value="@username" disabled /></label>@if(employee is not null){<label class="block mb-3">Họ và tên<input class="bakery-input w-full" @bind="fullName" /></label><label class="block mb-3">Số điện thoại<input class="bakery-input w-full" @bind="phone" /></label><p class="text-sm text-slate-500 mb-3">Vị trí: @employee.Position</p><button class="bakery-btn bakery-btn-primary" @onclick="SaveProfile">Lưu hồ sơ</button>}@if(!string.IsNullOrEmpty(profileMessage)){<p class="mt-3 text-sm @(profileSaved ? "text-emerald-600" : "text-rose-600")">@profileMessage</p>}</section>
<section class="bakery-filter-card"><h3 class="font-bold mb-4">Đổi mật khẩu</h3><label class="block mb-3">Mật khẩu hiện tại<input class="bakery-input w-full" type="password" autocomplete="current-password" @bind="oldPassword" /></label><label class="block mb-3">Mật khẩu mới<input class="bakery-input w-full" type="password" autocomplete="new-password" @bind="newPassword" /></label><label class="block mb-4">Xác nhận mật khẩu mới<input class="bakery-input w-full" type="password" autocomplete="new-password" @bind="confirmPassword" /></label><button class="bakery-btn bakery-btn-primary" @onclick="ChangePassword">Đổi mật khẩu</button>@if(!string.IsNullOrEmpty(passwordMessage)){<p class="mt-3 text-sm @(passwordSaved ? "text-emerald-600" : "text-rose-600")">@passwordMessage</p>}</section></div>
@code {int accountId;string username="",fullName="";string? phone;Employee? employee;string oldPassword="",newPassword="",confirmPassword="";string? profileMessage,passwordMessage;bool profileSaved,passwordSaved;protected override async Task OnInitializedAsync(){var state=await AuthState.GetAuthenticationStateAsync();int.TryParse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,out accountId);username=state.User.Identity?.Name??"";var result=await Employees.GetProfileAsync(accountId);if(result is not null){employee=result.Value.Employee;fullName=employee.FullName;phone=employee.Phone;}}async Task SaveProfile(){try{await Employees.UpdateProfileAsync(accountId,fullName,phone);profileMessage="Đã cập nhật hồ sơ.";profileSaved=true;}catch(Exception ex){profileMessage=ex.Message;profileSaved=false;}}async Task ChangePassword(){var ok=await AuthService.ChangePasswordAsync(new(){AccountId=accountId,OldPassword=oldPassword,NewPassword=newPassword,ConfirmPassword=confirmPassword});passwordSaved=ok;passwordMessage=ok?"Đã đổi mật khẩu thành công.":"Không thể đổi mật khẩu. Kiểm tra mật khẩu hiện tại và đảm bảo mật khẩu mới có ít nhất 6 ký tự.";if(ok){oldPassword="";newPassword="";confirmPassword="";}} }
