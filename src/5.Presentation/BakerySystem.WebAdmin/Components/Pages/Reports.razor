@code {
    // Bộ lọc chu kỳ
    private string filterType = "quick";
    private string quickPeriod = "month";
    private DateTime customStartDate = DateTime.Today.AddDays(-30);
    private DateTime customEndDate = DateTime.Today;
    private int selectedMonth = DateTime.Now.Month;
    private int selectedQuarter = (DateTime.Now.Month - 1) / 3 + 1;
    private int selectedYear = DateTime.Now.Year;

    private DateTime? activeStartDate;
    private DateTime? activeEndDate;
    private DateTime? prevStartDate;
    private DateTime? prevEndDate;

    private bool isLoading = true;
    private bool hasError;
    private string errorMessage = "";
    private bool detailChartNeedsRender;
    private bool isInteractive;

    private ReportAnalyticsResult analytics = new();

    // Mainform Master–Detail state
    private string masterTab = "products"; // "products" | "quarters" | "categories" | "channels"
    private string productSearch = "";
    private string productSort = "revenue_desc";
    private int? selectedProductId;       // null = Top Products Chart
    private string topChartMetric = "revenue"; // "revenue" | "sold" | "profit"
    private int topChartLimit = 5;        // 5 | 10 | 0 (all)

    private int? selectedQuarterDetail;   // null = 4-Quarter Overview, 1..4 = Specific Quarter
    private int? selectedCategoryId;      // null = All Categories Donut
    private string selectedChannelSection = "overview"; // "overview" | "pos" | "online" | "customers"

    protected override async Task OnInitializedAsync()
    {
        await LoadReportDataAsync();
    }

    private void SetFilterType(string type)
    {
        filterType = type;
        _ = LoadReportDataAsync();
    }

    private void ChangeQuickPeriod(string period)
    {
        quickPeriod = period;
        _ = LoadReportDataAsync();
    }

    private async Task LoadReportDataAsync()
    {
        isLoading = true;
        hasError = false;
        errorMessage = "";
        StateHasChanged();

        try
        {
            var now = DateTime.Now;
            var (startDate, endDate, pStart, pEnd, timelineMode, refYear, refMonth, refQuarter) = ResolvePeriod(now);

            activeStartDate = startDate;
            activeEndDate = endDate;
            prevStartDate = pStart;
            prevEndDate = pEnd;

            analytics = await ReportService.GetReportAnalyticsAsync(new ReportAnalyticsRequest
            {
                StartDate = startDate,
                EndDate = endDate,
                PreviousStartDate = pStart,
                PreviousEndDate = pEnd,
                TimelineMode = timelineMode,
                ReferenceYear = refYear,
                ReferenceMonth = refMonth,
                ReferenceQuarter = refQuarter
            });

            // Giữ lựa chọn hợp lệ nếu sản phẩm/danh mục không còn trong danh sách
            if (selectedProductId.HasValue && analytics.Products.All(p => p.ProductID != selectedProductId.Value))
            {
                selectedProductId = null;
            }
            if (selectedCategoryId.HasValue && analytics.Categories.All(c => c.CategoryID != selectedCategoryId.Value))
            {
                selectedCategoryId = null;
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            detailChartNeedsRender = true;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        isInteractive = true;
        if (isInteractive && detailChartNeedsRender && !isLoading)
        {
            detailChartNeedsRender = false;
            await TriggerDetailChartRenderAsync();
        }
    }

    private async Task TriggerDetailChartRenderAsync()
    {
        try
        {
            await Task.Delay(50);

            if (masterTab == "products")
            {
                if (selectedProductId is null)
                {
                    var items = GetTopChartProducts();
                    if (!items.Any()) return;

                    var labels = items.Select(p => p.ProductName).ToArray();
                    var (values, seriesName, unit, color) = topChartMetric switch
                    {
                        "sold" => (items.Select(p => (double)p.SoldQuantity).ToArray(), "Số lượng bán", " cái", "#f59e0b"),
                        "profit" => (items.Select(p => (double)p.GrossProfit).ToArray(), "Lợi nhuận gộp", " đ", "#10b981"),
                        _ => (items.Select(p => (double)p.NetRevenue).ToArray(), "Doanh thu thực thu", " đ", "#2563eb")
                    };

                    await JS.InvokeVoidAsync("renderReportTopBarChart", "rpt-detail-chart", labels, values, seriesName, unit, color);
                }
                else if (GetSelectedProduct() is { } prod)
                {
                    var labels = prod.QuarterlyMetrics.Select(q => q.Label).ToArray();
                    var rev = prod.QuarterlyMetrics.Select(q => (double)q.NetRevenue).ToArray();
                    var profit = prod.QuarterlyMetrics.Select(q => (double)q.GrossProfit).ToArray();
                    var qty = prod.QuarterlyMetrics.Select(q => (double)q.SoldQuantity).ToArray();
                    await JS.InvokeVoidAsync("renderReportQuarterlyChart", "rpt-detail-chart", labels, rev, profit, qty);
                }
            }
            else if (masterTab == "quarters")
            {
                if (selectedQuarterDetail is null)
                {
                    var labels = analytics.YearQuarters.Select(q => q.Label).ToArray();
                    var rev = analytics.YearQuarters.Select(q => (double)q.NetRevenue).ToArray();
                    var profit = analytics.YearQuarters.Select(q => (double)q.GrossProfit).ToArray();
                    var qty = analytics.YearQuarters.Select(q => (double)q.SoldQuantity).ToArray();
                    await JS.InvokeVoidAsync("renderReportQuarterlyChart", "rpt-detail-chart", labels, rev, profit, qty);
                }
                else if (analytics.TopProductsByQuarter.TryGetValue(selectedQuarterDetail.Value, out var qProds) && qProds.Any())
                {
                    var top = qProds.Take(8).ToList();
                    var labels = top.Select(p => p.ProductName).ToArray();
                    var values = top.Select(p => (double)p.NetRevenue).ToArray();
                    await JS.InvokeVoidAsync("renderReportTopBarChart", "rpt-detail-chart", labels, values, $"Doanh thu Quý {selectedQuarterDetail.Value}", " đ", "#2563eb");
                }
            }
            else if (masterTab == "categories")
            {
                if (selectedCategoryId is null)
                {
                    var labels = analytics.Categories.Select(c => c.CategoryName).ToArray();
                    var series = analytics.Categories.Select(c => (double)c.Revenue).ToArray();
                    var colors = analytics.Categories.Select(c => c.ColorHex).ToArray();
                    await JS.InvokeVoidAsync("renderReportDonutChart", "rpt-detail-chart", labels, series, colors, "Tổng thực thu");
                }
                else if (GetSelectedCategory() is { } cat)
                {
                    var labels = cat.QuarterlyMetrics.Select(q => q.Label).ToArray();
                    var rev = cat.QuarterlyMetrics.Select(q => (double)q.NetRevenue).ToArray();
                    var profit = cat.QuarterlyMetrics.Select(q => (double)q.GrossProfit).ToArray();
                    var qty = cat.QuarterlyMetrics.Select(q => (double)q.SoldQuantity).ToArray();
                    await JS.InvokeVoidAsync("renderReportQuarterlyChart", "rpt-detail-chart", labels, rev, profit, qty);
                }
            }
            else if (masterTab == "channels")
            {
                if (selectedChannelSection == "customers")
                {
                    if (!analytics.TopCustomers.Any()) return;
                    var labels = analytics.TopCustomers.Select(c => c.CustomerName).ToArray();
                    var values = analytics.TopCustomers.Select(c => (double)c.TotalSpent).ToArray();
                    await JS.InvokeVoidAsync("renderReportTopBarChart", "rpt-detail-chart", labels, values, "Tổng chi tiêu", " đ", "#7c3aed");
                }
                else
                {
                    var labels = analytics.Channels.Select(c => c.DisplayName).ToArray();
                    var series = analytics.Channels.Select(c => (double)c.Revenue).ToArray();
                    var colors = new[] { "#2563eb", "#8b5cf6" };
                    await JS.InvokeVoidAsync("renderReportDonutChart", "rpt-detail-chart", labels, series, colors, "Kênh bán");
                }
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException || ex is TaskCanceledException)
        {
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi render biểu đồ Mainform: " + ex.Message);
        }
    }

