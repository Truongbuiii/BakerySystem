                                        <td class="whitespace-nowrap">@imp.ReceiptDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td><strong>@imp.SupplierName</strong><span>NV: @imp.EmployeeName</span></td>
                                        <td>
                                            @foreach (var line in imp.Lines)
                                            {
                                                <span>@line.ProductName &times; @line.Quantity (@($"{line.UnitPrice:N0} đ"))</span>
                                            }
                                        </td>
                                        <td class="text-right font-semibold whitespace-nowrap">@($"{imp.TotalAmount:N0} đ")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            </div>
        </section>
    </div>
}

