                            <th>Món bánh</th>
                            <th class="text-center">SL bán</th>
                            <th class="text-center">Tồn</th>
                            <th class="text-right">Giá bán</th>
                            <th class="text-right">Giá vốn ĐV</th>
                            <th class="text-right">Doanh thu thuần</th>
                            <th class="text-right">Tổng COGS</th>
                            <th class="text-right">Lãi gộp</th>
                            <th class="text-center">Margin</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!profitList.Any())
                        {
                            <tr><td colspan="9" class="reports-detail-empty">Không tìm thấy sản phẩm phù hợp.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in profitList)
                            {
                                var target = item;
                                <tr style="cursor: pointer;" @onclick="() => OpenProductOrdersModal(target)">
                                    <td>
                                        <strong>@item.ProductName</strong>
                                        <span>@item.CategoryName</span>
                                    </td>
                                    <td class="text-center font-semibold">@item.SoldQuantity</td>
                                    <td class="text-center">@item.CurrentStock</td>
                                    <td class="text-right whitespace-nowrap">@($"{item.RetailPrice:N0} đ")</td>
                                    <td class="text-right whitespace-nowrap">
                                        @(item.HasUnitCost ? $"{item.UnitCost:N0} đ" : "0 đ (Chưa nhập)")
                                    </td>
                                    <td class="text-right font-semibold whitespace-nowrap">@($"{item.NetRevenue:N0} đ")</td>
                                    <td class="text-right whitespace-nowrap">@($"{item.TotalCost:N0} đ")</td>
                                    <td class="text-right font-semibold whitespace-nowrap">@($"{item.GrossProfit:N0} đ")</td>
                                    <td class="text-center">@($"{item.Margin:F1}%")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
}

@* 3. Modal Chi tiết Phiếu nhập kho trong kỳ *@
@if (showImportsModal)
