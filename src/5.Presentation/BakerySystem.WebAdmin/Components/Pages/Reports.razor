@code {
    // Bộ lọc chu kỳ
    private string filterType = "quick";
    private string quickPeriod = "month";
    private DateTime customStartDate = DateTime.Today.AddDays(-30);
    private DateTime customEndDate = DateTime.Today;
    private int selectedMonth = DateTime.Now.Month;
    private int selectedQuarter = (DateTime.Now.Month - 1) / 3 + 1;
    private int selectedYear = DateTime.Now.Year;

    private DateTime? activeStartDate;
    private DateTime? activeEndDate;
    private DateTime? prevStartDate;
    private DateTime? prevEndDate;

    private bool isLoading = true;
    private bool hasError;
    private string errorMessage = "";
    private bool chartsNeedRender;
    private bool isInteractive;

    private ReportAnalyticsResult analytics = new();

    // Panel UI state
    private string productTab = "top"; // "top" | "slow" | "all"

    // Drill-down modal state
    private bool showOrdersModal;
    private string ordersModalTitle = "";
    private string ordersModalStatusFilter = "all";
    private string ordersModalChannelFilter = "all";
    private string? ordersModalPaymentKey;
    private int? ordersModalCustomerId;

    private bool showProductProfitModal;
    private string productProfitSearch = "";
    private string productProfitSort = "sold_desc";

    private bool showImportsModal;
    private string importsModalTitle = "";
    private List<ReportImportItem> selectedModalImports = [];

    private bool showCategoryModal;
    private ReportCategoryItem? selectedCategory;

    private bool showProductOrdersModal;
    private ReportProductItem? selectedProductItem;
    private List<ReportOrderItem> selectedProductOrders = [];

    private bool showInventoryModal;
    private string inventoryModalFilter = "low";

    private bool showTimelineModal;
    private ReportTimelineItem? selectedTimelineBucket;
    private string timelineModalTab = "orders";

    protected override async Task OnInitializedAsync()
    {
        await LoadReportDataAsync();
    }

    private void SetFilterType(string type)
    {
        filterType = type;
        _ = LoadReportDataAsync();
    }

    private void ChangeQuickPeriod(string period)
    {
        quickPeriod = period;
        _ = LoadReportDataAsync();
    }

    private async Task LoadReportDataAsync()
    {
        isLoading = true;
        hasError = false;
        errorMessage = "";
        StateHasChanged();

        try
        {
            var now = DateTime.Now;
            var (startDate, endDate, pStart, pEnd, timelineMode, refYear, refMonth, refQuarter) = ResolvePeriod(now);

            activeStartDate = startDate;
            activeEndDate = endDate;
            prevStartDate = pStart;
            prevEndDate = pEnd;

            analytics = await ReportService.GetReportAnalyticsAsync(new ReportAnalyticsRequest
            {
                StartDate = startDate,
                EndDate = endDate,
                PreviousStartDate = pStart,
                PreviousEndDate = pEnd,
                TimelineMode = timelineMode,
                ReferenceYear = refYear,
                ReferenceMonth = refMonth,
                ReferenceQuarter = refQuarter
            });
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
            Console.WriteLine("Lỗi nạp báo cáo: " + ex);
        }
        finally
        {
            isLoading = false;
            chartsNeedRender = true;
            StateHasChanged();
        }
    }

    private (DateTime? Start, DateTime? End, DateTime? PrevStart, DateTime? PrevEnd, string TimelineMode, int RefYear, int RefMonth, int RefQuarter) ResolvePeriod(DateTime now)
    {
        switch (filterType)
        {
            case "custom":
            {
                var s = customStartDate.Date <= customEndDate.Date ? customStartDate.Date : customEndDate.Date;
                var e = customEndDate.Date >= customStartDate.Date ? customEndDate.Date : customStartDate.Date;
                var spanDays = (e - s).Days + 1;
                return (
                    s,
                    e.AddDays(1).AddTicks(-1),
                    s.AddDays(-spanDays),
                    s.AddTicks(-1),
                    "days",
                    s.Year,
                    s.Month,
                    (s.Month - 1) / 3 + 1
                );
            }
            case "month":
            {
                var s = new DateTime(selectedYear, selectedMonth, 1);
                var e = s.AddMonths(1).AddTicks(-1);
                return (s, e, s.AddMonths(-1), s.AddTicks(-1), "weeks", selectedYear, selectedMonth, (selectedMonth - 1) / 3 + 1);
            }
            case "quarter":
            {
                int startMonth = (selectedQuarter - 1) * 3 + 1;
                var s = new DateTime(selectedYear, startMonth, 1);
                var e = s.AddMonths(3).AddTicks(-1);
                return (s, e, s.AddMonths(-3), s.AddTicks(-1), "quarter", selectedYear, startMonth, selectedQuarter);
            }
            case "year":
            {
                var s = new DateTime(selectedYear, 1, 1);
                var e = new DateTime(selectedYear, 12, 31).AddDays(1).AddTicks(-1);
                var ps = new DateTime(selectedYear - 1, 1, 1);
                var pe = new DateTime(selectedYear - 1, 12, 31).AddDays(1).AddTicks(-1);
                return (s, e, ps, pe, "year", selectedYear, 1, 1);
            }
            default:
                return quickPeriod switch
                {
                    "today" => (
                        now.Date,
                        now.Date.AddDays(1).AddTicks(-1),
                        now.Date.AddDays(-1),
                        now.Date.AddTicks(-1),
                        "hours",
                        now.Year,
                        now.Month,
                        (now.Month - 1) / 3 + 1
                    ),
                    "week" => (
                        now.Date.AddDays(-6),
                        now.Date.AddDays(1).AddTicks(-1),
                        now.Date.AddDays(-13),
                        now.Date.AddDays(-6).AddTicks(-1),
                        "days",
                        now.Year,
                        now.Month,
                        (now.Month - 1) / 3 + 1
                    ),
                    "month" => (
                        new DateTime(now.Year, now.Month, 1),
                        new DateTime(now.Year, now.Month, 1).AddMonths(1).AddTicks(-1),
                        new DateTime(now.Year, now.Month, 1).AddMonths(-1),
                        new DateTime(now.Year, now.Month, 1).AddTicks(-1),
                        "weeks",
                        now.Year,
                        now.Month,
                        (now.Month - 1) / 3 + 1
                    ),
                    _ => (null, null, null, null, "days", now.Year, now.Month, (now.Month - 1) / 3 + 1)
                };
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        isInteractive = true;
        if (isInteractive && chartsNeedRender && !isLoading)
        {
            chartsNeedRender = false;
            await TriggerChartsRenderAsync();
        }
    }

    private async Task TriggerChartsRenderAsync()
    {
        try
        {
            await Task.Delay(80);
            var labels = analytics.Timeline.Select(t => t.ShortLabel).ToArray();
            var revSeries = analytics.Timeline.Select(t => (double)t.Revenue).ToArray();
            var costSeries = analytics.Timeline.Select(t => (double)t.CostOfGoodsSold).ToArray();
            var profitSeries = analytics.Timeline.Select(t => (double)t.GrossProfit).ToArray();
            var donutSeries = analytics.Categories.Select(c => (double)c.Revenue).ToArray();
            var donutLabels = analytics.Categories.Select(c => c.CategoryName).ToArray();
            var donutColors = analytics.Categories.Select(c => c.ColorHex).ToArray();

            await JS.InvokeVoidAsync(
                "initBakeryReportsCharts",
                labels,
                revSeries,
                costSeries,
                profitSeries,
                donutSeries,
                donutLabels,
                donutColors
            );
        }
        catch (Exception ex) when (ex is JSDisconnectedException || ex is TaskCanceledException)
        {
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi render biểu đồ: " + ex.Message);
        }
    }

    private List<ReportProductItem> GetDisplayedProductsForPanel() => productTab switch
    {
        "slow" => analytics.Products
            .OrderBy(p => p.SoldQuantity)
            .ThenByDescending(p => p.CurrentStock)
            .Take(6)
            .ToList(),
        "all" => analytics.Products.Take(8).ToList(),
        _ => analytics.Products
            .Where(p => p.SoldQuantity > 0)
            .OrderByDescending(p => p.SoldQuantity)
            .ThenByDescending(p => p.NetRevenue)
            .Take(6)
            .ToList()
    };

    // ===== Drill-down Modal Actions =====

    private void CloseAllModals()
    {
        showOrdersModal = false;
        showProductProfitModal = false;
        showImportsModal = false;
        showCategoryModal = false;
        showProductOrdersModal = false;
        showInventoryModal = false;
        showTimelineModal = false;
        ordersModalPaymentKey = null;
        ordersModalCustomerId = null;
        selectedCategory = null;
        selectedProductItem = null;
        selectedTimelineBucket = null;
    }

    private void OpenOrdersModal(string title, string statusFilter, string channelFilter)
    {
        CloseAllModals();
        ordersModalTitle = title;
        ordersModalStatusFilter = statusFilter;
        ordersModalChannelFilter = channelFilter;
        showOrdersModal = true;
    }

    private void OpenPaymentOrdersModal(ReportPaymentItem payment)
    {
        CloseAllModals();
        ordersModalTitle = $"Đơn hàng thanh toán: {payment.DisplayName}";
        ordersModalStatusFilter = "completed";
        ordersModalChannelFilter = "all";
        ordersModalPaymentKey = payment.GroupKey;
        showOrdersModal = true;
    }

    private void OpenCustomerOrdersModal(ReportCustomerItem customer)
    {
        CloseAllModals();
        ordersModalTitle = $"Lịch sử đơn trong kỳ - {customer.CustomerName}";
        ordersModalStatusFilter = "completed";
        ordersModalChannelFilter = "all";
        ordersModalCustomerId = customer.CustomerID;
        showOrdersModal = true;
    }

    private List<ReportOrderItem> GetFilteredModalOrders()
    {
        IEnumerable<ReportOrderItem> query = analytics.Orders;

        if (ordersModalStatusFilter != "all")
        {
            query = query.Where(o => o.StatusGroup == ordersModalStatusFilter);
        }

        if (ordersModalChannelFilter != "all")
        {
            query = query.Where(o => o.ChannelKey == ordersModalChannelFilter);
        }

        if (!string.IsNullOrEmpty(ordersModalPaymentKey))
        {
            query = query.Where(o => o.PaymentGroupKey == ordersModalPaymentKey);
        }

        if (ordersModalCustomerId.HasValue)
        {
            query = query.Where(o => o.CustomerID == ordersModalCustomerId.Value);
        }

        return query.OrderByDescending(o => o.OrderDate).ToList();
    }

    private void OpenProductProfitModal()
    {
        CloseAllModals();
        productProfitSearch = "";
        showProductProfitModal = true;
    }

    private List<ReportProductItem> GetFilteredProductProfitList()
    {
        IEnumerable<ReportProductItem> query = analytics.Products;

        if (!string.IsNullOrWhiteSpace(productProfitSearch))
        {
            var term = productProfitSearch.Trim();
            query = query.Where(p =>
                p.ProductName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                p.CategoryName.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        return productProfitSort switch
        {
            "profit_desc" => query.OrderByDescending(p => p.GrossProfit).ThenByDescending(p => p.SoldQuantity).ToList(),
            "margin_asc" => query.Where(p => p.SoldQuantity > 0).OrderBy(p => p.Margin).ThenByDescending(p => p.SoldQuantity).ToList(),
            "slow_asc" => query.OrderBy(p => p.SoldQuantity).ThenByDescending(p => p.CurrentStock).ToList(),
            _ => query.OrderByDescending(p => p.SoldQuantity).ThenByDescending(p => p.NetRevenue).ToList()
        };
    }

    private void OpenImportsModal(string? bucketKey, string title)
    {
        CloseAllModals();
        importsModalTitle = title;
        selectedModalImports = string.IsNullOrEmpty(bucketKey)
            ? analytics.Imports
            : analytics.Imports.Where(i => i.TimelineBucketKey == bucketKey).ToList();
        showImportsModal = true;
    }

    private void OpenCategoryDetail(ReportCategoryItem category)
    {
        CloseAllModals();
        selectedCategory = category;
        showCategoryModal = true;
    }

    private void OpenProductOrdersModal(ReportProductItem product)
    {
        CloseAllModals();
        selectedProductItem = product;
        selectedProductOrders = analytics.Orders
            .Where(o => o.Status == OrderStatus.Completed && o.Lines.Any(l => l.ProductID == product.ProductID))
            .OrderByDescending(o => o.OrderDate)
            .ToList();
        showProductOrdersModal = true;
    }

    private void OpenInventoryModal(string filterMode)
    {
        CloseAllModals();
        inventoryModalFilter = filterMode;
        showInventoryModal = true;
    }

    private void OpenTimelineBucketModal(ReportTimelineItem bucket)
    {
        CloseAllModals();
        selectedTimelineBucket = bucket;
        timelineModalTab = "orders";
        showTimelineModal = true;
    }

    // ===== Formatting Helpers =====

    private string GetPeriodDisplayName() => filterType switch
    {
        "custom" => $"Từ {customStartDate:dd/MM/yyyy} đến {customEndDate:dd/MM/yyyy}",
        "month" => $"Tháng {selectedMonth}/{selectedYear}",
        "quarter" => $"Quý {selectedQuarter} năm {selectedYear}",
        "year" => $"Cả năm {selectedYear}",
        _ => quickPeriod switch
        {
            "today" => "Hôm nay",
            "week" => "7 ngày gần nhất",
            "month" => "Tháng này",
            _ => "Toàn bộ thời gian"
        }
    };

    private static string GetGrowthBadgeClass(decimal? pct, decimal current, decimal previous)
    {
        if (pct.HasValue)
        {
            if (pct.Value > 0.05m) return "is-up";
            if (pct.Value < -0.05m) return "is-down";
            return "is-neutral";
        }
        return current > previous ? "is-up" : "is-neutral";
    }

    private static string FormatGrowthText(decimal? pct, decimal current, decimal previous)
    {
        if (!pct.HasValue)
        {
            return current > 0 && previous == 0 ? "Mới phát sinh kỳ này" : "So kỳ trước: 0%";
        }
        var sign = pct.Value > 0 ? "+" : "";
        return $"{sign}{pct.Value:F1}% vs kỳ trước";
    }

    private static string GetPaymentIconStyle(string tone) => tone switch
    {
        "emerald" => "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300",
        "violet" => "bg-violet-50 text-violet-700 dark:bg-violet-950/40 dark:text-violet-300",
        "pink" => "bg-pink-50 text-pink-700 dark:bg-pink-950/40 dark:text-pink-300",
        "slate" => "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300",
        _ => "bg-blue-50 text-blue-700 dark:bg-blue-950/40 dark:text-blue-300"
    };

    private async Task ExportReportToExcel()
    {
        try
        {
            var fileName = $"Bao_Cao_Thong_Ke_{filterType}_{DateTime.Now:yyyyMMdd_HHmmss}";
            await JS.InvokeVoidAsync("bakeryExcel.exportToExcel", "report-export-data", fileName);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi xuất Excel báo cáo: " + ex.Message);
        }
    }

    private async Task PrintReport()
    {
        try
        {
            var title = $"Bao_Cao_Doanh_Thu_BakerySystem_{DateTime.Now:yyyyMMdd}";
            await JS.InvokeVoidAsync("bakeryPdf.printReportToPdf", title, "print-reports");
        }
        catch
        {
            await JS.InvokeVoidAsync("window.print");
        }
    }
}
