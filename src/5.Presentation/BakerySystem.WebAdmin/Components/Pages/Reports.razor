                            @onclick='() => productProfitSort = "margin_asc"'>Biên lãi thấp</button>
                    <button type="button" class="rpt-tab @(productProfitSort == "slow_asc" ? "is-active" : "")"
                            @onclick='() => productProfitSort = "slow_asc"'>Bán chậm</button>
