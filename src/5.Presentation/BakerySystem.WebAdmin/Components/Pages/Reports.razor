                                        @foreach (var pay in analytics.Payments)
                                        {
                                            <tr>
                                                <td class="rpt-row-title">@pay.DisplayName</td>
                                                <td class="text-center font-bold">@pay.OrderCount</td>
                                                <td class="text-right font-bold rpt-text-blue whitespace-nowrap">@($"{pay.Amount:N0} đ")</td>
