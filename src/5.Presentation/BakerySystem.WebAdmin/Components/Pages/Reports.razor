@code {
    // Mode bộ lọc: "quick" | "custom" | "month" | "quarter" | "year"
    private string filterType = "quick";
    private string quickPeriod = "month";

    // Custom date range: Từ ngày a đến ngày b
    private DateTime customStartDate = DateTime.Today.AddDays(-30);
    private DateTime customEndDate = DateTime.Today;

    // Month / Quarter / Year
    private int selectedMonth = DateTime.Now.Month;
    private int selectedQuarter = (DateTime.Now.Month - 1) / 3 + 1;
    private int selectedYear = DateTime.Now.Year;

    private DateTime? activeStartDate = null;
    private DateTime? activeEndDate = null;

    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = "";

    // KPI Metrics
    private decimal totalRevenue = 0;
    private decimal totalImportCost = 0;
    private decimal grossProfit => totalRevenue - totalImportCost;
    private decimal profitMargin => totalRevenue > 0 ? (grossProfit / totalRevenue) * 100m : 0m;
    private decimal totalDiscountAmount = 0;
    private int totalOrdersCount = 0;
    private int completedOrdersCount = 0;
    private int cancelledOrdersCount = 0;
    private decimal orderSuccessRate => totalOrdersCount > 0 ? ((decimal)completedOrdersCount / totalOrdersCount) * 100m : 0m;

    private int importReceiptsCount = 0;
    private int suppliersCount = 0;

    // Top Selling Products
    private List<TopSellerItem> topSellingProducts = new();

    // Low Stock Alert
    private List<Product> lowStockProducts = new();

    // Category Breakdown & Payment Stats
    private List<CategoryShareItem> categoryShares = new();
    private List<PaymentStatItem> paymentStats = new();

    // Timeline Breakdown Table Data
    private List<TimelineRowItem> timelineBreakdown = new();

    // Chart Time Series Data
    private List<string> chartLabels = new();
    private List<decimal> chartRevenueSeries = new();
    private List<decimal> chartCostSeries = new();
    private bool chartsNeedRender;
    private bool isInteractive;
    private bool showLowStockModal;
    private bool stockAlertShown;

    // Drill-down chi tiết đơn hàng của Top 5 bán chạy
    private List<Order> reportOrders = new();
    private List<OrderDetail> reportOrderDetails = new();
    private bool showTopSellerModal;
    private TopSellerItem? selectedTopSeller;
    private List<TopSellerOrderItem> selectedTopSellerOrders = new();

    // Drill-down chi tiết đơn hàng theo phương thức thanh toán
    private bool showPaymentModal;
    private PaymentStatItem? selectedPaymentStat;
    private List<PaymentOrderItem> selectedPaymentOrders = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadReportDataAsync();
    }

    private void SetFilterType(string type)
    {
        filterType = type;
        _ = LoadReportDataAsync();
    }

    private void ChangeQuickPeriod(string period)
    {
        quickPeriod = period;
        _ = LoadReportDataAsync();
    }

    private void OpenTopSellerDetail(TopSellerItem item)
    {
        selectedTopSeller = item;

        var detailsByOrder = reportOrderDetails
            .Where(d => d.ProductID == item.ProductID)
            .GroupBy(d => d.OrderID)
            .ToDictionary(
                g => g.Key,
                g => new { Quantity = g.Sum(x => x.Quantity), SubTotal = g.Sum(x => x.SubTotal) });

        selectedTopSellerOrders = reportOrders
            .Where(o => detailsByOrder.ContainsKey(o.OrderID))
            .Select(o =>
            {
                var detail = detailsByOrder[o.OrderID];
                var customerName = o.Customer != null && !string.IsNullOrWhiteSpace(o.Customer.FullName)
                    ? o.Customer.FullName
                    : !string.IsNullOrWhiteSpace(o.ReceiverName) ? o.ReceiverName : "Khách lẻ";
                var customerPhone = o.Customer?.Phone ?? o.ReceiverPhone;

                return new TopSellerOrderItem
                {
                    OrderID = o.OrderID,
                    OrderDate = o.OrderDate,
                    CustomerName = customerName,
                    CustomerPhone = customerPhone,
                    Quantity = detail.Quantity,
                    SubTotal = detail.SubTotal,
                    PaymentMethodLabel = GetPaymentMethodLabel(o.PaymentMethod),
                    StatusLabel = GetOrderStatusLabel(o.Status),
                    StatusClass = GetOrderStatusClass(o.Status)
                };
            })
            .OrderByDescending(x => x.OrderDate)
            .ToList();

        showTopSellerModal = true;
    }

    private void CloseTopSellerModal()
    {
        showTopSellerModal = false;
        selectedTopSeller = null;
        selectedTopSellerOrders = new();
    }

    private void OpenPaymentMethodDetail(PaymentStatItem stat)
    {
        selectedPaymentStat = stat;

        selectedPaymentOrders = reportOrders
            .Where(o => o.Status != OrderStatus.Cancelled)
            .Where(o => stat.GroupKey == "cash" ? IsCashPayment(o.PaymentMethod) : IsTransferPayment(o.PaymentMethod))
            .Select(o =>
            {
                var customerName = o.Customer != null && !string.IsNullOrWhiteSpace(o.Customer.FullName)
                    ? o.Customer.FullName
                    : !string.IsNullOrWhiteSpace(o.ReceiverName) ? o.ReceiverName : "Khách lẻ";

                return new PaymentOrderItem
                {
                    OrderID = o.OrderID,
                    OrderDate = o.OrderDate,
                    CustomerName = customerName,
                    CustomerPhone = o.Customer?.Phone ?? o.ReceiverPhone,
                    Amount = o.FinalAmount,
                    PaymentMethodLabel = GetPaymentMethodLabel(o.PaymentMethod),
                    StatusLabel = GetOrderStatusLabel(o.Status),
                    StatusClass = GetOrderStatusClass(o.Status)
                };
            })
            .OrderByDescending(x => x.OrderDate)
            .ToList();

        showPaymentModal = true;
    }

    private void ClosePaymentModal()
    {
        showPaymentModal = false;
        selectedPaymentStat = null;
        selectedPaymentOrders = new();
    }

    private static bool IsCashPayment(string? method) =>
        string.Equals(method, "Cash", StringComparison.OrdinalIgnoreCase)
        || string.Equals(method, PaymentMethod.COD, StringComparison.OrdinalIgnoreCase);

    private static bool IsTransferPayment(string? method) =>
        string.Equals(method, PaymentMethod.BankTransfer, StringComparison.OrdinalIgnoreCase);

    private static string GetPaymentMethodLabel(string? method) => method switch
    {
        PaymentMethod.COD or "Cash" => "Tiền mặt / COD",
        PaymentMethod.BankTransfer => "Chuyển khoản / QR",
        PaymentMethod.VNPAY => "VNPAY",
        PaymentMethod.MoMo => "MoMo",
        _ => string.IsNullOrWhiteSpace(method) ? "Khác" : method
    };

    private static string GetOrderStatusLabel(string? status) => status switch
    {
        OrderStatus.Pending => "Chờ duyệt",
        OrderStatus.Confirmed => "Đã duyệt",
        OrderStatus.InProgress => "Đang làm bánh",
        OrderStatus.Shipping => "Đang giao",
        OrderStatus.Completed => "Hoàn tất",
        OrderStatus.Cancelled => "Đã hủy",
        _ => status ?? ""
    };

    private static string GetOrderStatusClass(string? status) => status switch
    {
        OrderStatus.Completed => "is-success",
        OrderStatus.Cancelled => "is-danger",
        OrderStatus.Confirmed or OrderStatus.InProgress or OrderStatus.Shipping => "is-info",
        _ => "is-warning"
    };

    private string GetPeriodDisplayName() => filterType switch
    {
        "custom" => $"Từ {customStartDate:dd/MM/yyyy} đến {customEndDate:dd/MM/yyyy}",
        "month" => $"Tháng {selectedMonth}/{selectedYear}",
        "quarter" => $"Quý {selectedQuarter} năm {selectedYear}",
        "year" => $"Cả năm {selectedYear}",
        _ => quickPeriod switch
        {
            "today" => "Hôm nay",
            "week" => "7 ngày gần nhất",
            "month" => "Tháng này",
            _ => "Toàn bộ thời gian"
        }
    };

    private async Task LoadReportDataAsync()
    {
        isLoading = true;
        hasError = false;
        errorMessage = "";
        StateHasChanged();

        try
        {
            DateTime? startDate = null;
            DateTime? endDate = null;
            var now = DateTime.Now;

            switch (filterType)
            {
                case "custom":
                    startDate = customStartDate.Date;
                    endDate = customEndDate.Date.AddDays(1).AddTicks(-1);
                    break;
                case "month":
                    startDate = new DateTime(selectedYear, selectedMonth, 1);
                    endDate = startDate.Value.AddMonths(1).AddTicks(-1);
                    break;
                case "quarter":
                    int startMonthOfQuarter = (selectedQuarter - 1) * 3 + 1;
                    startDate = new DateTime(selectedYear, startMonthOfQuarter, 1);
                    endDate = startDate.Value.AddMonths(3).AddTicks(-1);
                    break;
                case "year":
                    startDate = new DateTime(selectedYear, 1, 1);
                    endDate = new DateTime(selectedYear, 12, 31, 23, 59, 59, 999);
                    break;
                default: // "quick"
                    switch (quickPeriod)
                    {
                        case "today":
                            startDate = now.Date;
                            endDate = now.Date.AddDays(1).AddTicks(-1);
                            break;
                        case "week":
                            startDate = now.Date.AddDays(-6);
                            endDate = now.Date.AddDays(1).AddTicks(-1);
                            break;
                        case "month":
                            startDate = new DateTime(now.Year, now.Month, 1);
                            endDate = startDate.Value.AddMonths(1).AddTicks(-1);
                            break;
                        default: // "all"
                            startDate = null;
                            endDate = null;
                            break;
                    }
                    break;
            }

            activeStartDate = startDate;
            activeEndDate = endDate;

            var reportData = await ReportService.GetReportDataAsync(startDate, endDate);
            var orders = reportData.Orders;
            var imports = reportData.Imports;
            reportOrders = orders;
            reportOrderDetails = reportData.OrderDetails;
            totalOrdersCount = orders.Count;
            completedOrdersCount = orders.Count(o => o.Status == OrderStatus.Completed);
            cancelledOrdersCount = orders.Count(o => o.Status == OrderStatus.Cancelled);

            var validOrders = orders.Where(o => o.Status != OrderStatus.Cancelled).ToList();
            totalRevenue = validOrders.Sum(o => o.FinalAmount);
            totalDiscountAmount = validOrders.Sum(o => o.DiscountAmount);
            paymentStats = BuildPaymentStats(validOrders);

            totalImportCost = imports.Sum(i => i.TotalAmount);
            importReceiptsCount = imports.Count;
            suppliersCount = reportData.SuppliersCount;

            var groupedDetails = reportData.OrderDetails
                .GroupBy(d => new
                {
                    d.ProductID,
                    d.Product.ProductName,
                    d.Product.Price,
                    CategoryName = d.Product.Category != null
                        ? d.Product.Category.CategoryName
                        : "Khác"
                })
                .Select(g => new TopSellerItem
                {
                    ProductID = g.Key.ProductID,
                    ProductName = g.Key.ProductName,
                    CategoryName = g.Key.CategoryName,
                    UnitPrice = g.Key.Price,
                    SoldQuantity = g.Sum(x => x.Quantity),
                    TotalRevenue = g.Sum(x => x.SubTotal)
                })
                .OrderByDescending(x => x.SoldQuantity)
                .Take(5)
                .ToList();
            topSellingProducts = groupedDetails;

            lowStockProducts = reportData.LowStockProducts;
            if (!stockAlertShown && lowStockProducts.Count > 3)
            {
                showLowStockModal = true;
                stockAlertShown = true;
            }

            var categoryData = reportData.OrderDetails
                .GroupBy(d => d.Product.Category != null
                    ? d.Product.Category.CategoryName
                    : "Khác")
                .Select(g => new
                {
                    CategoryName = g.Key,
                    Revenue = g.Sum(x => x.SubTotal)
                })
                .ToList();

            var totalCatRev = categoryData.Sum(c => c.Revenue);
            var colorPalette = new[] { "#2563eb", "#10b981", "#f59e0b", "#8b5cf6", "#ec4899", "#06b6d4" };
            categoryShares = categoryData.Select((c, idx) => new CategoryShareItem
            {
                CategoryName = c.CategoryName,
                Revenue = c.Revenue,
                Percentage = totalCatRev > 0 ? (c.Revenue / totalCatRev) * 100m : 0m,
                ColorHex = colorPalette[idx % colorPalette.Length]
            }).OrderByDescending(c => c.Revenue).ToList();

            // Xây dựng bảng phân rã chi tiết & Biểu đồ chu kỳ
            BuildTimelineBreakdown(validOrders, imports, startDate, endDate);
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
            Console.WriteLine("Lỗi nạp báo cáo: " + ex);
        }
        finally
        {
            isLoading = false;
            chartsNeedRender = true;
            StateHasChanged();
        }
    }

    private void BuildTimelineBreakdown(List<Order> validOrders, List<ImportReceipt> imports, DateTime? start, DateTime? end)
    {
        timelineBreakdown.Clear();
        chartLabels.Clear();
        chartRevenueSeries.Clear();
        chartCostSeries.Clear();

        if (filterType == "quick" && quickPeriod == "today")
        {
            // Chia theo khung giờ
            var intervals = new[] {
                (Label: "06:00 - 09:00", StartH: 6, EndH: 9),
                (Label: "09:00 - 12:00", StartH: 9, EndH: 12),
                (Label: "12:00 - 15:00", StartH: 12, EndH: 15),
                (Label: "15:00 - 18:00", StartH: 15, EndH: 18),
                (Label: "18:00 - 21:00", StartH: 18, EndH: 21),
                (Label: "21:00 - 23:59", StartH: 21, EndH: 24)
            };

            foreach (var item in intervals)
            {
                var ords = validOrders.Where(o => o.OrderDate.Hour >= item.StartH && o.OrderDate.Hour < item.EndH).ToList();
                var rev = ords.Sum(o => o.FinalAmount);
                var cost = imports.Where(i => i.ReceiptDate.Hour >= item.StartH && i.ReceiptDate.Hour < item.EndH).Sum(i => i.TotalAmount);
                timelineBreakdown.Add(new TimelineRowItem
                {
                    TimeLabel = item.Label,
                    OrderCount = ords.Count,
                    Revenue = rev,
                    Cost = cost
                });
                chartLabels.Add(item.Label);
                chartRevenueSeries.Add(rev);
                chartCostSeries.Add(cost);
            }
        }
        else if (filterType == "month" || (filterType == "quick" && quickPeriod == "month"))
        {
            // Chia theo 4 tuần trong tháng
            for (int w = 1; w <= 4; w++)
            {
                int dayStart = (w - 1) * 7 + 1;
                int dayEnd = w == 4 ? 31 : w * 7;
                var ords = validOrders.Where(o => o.OrderDate.Day >= dayStart && o.OrderDate.Day <= dayEnd).ToList();
                var rev = ords.Sum(o => o.FinalAmount);
                var cost = imports.Where(i => i.ReceiptDate.Day >= dayStart && i.ReceiptDate.Day <= dayEnd).Sum(i => i.TotalAmount);
                string label = $"Tuần {w} (Ngày {dayStart} - {dayEnd})";
                timelineBreakdown.Add(new TimelineRowItem
                {
                    TimeLabel = label,
                    OrderCount = ords.Count,
                    Revenue = rev,
                    Cost = cost
                });
                chartLabels.Add($"Tuần {w}");
                chartRevenueSeries.Add(rev);
                chartCostSeries.Add(cost);
            }
        }
        else if (filterType == "quarter")
        {
            // Chia theo 3 tháng của quý
            int startM = (selectedQuarter - 1) * 3 + 1;
            for (int m = startM; m < startM + 3; m++)
            {
                var ords = validOrders.Where(o => o.OrderDate.Month == m && o.OrderDate.Year == selectedYear).ToList();
                var rev = ords.Sum(o => o.FinalAmount);
                var cost = imports.Where(i => i.ReceiptDate.Month == m && i.ReceiptDate.Year == selectedYear).Sum(i => i.TotalAmount);
                string label = $"Tháng {m}/{selectedYear}";
                timelineBreakdown.Add(new TimelineRowItem
                {
                    TimeLabel = label,
                    OrderCount = ords.Count,
                    Revenue = rev,
                    Cost = cost
                });
                chartLabels.Add($"Tháng {m}");
                chartRevenueSeries.Add(rev);
                chartCostSeries.Add(cost);
            }
        }
        else if (filterType == "year")
        {
            // Chia theo 12 tháng trong năm
            for (int m = 1; m <= 12; m++)
            {
                var ords = validOrders.Where(o => o.OrderDate.Month == m && o.OrderDate.Year == selectedYear).ToList();
                var rev = ords.Sum(o => o.FinalAmount);
                var cost = imports.Where(i => i.ReceiptDate.Month == m && i.ReceiptDate.Year == selectedYear).Sum(i => i.TotalAmount);
                string label = $"Tháng {m:D2}/{selectedYear}";
                timelineBreakdown.Add(new TimelineRowItem
                {
                    TimeLabel = label,
                    OrderCount = ords.Count,
                    Revenue = rev,
                    Cost = cost
                });
                chartLabels.Add($"T{m}");
                chartRevenueSeries.Add(rev);
                chartCostSeries.Add(cost);
            }
        }
        else // custom hoặc 7 ngày qua
        {
            var s = start ?? (validOrders.Any() ? validOrders.Min(o => o.OrderDate).Date : DateTime.Today.AddDays(-6));
            var e = end ?? DateTime.Today;
            var daysCount = (e.Date - s.Date).Days + 1;

            if (daysCount <= 14)
            {
                // Chia theo từng ngày
                for (var cur = s.Date; cur <= e.Date; cur = cur.AddDays(1))
                {
                    var day = cur;
                    var ords = validOrders.Where(o => o.OrderDate.Date == day).ToList();
                    var rev = ords.Sum(o => o.FinalAmount);
                    var cost = imports.Where(i => i.ReceiptDate.Date == day).Sum(i => i.TotalAmount);
                    string label = day.ToString("dd/MM/yyyy");
                    timelineBreakdown.Add(new TimelineRowItem
                    {
                        TimeLabel = label,
                        OrderCount = ords.Count,
                        Revenue = rev,
                        Cost = cost
                    });
                    chartLabels.Add(day.ToString("dd/MM"));
                    chartRevenueSeries.Add(rev);
                    chartCostSeries.Add(cost);
                }
            }
            else
            {
                // Chia theo tháng nếu khoảng cách lớn
                var cur = new DateTime(s.Year, s.Month, 1);
                var endMonth = new DateTime(e.Year, e.Month, 1);
                while (cur <= endMonth)
                {
                    var targetM = cur;
                    var ords = validOrders.Where(o => o.OrderDate.Month == targetM.Month && o.OrderDate.Year == targetM.Year).ToList();
                    var rev = ords.Sum(o => o.FinalAmount);
                    var cost = imports.Where(i => i.ReceiptDate.Month == targetM.Month && i.ReceiptDate.Year == targetM.Year).Sum(i => i.TotalAmount);
                    string label = $"Tháng {targetM.Month}/{targetM.Year}";
                    timelineBreakdown.Add(new TimelineRowItem
                    {
                        TimeLabel = label,
                        OrderCount = ords.Count,
                        Revenue = rev,
                        Cost = cost
                    });
                    chartLabels.Add($"T{targetM.Month}/{targetM.Year}");
                    chartRevenueSeries.Add(rev);
                    chartCostSeries.Add(cost);
                    cur = cur.AddMonths(1);
                }
            }
        }
    }

    private List<PaymentStatItem> BuildPaymentStats(List<Order> validOrders)
    {
        var total = validOrders.Sum(o => o.FinalAmount);

        var cashOrders = validOrders
            .Where(o => string.Equals(o.PaymentMethod, "Cash", StringComparison.OrdinalIgnoreCase)
                || string.Equals(o.PaymentMethod, PaymentMethod.COD, StringComparison.OrdinalIgnoreCase))
            .ToList();

        var transferOrders = validOrders
            .Where(o => string.Equals(o.PaymentMethod, PaymentMethod.BankTransfer, StringComparison.OrdinalIgnoreCase))
            .ToList();

        var result = new List<PaymentStatItem>
        {
            CreatePaymentStat("Tiền mặt / COD", cashOrders, total, "solar:wallet-money-bold", "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300"),
            CreatePaymentStat("Chuyển khoản / Quét QR", transferOrders, total, "solar:card-transfer-bold", "bg-blue-50 text-blue-700 dark:bg-blue-950/40 dark:text-blue-300")
        };

        return result;
    }

    private static PaymentStatItem CreatePaymentStat(string displayName, List<Order> orders, decimal total, string icon, string iconClass)
    {
        var amount = orders.Sum(o => o.FinalAmount);
        return new PaymentStatItem
        {
            DisplayName = displayName,
            OrderCount = orders.Count,
            Amount = amount,
            Percentage = total > 0 ? amount / total * 100m : 0m,
            Icon = icon,
            IconClass = iconClass
        };
    }

    private async Task TriggerChartsRenderAsync()
    {
        try
        {
            await Task.Delay(100);
            var donutSeries = categoryShares.Select(c => (double)c.Revenue).ToArray();
            var donutLabels = categoryShares.Select(c => c.CategoryName).ToArray();
            var revSeries = chartRevenueSeries.Select(x => (double)x).ToArray();
            var costSeries = chartCostSeries.Select(x => (double)x).ToArray();

            await JS.InvokeVoidAsync(
                "initBakeryReportsCharts",
                chartLabels.ToArray(),
                revSeries,
                costSeries,
                donutSeries,
                donutLabels
            );
        }
        catch (Exception ex) when (ex is JSDisconnectedException || ex is TaskCanceledException)
        {
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi render biểu đồ: " + ex.Message);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        isInteractive = true;
        if (isInteractive && chartsNeedRender)
        {
            chartsNeedRender = false;
            await TriggerChartsRenderAsync();
        }
    }

