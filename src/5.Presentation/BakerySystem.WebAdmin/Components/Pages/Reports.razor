                       @bind:event="oninput" />
                <div class="rpt-tabs">
                    <button type="button" class="rpt-tab @(productProfitSort == "sold_desc" ? "is-active" : "")"
                            @onclick='() => productProfitSort = "sold_desc"'>Bán chạy</button>
                    <button type="button" class="rpt-tab @(productProfitSort == "profit_desc" ? "is-active" : "")"
                            @onclick='() => productProfitSort = "profit_desc"'>Lãi cao nhất</button>
