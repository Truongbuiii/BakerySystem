                <div><span>Doanh thu thuần</span><strong>@($"{profitList.Sum(p => p.NetRevenue):N0} đ")</strong></div>
                <div><span>Tổng giá vốn (COGS)</span><strong>@($"{profitList.Sum(p => p.TotalCost):N0} đ")</strong></div>
                <div><span>Tổng lợi nhuận gộp</span><strong>@($"{profitList.Sum(p => p.GrossProfit):N0} đ")</strong></div>
