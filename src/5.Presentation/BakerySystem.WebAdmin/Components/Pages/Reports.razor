@page "/reports"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using BakerySystem.Application.Features.Reports
@using BakerySystem.Domain.Enums
@inject ReportService ReportService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Báo Cáo Doanh Thu &amp; Thống Kê | BakeryAdmin</PageTitle>

<div class="reports-page">
    <!-- Header Trang & Hành động -->
    <div class="bakery-page-header pb-2 border-b border-border dark:border-darkborder flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        <div>
            <div class="flex items-center gap-2 text-xs text-slate-500 mb-1">
                <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
                    <iconify-icon icon="solar:home-2-linear" class="text-sm"></iconify-icon>
                    Trang chủ
                </a>
                <span>/</span>
                <span class="text-slate-800 dark:text-slate-200 font-semibold">Báo cáo &amp; Thống kê</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2.5 mb-1">
                <span class="w-9 h-9 rounded-xl bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800 flex items-center justify-center shrink-0">
                    <iconify-icon icon="solar:chart-2-bold" class="text-xl"></iconify-icon>
                </span>
                Báo Cáo Kinh Doanh, Giá Vốn &amp; Lợi Nhuận
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 mb-0">
                Tổng hợp doanh thu thực thu từ đơn hoàn tất, giá vốn hàng bán (COGS), lãi gộp thực tế và hiệu suất vận hành theo chu kỳ.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <button type="button"
                    class="bakery-btn bakery-btn-outline bakery-btn-sm"
                    @onclick="LoadReportDataAsync"
                    disabled="@isLoading"
                    title="Tải lại dữ liệu">
                <iconify-icon icon="solar:restart-linear" class="text-base @(isLoading ? "rpt-spin" : "")"></iconify-icon>
                <span>Tải lại</span>
            </button>

            <button type="button"
                    class="bakery-btn bakery-btn-outline bakery-btn-sm"
                    @onclick="ExportReportToExcel"
                    disabled="@isLoading"
                    title="Xuất bảng báo cáo thống kê ra Excel">
                <iconify-icon icon="solar:file-download-linear" class="text-base rpt-text-emerald"></iconify-icon>
                <span>Xuất Excel</span>
            </button>

            <button type="button"
                    class="bakery-btn bakery-btn-primary bakery-btn-sm shadow-sm"
                    @onclick="PrintReport"
                    disabled="@isLoading"
                    title="In ấn hoặc lưu báo cáo này dạng PDF">
                <iconify-icon icon="solar:printer-linear" class="text-base"></iconify-icon>
                <span>In / Xuất PDF Báo Cáo</span>
            </button>
        </div>
    </div>

    <div class="rpt-section-stack">
        <!-- TẦNG 1: Bộ lọc chu kỳ & thông tin đối chiếu kỳ trước -->
        <div class="bakery-card report-timeline-panel report-filter p-4">
            <div class="report-filter-toolbar">
                <div class="report-filter-modes" role="tablist" aria-label="Kiểu lọc chu kỳ">
                    <button type="button" role="tab" aria-selected="@(filterType == "quick")"
                            class="report-filter-mode @(filterType == "quick" ? "is-active" : "")"
                            @onclick='() => SetFilterType("quick")'>Chu kỳ nhanh</button>
                    <button type="button" role="tab" aria-selected="@(filterType == "custom")"
                            class="report-filter-mode @(filterType == "custom" ? "is-active" : "")"
                            @onclick='() => SetFilterType("custom")'>Từ ngày A &rarr; B</button>
                    <button type="button" role="tab" aria-selected="@(filterType == "month")"
                            class="report-filter-mode @(filterType == "month" ? "is-active" : "")"
                            @onclick='() => SetFilterType("month")'>Theo tháng</button>
                    <button type="button" role="tab" aria-selected="@(filterType == "quarter")"
                            class="report-filter-mode @(filterType == "quarter" ? "is-active" : "")"
                            @onclick='() => SetFilterType("quarter")'>Theo quý</button>
                    <button type="button" role="tab" aria-selected="@(filterType == "year")"
                            class="report-filter-mode @(filterType == "year" ? "is-active" : "")"
                            @onclick='() => SetFilterType("year")'>Theo năm</button>
                </div>

                <div class="report-filter-controls">
                    @if (filterType == "quick")
                    {
                        <div class="report-filter-periods">
                            <button type="button" class="report-filter-pill @(quickPeriod == "today" ? "is-active" : "")"
                                    @onclick='() => ChangeQuickPeriod("today")'>Hôm nay</button>
                            <button type="button" class="report-filter-pill @(quickPeriod == "week" ? "is-active" : "")"
                                    @onclick='() => ChangeQuickPeriod("week")'>7 ngày qua</button>
                            <button type="button" class="report-filter-pill @(quickPeriod == "month" ? "is-active" : "")"
                                    @onclick='() => ChangeQuickPeriod("month")'>Tháng này</button>
                            <button type="button" class="report-filter-pill @(quickPeriod == "all" ? "is-active" : "")"
                                    @onclick='() => ChangeQuickPeriod("all")'>Toàn thời gian</button>
                        </div>
                    }
                    else if (filterType == "custom")
                    {
                        <div class="report-filter-fields">
                            <label class="report-filter-field">
                                <span>Từ ngày</span>
                                <input type="date" class="bakery-input report-filter-input" @bind="customStartDate" />
                            </label>
                            <span class="report-filter-arrow">&rarr;</span>
                            <label class="report-filter-field">
                                <span>Đến ngày</span>
                                <input type="date" class="bakery-input report-filter-input" @bind="customEndDate" />
                            </label>
                            <button type="button" class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick="LoadReportDataAsync">
                                Xem thống kê
                            </button>
                        </div>
                    }
                    else if (filterType == "month")
                    {
                        <div class="report-filter-fields">
                            <label class="report-filter-field">
                                <span>Chọn tháng</span>
                                <select class="bakery-input report-filter-input" @bind="selectedMonth">
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        <option value="@m">Tháng @m</option>
                                    }
                                </select>
                            </label>
                            <label class="report-filter-field">
                                <span>Năm</span>
                                <select class="bakery-input report-filter-input" @bind="selectedYear">
                                    @for (int y = DateTime.Now.Year - 3; y <= DateTime.Now.Year + 1; y++)
                                    {
                                        <option value="@y">Năm @y</option>
                                    }
                                </select>
                            </label>
                            <button type="button" class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick="LoadReportDataAsync">
                                Xem tháng
                            </button>
                        </div>
                    }
                    else if (filterType == "quarter")
                    {
                        <div class="report-filter-fields">
                            <label class="report-filter-field">
                                <span>Chọn quý</span>
                                <select class="bakery-input report-filter-input" @bind="selectedQuarter">
                                    <option value="1">Quý 1 (Tháng 1 - 3)</option>
                                    <option value="2">Quý 2 (Tháng 4 - 6)</option>
                                    <option value="3">Quý 3 (Tháng 7 - 9)</option>
                                    <option value="4">Quý 4 (Tháng 10 - 12)</option>
                                </select>
                            </label>
                            <label class="report-filter-field">
                                <span>Năm</span>
                                <select class="bakery-input report-filter-input" @bind="selectedYear">
                                    @for (int y = DateTime.Now.Year - 3; y <= DateTime.Now.Year + 1; y++)
                                    {
                                        <option value="@y">Năm @y</option>
                                    }
                                </select>
                            </label>
                            <button type="button" class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick="LoadReportDataAsync">
                                Xem quý
                            </button>
                        </div>
                    }
                    else if (filterType == "year")
                    {
                        <div class="report-filter-fields">
                            <label class="report-filter-field">
                                <span>Chọn năm</span>
                                <select class="bakery-input report-filter-input" @bind="selectedYear">
                                    @for (int y = DateTime.Now.Year - 3; y <= DateTime.Now.Year + 1; y++)
                                    {
                                        <option value="@y">Năm @y</option>
                                    }
                                </select>
                            </label>
                            <button type="button" class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick="LoadReportDataAsync">
                                Xem cả năm
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="rpt-meta-strip">
                <div class="rpt-meta-badges">
                    <span class="rpt-meta-chip is-primary">
                        <iconify-icon icon="solar:calendar-linear"></iconify-icon>
                        Chu kỳ: <strong>@GetPeriodDisplayName()</strong>
                        @if (activeStartDate.HasValue && activeEndDate.HasValue)
                        {
                            <span>(@activeStartDate.Value.ToString("dd/MM/yyyy") &ndash; @activeEndDate.Value.ToString("dd/MM/yyyy"))</span>
                        }
                    </span>
                    @if (prevStartDate.HasValue && prevEndDate.HasValue)
                    {
                        <span class="rpt-meta-chip">
                            <iconify-icon icon="solar:history-linear"></iconify-icon>
                            So với kỳ trước: @prevStartDate.Value.ToString("dd/MM/yyyy") &ndash; @prevEndDate.Value.ToString("dd/MM/yyyy")
                        </span>
                    }
                </div>
                <span class="rpt-meta-chip is-rule">
                    <iconify-icon icon="solar:verified-check-linear"></iconify-icon>
                    Doanh thu thực thu chỉ tính đơn Hoàn tất &amp; Giá vốn tính theo từng món đã bán
                </span>
            </div>
        </div>

        @if (hasError)
        {
            <div class="bakery-card p-4 border-red-200 bg-red-50 dark:bg-red-950/30 text-red-700 dark:text-red-300 text-sm flex items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:danger-triangle-bold" class="text-lg"></iconify-icon>
                    <span>Không thể nạp dữ liệu thống kê: @errorMessage</span>
                </div>
                <button type="button" class="bakery-btn bakery-btn-outline bakery-btn-sm" @onclick="LoadReportDataAsync">Thử lại</button>
            </div>
        }

        @if (isLoading)
        {
            <div class="bakery-card p-6 text-center text-sm rpt-text-muted flex flex-col items-center gap-2">
                <iconify-icon icon="solar:refresh-circle-linear" class="text-3xl rpt-text-blue rpt-spin"></iconify-icon>
                <span>Đang tổng hợp số liệu tài chính, giá vốn và tồn kho...</span>
            </div>
        }
        else
        {
            var kpi = analytics.Kpi;
            var inv = analytics.Inventory;
            var posChannel = analytics.Channels.FirstOrDefault(c => c.ChannelKey == "pos");
            var onlineChannel = analytics.Channels.FirstOrDefault(c => c.ChannelKey == "online");

            <!-- TẦNG 2: 4 Thẻ KPI Cốt Lõi (Đập vào mắt đầu tiên + Bấm xem chi tiết) -->
            <div class="rpt-kpi-grid">
                <!-- KPI 1: Doanh thu thực thu -->
                <button type="button" class="rpt-kpi-card" @onclick='() => OpenOrdersModal("Đơn hàng hoàn tất (Doanh thu thực thu)", "completed", "all")'>
                    <div class="rpt-kpi-top">
                        <div>
                            <div class="rpt-kpi-label">Doanh thu thực thu</div>
                            <div class="rpt-kpi-value">@($"{kpi.ActualRevenue:N0} đ")</div>
                        </div>
                        <span class="rpt-kpi-icon is-blue">
                            <iconify-icon icon="solar:wallet-money-bold"></iconify-icon>
                        </span>
                    </div>
                    <div class="rpt-kpi-badges">
                        @if (kpi.HasComparison)
                        {
                            <span class="rpt-pill @GetGrowthBadgeClass(kpi.RevenueGrowthPercent, kpi.ActualRevenue, kpi.PreviousRevenue)">
                                @FormatGrowthText(kpi.RevenueGrowthPercent, kpi.ActualRevenue, kpi.PreviousRevenue)
                            </span>
                        }
                        <span class="rpt-pill is-info">TB/đơn: @($"{kpi.AverageOrderValue:N0} đ")</span>
                        @if (kpi.VoucherDiscount > 0)
                        {
                            <span class="rpt-pill is-neutral">Giảm voucher: @($"{kpi.VoucherDiscount:N0} đ")</span>
                        }
                    </div>
                    <div class="rpt-kpi-foot">
                        <span>@kpi.CompletedOrdersCount đơn hoàn tất</span>
                        <span class="rpt-kpi-link">Xem đơn hoàn tất &rarr;</span>
                    </div>
                </button>

                <!-- KPI 2: Lợi nhuận gộp & Giá vốn COGS -->
                <button type="button" class="rpt-kpi-card" @onclick="OpenProductProfitModal">
                    <div class="rpt-kpi-top">
                        <div>
                            <div class="rpt-kpi-label">Lợi nhuận gộp (Doanh thu - COGS)</div>
                            <div class="rpt-kpi-value">@($"{kpi.GrossProfit:N0} đ")</div>
                        </div>
                        <span class="rpt-kpi-icon is-emerald">
                            <iconify-icon icon="solar:graph-up-bold"></iconify-icon>
                        </span>
                    </div>
                    <div class="rpt-kpi-badges">
                        @if (kpi.HasComparison)
                        {
                            <span class="rpt-pill @GetGrowthBadgeClass(kpi.GrossProfitGrowthPercent, kpi.GrossProfit, kpi.PreviousGrossProfit)">
                                @FormatGrowthText(kpi.GrossProfitGrowthPercent, kpi.GrossProfit, kpi.PreviousGrossProfit)
                            </span>
                        }
                        <span class="rpt-pill @(kpi.ProfitMargin >= 30 ? "is-up" : kpi.ProfitMargin >= 0 ? "is-warn" : "is-down")">
                            Biên lãi: @($"{kpi.ProfitMargin:F1}%")
                        </span>
                        <span class="rpt-pill is-neutral">Giá vốn COGS: @($"{kpi.CostOfGoodsSold:N0} đ")</span>
                    </div>
                    <div class="rpt-kpi-foot">
                        <span>Giá vốn tính trên SL món đã bán</span>
                        <span class="rpt-kpi-link">Lãi gộp từng món &rarr;</span>
                    </div>
                </button>

                <!-- KPI 3: Hiệu suất Đơn hàng & Kênh bán -->
                <button type="button" class="rpt-kpi-card" @onclick='() => OpenOrdersModal("Tất cả đơn hàng trong kỳ", "all", "all")'>
                    <div class="rpt-kpi-top">
                        <div>
                            <div class="rpt-kpi-label">Đơn hàng &amp; Kênh bán</div>
                            <div class="rpt-kpi-value">@kpi.CompletedOrdersCount / @kpi.TotalOrdersCount đơn</div>
                        </div>
                        <span class="rpt-kpi-icon is-violet">
                            <iconify-icon icon="solar:bag-check-bold"></iconify-icon>
                        </span>
                    </div>
                    <div class="rpt-kpi-badges">
                        <span class="rpt-pill is-up">@($"{kpi.OrderSuccessRate:F1}%") thành công</span>
                        <span class="rpt-pill is-info">POS: @(posChannel?.OrderCount ?? 0) &middot; Online: @(onlineChannel?.OrderCount ?? 0)</span>
                        @if (kpi.ProcessingOrdersCount > 0)
                        {
                            <span class="rpt-pill is-warn">Chờ thu: @kpi.ProcessingOrdersCount đơn</span>
                        }
                        @if (kpi.CancelledOrdersCount > 0)
                        {
                            <span class="rpt-pill is-down">Hủy: @kpi.CancelledOrdersCount</span>
                        }
                    </div>
                    <div class="rpt-kpi-foot">
                        <span>Chờ thu: @($"{kpi.ProcessingOrdersAmount:N0} đ")</span>
                        <span class="rpt-kpi-link">Chi tiết trạng thái &rarr;</span>
                    </div>
                </button>

                <!-- KPI 4: Nhập kho kỳ & Sức khỏe Tồn kho -->
                <button type="button" class="rpt-kpi-card" @onclick='() => OpenImportsModal(null, "Phiếu nhập kho trong kỳ")'>
                    <div class="rpt-kpi-top">
                        <div>
                            <div class="rpt-kpi-label">Chi nhập kho &amp; Tồn kho</div>
                            <div class="rpt-kpi-value">@($"{kpi.PeriodImportCashflow:N0} đ")</div>
                        </div>
                        <span class="rpt-kpi-icon is-amber">
                            <iconify-icon icon="solar:box-bold"></iconify-icon>
                        </span>
                    </div>
                    <div class="rpt-kpi-badges">
                        <span class="rpt-pill is-neutral">@kpi.ImportReceiptsCount phiếu nhập &middot; @kpi.SuppliersCount NCC</span>
                        <span class="rpt-pill is-info">Tồn: @($"{inv.TotalStockUnits:N0}") bánh</span>
                        @if (inv.LowStockCount > 0)
                        {
                            <span class="rpt-pill @(inv.OutOfStockCount > 0 ? "is-down" : "is-warn")">
                                &#9888; @inv.LowStockCount món sắp hết
                            </span>
                        }
                        else
                        {
                            <span class="rpt-pill is-up">Tồn kho ổn định</span>
                        }
                    </div>
                    <div class="rpt-kpi-foot">
                        <span>Vốn tồn: @($"{inv.TotalInventoryCostValue:N0} đ")</span>
                        <span class="rpt-kpi-link">Xem phiếu nhập &rarr;</span>
                    </div>
                </button>
            </div>

            <!-- TẦNG 3: Biểu đồ Trực quan Ngay Dưới KPI -->
            <div class="rpt-charts-grid">
                <!-- Left 2/3: Revenue vs COGS vs Gross Profit Chart -->
                <section class="rpt-panel">
                    <div class="rpt-panel-header">
                        <div>
                            <h3 class="rpt-panel-title">
                                <iconify-icon icon="solar:chart-square-bold" class="rpt-text-blue"></iconify-icon>
                                Biểu Đồ Doanh Thu &ndash; Giá Vốn (COGS) &ndash; Lợi Nhuận Gộp
                            </h3>
                            <p class="rpt-panel-sub">So sánh doanh thu thực thu với giá vốn hàng bán thực tế theo từng mốc (@GetPeriodDisplayName())</p>
                        </div>
                        <button type="button" class="rpt-link-btn" @onclick="OpenProductProfitModal">
                            Phân tích giá vốn món bánh &rarr;
                        </button>
                    </div>

                    <div class="rpt-chart-summary-row">
                        <div class="rpt-mini-stat">
                            <span>Doanh thu thực thu</span>
                            <strong class="rpt-text-blue">@($"{kpi.ActualRevenue:N0} đ")</strong>
                        </div>
                        <div class="rpt-mini-stat">
                            <span>Giá vốn hàng bán (COGS)</span>
                            <strong class="rpt-text-amber">@($"{kpi.CostOfGoodsSold:N0} đ")</strong>
                        </div>
                        <div class="rpt-mini-stat">
                            <span>Lợi nhuận gộp (@($"{kpi.ProfitMargin:F1}%"))</span>
                            <strong class="@(kpi.GrossProfit >= 0 ? "rpt-text-emerald" : "rpt-text-red")">
                                @($"{kpi.GrossProfit:N0} đ")
                            </strong>
                        </div>
                    </div>

                    <div id="reports-financial-chart" style="min-height: 260px;"></div>
                </section>

                <!-- Right 1/3: Category Net Revenue Donut (Khớp 100% Doanh thu thực thu) -->
                <section class="rpt-panel">
                    <div class="rpt-panel-header">
                        <div>
                            <h3 class="rpt-panel-title">
                                <iconify-icon icon="solar:pie-chart-2-bold" class="rpt-text-emerald"></iconify-icon>
                                Cơ Cấu Doanh Thu Loại Bánh
                            </h3>
                            <p class="rpt-panel-sub">Đã phân bổ voucher &middot; Khớp 100% tổng thực thu (@($"{kpi.ActualRevenue:N0} đ"))</p>
                        </div>
                    </div>

                    <div id="reports-category-donut" style="min-height: 200px;"></div>

                    @if (!analytics.Categories.Any())
                    {
                        <div class="rpt-empty">Chưa phát sinh doanh thu loại bánh trong chu kỳ này.</div>
                    }
                    else
                    {
                        <div class="rpt-list">
                            @foreach (var cat in analytics.Categories)
                            {
                                var targetCat = cat;
                                <button type="button" class="rpt-list-row" @onclick="() => OpenCategoryDetail(targetCat)">
                                    <div class="flex items-center gap-2 min-w-0">
                                        <span class="rpt-dot" style="background: @cat.ColorHex"></span>
                                        <div class="min-w-0">
                                            <div class="rpt-row-title truncate">@cat.CategoryName</div>
                                            <div class="rpt-row-sub rpt-num">@cat.SoldQuantity bánh &middot; Lãi @($"{cat.GrossProfit:N0} đ") (@($"{cat.Margin:F1}%"))</div>
                                        </div>
                                    </div>
                                    <div class="text-right shrink-0">
                                        <div class="rpt-row-amount">@($"{cat.Revenue:N0} đ")</div>
                                        <div class="rpt-row-sub rpt-text-blue font-semibold rpt-num">@($"{cat.Percentage:F1}%") &rsaquo;</div>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                </section>
            </div>

            <!-- TẦNG 4A: Kênh bán & Thanh toán + Hiệu suất Món bánh -->
            <div class="rpt-analytics-grid">
                <!-- Panel 1: Kênh bán hàng (POS vs Online) & Phương thức thanh toán -->
                <section class="rpt-panel">
                    <div class="rpt-panel-header">
                        <div>
                            <h3 class="rpt-panel-title">
                                <iconify-icon icon="solar:shop-2-bold" class="rpt-text-violet"></iconify-icon>
                                Kênh Bán Hàng &amp; Thanh Toán
                            </h3>
                            <p class="rpt-panel-sub">Tách bạch bán tại quầy (POS) với đặt hàng Online &amp; dòng tiền thanh toán</p>
                        </div>
                        <span class="rpt-pill is-info">@($"{kpi.ActualRevenue:N0} đ")</span>
                    </div>

                    <!-- POS vs Online Cards -->
                    <div class="rpt-channel-cards">
                        @foreach (var channel in analytics.Channels)
                        {
                            var ch = channel;
                            <button type="button" class="rpt-channel-card"
                                    @onclick='() => OpenOrdersModal($"Đơn hàng hoàn tất - {ch.DisplayName}", "completed", ch.ChannelKey)'>
                                <div class="flex items-center justify-between gap-2 mb-1">
                                    <span class="rpt-channel-name">
                                        <iconify-icon icon="@ch.Icon" class="text-base rpt-text-blue"></iconify-icon>
                                        @ch.DisplayName
                                    </span>
                                    <span class="rpt-channel-pct">@($"{ch.Percentage:F1}%")</span>
                                </div>
                                <div class="rpt-channel-amount">@($"{ch.Revenue:N0} đ")</div>
                                <div class="rpt-row-sub rpt-num">@ch.OrderCount đơn hoàn tất &middot; Lãi @($"{ch.GrossProfit:N0} đ")</div>
                                <div class="rpt-progress-track">
                                    <div class="rpt-progress-fill"
                                         style="width: @($"{Math.Min(100m, ch.Percentage):F1}%"); background: @(ch.ChannelKey == "pos" ? "#2563eb" : "#8b5cf6")"></div>
                                </div>
                            </button>
                        }
                    </div>

                    <!-- Payment Methods -->
                    <div class="pt-1">
                        <div class="flex items-center justify-between mb-2">
                            <span class="rpt-row-title">Chi tiết theo phương thức thanh toán</span>
                            <span class="rpt-row-sub">Bấm dòng để xem đơn hàng</span>
                        </div>
                        <div class="rpt-list">
                            @foreach (var pay in analytics.Payments)
                            {
                                var targetPay = pay;
                                <button type="button" class="rpt-list-row" @onclick="() => OpenPaymentOrdersModal(targetPay)">
                                    <div class="flex items-center gap-2 min-w-0">
                                        <span class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 @GetPaymentIconStyle(pay.BadgeTone)">
                                            <iconify-icon icon="@pay.Icon" class="text-base"></iconify-icon>
                                        </span>
                                        <div class="min-w-0">
                                            <div class="rpt-row-title">@pay.DisplayName</div>
                                            <div class="rpt-row-sub rpt-num">@pay.OrderCount đơn hoàn tất</div>
                                        </div>
                                    </div>
                                    <div class="text-right shrink-0">
                                        <div class="rpt-row-amount">@($"{pay.Amount:N0} đ")</div>
                                        <div class="rpt-row-sub rpt-num">@($"{pay.Percentage:F1}%") &rsaquo;</div>
                                    </div>
                                </button>
                            }
                        </div>
                    </div>

                    @if (kpi.ProcessingOrdersCount > 0 || kpi.CancelledOrdersCount > 0)
                    {
                        <div class="rpt-panel-footer">
                            @if (kpi.ProcessingOrdersCount > 0)
                            {
                                <button type="button" class="rpt-link-btn rpt-text-amber rpt-num"
                                        @onclick='() => OpenOrdersModal("Đơn hàng đang xử lý / chờ thu tiền", "processing", "all")'>
                                    &#9203; @kpi.ProcessingOrdersCount đơn đang xử lý (@($"{kpi.ProcessingOrdersAmount:N0} đ")) &rarr;
                                </button>
                            }
                            @if (kpi.CancelledOrdersCount > 0)
                            {
                                <button type="button" class="rpt-link-btn rpt-text-red rpt-num"
                                        @onclick='() => OpenOrdersModal("Đơn hàng đã hủy trong kỳ", "cancelled", "all")'>
                                    &#10005; @kpi.CancelledOrdersCount đơn hủy (@($"{kpi.CancellationRate:F1}%")) &rarr;
                                </button>
                            }
                        </div>
                    }
                </section>

                <!-- Panel 2: Hiệu suất Món bánh (Bán chạy / Bán chậm / Toàn bộ Menu) -->
                <section class="rpt-panel">
                    <div class="rpt-panel-header">
                        <div>
                            <h3 class="rpt-panel-title">
                                <iconify-icon icon="solar:cup-star-bold" class="rpt-text-amber"></iconify-icon>
                                Hiệu Suất Món Bánh Trong Kỳ
                            </h3>
                            <p class="rpt-panel-sub">Theo dõi món chủ lực và món bán chậm / tồn kho cần đẩy</p>
                        </div>
                        <div class="rpt-tabs" role="tablist">
                            <button type="button" role="tab" class="rpt-tab @(productTab == "top" ? "is-active" : "")"
                                    @onclick='() => productTab = "top"'>Bán chạy</button>
                            <button type="button" role="tab" class="rpt-tab @(productTab == "slow" ? "is-active" : "")"
                                    @onclick='() => productTab = "slow"'>Bán chậm</button>
                            <button type="button" role="tab" class="rpt-tab @(productTab == "all" ? "is-active" : "")"
                                    @onclick='() => productTab = "all"'>Tất cả (@analytics.Products.Count)</button>
                        </div>
                    </div>

                    @{
                        var displayedProducts = GetDisplayedProductsForPanel();
                    }

                    @if (!displayedProducts.Any())
                    {
                        <div class="rpt-empty">Chưa có dữ liệu sản phẩm phù hợp trong chu kỳ này.</div>
                    }
                    else
                    {
                        <div class="rpt-table-wrap">
                            <table class="rpt-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Món bánh</th>
                                        <th class="text-center">SL bán</th>
                                        <th class="text-center">Tồn</th>
                                        <th class="text-right">Doanh thu</th>
                                        <th class="text-right">Lãi gộp</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < displayedProducts.Count; i++)
                                    {
                                        var p = displayedProducts[i];
                                        var rankClass = productTab == "top"
                                            ? (i == 0 ? "is-top1" : i == 1 ? "is-top2" : i == 2 ? "is-top3" : "")
                                            : "";
                                        <tr class="is-clickable" @onclick="() => OpenProductOrdersModal(p)">
                                            <td><span class="rpt-rank-badge @rankClass">@(i + 1)</span></td>
                                            <td>
                                                <div class="rpt-row-title">@p.ProductName</div>
                                                <div class="rpt-row-sub rpt-num">@p.CategoryName &middot; Bán @($"{p.RetailPrice:N0} đ")</div>
                                            </td>
                                            <td class="text-center font-bold">@p.SoldQuantity</td>
                                            <td class="text-center">
                                                <span class="rpt-pill @(p.CurrentStock <= 0 ? "is-down" : p.CurrentStock <= 10 ? "is-warn" : "is-neutral")">
                                                    @p.CurrentStock
                                                </span>
                                            </td>
                                            <td class="text-right font-semibold whitespace-nowrap">@($"{p.NetRevenue:N0} đ")</td>
                                            <td class="text-right whitespace-nowrap">
                                                <div class="font-bold @(p.GrossProfit >= 0 ? "rpt-text-emerald" : "rpt-text-red")">
                                                    @($"{p.GrossProfit:N0} đ")
                                                </div>
                                                <div class="rpt-micro">@($"{p.Margin:F1}%")</div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="rpt-panel-footer">
                        <span class="rpt-row-sub">Bấm vào từng món để xem các hóa đơn đã bán</span>
                        <button type="button" class="rpt-link-btn" @onclick="OpenProductProfitModal">
                            Xem bảng giá vốn &amp; lãi gộp đầy đủ &rarr;
                        </button>
                    </div>
                </section>
            </div>

            <!-- TẦNG 4B: Top Khách hàng & Sức khỏe Tồn kho -->
            <div class="rpt-analytics-grid">
                <!-- Panel 3: Top Khách hàng -->
                <section class="rpt-panel">
                    <div class="rpt-panel-header">
                        <div>
                            <h3 class="rpt-panel-title">
                                <iconify-icon icon="solar:users-group-rounded-bold" class="rpt-text-blue"></iconify-icon>
                                Khách Hàng Chi Tiêu Cao Trong Kỳ
                            </h3>
                            <p class="rpt-panel-sub">Xếp hạng theo tổng chi tiêu từ đơn Hoàn tất (bấm để xem lịch sử đơn)</p>
                        </div>
                        <span class="rpt-pill is-neutral">Top @analytics.TopCustomers.Count</span>
                    </div>

                    @if (!analytics.TopCustomers.Any())
                    {
                        <div class="rpt-empty">Chưa có khách hàng phát sinh đơn hoàn tất trong chu kỳ này.</div>
                    }
                    else
                    {
                        <div class="rpt-table-wrap">
                            <table class="rpt-table">
                                <thead>
                                    <tr>
                                        <th>Hạng</th>
                                        <th>Khách hàng</th>
                                        <th class="text-center">Số đơn</th>
                                        <th class="text-right">TB / đơn</th>
                                        <th class="text-right">Tổng chi tiêu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int idx = 0; idx < analytics.TopCustomers.Count; idx++)
                                    {
                                        var cust = analytics.TopCustomers[idx];
                                        var rankClass = idx == 0 ? "is-top1" : idx == 1 ? "is-top2" : idx == 2 ? "is-top3" : "";
                                        <tr class="is-clickable" @onclick="() => OpenCustomerOrdersModal(cust)">
                                            <td><span class="rpt-rank-badge @rankClass">@(idx + 1)</span></td>
                                            <td>
                                                <div class="rpt-row-title">@cust.CustomerName</div>
                                                <div class="rpt-row-sub rpt-num">
                                                    @(string.IsNullOrWhiteSpace(cust.Phone) ? "Không có SĐT" : cust.Phone) &middot; Gần nhất: @cust.LastOrderDate.ToString("dd/MM")
                                                </div>
                                            </td>
                                            <td class="text-center font-semibold">@cust.CompletedOrderCount</td>
                                            <td class="text-right rpt-text-muted whitespace-nowrap">@($"{cust.AverageOrderValue:N0} đ")</td>
                                            <td class="text-right font-bold rpt-text-blue whitespace-nowrap">@($"{cust.TotalSpent:N0} đ")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>

                <!-- Panel 4: Sức khỏe Tồn kho & Nhập hàng -->
                <section class="rpt-panel">
                    <div class="rpt-panel-header">
                        <div>
                            <h3 class="rpt-panel-title">
                                <iconify-icon icon="solar:archive-check-bold" class="rpt-text-amber"></iconify-icon>
                                Giá Trị Tồn Kho &amp; Cảnh Báo Nhập Hàng
                            </h3>
                            <p class="rpt-panel-sub">Định giá hàng tồn hiện tại theo giá vốn &amp; theo dõi món sắp hết (&le; 10)</p>
                        </div>
                        <button type="button" class="rpt-link-btn" @onclick='() => OpenInventoryModal("low")'>
                            Xem toàn bộ tồn kho &rarr;
                        </button>
                    </div>

                    <div class="rpt-inv-grid">
                        <div class="rpt-inv-box">
                            <span>Tổng tồn (@inv.ActiveProductsCount món đang bán)</span>
                            <strong>@($"{inv.TotalStockUnits:N0} sản phẩm")</strong>
                        </div>
                        <div class="rpt-inv-box">
                            <span>Giá trị tồn (theo giá vốn)</span>
                            <strong class="rpt-text-blue">@($"{inv.TotalInventoryCostValue:N0} đ")</strong>
                        </div>
                        <div class="rpt-inv-box">
                            <span>Giá trị bán lẻ dự kiến</span>
                            <strong class="rpt-text-emerald">@($"{inv.TotalInventoryRetailValue:N0} đ")</strong>
                        </div>
                        <div class="rpt-inv-box">
                            <span>Cần bổ sung kho (&le; 10 cái)</span>
                            <strong class="@(inv.LowStockCount > 0 ? "rpt-text-amber" : "rpt-text-emerald")">
                                @inv.LowStockCount món (@inv.OutOfStockCount hết hàng)
                            </strong>
                        </div>
                    </div>

                    @if (!inv.LowStockItems.Any())
                    {
                        <div class="p-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800 text-xs rpt-text-emerald flex items-center gap-2">
                            <iconify-icon icon="solar:check-circle-bold" class="text-base"></iconify-icon>
                            Tất cả sản phẩm đang bán đều có lượng tồn kho trên 10 chiếc.
                        </div>
                    }
                    else
                    {
                        <div class="rpt-list">
                            @foreach (var item in inv.LowStockItems.Take(4))
                            {
                                <button type="button" class="rpt-list-row" @onclick='() => OpenInventoryModal("low")'>
                                    <div class="min-w-0">
                                        <div class="rpt-row-title truncate">@item.ProductName</div>
                                        <div class="rpt-row-sub rpt-num">@item.CategoryName &middot; Giá vốn @(item.HasUnitCost ? $"{item.UnitCost:N0} đ" : "Chưa có giá nhập")</div>
                                    </div>
                                    <span class="rpt-pill @(item.StockQuantity <= 0 ? "is-down" : "is-warn") shrink-0">
                                        @(item.StockQuantity <= 0 ? "Hết hàng (0)" : $"Còn {item.StockQuantity}")
                                    </span>
                                </button>
                            }
                        </div>
                    }

                    <div class="rpt-panel-footer">
                        <button type="button" class="rpt-link-btn rpt-num" @onclick='() => OpenImportsModal(null, "Phiếu nhập kho trong kỳ")'>
                            &#128230; @kpi.ImportReceiptsCount phiếu nhập trong kỳ (@($"{kpi.PeriodImportCashflow:N0} đ")) &rarr;
                        </button>
                        <button type="button" class="bakery-btn bakery-btn-outline bakery-btn-sm" @onclick='() => Navigation.NavigateTo("/import-receipts")'>
                            Lập phiếu nhập kho
                        </button>
                    </div>
                </section>
            </div>

            <!-- TẦNG 5: Bảng Thống kê Chi tiết Theo Mốc Thời Gian + Drill-down từng mốc -->
            <section class="rpt-panel">
                <div class="rpt-panel-header">
                    <div>
                        <h3 class="rpt-panel-title">
                            <iconify-icon icon="solar:calendar-mark-bold" class="rpt-text-blue"></iconify-icon>
                            Bảng Thống Kê Chi Tiết Theo Mốc Thời Gian (@GetPeriodDisplayName())
                        </h3>
                        <p class="rpt-panel-sub">Bấm vào từng dòng mốc thời gian để xem chi tiết các đơn hàng và phiếu nhập phát sinh trong mốc đó</p>
                    </div>
                    <span class="rpt-pill is-info">@analytics.Timeline.Count mốc thời gian</span>
                </div>

                @if (!analytics.Timeline.Any())
                {
                    <div class="rpt-empty">Không có mốc thời gian nào trong chu kỳ đã chọn.</div>
                }
                else
                {
                    <div class="rpt-table-wrap">
                        <table class="rpt-table">
                            <thead>
                                <tr>
                                    <th>Mốc thời gian</th>
                                    <th class="text-center">Đơn hoàn tất</th>
                                    <th class="text-right">Doanh thu thuần</th>
                                    <th class="text-right">Giá vốn (COGS)</th>
                                    <th class="text-right">Lợi nhuận gộp</th>
                                    <th class="text-center">Biên lãi</th>
                                    <th class="text-right">Chi nhập kho (TK)</th>
                                    <th class="text-right">Chi tiết</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in analytics.Timeline)
                                {
                                    var bucket = row;
                                    <tr class="is-clickable" @onclick="() => OpenTimelineBucketModal(bucket)">
                                        <td class="font-semibold">@row.TimeLabel</td>
                                        <td class="text-center">
                                            <span class="font-semibold">@row.CompletedOrderCount đơn</span>
                                            @if (row.CancelledOrderCount > 0)
                                            {
                                                <span class="rpt-micro rpt-text-red"> (@row.CancelledOrderCount hủy)</span>
                                            }
                                        </td>
                                        <td class="text-right font-bold rpt-text-blue whitespace-nowrap">@($"{row.Revenue:N0} đ")</td>
                                        <td class="text-right rpt-text-amber whitespace-nowrap">@($"{row.CostOfGoodsSold:N0} đ")</td>
                                        <td class="text-right font-bold @(row.GrossProfit >= 0 ? "rpt-text-emerald" : "rpt-text-red") whitespace-nowrap">
                                            @($"{row.GrossProfit:N0} đ")
                                        </td>
                                        <td class="text-center">
                                            <span class="rpt-pill @(row.Revenue == 0 ? "is-neutral" : row.Margin >= 30 ? "is-up" : row.Margin >= 0 ? "is-warn" : "is-down")">
                                                @($"{row.Margin:F1}%")
                                            </span>
                                        </td>
                                        <td class="text-right rpt-text-muted whitespace-nowrap">
                                            @($"{row.ImportCashflow:N0} đ")
                                            @if (row.ImportReceiptsCount > 0)
                                            {
                                                <span class="rpt-micro"> (@row.ImportReceiptsCount PN)</span>
                                            }
                                        </td>
                                        <td class="text-right rpt-text-blue font-semibold">&rsaquo;</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td>Tổng cộng chu kỳ</td>
                                    <td class="text-center">@kpi.CompletedOrdersCount đơn</td>
                                    <td class="text-right rpt-text-blue whitespace-nowrap">@($"{kpi.ActualRevenue:N0} đ")</td>
                                    <td class="text-right rpt-text-amber whitespace-nowrap">@($"{kpi.CostOfGoodsSold:N0} đ")</td>
                                    <td class="text-right @(kpi.GrossProfit >= 0 ? "rpt-text-emerald" : "rpt-text-red") whitespace-nowrap">
                                        @($"{kpi.GrossProfit:N0} đ")
                                    </td>
                                    <td class="text-center">@($"{kpi.ProfitMargin:F1}%")</td>
                                    <td class="text-right whitespace-nowrap">@($"{kpi.PeriodImportCashflow:N0} đ")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </section>
        }
    </div>
</div>

<!-- ======================== 6+ DRILL-DOWN MODALS ======================== -->

@* 1. Modal Chi tiết Đơn hàng (Hỗ trợ lọc theo Trạng thái, Kênh bán, Thanh toán, Khách hàng) *@
@if (showOrdersModal)
{
    var filteredOrders = GetFilteredModalOrders();
    <div class="reports-modal-backdrop" role="presentation" @onclick="CloseAllModals">
        <section class="reports-stock-modal rpt-modal-wide" role="dialog" aria-modal="true" @onclick:stopPropagation>
            <div class="reports-stock-modal-header">
                <div>
                    <h2>@ordersModalTitle</h2>
                    <p>@GetPeriodDisplayName() · @filteredOrders.Count đơn hàng phù hợp</p>
                </div>
                <button type="button" class="reports-modal-close" aria-label="Đóng" @onclick="CloseAllModals">&times;</button>
            </div>

            <div class="rpt-modal-toolbar">
                <div class="rpt-tabs">
                    <button type="button" class="rpt-tab @(ordersModalStatusFilter == "all" ? "is-active" : "")"
                            @onclick='() => ordersModalStatusFilter = "all"'>Tất cả</button>
                    <button type="button" class="rpt-tab @(ordersModalStatusFilter == "completed" ? "is-active" : "")"
                            @onclick='() => ordersModalStatusFilter = "completed"'>Hoàn tất</button>
                    <button type="button" class="rpt-tab @(ordersModalStatusFilter == "processing" ? "is-active" : "")"
                            @onclick='() => ordersModalStatusFilter = "processing"'>Đang xử lý</button>
                    <button type="button" class="rpt-tab @(ordersModalStatusFilter == "cancelled" ? "is-active" : "")"
                            @onclick='() => ordersModalStatusFilter = "cancelled"'>Đã hủy</button>
                </div>
                <div class="rpt-tabs">
                    <button type="button" class="rpt-tab @(ordersModalChannelFilter == "all" ? "is-active" : "")"
                            @onclick='() => ordersModalChannelFilter = "all"'>Mọi kênh</button>
                    <button type="button" class="rpt-tab @(ordersModalChannelFilter == "pos" ? "is-active" : "")"
                            @onclick='() => ordersModalChannelFilter = "pos"'>Tại quầy POS</button>
                    <button type="button" class="rpt-tab @(ordersModalChannelFilter == "online" ? "is-active" : "")"
                            @onclick='() => ordersModalChannelFilter = "online"'>Đặt Online</button>
                </div>
            </div>

            <div class="rpt-summary-4">
                <div><span>Số đơn hiển thị</span><strong>@filteredOrders.Count đơn</strong></div>
                <div><span>Tổng giá trị đơn</span><strong>@($"{filteredOrders.Sum(o => o.FinalAmount):N0} đ")</strong></div>
                <div><span>Giá vốn COGS (Hoàn tất)</span><strong>@($"{filteredOrders.Where(o => o.Status == OrderStatus.Completed).Sum(o => o.CostOfGoodsSold):N0} đ")</strong></div>
                <div><span>Lãi gộp (Hoàn tất)</span><strong>@($"{filteredOrders.Where(o => o.Status == OrderStatus.Completed).Sum(o => o.GrossProfit):N0} đ")</strong></div>
            </div>

            <div class="reports-detail-table-wrap">
                <table class="reports-detail-table">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Ngày đặt</th>
                            <th>Khách hàng</th>
                            <th>Kênh &amp; TT</th>
                            <th>Món bánh</th>
                            <th class="text-right">Tổng thu</th>
                            <th class="text-right">Giá vốn</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!filteredOrders.Any())
                        {
                            <tr><td colspan="7" class="reports-detail-empty">Không có đơn hàng nào khớp bộ lọc.</td></tr>
                        }
                        else
                        {
                            @foreach (var ord in filteredOrders)
                            {
                                <tr>
                                    <td>
                                        <strong>#HD-@ord.OrderID.ToString("D4")</strong>
                                        <span class="reports-detail-status @ord.StatusClass">@ord.StatusLabel</span>
                                    </td>
                                    <td class="whitespace-nowrap">@ord.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <strong>@ord.CustomerName</strong>
                                        @if (!string.IsNullOrWhiteSpace(ord.CustomerPhone))
                                        {
                                            <span>@ord.CustomerPhone</span>
                                        }
                                    </td>
                                    <td>
                                        <strong>@ord.ChannelLabel</strong>
                                        <span>@ord.PaymentMethodLabel</span>
                                    </td>
                                    <td>
                                        @foreach (var line in ord.Lines.Take(2))
                                        {
                                            <span>@line.ProductName &times; @line.Quantity</span>
                                        }
                                        @if (ord.Lines.Count > 2)
                                        {
                                            <span>+@(ord.Lines.Count - 2) món khác...</span>
                                        }
                                    </td>
                                    <td class="text-right whitespace-nowrap">
                                        <strong>@($"{ord.FinalAmount:N0} đ")</strong>
                                        @if (ord.DiscountAmount > 0)
                                        {
                                            <span>Giảm @($"{ord.DiscountAmount:N0} đ")</span>
                                        }
                                    </td>
                                    <td class="text-right whitespace-nowrap">@($"{ord.CostOfGoodsSold:N0} đ")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
