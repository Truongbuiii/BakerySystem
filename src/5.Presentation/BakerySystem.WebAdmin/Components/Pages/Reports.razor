@page "/reports"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject BakerySystem.Application.Features.Reports.ReportService ReportService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Báo Cáo Doanh Thu & Thống Kê | BakeryAdmin</PageTitle>

<div class="space-y-5">
    <!-- 1. Header Trang & Tiêu đề -->
    <div class="bakery-page-header pb-2 border-b border-border dark:border-darkborder flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        <div>
            <div class="flex items-center gap-2 text-xs text-slate-500 mb-1">
                <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
                    <iconify-icon icon="solar:home-2-linear" class="text-sm"></iconify-icon>
                    Trang chủ
                </a>
                <span>/</span>
                <span class="text-slate-800 dark:text-slate-200 font-semibold">Báo cáo & Thống kê</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2.5 mb-1">
                <span class="w-9 h-9 rounded-xl bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800 flex items-center justify-center shrink-0">
                    <iconify-icon icon="solar:chart-2-bold" class="text-xl"></iconify-icon>
                </span>
                Báo Cáo Doanh Thu, Tồn Kho & Lợi Nhuận
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 mb-0">
                Thống kê toàn diện doanh thu thực tế, chi phí vốn nhập kho, phân tích lợi nhuận gộp theo chu kỳ tùy chọn.
            </p>
        </div>

        <div class="flex items-center gap-2">
            <button type="button" 
                    class="bakery-btn bakery-btn-outline bakery-btn-sm"
                    @onclick="LoadReportDataAsync"
                    disabled="@isLoading"
                    title="Tải lại dữ liệu">
                <iconify-icon icon="solar:restart-linear" class="text-base @(isLoading ? "animate-spin" : "")"></iconify-icon>
                <span>Tải lại</span>
            </button>

            <button type="button" 
                    class="bakery-btn bakery-btn-outline bakery-btn-sm"
                    @onclick="ExportReportToExcel"
                    title="Xuất bảng báo cáo thống kê ra Excel">
                <iconify-icon icon="solar:file-download-linear" class="text-base text-emerald-600"></iconify-icon>
                <span>Xuất Excel</span>
            </button>

            <button type="button" 
                    class="bakery-btn bakery-btn-primary bakery-btn-sm shadow-sm"
                    @onclick="PrintReport"
                    title="In ấn hoặc lưu báo cáo này dạng PDF">
                <iconify-icon icon="solar:printer-linear" class="text-base"></iconify-icon>
                <span>In / Xuất PDF Báo Cáo</span>
            </button>
        </div>
    </div>

    <!-- 2. BỘ LỌC THỐNG KÊ TOÀN DIỆN (Từ ngày - đến ngày & Theo tháng / quý / năm) -->
    <div class="bakery-card p-4">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            <!-- Mode Switcher: Nhanh / Tùy chọn ngày / Theo tháng / Theo quý / Theo năm -->
            <div class="flex flex-wrap items-center gap-2">
                <div class="inline-flex rounded-xl p-1 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
                    <button type="button"
                            class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-all @(filterType == "quick" ? "bg-white dark:bg-slate-700 text-primary shadow-sm" : "text-slate-600 dark:text-slate-400 hover:text-slate-900")"
                            @onclick='() => SetFilterType("quick")'>
                        Chu kỳ nhanh
                    </button>
                    <button type="button"
                            class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-all @(filterType == "custom" ? "bg-white dark:bg-slate-700 text-primary shadow-sm" : "text-slate-600 dark:text-slate-400 hover:text-slate-900")"
                            @onclick='() => SetFilterType("custom")'>
                        Từ ngày A &rarr; B
                    </button>
                    <button type="button"
                            class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-all @(filterType == "month" ? "bg-white dark:bg-slate-700 text-primary shadow-sm" : "text-slate-600 dark:text-slate-400 hover:text-slate-900")"
                            @onclick='() => SetFilterType("month")'>
                        Theo tháng
                    </button>
                    <button type="button"
                            class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-all @(filterType == "quarter" ? "bg-white dark:bg-slate-700 text-primary shadow-sm" : "text-slate-600 dark:text-slate-400 hover:text-slate-900")"
                            @onclick='() => SetFilterType("quarter")'>
                        Theo quý
                    </button>
                    <button type="button"
                            class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-all @(filterType == "year" ? "bg-white dark:bg-slate-700 text-primary shadow-sm" : "text-slate-600 dark:text-slate-400 hover:text-slate-900")"
                            @onclick='() => SetFilterType("year")'>
                        Theo năm
                    </button>
                </div>
            </div>

            <!-- Detailed controls based on chosen filterType -->
            <div class="flex flex-wrap items-center gap-3">
                @if (filterType == "quick")
                {
                    <div class="flex items-center gap-1.5">
                        <button type="button" class="px-2.5 py-1 text-xs rounded-md border transition-colors @(quickPeriod == "today" ? "bg-blue-50 border-blue-300 text-blue-700 font-bold" : "border-slate-200 text-slate-600 hover:bg-slate-50")"
                                @onclick='() => ChangeQuickPeriod("today")'>Hôm nay</button>
                        <button type="button" class="px-2.5 py-1 text-xs rounded-md border transition-colors @(quickPeriod == "week" ? "bg-blue-50 border-blue-300 text-blue-700 font-bold" : "border-slate-200 text-slate-600 hover:bg-slate-50")"
                                @onclick='() => ChangeQuickPeriod("week")'>7 ngày qua</button>
                        <button type="button" class="px-2.5 py-1 text-xs rounded-md border transition-colors @(quickPeriod == "month" ? "bg-blue-50 border-blue-300 text-blue-700 font-bold" : "border-slate-200 text-slate-600 hover:bg-slate-50")"
                                @onclick='() => ChangeQuickPeriod("month")'>Tháng này</button>
                        <button type="button" class="px-2.5 py-1 text-xs rounded-md border transition-colors @(quickPeriod == "all" ? "bg-blue-50 border-blue-300 text-blue-700 font-bold" : "border-slate-200 text-slate-600 hover:bg-slate-50")"
                                @onclick='() => ChangeQuickPeriod("all")'>Toàn thời gian</button>
                    </div>
                }
                else if (filterType == "custom")
                {
                    <div class="flex items-center gap-2">
                        <div class="flex items-center gap-1.5">
                            <span class="text-xs text-slate-500 font-medium">Từ ngày:</span>
                            <input type="date" class="bakery-input py-1 px-2.5 text-xs" style="height: 34px; width: auto;" @bind="customStartDate" />
                        </div>
                        <span class="text-slate-400">&rarr;</span>
                        <div class="flex items-center gap-1.5">
                            <span class="text-xs text-slate-500 font-medium">Đến ngày:</span>
                            <input type="date" class="bakery-input py-1 px-2.5 text-xs" style="height: 34px; width: auto;" @bind="customEndDate" />
                        </div>
                        <button type="button" class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick="LoadReportDataAsync">
                            Xem thống kê
                        </button>
                    </div>
                }
                else if (filterType == "month")
                {
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-slate-500 font-medium">Chọn tháng:</span>
                        <select class="bakery-input py-1 px-2.5 text-xs" style="height: 34px; width: auto;" @bind="selectedMonth">
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m">Tháng @m</option>
                            }
                        </select>
                        <span class="text-xs text-slate-500 font-medium">Năm:</span>
                        <select class="bakery-input py-1 px-2.5 text-xs" style="height: 34px; width: auto;" @bind="selectedYear">
                            @for (int y = DateTime.Now.Year - 3; y <= DateTime.Now.Year + 1; y++)
                            {
                                <option value="@y">Năm @y</option>
                            }
                        </select>
                        <button type="button" class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick="LoadReportDataAsync">
                            Xem tháng
                        </button>
                    </div>
                }
                else if (filterType == "quarter")
                {
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-slate-500 font-medium">Chọn quý:</span>
                        <select class="bakery-input py-1 px-2.5 text-xs" style="height: 34px; width: auto;" @bind="selectedQuarter">
                            <option value="1">Quý 1 (Tháng 1 - 3)</option>
                            <option value="2">Quý 2 (Tháng 4 - 6)</option>
                            <option value="3">Quý 3 (Tháng 7 - 9)</option>
                            <option value="4">Quý 4 (Tháng 10 - 12)</option>
                        </select>
                        <span class="text-xs text-slate-500 font-medium">Năm:</span>
                        <select class="bakery-input py-1 px-2.5 text-xs" style="height: 34px; width: auto;" @bind="selectedYear">
                            @for (int y = DateTime.Now.Year - 3; y <= DateTime.Now.Year + 1; y++)
                            {
                                <option value="@y">Năm @y</option>
                            }
                        </select>
                        <button type="button" class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick="LoadReportDataAsync">
                            Xem quý
                        </button>
                    </div>
                }
                else if (filterType == "year")
                {
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-slate-500 font-medium">Chọn năm:</span>
                        <select class="bakery-input py-1 px-2.5 text-xs" style="height: 34px; width: auto;" @bind="selectedYear">
                            @for (int y = DateTime.Now.Year - 3; y <= DateTime.Now.Year + 1; y++)
                            {
                                <option value="@y">Năm @y</option>
                            }
                        </select>
                        <button type="button" class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick="LoadReportDataAsync">
                            Xem cả năm
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="mt-3 pt-3 border-t border-slate-100 dark:border-slate-800 text-xs text-slate-500 flex items-center justify-between">
            <div>
                Đang hiển thị thống kê cho chu kỳ: <strong class="text-primary dark:text-blue-400">@GetPeriodDisplayName()</strong>
            </div>
            @if (activeStartDate.HasValue && activeEndDate.HasValue)
            {
                <div class="font-mono text-[11px] text-slate-400">
                    [@activeStartDate.Value.ToString("dd/MM/yyyy HH:mm")] &rarr; [@activeEndDate.Value.ToString("dd/MM/yyyy HH:mm")]
                </div>
            }
        </div>
    </div>

    <!-- 3. Top 4 KPI Metric Cards -->
    <div class="bakery-kpi-grid">
        <!-- Card 1: Doanh Thu Thực Thu -->
        <div class="bakery-kpi-card">
            <div class="bakery-kpi-content">
                <span class="bakery-kpi-label">Doanh thu thực thu</span>
                <div class="bakery-kpi-val text-blue-700 dark:text-blue-400">@($"{totalRevenue:N0} đ")</div>
                <div class="bakery-kpi-subtext">
                    <span class="bakery-badge bakery-badge-success text-[10px] py-0 px-1.5 font-bold">
                        @completedOrdersCount đơn
                    </span>
                    <span class="truncate">Đã giảm voucher: @($"{totalDiscountAmount:N0} đ")</span>
                </div>
            </div>
            <div class="bakery-kpi-iconbox bakery-kpi-blue">
                <iconify-icon icon="solar:wallet-money-bold"></iconify-icon>
            </div>
        </div>

        <!-- Card 2: Chi Phí Vốn Nhập Kho -->
        <div class="bakery-kpi-card">
            <div class="bakery-kpi-content">
                <span class="bakery-kpi-label">Chi phí vốn nguyên liệu</span>
                <div class="bakery-kpi-val text-amber-700 dark:text-amber-400">@($"{totalImportCost:N0} đ")</div>
                <div class="bakery-kpi-subtext">
                    <span class="bakery-badge bakery-badge-secondary text-[10px] py-0 px-1.5 font-bold">
                        @importReceiptsCount phiếu nhập
                    </span>
                    <span class="truncate">Từ @suppliersCount nhà cung cấp</span>
                </div>
            </div>
            <div class="bakery-kpi-iconbox bakery-kpi-amber">
                <iconify-icon icon="solar:box-minimalistic-bold"></iconify-icon>
            </div>
        </div>

        <!-- Card 3: Lợi Nhuận Gộp -->
        <div class="bakery-kpi-card">
            <div class="bakery-kpi-content">
                <span class="bakery-kpi-label">Lợi nhuận gộp (Doanh thu - Vốn)</span>
                <div class="bakery-kpi-val @(grossProfit >= 0 ? "text-emerald-700 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400")">
                    @($"{grossProfit:N0} đ")
                </div>
                <div class="bakery-kpi-subtext">
                    <span class="bakery-badge @(profitMargin >= 0 ? "bakery-badge-success" : "bakery-badge-danger") text-[10px] py-0 px-1.5 font-bold">
                        @(profitMargin.ToString("F1"))% Margin
                    </span>
                    <span>Tỷ suất lợi nhuận</span>
                </div>
            </div>
            <div class="bakery-kpi-iconbox bakery-kpi-green">
                <iconify-icon icon="solar:graph-up-bold"></iconify-icon>
            </div>
        </div>

        <!-- Card 4: Hiệu Suất Đơn Hàng -->
        <div class="bakery-kpi-card">
            <div class="bakery-kpi-content">
                <span class="bakery-kpi-label">Hiệu suất đơn hàng</span>
                <div class="bakery-kpi-val text-purple-700 dark:text-purple-400">@completedOrdersCount / @totalOrdersCount đơn</div>
                <div class="bakery-kpi-subtext">
                    <span class="bakery-badge bakery-badge-primary text-[10px] py-0 px-1.5 font-bold">
                        @(orderSuccessRate.ToString("F1"))% Thành công
                    </span>
                    <span>Đã hủy: @cancelledOrdersCount</span>
                </div>
            </div>
            <div class="bakery-kpi-iconbox bakery-kpi-purple">
                <iconify-icon icon="solar:bill-check-bold"></iconify-icon>
            </div>
        </div>
    </div>

    @if (hasError)
    {
        <div class="p-4 rounded-xl border border-rose-200 bg-rose-50 dark:bg-rose-950/20 dark:border-rose-800 flex items-start gap-3">
            <iconify-icon icon="solar:danger-triangle-bold" class="text-rose-500 text-xl shrink-0 mt-0.5"></iconify-icon>
            <div>
                <p class="text-sm font-bold text-rose-800 dark:text-rose-300 mb-0.5">Lỗi tải dữ liệu báo cáo</p>
                <p class="text-xs text-rose-600 dark:text-rose-400 mb-0">@errorMessage</p>
            </div>
        </div>
    }

    <!-- 4. BẢNG BIỂU THỐNG KÊ CHI TIẾT THEO CHU KỲ (TIMELINE TABLE) -->
    <div class="bakery-card p-4">
        <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-100 dark:border-slate-800">
            <div>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-1.5 mb-0.5">
                    <iconify-icon icon="solar:calendar-date-bold" class="text-primary text-base"></iconify-icon>
                    Bảng Thống Kê Chi Tiết Theo Mốc Thời Gian (@GetPeriodDisplayName())
                </h3>
                <p class="text-[11px] text-slate-500 mb-0">Phân rã số liệu doanh thu, vốn nhập, lợi nhuận gộp theo từng mốc trong chu kỳ.</p>
            </div>
            <span class="bakery-badge bakery-badge-primary text-xs">@timelineBreakdown.Count mốc thời gian</span>
        </div>

        <div class="bakery-table-responsive overflow-x-auto">
            <table id="report-timeline-table" class="bakery-table">
                <thead>
                    <tr>
                        <th class="py-2 px-3 text-left">Mốc thời gian</th>
                        <th class="py-2 px-3 text-center">Số đơn hàng</th>
                        <th class="py-2 px-3 text-right">Doanh thu bán</th>
                        <th class="py-2 px-3 text-right">Chi phí vốn</th>
                        <th class="py-2 px-3 text-right">Lợi nhuận gộp</th>
                        <th class="py-2 px-3 text-center">Tỷ suất lãi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!timelineBreakdown.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-6 text-slate-400 text-xs">
                                Chưa có phát sinh doanh thu hoặc phiếu nhập kho trong chu kỳ này.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in timelineBreakdown)
                        {
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
                                <td class="py-2 px-3 font-semibold text-slate-800 dark:text-white">
                                    @row.TimeLabel
                                </td>
                                <td class="py-2 px-3 text-center">
                                    <span class="inline-block px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-xs font-bold text-slate-700 dark:text-slate-300">
                                        @row.OrderCount đơn
                                    </span>
                                </td>
                                <td class="py-2 px-3 text-right font-mono font-bold text-blue-700 dark:text-blue-400">
                                    @($"{row.Revenue:N0} đ")
                                </td>
                                <td class="py-2 px-3 text-right font-mono font-semibold text-amber-700 dark:text-amber-400">
                                    @($"{row.Cost:N0} đ")
                                </td>
                                <td class="py-2 px-3 text-right font-mono font-bold @(row.GrossProfit >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600")">
                                    @($"{row.GrossProfit:N0} đ")
                                </td>
                                <td class="py-2 px-3 text-center">
                                    <span class="bakery-badge @(row.Margin >= 20 ? "bakery-badge-success" : row.Margin > 0 ? "bakery-badge-warning" : "bakery-badge-danger") text-xs">
                                        @(row.Margin.ToString("F1"))%
                                    </span>
                                </td>
                            </tr>
                        }
                        <!-- Dòng tổng cộng -->
                        <tr class="bg-slate-50 dark:bg-slate-800/80 font-bold border-t-2 border-slate-300 dark:border-slate-700">
                            <td class="py-2.5 px-3 uppercase text-slate-900 dark:text-white">Tổng cộng chu kỳ</td>
                            <td class="py-2.5 px-3 text-center text-primary font-bold">@timelineBreakdown.Sum(x => x.OrderCount) đơn</td>
                            <td class="py-2.5 px-3 text-right font-mono text-blue-700 dark:text-blue-400">@($"{timelineBreakdown.Sum(x => x.Revenue):N0} đ")</td>
                            <td class="py-2.5 px-3 text-right font-mono text-amber-700 dark:text-amber-400">@($"{timelineBreakdown.Sum(x => x.Cost):N0} đ")</td>
                            <td class="py-2.5 px-3 text-right font-mono @(grossProfit >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600")">@($"{grossProfit:N0} đ")</td>
                            <td class="py-2.5 px-3 text-center">
                                <span class="bakery-badge bakery-badge-primary text-xs font-bold">
                                    @(profitMargin.ToString("F1"))%
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 5. BIỂU ĐỒ SO SÁNH DOANH THU & VỐN -->
    <div class="bakery-card p-3 mb-4">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-3 pb-2 border-b border-slate-100 dark:border-slate-800">
            <div>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-1.5 mb-0.5">
                    Biểu Đồ So Sánh Doanh Thu Thực Thu vs Chi Phí Vốn Nhập Hàng
                </h3>
                <p class="text-[10px] text-slate-500 mb-0">Theo chu kỳ @GetPeriodDisplayName()</p>
            </div>
            <div class="flex flex-wrap items-center gap-2 text-[10px] font-semibold">
                <span class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-300">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>Doanh thu
                </span>
                <span class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-300">
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>Chi phí vốn
                </span>
            </div>
        </div>

        <div id="reports-financial-chart" style="min-height: 250px;">
            @if (isLoading)
            {
                <div class="flex items-center justify-center h-56">
                    <span class="w-8 h-8 border-3 border-primary border-t-transparent rounded-full animate-spin"></span>
                </div>
            }
        </div>
    </div>

    <!-- 6. HAI BẢNG: CƠ CẤU DOANH THU LOẠI BÁNH & PHƯƠNG THỨC THANH TOÁN -->
    <div class="bakery-report-two-col">
        <div class="bakery-card p-3 h-full flex flex-col min-h-0">
            <div class="mb-2 pb-2 border-b border-slate-100 dark:border-slate-800 flex-shrink-0">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-1.5 mb-0.5">
                    Cơ Cấu Doanh Thu Theo Loại Bánh
                </h3>
                <p class="text-[10px] text-slate-500 mb-0">Tỷ lệ đóng góp doanh thu của các phân loại bánh</p>
            </div>

            <div class="flex-1 flex items-center justify-center min-h-0" style="max-height: 200px;">
                <div id="reports-category-donut" style="width: 100%; height: 200px;"></div>
            </div>

            <div class="mt-2 space-y-1 text-[10px] flex-shrink-0 max-h-24 overflow-y-auto pr-1">
                @foreach (var cat in categoryShares.Take(5))
                {
                    <div class="flex items-center justify-between gap-2 py-0.5 px-1.5 rounded bg-slate-50/60 dark:bg-slate-800/50">
                        <div class="flex items-center gap-1.5 min-w-0">
                            <span class="w-2 h-2 rounded-full shrink-0" style="background-color: @cat.ColorHex;"></span>
