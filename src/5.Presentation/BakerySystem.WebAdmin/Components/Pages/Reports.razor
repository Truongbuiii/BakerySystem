@* 5. Modal Chi tiết các Hóa đơn đã bán của 1 Món bánh cụ thể *@
@if (showProductOrdersModal && selectedProductItem != null)
{
    <div class="reports-modal-backdrop" role="presentation" @onclick="CloseAllModals">
        <section class="reports-stock-modal reports-detail-modal" role="dialog" aria-modal="true" @onclick:stopPropagation>
            <div class="reports-stock-modal-header">
                <div>
                    <h2>Chi tiết đơn bán món: @selectedProductItem.ProductName</h2>
                    <p>@selectedProductItem.CategoryName · @GetPeriodDisplayName() (chỉ tính đơn Hoàn tất)</p>
                </div>
                <button type="button" class="reports-modal-close" aria-label="Đóng" @onclick="CloseAllModals">&times;</button>
            </div>

            <div class="rpt-summary-4">
                <div><span>SL đã bán</span><strong>@selectedProductItem.SoldQuantity cái</strong></div>
                <div><span>Doanh thu thuần</span><strong>@($"{selectedProductItem.NetRevenue:N0} đ")</strong></div>
                <div><span>Giá vốn (COGS)</span><strong>@($"{selectedProductItem.TotalCost:N0} đ")</strong></div>
                <div><span>Lãi gộp (@($"{selectedProductItem.Margin:F1}%"))</span><strong>@($"{selectedProductItem.GrossProfit:N0} đ")</strong></div>
            </div>

            <div class="reports-detail-table-wrap">
                <table class="reports-detail-table">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Ngày đặt</th>
                            <th>Khách hàng</th>
                            <th class="text-center">SL</th>
                            <th class="text-right">Doanh thu thuần</th>
                            <th class="text-right">Giá vốn</th>
                            <th>Kênh &amp; TT</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!selectedProductOrders.Any())
                        {
                            <tr><td colspan="7" class="reports-detail-empty">Món bánh này chưa có đơn hoàn tất nào trong chu kỳ đã chọn.</td></tr>
                        }
                        else
                        {
                            @foreach (var ord in selectedProductOrders)
                            {
                                var qty = ord.Lines.Where(l => l.ProductID == selectedProductItem.ProductID).Sum(l => l.Quantity);
                                var rev = ord.Lines.Where(l => l.ProductID == selectedProductItem.ProductID).Sum(l => l.AllocatedNetRevenue);
                                var cost = ord.Lines.Where(l => l.ProductID == selectedProductItem.ProductID).Sum(l => l.LineCost);
                                <tr>
                                    <td><strong>#HD-@ord.OrderID.ToString("D4")</strong><span class="reports-detail-status @ord.StatusClass">@ord.StatusLabel</span></td>
                                    <td class="whitespace-nowrap">@ord.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><strong>@ord.CustomerName</strong>@if (!string.IsNullOrWhiteSpace(ord.CustomerPhone)) { <span>@ord.CustomerPhone</span> }</td>
                                    <td class="text-center font-semibold">@qty</td>
                                    <td class="text-right font-semibold whitespace-nowrap">@($"{rev:N0} đ")</td>
                                    <td class="text-right whitespace-nowrap">@($"{cost:N0} đ")</td>
                                    <td><strong>@ord.ChannelLabel</strong><span>@ord.PaymentMethodLabel</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
}

@* 6. Modal Danh sách Cảnh báo Tồn kho & Định giá Tồn kho *@
@if (showInventoryModal)
{
    var invList = inventoryModalFilter == "low" ? analytics.Inventory.LowStockItems : analytics.Inventory.AllItems;
    <div class="reports-modal-backdrop" role="presentation" @onclick="CloseAllModals">
        <section class="reports-stock-modal rpt-modal-wide" role="dialog" aria-modal="true" @onclick:stopPropagation>
            <div class="reports-stock-modal-header">
                <div>
                    <h2>Báo cáo Tồn kho &amp; Định giá hàng tồn</h2>
                    <p>Quản lý số lượng tồn thực tế, cảnh báo hết hàng và giá trị vốn tồn kho</p>
                </div>
                <button type="button" class="reports-modal-close" aria-label="Đóng" @onclick="CloseAllModals">&times;</button>
            </div>

            <div class="rpt-modal-toolbar">
                <div class="rpt-tabs">
                    <button type="button" class="rpt-tab @(inventoryModalFilter == "low" ? "is-active" : "")"
                            @onclick='() => inventoryModalFilter = "low"'>Cần nhập gấp (@analytics.Inventory.LowStockCount)</button>
                    <button type="button" class="rpt-tab @(inventoryModalFilter == "all" ? "is-active" : "")"
                            @onclick='() => inventoryModalFilter = "all"'>Toàn bộ menu (@analytics.Inventory.ActiveProductsCount)</button>
                </div>
                <button type="button" class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick='() => Navigation.NavigateTo("/import-receipts")'>
                    Tạo phiếu nhập kho &rarr;
                </button>
            </div>

            <div class="rpt-summary-4">
                <div><span>Sản phẩm hiển thị</span><strong>@invList.Count món</strong></div>
                <div><span>Tổng SL tồn</span><strong>@($"{invList.Sum(i => i.StockQuantity):N0}") cái</strong></div>
                <div><span>Giá trị theo vốn</span><strong>@($"{invList.Sum(i => i.InventoryCostValue):N0} đ")</strong></div>
                <div><span>Giá trị bán dự kiến</span><strong>@($"{invList.Sum(i => i.InventoryRetailValue):N0} đ")</strong></div>
            </div>

            <div class="reports-detail-table-wrap">
                <table class="reports-detail-table">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-center">Tồn kho</th>
                            <th class="text-right">Giá vốn ĐV</th>
                            <th class="text-right">Giá bán</th>
                            <th class="text-right">Giá trị tồn (Vốn)</th>
                            <th class="text-center">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!invList.Any())
                        {
                            <tr><td colspan="6" class="reports-detail-empty">Không có sản phẩm nào trong danh sách này.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in invList)
                            {
                                <tr>
                                    <td><strong>@item.ProductName</strong><span>@item.CategoryName</span></td>
                                    <td class="text-center font-semibold">@item.StockQuantity</td>
                                    <td class="text-right whitespace-nowrap">@(item.HasUnitCost ? $"{item.UnitCost:N0} đ" : "Chưa nhập")</td>
                                    <td class="text-right whitespace-nowrap">@($"{item.RetailPrice:N0} đ")</td>
                                    <td class="text-right font-semibold whitespace-nowrap">@($"{item.InventoryCostValue:N0} đ")</td>
                                    <td class="text-center">
                                        @if (item.StockQuantity <= 0)
                                        {
                                            <span class="reports-detail-status is-danger">Hết hàng</span>
                                        }
                                        else if (item.StockQuantity <= 10)
                                        {
                                            <span class="reports-detail-status is-warning">Sắp hết</span>
                                        }
                                        else
                                        {
                                            <span class="reports-detail-status is-success">Ổn định</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
}

