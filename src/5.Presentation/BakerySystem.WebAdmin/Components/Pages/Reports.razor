    // ===== Query Helpers =====

    private ReportProductItem? GetSelectedProduct() =>
        selectedProductId.HasValue
            ? analytics.Products.FirstOrDefault(p => p.ProductID == selectedProductId.Value)
            : null;

    private ReportCategoryItem? GetSelectedCategory() =>
        selectedCategoryId.HasValue
            ? analytics.Categories.FirstOrDefault(c => c.CategoryID == selectedCategoryId.Value)
            : null;

    private List<ReportProductItem> GetMasterProducts()
    {
        IEnumerable<ReportProductItem> query = analytics.Products;
        if (!string.IsNullOrWhiteSpace(productSearch))
        {
            var term = productSearch.Trim();
            query = query.Where(p =>
                p.ProductName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                p.CategoryName.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        return productSort switch
        {
            "sold_desc" => query.OrderByDescending(p => p.SoldQuantity).ThenByDescending(p => p.NetRevenue).ToList(),
            "profit_desc" => query.OrderByDescending(p => p.GrossProfit).ThenByDescending(p => p.NetRevenue).ToList(),
            "slow_asc" => query.OrderBy(p => p.SoldQuantity).ThenByDescending(p => p.CurrentStock).ToList(),
            _ => query.OrderByDescending(p => p.NetRevenue).ThenByDescending(p => p.SoldQuantity).ToList()
        };
    }

    private List<ReportProductItem> GetTopChartProducts()
    {
        IEnumerable<ReportProductItem> query = analytics.Products.Where(p => p.SoldQuantity > 0 || p.NetRevenue > 0);
        query = topChartMetric switch
        {
            "sold" => query.OrderByDescending(p => p.SoldQuantity).ThenByDescending(p => p.NetRevenue),
            "profit" => query.OrderByDescending(p => p.GrossProfit).ThenByDescending(p => p.NetRevenue),
            _ => query.OrderByDescending(p => p.NetRevenue).ThenByDescending(p => p.SoldQuantity)
        };

        if (topChartLimit > 0)
        {
            query = query.Take(topChartLimit);
        }

        return query.ToList();
    }

    private (DateTime? Start, DateTime? End, DateTime? PrevStart, DateTime? PrevEnd, string TimelineMode, int RefYear, int RefMonth, int RefQuarter) ResolvePeriod(DateTime now)
    {
        switch (filterType)
        {
            case "custom":
            {
                var s = customStartDate.Date <= customEndDate.Date ? customStartDate.Date : customEndDate.Date;
                var e = customEndDate.Date >= customStartDate.Date ? customEndDate.Date : customStartDate.Date;
                var spanDays = (e - s).Days + 1;
                return (s, e.AddDays(1).AddTicks(-1), s.AddDays(-spanDays), s.AddTicks(-1), "days", e.Year, e.Month, (e.Month - 1) / 3 + 1);
            }
            case "month":
            {
                var s = new DateTime(selectedYear, selectedMonth, 1);
                var e = s.AddMonths(1).AddTicks(-1);
                return (s, e, s.AddMonths(-1), s.AddTicks(-1), "weeks", selectedYear, selectedMonth, (selectedMonth - 1) / 3 + 1);
            }
            case "quarter":
            {
                int startMonth = (selectedQuarter - 1) * 3 + 1;
                var s = new DateTime(selectedYear, startMonth, 1);
                var e = s.AddMonths(3).AddTicks(-1);
                return (s, e, s.AddMonths(-3), s.AddTicks(-1), "quarter", selectedYear, startMonth, selectedQuarter);
            }
            case "year":
            {
                var s = new DateTime(selectedYear, 1, 1);
                var e = new DateTime(selectedYear, 12, 31).AddDays(1).AddTicks(-1);
                var ps = new DateTime(selectedYear - 1, 1, 1);
                var pe = new DateTime(selectedYear - 1, 12, 31).AddDays(1).AddTicks(-1);
                return (s, e, ps, pe, "year", selectedYear, 1, 1);
            }
            default:
                return quickPeriod switch
                {
                    "today" => (now.Date, now.Date.AddDays(1).AddTicks(-1), now.Date.AddDays(-1), now.Date.AddTicks(-1), "hours", now.Year, now.Month, (now.Month - 1) / 3 + 1),
                    "week" => (now.Date.AddDays(-6), now.Date.AddDays(1).AddTicks(-1), now.Date.AddDays(-13), now.Date.AddDays(-6).AddTicks(-1), "days", now.Year, now.Month, (now.Month - 1) / 3 + 1),
                    "month" => (new DateTime(now.Year, now.Month, 1), new DateTime(now.Year, now.Month, 1).AddMonths(1).AddTicks(-1), new DateTime(now.Year, now.Month, 1).AddMonths(-1), new DateTime(now.Year, now.Month, 1).AddTicks(-1), "weeks", now.Year, now.Month, (now.Month - 1) / 3 + 1),
                    _ => (null, null, null, null, "days", selectedYear, now.Month, (now.Month - 1) / 3 + 1)
                };
        }
    }

    private string GetPeriodDisplayName() => filterType switch
    {
        "custom" => $"Từ {customStartDate:dd/MM/yyyy} đến {customEndDate:dd/MM/yyyy}",
        "month" => $"Tháng {selectedMonth}/{selectedYear}",
        "quarter" => $"Quý {selectedQuarter} năm {selectedYear}",
        "year" => $"Cả năm {selectedYear}",
        _ => quickPeriod switch
        {
            "today" => "Hôm nay",
            "week" => "7 ngày gần nhất",
            "month" => "Tháng này",
            _ => "Toàn bộ thời gian"
        }
    };

    private static string GetGrowthBadgeClass(decimal? pct, decimal current, decimal previous)
    {
        if (pct.HasValue)
        {
            if (pct.Value > 0.05m) return "is-up";
            if (pct.Value < -0.05m) return "is-down";
            return "is-neutral";
        }
        return current > previous ? "is-up" : "is-neutral";
    }

    private static string FormatGrowthText(decimal? pct, decimal current, decimal previous)
    {
        if (!pct.HasValue)
        {
            return current > 0 && previous == 0 ? "Mới phát sinh" : "So kỳ trước: 0%";
        }
        var sign = pct.Value > 0 ? "+" : "";
        return $"{sign}{pct.Value:F1}% vs kỳ trước";
    }

