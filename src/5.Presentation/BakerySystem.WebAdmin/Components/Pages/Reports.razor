@page "/reports"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using BakerySystem.Application.Features.Reports
@using BakerySystem.Domain.Enums
@inject ReportService ReportService
@inject IJSRuntime JS

<PageTitle>Báo Cáo &amp; Thống Kê Mainform | BakeryAdmin</PageTitle>

<div class="reports-page">
    <!-- HEADER -->
    <div class="bakery-page-header pb-2 border-b border-border dark:border-darkborder flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        <div>
            <div class="flex items-center gap-2 text-xs text-slate-500 mb-1">
                <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
                    <iconify-icon icon="solar:home-2-linear" class="text-sm"></iconify-icon>
                    Trang chủ
                </a>
                <span>/</span>
                <span class="text-slate-800 dark:text-slate-200 font-semibold">Báo cáo &amp; Thống kê</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2.5 mb-1">
                <span class="w-9 h-9 rounded-xl bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800 flex items-center justify-center shrink-0">
                    <iconify-icon icon="solar:chart-2-bold" class="text-xl"></iconify-icon>
                </span>
                Báo Cáo &amp; Thống Kê Kinh Doanh
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 mb-0">
                Chọn danh mục hoặc sản phẩm ở danh sách bên trái để xem chi tiết doanh thu theo từng quý và biểu đồ trực quan ở bên phải.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <button type="button"
                    class="bakery-btn bakery-btn-outline bakery-btn-sm"
                    @onclick="LoadReportDataAsync"
                    disabled="@isLoading">
                <iconify-icon icon="solar:restart-linear" class="text-base @(isLoading ? "rpt-spin" : "")"></iconify-icon>
                <span>Tải lại</span>
            </button>

            <button type="button"
                    class="bakery-btn bakery-btn-outline bakery-btn-sm"
                    @onclick="ExportReportToExcel"
                    disabled="@isLoading">
                <iconify-icon icon="solar:file-download-linear" class="text-base rpt-text-emerald"></iconify-icon>
                <span>Xuất Excel</span>
            </button>

            <button type="button"
                    class="bakery-btn bakery-btn-primary bakery-btn-sm shadow-sm"
                    @onclick="PrintReport"
                    disabled="@isLoading">
                <iconify-icon icon="solar:printer-linear" class="text-base"></iconify-icon>
                <span>In / Xuất PDF</span>
            </button>
        </div>
    </div>

    <div class="rpt-section-stack">
        <!-- TẦNG 1: BỘ LỌC CHU KỲ & NĂM THỐNG KÊ QUÝ -->
        <div class="bakery-card report-timeline-panel report-filter p-3.5">
            <div class="report-filter-toolbar">
                <div class="report-filter-modes" role="tablist" aria-label="Kiểu lọc chu kỳ">
                    <button type="button" role="tab" class="report-filter-mode @(filterType == "quick" ? "is-active" : "")"
                            @onclick='() => SetFilterType("quick")'>Chu kỳ nhanh</button>
                    <button type="button" role="tab" class="report-filter-mode @(filterType == "year" ? "is-active" : "")"
                            @onclick='() => SetFilterType("year")'>Theo năm</button>
                    <button type="button" role="tab" class="report-filter-mode @(filterType == "quarter" ? "is-active" : "")"
                            @onclick='() => SetFilterType("quarter")'>Theo quý</button>
                    <button type="button" role="tab" class="report-filter-mode @(filterType == "month" ? "is-active" : "")"
                            @onclick='() => SetFilterType("month")'>Theo tháng</button>
                    <button type="button" role="tab" class="report-filter-mode @(filterType == "custom" ? "is-active" : "")"
                            @onclick='() => SetFilterType("custom")'>Từ ngày A &rarr; B</button>
                </div>

                <div class="report-filter-controls">
                    @if (filterType == "quick")
                    {
                        <div class="report-filter-periods">
                            <button type="button" class="report-filter-pill @(quickPeriod == "today" ? "is-active" : "")"
                                    @onclick='() => ChangeQuickPeriod("today")'>Hôm nay</button>
                            <button type="button" class="report-filter-pill @(quickPeriod == "week" ? "is-active" : "")"
                                    @onclick='() => ChangeQuickPeriod("week")'>7 ngày qua</button>
                            <button type="button" class="report-filter-pill @(quickPeriod == "month" ? "is-active" : "")"
                                    @onclick='() => ChangeQuickPeriod("month")'>Tháng này</button>
                            <button type="button" class="report-filter-pill @(quickPeriod == "all" ? "is-active" : "")"
                                    @onclick='() => ChangeQuickPeriod("all")'>Toàn thời gian</button>
                        </div>
                    }
                    else if (filterType == "custom")
                    {
                        <div class="report-filter-fields">
                            <label class="report-filter-field">
                                <span>Từ ngày</span>
                                <input type="date" class="bakery-input report-filter-input" @bind="customStartDate" />
                            </label>
                            <span class="report-filter-arrow">&rarr;</span>
                            <label class="report-filter-field">
                                <span>Đến ngày</span>
                                <input type="date" class="bakery-input report-filter-input" @bind="customEndDate" />
                            </label>
                            <button type="button" class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick="LoadReportDataAsync">
                                Xem
                            </button>
                        </div>
                    }
                    else if (filterType == "month")
                    {
                        <div class="report-filter-fields">
                            <label class="report-filter-field">
                                <span>Tháng</span>
                                <select class="bakery-input report-filter-input" @bind="selectedMonth">
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        <option value="@m">Tháng @m</option>
                                    }
                                </select>
                            </label>
                            <label class="report-filter-field">
                                <span>Năm</span>
                                <select class="bakery-input report-filter-input" @bind="selectedYear">
                                    @for (int y = DateTime.Now.Year - 3; y <= DateTime.Now.Year + 1; y++)
                                    {
                                        <option value="@y">Năm @y</option>
                                    }
                                </select>
                            </label>
                            <button type="button" class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick="LoadReportDataAsync">
                                Xem
                            </button>
                        </div>
                    }
                    else if (filterType == "quarter")
                    {
                        <div class="report-filter-fields">
                            <label class="report-filter-field">
                                <span>Quý</span>
                                <select class="bakery-input report-filter-input" @bind="selectedQuarter">
                                    <option value="1">Quý 1 (T1 - T3)</option>
                                    <option value="2">Quý 2 (T4 - T6)</option>
                                    <option value="3">Quý 3 (T7 - T9)</option>
                                    <option value="4">Quý 4 (T10 - T12)</option>
                                </select>
                            </label>
                            <label class="report-filter-field">
                                <span>Năm</span>
                                <select class="bakery-input report-filter-input" @bind="selectedYear">
                                    @for (int y = DateTime.Now.Year - 3; y <= DateTime.Now.Year + 1; y++)
                                    {
                                        <option value="@y">Năm @y</option>
                                    }
                                </select>
                            </label>
                            <button type="button" class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick="LoadReportDataAsync">
                                Xem
                            </button>
                        </div>
                    }
                    else if (filterType == "year")
                    {
                        <div class="report-filter-fields">
                            <label class="report-filter-field">
                                <span>Năm</span>
                                <select class="bakery-input report-filter-input" @bind="selectedYear">
                                    @for (int y = DateTime.Now.Year - 3; y <= DateTime.Now.Year + 1; y++)
                                    {
                                        <option value="@y">Năm @y</option>
                                    }
                                </select>
                            </label>
                            <button type="button" class="bakery-btn bakery-btn-primary bakery-btn-sm" @onclick="LoadReportDataAsync">
                                Xem năm
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="rpt-meta-strip">
                <div class="rpt-meta-badges">
                    <span class="rpt-meta-chip is-primary">
                        <iconify-icon icon="solar:calendar-linear"></iconify-icon>
                        Chu kỳ: <strong>@GetPeriodDisplayName()</strong>
                        @if (activeStartDate.HasValue && activeEndDate.HasValue)
                        {
                            <span>(@activeStartDate.Value.ToString("dd/MM/yyyy") &ndash; @activeEndDate.Value.ToString("dd/MM/yyyy"))</span>
                        }
                    </span>
                    <span class="rpt-meta-chip">
                        <iconify-icon icon="solar:chart-square-linear"></iconify-icon>
                        Biểu đồ Quý (Q1–Q4): <strong>Năm @analytics.AnalyticsYear</strong>
                    </span>
                </div>
                <span class="rpt-meta-chip is-rule">
                    <iconify-icon icon="solar:verified-check-linear"></iconify-icon>
                    Doanh thu thực thu tính theo đơn Hoàn tất &amp; phân bổ voucher
                </span>
            </div>
        </div>

        @if (hasError)
        {
            <div class="bakery-card p-4 border-red-200 bg-red-50 dark:bg-red-950/30 text-red-700 dark:text-red-300 text-sm flex items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:danger-triangle-bold" class="text-lg"></iconify-icon>
                    <span>Không thể nạp dữ liệu thống kê: @errorMessage</span>
                </div>
                <button type="button" class="bakery-btn bakery-btn-outline bakery-btn-sm" @onclick="LoadReportDataAsync">Thử lại</button>
            </div>
        }

        @if (isLoading)
        {
            <div class="bakery-card p-8 text-center text-sm rpt-text-muted flex flex-col items-center gap-2">
                <iconify-icon icon="solar:refresh-circle-linear" class="text-3xl rpt-text-blue rpt-spin"></iconify-icon>
                <span>Đang tổng hợp số liệu kinh doanh, quý và sản phẩm...</span>
            </div>
        }
        else
        {
            var kpi = analytics.Kpi;
            var inv = analytics.Inventory;
            var posChannel = analytics.Channels.FirstOrDefault(c => c.ChannelKey == "pos");
            var onlineChannel = analytics.Channels.FirstOrDefault(c => c.ChannelKey == "online");

            <!-- TẦNG 2: 4 THẺ KPI TÓM TẮT (Bấm để chuyển nhanh tab Mainform) -->
            <div class="rpt-kpi-grid">
                <button type="button" class="rpt-kpi-card @(masterTab == "quarters" ? "is-active-kpi" : "")"
                        @onclick="SelectQuartersOverview">
                    <div class="rpt-kpi-top">
                        <div>
                            <div class="rpt-kpi-label">Doanh thu thực thu</div>
                            <div class="rpt-kpi-value">@($"{kpi.ActualRevenue:N0} đ")</div>
                        </div>
                        <span class="rpt-kpi-icon is-blue"><iconify-icon icon="solar:wallet-money-bold"></iconify-icon></span>
                    </div>
                    <div class="rpt-kpi-badges">
                        @if (kpi.HasComparison)
                        {
                            <span class="rpt-pill @GetGrowthBadgeClass(kpi.RevenueGrowthPercent, kpi.ActualRevenue, kpi.PreviousRevenue)">
                                @FormatGrowthText(kpi.RevenueGrowthPercent, kpi.ActualRevenue, kpi.PreviousRevenue)
                            </span>
                        }
                        <span class="rpt-pill is-info">TB/đơn: @($"{kpi.AverageOrderValue:N0} đ")</span>
                    </div>
                </button>

                <button type="button" class="rpt-kpi-card @(masterTab == "products" ? "is-active-kpi" : "")"
                        @onclick='() => JumpToTopProducts("profit")'>
                    <div class="rpt-kpi-top">
                        <div>
                            <div class="rpt-kpi-label">Lợi nhuận gộp (COGS)</div>
                            <div class="rpt-kpi-value">@($"{kpi.GrossProfit:N0} đ")</div>
                        </div>
                        <span class="rpt-kpi-icon is-emerald"><iconify-icon icon="solar:graph-up-bold"></iconify-icon></span>
                    </div>
                    <div class="rpt-kpi-badges">
                        <span class="rpt-pill @(kpi.ProfitMargin >= 30 ? "is-up" : kpi.ProfitMargin >= 0 ? "is-warn" : "is-down")">
                            Biên lãi: @($"{kpi.ProfitMargin:F1}%")
                        </span>
                        <span class="rpt-pill is-neutral">Giá vốn: @($"{kpi.CostOfGoodsSold:N0} đ")</span>
                    </div>
                </button>

                <button type="button" class="rpt-kpi-card @(masterTab == "channels" ? "is-active-kpi" : "")"
                        @onclick="SelectChannelsOverview">
                    <div class="rpt-kpi-top">
                        <div>
                            <div class="rpt-kpi-label">Đơn hàng &amp; Kênh bán</div>
                            <div class="rpt-kpi-value">@kpi.CompletedOrdersCount / @kpi.TotalOrdersCount đơn</div>
                        </div>
                        <span class="rpt-kpi-icon is-violet"><iconify-icon icon="solar:bag-check-bold"></iconify-icon></span>
                    </div>
                    <div class="rpt-kpi-badges">
                        <span class="rpt-pill is-up">@($"{kpi.OrderSuccessRate:F1}%") thành công</span>
                        <span class="rpt-pill is-info">POS: @(posChannel?.OrderCount ?? 0) &middot; Online: @(onlineChannel?.OrderCount ?? 0)</span>
                    </div>
                </button>

                <button type="button" class="rpt-kpi-card @(masterTab == "categories" ? "is-active-kpi" : "")"
                        @onclick="SelectCategoriesOverview">
                    <div class="rpt-kpi-top">
                        <div>
                            <div class="rpt-kpi-label">Chi nhập kho &amp; Tồn kho</div>
                            <div class="rpt-kpi-value">@($"{kpi.PeriodImportCashflow:N0} đ")</div>
                        </div>
                        <span class="rpt-kpi-icon is-amber"><iconify-icon icon="solar:box-bold"></iconify-icon></span>
                    </div>
                    <div class="rpt-kpi-badges">
                        <span class="rpt-pill is-info">Tồn: @($"{inv.TotalStockUnits:N0}") bánh</span>
                        @if (inv.LowStockCount > 0)
                        {
                            <span class="rpt-pill is-warn">@inv.LowStockCount món sắp hết</span>
                        }
                        else
                        {
                            <span class="rpt-pill is-up">Tồn kho ổn định</span>
                        }
                    </div>
                </button>
            </div>

            <!-- TẦNG 3: MAINFORM MASTER–DETAIL (TRÁI: DANH SÁCH | PHẢI: CHI TIẾT & BIỂU ĐỒ) -->
            <div class="rpt-mainform-grid">
                <!-- CỘT TRÁI: DANH SÁCH LỰA CHỌN THỐNG KÊ -->
                <section class="rpt-master-card">
                    <div class="rpt-master-head">
                        <div class="rpt-master-tabs" role="tablist">
                            <button type="button" role="tab" class="rpt-master-tab @(masterTab == "products" ? "is-active" : "")"
                                    @onclick='() => SwitchMasterTab("products")'>
                                <iconify-icon icon="solar:cup-star-bold"></iconify-icon>
                                <span>Sản phẩm</span>
                            </button>
                            <button type="button" role="tab" class="rpt-master-tab @(masterTab == "quarters" ? "is-active" : "")"
                                    @onclick='() => SwitchMasterTab("quarters")'>
                                <iconify-icon icon="solar:calendar-mark-bold"></iconify-icon>
                                <span>Theo Quý</span>
                            </button>
                            <button type="button" role="tab" class="rpt-master-tab @(masterTab == "categories" ? "is-active" : "")"
                                    @onclick='() => SwitchMasterTab("categories")'>
                                <iconify-icon icon="solar:pie-chart-2-bold"></iconify-icon>
                                <span>Loại bánh</span>
                            </button>
                            <button type="button" role="tab" class="rpt-master-tab @(masterTab == "channels" ? "is-active" : "")"
                                    @onclick='() => SwitchMasterTab("channels")'>
                                <iconify-icon icon="solar:shop-2-bold"></iconify-icon>
                                <span>Kênh &amp; KH</span>
                            </button>
                        </div>

                        @if (masterTab == "products")
                        {
                            <div class="rpt-master-tools">
                                <div class="rpt-search-wrap">
                                    <iconify-icon icon="solar:magnifer-linear" class="rpt-search-icon"></iconify-icon>
                                    <input type="text"
                                           class="bakery-input rpt-search-input"
                                           placeholder="Tìm tên bánh hoặc loại bánh..."
                                           @bind="productSearch"
                                           @bind:event="oninput" />
                                </div>
                                <select class="bakery-input rpt-sort-select" @bind="productSort">
                                    <option value="revenue_desc">Top doanh thu</option>
                                    <option value="sold_desc">Top SL bán</option>
                                    <option value="profit_desc">Top lãi gộp</option>
                                    <option value="slow_asc">Bán chậm / Tồn cao</option>
                                </select>
                            </div>
                        }
                    </div>

                    <div class="rpt-master-list">
                        @if (masterTab == "products")
                        {
                            <!-- Mục ghim: Biểu đồ Top sản phẩm -->
                            <button type="button"
                                    class="rpt-master-item is-pinned @(selectedProductId is null ? "is-selected" : "")"
                                    @onclick="SelectTopProductsChart">
                                <div class="rpt-item-main">
                                    <span class="rpt-pin-icon"><iconify-icon icon="solar:ranking-bold"></iconify-icon></span>
                                    <div class="min-w-0">
                                        <div class="rpt-row-title">Tổng quan Biểu đồ Top sản phẩm</div>
                                        <div class="rpt-row-sub">So sánh Top 5 / Top 10 theo Doanh thu, SL &amp; Lãi gộp</div>
                                    </div>
                                </div>
                                <iconify-icon icon="solar:alt-arrow-right-linear" class="rpt-chevron"></iconify-icon>
                            </button>

                            var productList = GetMasterProducts();
                            @if (!productList.Any())
                            {
                                <div class="rpt-empty">Không tìm thấy sản phẩm phù hợp.</div>
                            }
                            else
                            {
                                @for (int i = 0; i < productList.Count; i++)
                                {
                                    var prod = productList[i];
                                    var rank = i + 1;
                                    var rankClass = productSort != "slow_asc"
                                        ? (rank == 1 ? "is-top1" : rank == 2 ? "is-top2" : rank == 3 ? "is-top3" : "")
                                        : "";
                                    var annualRev = prod.QuarterlyMetrics.Sum(q => q.NetRevenue);
                                    var isSelected = selectedProductId == prod.ProductID;

                                    <button type="button"
                                            class="rpt-master-item @(isSelected ? "is-selected" : "")"
                                            @onclick="() => SelectProduct(prod.ProductID)">
                                        <div class="rpt-item-main">
                                            <span class="rpt-rank-badge @rankClass">@rank</span>
                                            <div class="min-w-0">
                                                <div class="rpt-row-title truncate" title="@prod.ProductName">@prod.ProductName</div>
                                                <div class="rpt-row-sub rpt-num">
                                                    @prod.CategoryName &middot; Đã bán <strong>@prod.SoldQuantity</strong> &middot; Tồn @prod.CurrentStock
                                                </div>
                                            </div>
                                        </div>
                                        <div class="text-right shrink-0">
                                            <div class="rpt-row-amount">@($"{prod.NetRevenue:N0} đ")</div>
                                            <div class="rpt-micro">Năm @analytics.AnalyticsYear: @($"{annualRev:N0} đ")</div>
                                        </div>
                                    </button>
                                }
                            }
                        }
                        else if (masterTab == "quarters")
                        {
                            <button type="button"
                                    class="rpt-master-item is-pinned @(selectedQuarterDetail is null ? "is-selected" : "")"
                                    @onclick="SelectQuartersOverview">
                                <div class="rpt-item-main">
                                    <span class="rpt-pin-icon"><iconify-icon icon="solar:chart-bold"></iconify-icon></span>
                                    <div class="min-w-0">
                                        <div class="rpt-row-title">So sánh cả 4 Quý năm @analytics.AnalyticsYear</div>
                                        <div class="rpt-row-sub">Biểu đồ Doanh thu, Lợi nhuận &amp; SL bán Q1 &rarr; Q4</div>
                                    </div>
                                </div>
                                <iconify-icon icon="solar:alt-arrow-right-linear" class="rpt-chevron"></iconify-icon>
                            </button>

                            @foreach (var q in analytics.YearQuarters)
                            {
                                var quarterNum = q.Quarter;
                                var isSelected = selectedQuarterDetail == quarterNum;
                                var monthsRange = quarterNum switch
                                {
                                    1 => "Tháng 1 – 3",
                                    2 => "Tháng 4 – 6",
                                    3 => "Tháng 7 – 9",
                                    _ => "Tháng 10 – 12"
                                };

                                <button type="button"
                                        class="rpt-master-item @(isSelected ? "is-selected" : "")"
                                        @onclick="() => SelectQuarter(quarterNum)">
                                    <div class="rpt-item-main">
                                        <span class="rpt-quarter-badge">@q.ShortLabel</span>
                                        <div class="min-w-0">
                                            <div class="rpt-row-title">@q.Label / @analytics.AnalyticsYear</div>
                                            <div class="rpt-row-sub rpt-num">@monthsRange &middot; @q.OrderCount đơn &middot; @q.SoldQuantity bánh</div>
                                        </div>
                                    </div>
                                    <div class="text-right shrink-0">
                                        <div class="rpt-row-amount">@($"{q.NetRevenue:N0} đ")</div>
                                        <div class="rpt-micro @(q.GrossProfit >= 0 ? "rpt-text-emerald" : "rpt-text-red")">
                                            Lãi @($"{q.GrossProfit:N0} đ")
                                        </div>
                                    </div>
                                </button>
                            }
                        }
                        else if (masterTab == "categories")
                        {
                            <button type="button"
                                    class="rpt-master-item is-pinned @(selectedCategoryId is null ? "is-selected" : "")"
                                    @onclick="SelectCategoriesOverview">
                                <div class="rpt-item-main">
                                    <span class="rpt-pin-icon"><iconify-icon icon="solar:pie-chart-2-bold"></iconify-icon></span>
                                    <div class="min-w-0">
                                        <div class="rpt-row-title">Cơ cấu toàn bộ Loại bánh</div>
                                        <div class="rpt-row-sub">Biểu đồ Donut tỷ trọng doanh thu theo nhóm sản phẩm</div>
                                    </div>
                                </div>
                                <iconify-icon icon="solar:alt-arrow-right-linear" class="rpt-chevron"></iconify-icon>
                            </button>

                            @if (!analytics.Categories.Any())
                            {
                                <div class="rpt-empty">Chưa có doanh thu theo loại bánh trong kỳ này.</div>
                            }
                            else
                            {
                                @foreach (var cat in analytics.Categories)
                                {
                                    var catId = cat.CategoryID;
                                    var isSelected = selectedCategoryId == catId;
                                    <button type="button"
                                            class="rpt-master-item @(isSelected ? "is-selected" : "")"
                                            @onclick="() => SelectCategory(catId)">
                                        <div class="rpt-item-main">
                                            <span class="rpt-dot" style="background: @cat.ColorHex"></span>
                                            <div class="min-w-0">
                                                <div class="rpt-row-title truncate">@cat.CategoryName</div>
                                                <div class="rpt-row-sub rpt-num">@cat.SoldQuantity bánh &middot; @cat.ProductCount món bán chạy</div>
                                            </div>
                                        </div>
                                        <div class="text-right shrink-0">
                                            <div class="rpt-row-amount">@($"{cat.Revenue:N0} đ")</div>
                                            <div class="rpt-micro rpt-text-blue font-semibold">@($"{cat.Percentage:F1}%")</div>
                                        </div>
                                    </button>
                                }
                            }
                        }
                        else if (masterTab == "channels")
                        {
                            <button type="button"
                                    class="rpt-master-item is-pinned @(selectedChannelSection == "overview" ? "is-selected" : "")"
                                    @onclick='() => SelectChannelSection("overview")'>
                                <div class="rpt-item-main">
                                    <span class="rpt-pin-icon"><iconify-icon icon="solar:shop-2-bold"></iconify-icon></span>
                                    <div class="min-w-0">
                                        <div class="rpt-row-title">Cơ cấu Kênh bán &amp; Thanh toán</div>
                                        <div class="rpt-row-sub">So sánh POS vs Online &amp; dòng tiền thanh toán</div>
                                    </div>
                                </div>
                                <iconify-icon icon="solar:alt-arrow-right-linear" class="rpt-chevron"></iconify-icon>
                            </button>

                            @foreach (var ch in analytics.Channels)
                            {
                                var chKey = ch.ChannelKey;
                                <button type="button"
                                        class="rpt-master-item @(selectedChannelSection == chKey ? "is-selected" : "")"
                                        @onclick="() => SelectChannelSection(chKey)">
                                    <div class="rpt-item-main">
                                        <span class="rpt-pin-icon is-soft"><iconify-icon icon="@ch.Icon"></iconify-icon></span>
                                        <div class="min-w-0">
                                            <div class="rpt-row-title">@ch.DisplayName</div>
                                            <div class="rpt-row-sub rpt-num">@ch.OrderCount đơn hoàn tất &middot; @($"{ch.Percentage:F1}%")</div>
                                        </div>
                                    </div>
                                    <div class="text-right shrink-0">
                                        <div class="rpt-row-amount">@($"{ch.Revenue:N0} đ")</div>
                                        <div class="rpt-micro rpt-text-emerald">Lãi @($"{ch.GrossProfit:N0} đ")</div>
                                    </div>
                                </button>
                            }

                            <button type="button"
                                    class="rpt-master-item @(selectedChannelSection == "customers" ? "is-selected" : "")"
                                    @onclick='() => SelectChannelSection("customers")'>
                                <div class="rpt-item-main">
                                    <span class="rpt-pin-icon is-amber"><iconify-icon icon="solar:users-group-rounded-bold"></iconify-icon></span>
                                    <div class="min-w-0">
                                        <div class="rpt-row-title">Top Khách hàng chi tiêu cao</div>
                                        <div class="rpt-row-sub">@analytics.TopCustomers.Count khách hàng nổi bật trong kỳ</div>
                                    </div>
                                </div>
                                <iconify-icon icon="solar:alt-arrow-right-linear" class="rpt-chevron"></iconify-icon>
                            </button>
                        }
                    </div>
                </section>

                <!-- CỘT PHẢI: CHI TIẾT & BIỂU ĐỒ THEO LỰA CHỌN BÊN TRÁI -->
                <section class="rpt-detail-card">
                    @if (masterTab == "products" && selectedProductId is null)
                    {
                        <!-- DETAIL 1A: BIỂU ĐỒ TOP SẢN PHẨM -->
                        var topItems = GetTopChartProducts();
                        <div class="rpt-detail-head">
                            <div>
                                <div class="rpt-detail-eyebrow">TOP BIỂU ĐỒ SẢN PHẨM &middot; @GetPeriodDisplayName()</div>
                                <h3 class="rpt-detail-title">Xếp hạng Top Sản Phẩm Nổi Bật</h3>
                                <p class="rpt-detail-sub">So sánh trực quan các món bánh dẫn đầu — bấm vào bất kỳ món nào bên dưới để xem tổng tiền theo từng Quý (Q1–Q4).</p>
                            </div>
                            <div class="rpt-detail-controls">
                                <div class="rpt-seg-group">
                                    <button type="button" class="rpt-seg-btn @(topChartMetric == "revenue" ? "is-active" : "")"
                                            @onclick='() => ChangeTopChartConfig("revenue", topChartLimit)'>Doanh thu</button>
                                    <button type="button" class="rpt-seg-btn @(topChartMetric == "sold" ? "is-active" : "")"
                                            @onclick='() => ChangeTopChartConfig("sold", topChartLimit)'>Số lượng</button>
                                    <button type="button" class="rpt-seg-btn @(topChartMetric == "profit" ? "is-active" : "")"
                                            @onclick='() => ChangeTopChartConfig("profit", topChartLimit)'>Lãi gộp</button>
                                </div>
                                <div class="rpt-seg-group">
                                    <button type="button" class="rpt-seg-btn @(topChartLimit == 5 ? "is-active" : "")"
                                            @onclick='() => ChangeTopChartConfig(topChartMetric, 5)'>Top 5</button>
                                    <button type="button" class="rpt-seg-btn @(topChartLimit == 10 ? "is-active" : "")"
                                            @onclick='() => ChangeTopChartConfig(topChartMetric, 10)'>Top 10</button>
                                    <button type="button" class="rpt-seg-btn @(topChartLimit == 0 ? "is-active" : "")"
                                            @onclick='() => ChangeTopChartConfig(topChartMetric, 0)'>Tất cả</button>
                                </div>
                            </div>
                        </div>

                        <div class="rpt-chart-box">
                            @if (!topItems.Any())
                            {
                                <div class="rpt-empty">Chưa có sản phẩm nào bán ra trong chu kỳ này.</div>
                            }
                            else
                            {
                                <div id="rpt-detail-chart" style="min-height: 240px;"></div>
                            }
                        </div>

                        <div class="rpt-table-box">
                            <div class="rpt-table-box-head">
                                <span>Bảng chi tiết Top sản phẩm (@topItems.Count món)</span>
                                <span class="rpt-micro">Bấm một dòng để xem thống kê Q1–Q4 của sản phẩm đó</span>
                            </div>
                            <div class="rpt-table-wrap">
                                <table class="rpt-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 38px;">#</th>
                                            <th>Sản phẩm</th>
                                            <th class="text-center">SL bán</th>
                                            <th class="text-right">Doanh thu</th>
                                            <th class="text-right">Lợi nhuận gộp</th>
                                            <th class="text-right">Biên lãi</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < topItems.Count; i++)
                                        {
                                            var p = topItems[i];
                                            var rCls = i == 0 ? "is-top1" : i == 1 ? "is-top2" : i == 2 ? "is-top3" : "";
                                            <tr class="is-clickable" @onclick="() => SelectProduct(p.ProductID)">
                                                <td><span class="rpt-rank-badge @rCls">@(i + 1)</span></td>
                                                <td>
                                                    <div class="rpt-row-title">@p.ProductName</div>
                                                    <div class="rpt-micro">@p.CategoryName</div>
                                                </td>
                                                <td class="text-center font-bold">@p.SoldQuantity</td>
                                                <td class="text-right font-bold rpt-text-blue whitespace-nowrap">@($"{p.NetRevenue:N0} đ")</td>
                                                <td class="text-right font-semibold @(p.GrossProfit >= 0 ? "rpt-text-emerald" : "rpt-text-red") whitespace-nowrap">@($"{p.GrossProfit:N0} đ")</td>
                                                <td class="text-right font-semibold">@($"{p.Margin:F1}%")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else if (masterTab == "products" && GetSelectedProduct() is { } selectedProd)
                    {
                        <!-- DETAIL 1B: CHI TIẾT 1 SẢN PHẨM THEO TỪNG QUÝ (Q1–Q4) -->
                        var annualRev = selectedProd.QuarterlyMetrics.Sum(q => q.NetRevenue);
                        var annualCost = selectedProd.QuarterlyMetrics.Sum(q => q.CostOfGoodsSold);
                        var annualProfit = annualRev - annualCost;
                        var annualQty = selectedProd.QuarterlyMetrics.Sum(q => q.SoldQuantity);
                        var annualMargin = annualRev > 0 ? annualProfit / annualRev * 100m : 0m;
                        var relatedOrders = analytics.Orders
                            .Where(o => o.Status == OrderStatus.Completed && o.Lines.Any(l => l.ProductID == selectedProd.ProductID))
                            .OrderByDescending(o => o.OrderDate)
                            .Take(8)
                            .ToList();

                        <div class="rpt-detail-head">
                            <div>
                                <div class="rpt-detail-eyebrow">CHI TIẾT SẢN PHẨM THEO QUÝ &middot; NĂM @analytics.AnalyticsYear</div>
                                <h3 class="rpt-detail-title">@selectedProd.ProductName</h3>
                                <p class="rpt-detail-sub">
                                    Loại: <strong>@selectedProd.CategoryName</strong> &middot;
                                    Giá bán: <strong>@($"{selectedProd.RetailPrice:N0} đ")</strong> &middot;
                                    Giá vốn ĐV: <strong>@(selectedProd.HasUnitCost ? $"{selectedProd.UnitCost:N0} đ" : "Chưa có")</strong> &middot;
                                    Tồn kho: <strong>@selectedProd.CurrentStock</strong>
                                </p>
                            </div>
                            <button type="button" class="bakery-btn bakery-btn-outline bakery-btn-sm" @onclick="SelectTopProductsChart">
                                &larr; Về Top biểu đồ
                            </button>
                        </div>

                        <div class="rpt-summary-4">
                            <div class="rpt-summary-box">
                                <span>Tổng tiền cả năm @analytics.AnalyticsYear</span>
                                <strong class="rpt-text-blue">@($"{annualRev:N0} đ")</strong>
                            </div>
                            <div class="rpt-summary-box">
                                <span>Tổng SL bán năm @analytics.AnalyticsYear</span>
                                <strong>@($"{annualQty:N0} cái")</strong>
                            </div>
                            <div class="rpt-summary-box">
                                <span>Lợi nhuận gộp năm</span>
                                <strong class="@(annualProfit >= 0 ? "rpt-text-emerald" : "rpt-text-red")">@($"{annualProfit:N0} đ")</strong>
                            </div>
                            <div class="rpt-summary-box">
                                <span>Biên lãi gộp</span>
                                <strong>@($"{annualMargin:F1}%")</strong>
                            </div>
                        </div>

                        <div class="rpt-chart-box">
                            <div class="rpt-chart-box-title">
                                Biểu đồ Tổng tiền &amp; Số lượng bán theo từng Quý (Năm @analytics.AnalyticsYear)
                            </div>
                            <div id="rpt-detail-chart" style="min-height: 270px;"></div>
                        </div>

                        <div class="rpt-table-box">
                            <div class="rpt-table-box-head">
                                <span>Bảng tổng tiền sản phẩm theo từng Quý (Q1 – Q4 / @analytics.AnalyticsYear)</span>
                            </div>
                            <div class="rpt-table-wrap">
                                <table class="rpt-table">
                                    <thead>
                                        <tr>
                                            <th>Quý</th>
                                            <th class="text-center">Số đơn</th>
                                            <th class="text-center">SL bán</th>
                                            <th class="text-right">Tổng tiền (Thực thu)</th>
                                            <th class="text-right">Giá vốn</th>
                                            <th class="text-right">Lợi nhuận gộp</th>
                                            <th class="text-right">Tỷ trọng</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var q in selectedProd.QuarterlyMetrics)
                                        {
                                            var share = annualRev > 0 ? q.NetRevenue / annualRev * 100m : 0m;
                                            <tr>
                                                <td class="font-bold">@q.Label</td>
                                                <td class="text-center">@q.OrderCount</td>
                                                <td class="text-center font-semibold">@q.SoldQuantity</td>
                                                <td class="text-right font-bold rpt-text-blue whitespace-nowrap">@($"{q.NetRevenue:N0} đ")</td>
                                                <td class="text-right rpt-text-amber whitespace-nowrap">@($"{q.CostOfGoodsSold:N0} đ")</td>
                                                <td class="text-right font-bold @(q.GrossProfit >= 0 ? "rpt-text-emerald" : "rpt-text-red") whitespace-nowrap">@($"{q.GrossProfit:N0} đ")</td>
                                                <td class="text-right font-semibold">@($"{share:F1}%")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        @if (relatedOrders.Any())
                        {
                            <div class="rpt-table-box">
                                <div class="rpt-table-box-head">
                                    <span>Đơn hàng hoàn tất gần đây có món này trong kỳ (@GetPeriodDisplayName())</span>
                                </div>
                                <div class="rpt-table-wrap">
                                    <table class="rpt-table">
                                        <thead>
                                            <tr>
                                                <th>Mã đơn</th>
                                                <th>Ngày đặt</th>
                                                <th>Kênh</th>
                                                <th class="text-center">SL món này</th>
                                                <th class="text-right">Tiền món</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var ord in relatedOrders)
                                            {
                                                var lineQty = ord.Lines.Where(l => l.ProductID == selectedProd.ProductID).Sum(l => l.Quantity);
                                                var lineRev = ord.Lines.Where(l => l.ProductID == selectedProd.ProductID).Sum(l => l.AllocatedNetRevenue);
                                                <tr>
                                                    <td>
                                                        <a href="/orders?order=@ord.OrderID" class="font-bold rpt-text-blue hover:underline">
                                                            #HD-@ord.OrderID.ToString("D4")
                                                        </a>
                                                    </td>
                                                    <td class="whitespace-nowrap">@ord.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                                    <td>@ord.ChannelLabel</td>
                                                    <td class="text-center font-bold">@lineQty</td>
                                                    <td class="text-right font-bold whitespace-nowrap">@($"{lineRev:N0} đ")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                    else if (masterTab == "quarters" && selectedQuarterDetail is null)
                    {
                        <!-- DETAIL 2A: SO SÁNH 4 QUÝ TRONG NĂM -->
                        var totalYearRev = analytics.YearQuarters.Sum(q => q.NetRevenue);
                        var totalYearProfit = analytics.YearQuarters.Sum(q => q.GrossProfit);
                        var totalYearOrders = analytics.YearQuarters.Sum(q => q.OrderCount);
                        var totalYearQty = analytics.YearQuarters.Sum(q => q.SoldQuantity);

                        <div class="rpt-detail-head">
                            <div>
                                <div class="rpt-detail-eyebrow">THỐNG KÊ THEO QUÝ &middot; NĂM @analytics.AnalyticsYear</div>
                                <h3 class="rpt-detail-title">Tổng Quan Doanh Thu &amp; Lợi Nhuận 4 Quý (@analytics.AnalyticsYear)</h3>
                                <p class="rpt-detail-sub">So sánh hiệu quả kinh doanh từ Quý 1 đến Quý 4. Bấm vào từng Quý bên trái để xem Top sản phẩm của quý đó.</p>
                            </div>
                        </div>

                        <div class="rpt-summary-4">
                            <div class="rpt-summary-box">
                                <span>Doanh thu năm @analytics.AnalyticsYear</span>
                                <strong class="rpt-text-blue">@($"{totalYearRev:N0} đ")</strong>
                            </div>
                            <div class="rpt-summary-box">
                                <span>Lợi nhuận gộp năm</span>
                                <strong class="rpt-text-emerald">@($"{totalYearProfit:N0} đ")</strong>
                            </div>
                            <div class="rpt-summary-box">
                                <span>Tổng đơn hoàn tất</span>
                                <strong>@($"{totalYearOrders:N0} đơn")</strong>
                            </div>
                            <div class="rpt-summary-box">
                                <span>Tổng bánh đã bán</span>
                                <strong>@($"{totalYearQty:N0} cái")</strong>
                            </div>
                        </div>

                        <div class="rpt-chart-box">
                            <div class="rpt-chart-box-title">Biểu đồ Doanh thu, Lợi nhuận gộp &amp; Sản lượng theo 4 Quý</div>
                            <div id="rpt-detail-chart" style="min-height: 270px;"></div>
                        </div>

                        <div class="rpt-table-box">
                            <div class="rpt-table-box-head">
                                <span>Bảng tổng hợp 4 Quý năm @analytics.AnalyticsYear</span>
                                <span class="rpt-micro">Bấm một quý để xem Top sản phẩm trong quý</span>
                            </div>
                            <div class="rpt-table-wrap">
                                <table class="rpt-table">
                                    <thead>
                                        <tr>
                                            <th>Quý</th>
                                            <th class="text-center">Đơn hoàn tất</th>
                                            <th class="text-center">SL bánh</th>
                                            <th class="text-right">Doanh thu</th>
                                            <th class="text-right">Giá vốn</th>
                                            <th class="text-right">Lợi nhuận gộp</th>
                                            <th class="text-right">Tỷ trọng</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var q in analytics.YearQuarters)
                                        {
                                            var share = totalYearRev > 0 ? q.NetRevenue / totalYearRev * 100m : 0m;
                                            <tr class="is-clickable" @onclick="() => SelectQuarter(q.Quarter)">
                                                <td class="font-bold">@q.Label</td>
                                                <td class="text-center">@q.OrderCount</td>
                                                <td class="text-center font-semibold">@q.SoldQuantity</td>
                                                <td class="text-right font-bold rpt-text-blue whitespace-nowrap">@($"{q.NetRevenue:N0} đ")</td>
                                                <td class="text-right rpt-text-amber whitespace-nowrap">@($"{q.CostOfGoodsSold:N0} đ")</td>
                                                <td class="text-right font-bold rpt-text-emerald whitespace-nowrap">@($"{q.GrossProfit:N0} đ")</td>
                                                <td class="text-right font-semibold">@($"{share:F1}%")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else if (masterTab == "quarters" && selectedQuarterDetail is int qNum)
                    {
                        <!-- DETAIL 2B: CHI TIẾT 1 QUÝ CỤ THỂ -->
                        var qInfo = analytics.YearQuarters.FirstOrDefault(x => x.Quarter == qNum) ?? new ReportQuarterMetric { Quarter = qNum };
                        var qProducts = analytics.TopProductsByQuarter.TryGetValue(qNum, out var list) ? list : [];

                        <div class="rpt-detail-head">
                            <div>
                                <div class="rpt-detail-eyebrow">CHI TIẾT QUÝ @qNum / @analytics.AnalyticsYear</div>
                                <h3 class="rpt-detail-title">Top Sản Phẩm &amp; Hiệu Suất Quý @qNum (@analytics.AnalyticsYear)</h3>
                                <p class="rpt-detail-sub">Xếp hạng sản phẩm đóng góp doanh thu cao nhất trong Quý @qNum.</p>
                            </div>
                            <button type="button" class="bakery-btn bakery-btn-outline bakery-btn-sm" @onclick="SelectQuartersOverview">
                                &larr; So sánh 4 Quý
                            </button>
                        </div>

                        <div class="rpt-summary-4">
                            <div class="rpt-summary-box">
                                <span>Doanh thu Quý @qNum</span>
                                <strong class="rpt-text-blue">@($"{qInfo.NetRevenue:N0} đ")</strong>
                            </div>
                            <div class="rpt-summary-box">
                                <span>Lợi nhuận gộp</span>
                                <strong class="rpt-text-emerald">@($"{qInfo.GrossProfit:N0} đ")</strong>
                            </div>
                            <div class="rpt-summary-box">
                                <span>Đơn hoàn tất</span>
                                <strong>@($"{qInfo.OrderCount} đơn")</strong>
                            </div>
                            <div class="rpt-summary-box">
                                <span>Sản phẩm bán ra</span>
                                <strong>@($"{qInfo.SoldQuantity} cái")</strong>
                            </div>
                        </div>

                        <div class="rpt-chart-box">
                            <div class="rpt-chart-box-title">Biểu đồ Top Sản Phẩm Doanh Thu Cao Nhất — Quý @qNum/@analytics.AnalyticsYear</div>
                            @if (!qProducts.Any())
                            {
                                <div class="rpt-empty">Chưa có đơn hàng hoàn tất trong Quý @qNum/@analytics.AnalyticsYear.</div>
                            }
                            else
                            {
                                <div id="rpt-detail-chart" style="min-height: 240px;"></div>
                            }
                        </div>

                        <div class="rpt-table-box">
                            <div class="rpt-table-box-head">
                                <span>Danh sách sản phẩm bán trong Quý @qNum (@qProducts.Count món)</span>
                            </div>
                            @if (!qProducts.Any())
                            {
                                <div class="rpt-empty">Không có dữ liệu bán hàng trong quý này.</div>
                            }
                            else
                            {
                                <div class="rpt-table-wrap">
                                    <table class="rpt-table">
                                        <thead>
                                            <tr>
                                                <th style="width: 38px;">#</th>
                                                <th>Món bánh</th>
                                                <th class="text-center">SL bán</th>
                                                <th class="text-right">Doanh thu Quý @qNum</th>
                                                <th class="text-right">Lãi gộp</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < qProducts.Count; i++)
                                            {
                                                var p = qProducts[i];
                                                <tr class="is-clickable" @onclick="() => JumpToProductDetail(p.ProductID)">
                                                    <td><span class="rpt-rank-badge @(i == 0 ? "is-top1" : i == 1 ? "is-top2" : i == 2 ? "is-top3" : "")">@(i + 1)</span></td>
                                                    <td>
                                                        <div class="rpt-row-title">@p.ProductName</div>
                                                        <div class="rpt-micro">@p.CategoryName</div>
                                                    </td>
                                                    <td class="text-center font-bold">@p.SoldQuantity</td>
                                                    <td class="text-right font-bold rpt-text-blue whitespace-nowrap">@($"{p.NetRevenue:N0} đ")</td>
                                                    <td class="text-right font-semibold rpt-text-emerald whitespace-nowrap">@($"{p.GrossProfit:N0} đ")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    }
                    else if (masterTab == "categories" && selectedCategoryId is null)
                    {
                        <!-- DETAIL 3A: CƠ CẤU TOÀN BỘ LOẠI BÁNH -->
                        <div class="rpt-detail-head">
                            <div>
                                <div class="rpt-detail-eyebrow">CƠ CẤU DANH MỤC &middot; @GetPeriodDisplayName()</div>
                                <h3 class="rpt-detail-title">Tỷ Trọng Doanh Thu Theo Loại Bánh</h3>
                                <p class="rpt-detail-sub">Doanh thu đã phân bổ voucher theo tỷ lệ — bấm vào 1 loại bánh bên trái để xem biến động theo từng Quý (Q1–Q4).</p>
                            </div>
                        </div>

                        <div class="rpt-chart-box">
                            <div id="rpt-detail-chart" style="min-height: 250px;"></div>
                        </div>

                        <div class="rpt-table-box">
                            <div class="rpt-table-box-head">
                                <span>Chi tiết từng loại bánh (@analytics.Categories.Count nhóm)</span>
                            </div>
                            <div class="rpt-table-wrap">
                                <table class="rpt-table">
                                    <thead>
                                        <tr>
                                            <th>Loại bánh</th>
                                            <th class="text-center">SL bán</th>
                                            <th class="text-right">Doanh thu</th>
                                            <th class="text-right">Lãi gộp</th>
                                            <th class="text-right">Tỷ trọng</th>
                                        </tr>
