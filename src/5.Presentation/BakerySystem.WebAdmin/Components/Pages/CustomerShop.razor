@page "/shop"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Customer")]
@implements IDisposable
@using System.Security.Claims
@inject CustomerOrderService CustomerOrderService
@inject IAuthService AuthService
@inject WebCartService CartService
@inject OrderNotificationService NotifService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Thực đơn &amp; Đặt bánh Online | BakerySystem</PageTitle>

@if (!string.IsNullOrEmpty(toastMessage))
{
    <div class="shop-toast" role="status">
        <iconify-icon icon="solar:check-circle-bold" style="color: #34d399; font-size: 1.1rem;"></iconify-icon>
        <span>@toastMessage</span>
    </div>
}

<div class="bakery-page-header" style="margin-bottom: 0.85rem;">
    <div>
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-0.5">
            Xin chào, @(customerProfile?.FullName ?? "Quý khách")!
        </h2>
        <p class="text-xs text-slate-500 mb-0">
            Chọn các món bánh tươi bên trái và kiểm tra chi tiết đơn hàng của bạn ở khung bên phải.
        </p>
    </div>

    <div class="bakery-page-actions">
        <button type="button" class="bakery-btn bakery-btn-secondary bakery-btn-sm" @onclick="RefreshCatalogAsync">
            <iconify-icon icon="solar:restart-linear"></iconify-icon>
            <span>Làm mới menu</span>
        </button>
        <a href="/my-orders" class="bakery-btn bakery-btn-primary bakery-btn-sm">
            <iconify-icon icon="solar:bag-heart-bold"></iconify-icon>
            <span>Xem đơn hàng đã đặt (@customerOrders.Count)</span>
        </a>
    </div>
</div>

@if (isLoading)
{
    <div class="bakery-card p-10 text-center">
        <div class="w-9 h-9 border-4 border-primary border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
        <p class="text-xs text-slate-500 mb-0">Đang tải thực đơn bánh tươi từ cửa hàng...</p>
    </div>
}
else
{
    <!-- Thông báo nổi bật khi có đơn hàng đã giao tới nơi chờ khách xác nhận -->
    @foreach (var deliveredOrder in customerOrders.Where(o => o.Status == OrderStatus.Delivered))
    {
        <div class="shop-delivery-alert">
            <div class="shop-delivery-alert-left">
                <span class="shop-delivery-alert-icon">
                    <iconify-icon icon="solar:delivery-bold"></iconify-icon>
                </span>
                <div>
                    <div class="text-sm font-bold text-slate-900">
                        Đơn hàng #HD-@deliveredOrder.OrderID.ToString("D4") đã được giao tới nơi!
                    </div>
                    <div class="text-xs text-slate-600">
                        Tổng thanh toán: <strong>@($"{deliveredOrder.FinalAmount:N0}đ")</strong> &bull; Vui lòng kiểm tra bánh và bấm xác nhận đã nhận.
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" class="bakery-btn bakery-btn-primary bakery-btn-sm"
                        style="background-color: #059669;"
                        @onclick="() => ConfirmDeliveredOrderAsync(deliveredOrder.OrderID)">
                    <iconify-icon icon="solar:check-circle-bold"></iconify-icon>
                    <span>Xác nhận đã nhận bánh</span>
                </button>
                <a href="/my-orders" class="bakery-btn bakery-btn-outline bakery-btn-sm">Xem chi tiết</a>
            </div>
        </div>
    }

    <!-- Banner Kho Voucher & Ưu đãi nhỏ gọn -->
    <div class="shop-promo-banner">
        <div class="flex items-center gap-3 flex-wrap">
            <span class="shop-promo-pill">
                <iconify-icon icon="solar:ticket-sale-bold"></iconify-icon>
                <span>ƯU ĐÃI HÔM NAY</span>
            </span>
            <span class="text-sm font-bold text-white">Kho Voucher BakerySystem</span>
            <span class="text-xs" style="color: rgba(255,255,255,0.88);">
                @(promotions.Count > 0 ? $"Có {promotions.Count} mã giảm giá đang mở" : "Ưu đãi trực tuyến")
            </span>
        </div>
        <div class="flex items-center gap-2">
            @if (!string.IsNullOrEmpty(CartService.AppliedVoucherCode))
            {
                <span class="px-2.5 py-1 rounded-lg text-xs font-bold" style="background: rgba(255,255,255,0.2); color: #fff;">
                    Đang dùng: @CartService.AppliedVoucherCode
                </span>
            }
            <button type="button" class="bakery-btn bakery-btn-sm"
                    style="background: #ffffff; color: #1e40af; font-weight: 700;"
                    @onclick="() => isVoucherModalOpen = true">
                <iconify-icon icon="solar:ticket-sale-bold"></iconify-icon>
                <span>Mở Kho Voucher (@promotions.Count)</span>
            </button>
        </div>
    </div>

    <div class="shop-layout">
        <!-- CỘT TRÁI: Ô BÁNH NHỎ GỌN, CHỌN MÓN RÕ RÀNG -->
        <div class="bakery-pos-left">
            <div class="bakery-pos-filter-card" style="padding: 0.65rem 0.85rem !important;">
                <div class="shop-filter-bar">
                    <div class="bakery-search-input-wrap shop-search-wrap">
                        <iconify-icon icon="solar:magnifer-linear"></iconify-icon>
                        <input type="text"
                               class="bakery-search-input"
                               style="height: 36px !important;"
                               placeholder="Tìm tên bánh kem, tiramisu, croissant..."
                               @bind="searchQuery"
                               @bind:event="oninput" />
                    </div>

                    <select class="shop-sort-select" @bind="sortOrder" title="Sắp xếp sản phẩm">
                        <option value="default">Mặc định</option>
                        <option value="price-asc">Giá: Thấp → Cao</option>
                        <option value="price-desc">Giá: Cao → Thấp</option>
                    </select>

                    @if (!string.IsNullOrWhiteSpace(searchQuery) || selectedCategoryId != 0 || sortOrder != "default")
                    {
                        <button type="button" class="bakery-btn bakery-btn-outline bakery-btn-sm" @onclick="ResetFilters">
                            <span>Xóa lọc</span>
                        </button>
                    }
                </div>

                <!-- Danh mục sản phẩm -->
                <div class="bakery-pos-cats">
                    <button type="button"
                            class="bakery-pos-cat-pill @(selectedCategoryId == 0 ? "active" : "")"
                            @onclick="() => selectedCategoryId = 0">
                        Tất cả (@products.Count)
                    </button>
                    @foreach (var cat in categories)
                    {
                        var count = products.Count(p => p.CategoryID == cat.CategoryID);
                        <button type="button"
                                class="bakery-pos-cat-pill @(selectedCategoryId == cat.CategoryID ? "active" : "")"
                                @onclick="() => selectedCategoryId = cat.CategoryID">
                            @cat.CategoryName (@count)
                        </button>
                    }
                </div>
            </div>

            @if (!FilteredProducts.Any())
            {
                <div class="bakery-card p-8 text-center text-slate-400">
                    <iconify-icon icon="solar:cup-paper-linear" class="text-4xl mb-2"></iconify-icon>
                    <p class="text-sm font-semibold text-slate-700 mb-1">Không tìm thấy món bánh phù hợp</p>
                    <p class="text-xs mb-0">Vui lòng thử từ khóa hoặc danh mục khác.</p>
                </div>
            }
            else
            {
                <div class="shop-product-grid">
                    @foreach (var prod in FilteredProducts)
                    {
                        var isOutOfStock = prod.Quantity <= 0;
                        var inCartItem = CartService.Items.FirstOrDefault(i => i.ProductID == prod.ProductID);
                        var isSelected = inCartItem is not null;
                        var productDiscount = CartService.GetProductDiscountAmount(prod.ProductID, prod.Price);
                        var productDiscountPct = CartService.GetProductDiscountPercent(prod.ProductID);
                        var discountedPrice = prod.Price - productDiscount;

                        <div class="shop-product-card @(isSelected ? "is-selected" : "") @(isOutOfStock ? "opacity-60" : "")"
                             @onclick="() => OpenProductModal(prod)">
                            <div>
                                <div class="shop-product-img-box">
                                    <img src="@WebCartService.ResolveProductImageUrl(prod)"
                                         alt="@prod.ProductName"
                                         class="shop-product-img"
                                         onerror="this.src='/assets/images/products/default-bakery.svg'" />

                                    @if (productDiscount > 0)
                                    {
                                        <span class="shop-discount-tag">-@($"{productDiscountPct:0.##}%")</span>
                                    }

                                    @if (isOutOfStock)
                                    {
                                        <span class="shop-stock-tag is-out">Hết bánh</span>
                                    }
                                    else if (prod.Quantity <= 5)
                                    {
                                        <span class="shop-stock-tag is-low">Còn @prod.Quantity</span>
                                    }

                                    @if (!isOutOfStock && inCartItem is not null)
                                    {
                                        <span class="shop-card-selected-badge">Đã chọn: @inCartItem.Quantity</span>
                                    }
                                </div>

                                <div class="shop-card-title" title="@prod.ProductName">@prod.ProductName</div>
                                <div class="shop-card-cat">@(prod.Category?.CategoryName ?? "Bánh tươi")</div>
                            </div>

                            <div>
                                <div class="shop-card-price-row">
                                    <div>
                                        @if (productDiscount > 0)
                                        {
                                            <del class="text-[10px] text-slate-400 mr-1">@($"{prod.Price:N0}đ")</del>
                                            <span class="shop-card-price" style="color: #dc2626;">@($"{discountedPrice:N0}đ")</span>
                                        }
                                        else
                                        {
                                            <span class="shop-card-price">@($"{prod.Price:N0}đ")</span>
                                        }
                                    </div>
                                    <span class="shop-card-stock @(isOutOfStock ? "is-out" : (prod.Quantity <= 5 ? "is-low" : ""))">
                                        @(isOutOfStock ? "Hết" : $"Còn {prod.Quantity}")
                                    </span>
                                </div>

                                @if (isOutOfStock)
                                {
                                    <button type="button" class="shop-card-select-btn" disabled>
                                        <span>Hết hàng</span>
                                    </button>
                                }
                                else if (inCartItem is not null)
                                {
                                    <div class="shop-card-qty-bar" @onclick:stopPropagation="true">
                                        <button type="button"
                                                class="shop-card-qty-btn"
                                                title="Giảm số lượng"
                                                @onclick="() => CartService.UpdateQuantity(prod.ProductID, -1)">
                                            -
                                        </button>
                                        <span class="shop-card-qty-val">Đã chọn @inCartItem.Quantity</span>
                                        <button type="button"
                                                class="shop-card-qty-btn"
                                                title="Tăng số lượng"
                                                disabled="@(inCartItem.Quantity >= prod.Quantity)"
                                                @onclick="() => CartService.UpdateQuantity(prod.ProductID, 1)">
                                            +
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <button type="button"
                                            class="shop-card-select-btn"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => QuickAddToCart(prod)">
                                        <iconify-icon icon="solar:cart-plus-bold"></iconify-icon>
                                        <span>Chọn vào đơn</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- CỘT PHẢI: CHI TIẾT GIỎ HÀNG & ĐẶT ĐƠN LỚN, RÕ RÀNG -->
        <aside class="shop-cart-panel">
            <div class="shop-cart-header">
                <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:bill-check-bold" class="text-primary text-xl"></iconify-icon>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 mb-0">Chi tiết giỏ hàng &amp; Đặt đơn</h3>
                        <span class="text-[11px] text-slate-500">Kiểm tra các món bánh đã chọn và xác nhận đặt hàng</span>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <span class="bakery-badge bakery-badge-primary text-xs">@CartService.TotalItemsCount món</span>
                    @if (CartService.Items.Any())
                    {
                        <button type="button" class="text-xs text-rose-600 font-semibold hover:underline border-0 bg-transparent cursor-pointer"
                                @onclick="ClearCart">
                            Xóa giỏ
                        </button>
                    }
                </div>
            </div>

            <div class="shop-cart-body">
                @if (!CartService.Items.Any())
                {
                    <div class="text-center py-8 text-slate-500">
                        <iconify-icon icon="solar:cart-large-2-linear" class="text-5xl text-slate-300 mb-2"></iconify-icon>
                        <p class="text-sm font-bold text-slate-700 mb-1">Chưa có món bánh nào trong đơn</p>
                        <p class="text-xs mb-0">Hãy bấm <strong>"Chọn vào đơn"</strong> ở các ô bánh bên trái để bắt đầu đặt bánh nhé!</p>
                    </div>
                }
                else
                {
                    <!-- Danh sách chi tiết các món đã chọn -->
                    <div class="shop-cart-items">
                        @foreach (var item in CartService.Items)
                        {
                            <div class="shop-cart-item">
                                <div class="flex items-center gap-2.5 min-w-0 flex-1">
                                    <img src="@item.ImageURL" alt="@item.ProductName" class="shop-cart-item-img"
                                         onerror="this.src='/assets/images/products/default-bakery.svg'" />
                                    <div class="min-w-0 flex-1">
                                        <div class="text-xs font-bold text-slate-900 truncate" title="@item.ProductName">@item.ProductName</div>
                                        <div class="text-[11px] text-slate-500">
                                            Đơn giá: <strong class="text-slate-700">@($"{item.UnitPrice:N0}đ")</strong> &bull; Tồn: @item.MaxStock
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2.5 shrink-0">
                                    <div class="shop-stepper">
                                        <button type="button" @onclick="() => CartService.UpdateQuantity(item.ProductID, -1)" title="Giảm">-</button>
                                        <span>@item.Quantity</span>
                                        <button type="button" @onclick="() => CartService.UpdateQuantity(item.ProductID, 1)"
                                                disabled="@(item.Quantity >= item.MaxStock)" title="Tăng">+</button>
                                    </div>
                                    <div class="text-right" style="min-width: 78px;">
                                        <strong class="text-xs text-primary">@($"{item.SubTotal:N0}đ")</strong>
                                    </div>
                                    <button type="button" class="border-0 bg-transparent text-rose-600 cursor-pointer p-1"
                                            title="Xóa món"
                                            @onclick="() => CartService.RemoveItem(item.ProductID)">
                                        <iconify-icon icon="solar:trash-bin-trash-linear"></iconify-icon>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Mã khuyến mãi / Kho voucher -->
                    <div class="shop-section-box">
                        <div class="shop-section-title">
                            <span>Mã khuyến mãi / Voucher</span>
                            <button type="button" class="text-xs font-bold text-primary border-0 bg-transparent cursor-pointer hover:underline"
                                    @onclick="() => isVoucherModalOpen = true">
                                Chọn từ kho (@promotions.Count)
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(CartService.AppliedVoucherCode))
                        {
                            <div class="shop-alert-inline is-info mb-2 flex items-center justify-between gap-2">
                                <div class="min-w-0">
                                    <div class="font-bold">Mã: @CartService.AppliedVoucherCode</div>
                                    <div class="text-[11px]">@CartService.AppliedPromotionSummary</div>
                                </div>
                                <button type="button" class="bakery-btn bakery-btn-outline bakery-btn-sm shrink-0"
                                        @onclick="RemoveVoucher">
                                    Bỏ mã
                                </button>
                            </div>
                        }

                        <div class="flex gap-2">
                            <input type="text" class="bakery-input w-full" style="height: 34px;"
                                   placeholder="Nhập mã voucher..."
                                   @bind="voucherInput" />
                            <button type="button" class="bakery-btn bakery-btn-secondary bakery-btn-sm shrink-0"
                                    @onclick="ApplyVoucherByCodeAsync">
                                Áp dụng
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(voucherMessage))
                        {
                            <p class="text-xs font-semibold mt-1 mb-0 @(voucherAppliedSuccess ? "text-emerald-600" : "text-rose-600")">
                                @voucherMessage
                            </p>
                        }

                        @if (!string.IsNullOrEmpty(CartService.AppliedVoucherCode) && CartService.RemainingForVoucher > 0)
                        {
                            <div class="shop-alert-inline is-warning mt-1.5">
                                Cần mua thêm <strong>@($"{CartService.RemainingForVoucher:N0}đ")</strong> để áp dụng mã @CartService.AppliedVoucherCode.
                            </div>
                        }
                        else if (string.IsNullOrEmpty(CartService.AppliedVoucherCode) && GetUpsellSuggestion() is string upsell)
                        {
                            <div class="shop-alert-inline is-info mt-1.5">
                                @upsell
                            </div>
                        }
                    </div>

                    <!-- Thông tin giao nhận 2 cột gọn gàng -->
                    <div class="shop-section-box">
                        <div class="shop-section-title">
                            <span>Thông tin nhận bánh</span>
                        </div>
                        <div class="shop-form-grid-2">
                            <div>
                                <label class="text-[11px] font-semibold text-slate-600 block mb-0.5">Người nhận (*)</label>
                                <input type="text" class="bakery-input w-full" style="height: 34px;"
                                       placeholder="Họ và tên người nhận" @bind="receiverName" />
                            </div>
                            <div>
                                <label class="text-[11px] font-semibold text-slate-600 block mb-0.5">Số điện thoại (*)</label>
                                <input type="tel" class="bakery-input w-full" style="height: 34px;"
                                       placeholder="SĐT liên hệ" @bind="receiverPhone" />
                            </div>
                            <div>
                                <label class="text-[11px] font-semibold text-slate-600 block mb-0.5">Địa chỉ giao bánh (*)</label>
                                <input type="text" class="bakery-input w-full" style="height: 34px;"
                                       placeholder="Địa chỉ nhận bánh" @bind="receiverAddress" />
                            </div>
                            <div>
                                <label class="text-[11px] font-semibold text-slate-600 block mb-0.5">Ghi chú cho tiệm</label>
                                <input type="text" class="bakery-input w-full" style="height: 34px;"
                                       placeholder="VD: Viết chữ, giao trước 17h..." @bind="orderNote" />
                            </div>
                        </div>
                    </div>

                    <!-- Phương thức thanh toán 2 cột ngang -->
                    <div class="shop-section-box">
                        <div class="shop-section-title">
                            <span>Phương thức thanh toán</span>
                        </div>
                        <div class="shop-pay-grid-2">
                            <label class="shop-pay-option @(selectedPaymentMethod == PaymentMethod.COD ? "active" : "")">
                                <span class="flex items-center gap-1.5">
                                    <input type="radio" name="webPaymentMethod"
                                           checked="@(selectedPaymentMethod == PaymentMethod.COD)"
                                           @onchange="() => selectedPaymentMethod = PaymentMethod.COD" />
                                    <span>Tiền mặt (COD)</span>
                                </span>
                                <iconify-icon icon="solar:wallet-money-bold" class="text-base"></iconify-icon>
                            </label>

                            <label class="shop-pay-option @(selectedPaymentMethod == PaymentMethod.BankTransfer ? "active" : "")">
                                <span class="flex items-center gap-1.5">
                                    <input type="radio" name="webPaymentMethod"
                                           checked="@(selectedPaymentMethod == PaymentMethod.BankTransfer)"
                                           @onchange="() => selectedPaymentMethod = PaymentMethod.BankTransfer" />
                                    <span>Chuyển khoản QR</span>
                                </span>
                                <iconify-icon icon="solar:qr-code-bold" class="text-base"></iconify-icon>
                            </label>
                        </div>
                    </div>

                    <!-- Tổng kết thanh toán -->
                    <div class="shop-summary-box">
                        <div class="shop-summary-row">
                            <span>Tạm tính (@CartService.TotalItemsCount món)</span>
                            <strong>@($"{CartService.SubTotalAmount:N0}đ")</strong>
                        </div>
                        @if (CartService.InvoiceDiscountAmount > 0)
                        {
                            <div class="shop-summary-row" style="color: #dc2626;">
                                <span>Giảm theo hóa đơn</span>
                                <strong>-@($"{CartService.InvoiceDiscountAmount:N0}đ")</strong>
                            </div>
                        }
                        @if (CartService.ProductDiscountAmount > 0)
                        {
                            <div class="shop-summary-row" style="color: #dc2626;">
                                <span>Giảm theo sản phẩm</span>
                                <strong>-@($"{CartService.ProductDiscountAmount:N0}đ")</strong>
                            </div>
                        }
                        <div class="shop-summary-row">
                            <span>Phí giao hàng</span>
                            <strong style="color: #059669;">Miễn phí (Freeship)</strong>
                        </div>
                        <div class="shop-summary-total">
                            <span>Tổng thanh toán</span>
                            <span class="text-primary">@($"{CartService.FinalAmount:N0}đ")</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(checkoutError))
                    {
                        <div class="shop-alert-inline is-error">@checkoutError</div>
                    }

                    <button type="button" class="bakery-btn bakery-btn-primary w-full" style="height: 44px; font-size: 0.875rem;"
                            disabled="@isSubmittingOrder"
                            @onclick="RequestPlaceOrder">
                        <iconify-icon icon="@(selectedPaymentMethod == PaymentMethod.BankTransfer ? "solar:qr-code-bold" : "solar:check-circle-bold")"></iconify-icon>
                        @if (isSubmittingOrder)
                        {
                            <span>Đang gửi đơn hàng...</span>
                        }
                        else if (selectedPaymentMethod == PaymentMethod.BankTransfer)
                        {
                            <span>Thanh toán VietQR &amp; Đặt đơn • @($"{CartService.FinalAmount:N0}đ")</span>
                        }
                        else
                        {
                            <span>Xác nhận đặt đơn ngay • @($"{CartService.FinalAmount:N0}đ")</span>
                        }
                    </button>
                }
            </div>
        </aside>
    </div>
}

<!-- MODAL CHI TIẾT MÓN BÁNH -->
@if (selectedProduct is not null)
{
    var prodDiscount = CartService.GetProductDiscountAmount(selectedProduct.ProductID, selectedProduct.Price * modalQuantity);
    <div class="bakery-modal-backdrop" @onclick="() => selectedProduct = null">
        <div class="bakery-modal-card max-w-md" @onclick:stopPropagation="true">
            <div class="bakery-modal-header">
                <div>
                    <h4 class="text-base font-bold text-slate-900 mb-0">@selectedProduct.ProductName</h4>
                    <span class="text-xs text-slate-500">@(selectedProduct.Category?.CategoryName ?? "Bánh tươi")</span>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 text-xl font-bold border-0 bg-transparent cursor-pointer"
                        @onclick="() => selectedProduct = null">&times;</button>
            </div>
            <div class="bakery-modal-body space-y-3">
                <div style="height: 210px; border-radius: 10px; overflow: hidden; background: #f1f5f9;">
                    <img src="@WebCartService.ResolveProductImageUrl(selectedProduct)"
                         alt="@selectedProduct.ProductName"
                         style="width: 100%; height: 100%; object-fit: cover;"
                         onerror="this.src='/assets/images/products/default-bakery.svg'" />
                </div>
                <p class="text-xs text-slate-600 mb-0">
                    @(string.IsNullOrWhiteSpace(selectedProduct.Description) ? "Bánh thủ công nướng mới mỗi ngày tại BakerySystem." : selectedProduct.Description)
                </p>
                <div class="flex items-center justify-between pt-2 border-t border-slate-100">
                    <div>
                        <span class="text-xs text-slate-500 block">Đơn giá</span>
                        <strong class="text-base text-primary">@($"{selectedProduct.Price:N0}đ")</strong>
                        @if (prodDiscount > 0)
                        {
                            <span class="text-xs text-emerald-600 font-semibold block">
                                Giảm thêm @($"{prodDiscount:N0}đ") với mã đang chọn
                            </span>
                        }
                    </div>
                    <div class="text-right">
                        <span class="text-xs text-slate-500 block">Tồn kho</span>
                        <strong class="text-xs @(selectedProduct.Quantity <= 0 ? "text-rose-600" : "text-slate-800")">
                            @(selectedProduct.Quantity <= 0 ? "Hết hàng" : $"Còn {selectedProduct.Quantity} phần")
                        </strong>
                    </div>
                </div>
                @if (selectedProduct.Quantity > 0)
                {
                    <div class="flex items-center justify-between pt-2">
                        <span class="text-xs font-semibold text-slate-700">Số lượng đặt:</span>
                        <div class="shop-stepper">
                            <button type="button" @onclick="() => { if (modalQuantity > 1) modalQuantity--; }">-</button>
                            <span style="min-width: 34px;">@modalQuantity</span>
                            <button type="button" @onclick="() => { if (modalQuantity < selectedProduct.Quantity) modalQuantity++; }"
                                    disabled="@(modalQuantity >= selectedProduct.Quantity)">+</button>
                        </div>
                    </div>
                }
            </div>
            <div class="bakery-modal-footer">
                <button type="button" class="bakery-btn bakery-btn-outline" @onclick="() => selectedProduct = null">Đóng</button>
                <button type="button" class="bakery-btn bakery-btn-primary"
                        disabled="@(selectedProduct.Quantity <= 0)"
                        @onclick="AddFromModal">
                    <iconify-icon icon="solar:cart-plus-bold"></iconify-icon>
                    <span>Chọn vào đơn (@($"{(selectedProduct.Price * modalQuantity - prodDiscount):N0}đ"))</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- MODAL KHO VOUCHER -->
@if (isVoucherModalOpen)
{
    <div class="bakery-modal-backdrop" @onclick="() => isVoucherModalOpen = false">
        <div class="bakery-modal-card max-w-lg" @onclick:stopPropagation="true">
            <div class="bakery-modal-header">
                <div class="flex items-center gap-2.5">
                    <div class="bakery-modal-icon-badge blue"><iconify-icon icon="solar:ticket-sale-bold"></iconify-icon></div>
                    <div>
                        <h4 class="text-base font-bold text-slate-900 mb-0">Kho Voucher &amp; Khuyến Mãi</h4>
                        <p class="text-xs text-slate-500 mb-0">@promotions.Count mã ưu đãi khả dụng hôm nay</p>
                    </div>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 text-xl font-bold border-0 bg-transparent cursor-pointer"
                        @onclick="() => isVoucherModalOpen = false">&times;</button>
            </div>
            <div class="bakery-modal-body space-y-2.5" style="max-height: 65vh; overflow-y: auto;">
                @if (!promotions.Any())
                {
                    <p class="text-center text-xs text-slate-500 py-6 mb-0">Hiện chưa có mã khuyến mãi nào đang mở.</p>
                }
                else
                {
                    @foreach (var promo in promotions)
                    {
                        var isApplied = CartService.AppliedVoucherCode.Equals(promo.PromotionCode, StringComparison.OrdinalIgnoreCase);
                        var inv = promo.PromotionInvoice;
                        var firstProd = promo.PromotionProducts.FirstOrDefault();
                        var badgeLabel = inv?.DiscountAmount is > 0
                            ? $"{inv.DiscountAmount.Value / 1000m:0.#}K"
                            : $"{(inv?.DiscountPercent ?? firstProd?.DiscountPercent ?? 0):0.##}%";

                        <div class="shop-voucher-card @(isApplied ? "is-active" : "")">
                            <div class="shop-voucher-stub">
                                <span class="text-base font-bold">@badgeLabel</span>
                                <span class="text-[10px] uppercase tracking-wider">GIẢM</span>
                            </div>
                            <div class="shop-voucher-body">
                                <div class="min-w-0 flex-1">
                                    <div class="text-xs font-bold text-slate-900">@promo.PromotionName</div>
                                    <div class="text-[11px] text-slate-600 mt-0.5">
                                        @if (inv is not null)
                                        {
                                            <span>Đơn từ @($"{inv.MinOrderAmount:N0}đ")</span>
                                            @if (inv.MaxDiscountAmount is > 0)
                                            {
                                                <span> &bull; Tối đa @($"{inv.MaxDiscountAmount.Value:N0}đ")</span>
                                            }
                                        }
                                        else if (promo.PromotionProducts.Count > 0)
                                        {
                                            var names = string.Join(", ", promo.PromotionProducts.Select(p => p.Product?.ProductName).Where(n => !string.IsNullOrWhiteSpace(n)));
                                            <span>Áp dụng: @names</span>
                                        }
                                    </div>
                                    <div class="text-[10px] text-slate-400 mt-1">
                                        Mã: <strong class="font-mono text-primary">@promo.PromotionCode</strong>
                                        &bull; HSD: @promo.EndDate.ToString("dd/MM/yyyy")
                                        @if (inv?.UsageLimit is int limit)
                                        {
                                            <span> &bull; Còn @(Math.Max(0, limit - inv.UsedCount))/@limit lượt</span>
                                        }
                                    </div>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <button type="button" class="bakery-btn bakery-btn-outline bakery-btn-sm"
                                            @onclick="() => CopyVoucherCodeAsync(promo.PromotionCode)">
                                        Sao chép
                                    </button>
                                    @if (isApplied)
                                    {
                                        <button type="button" class="bakery-btn bakery-btn-secondary bakery-btn-sm"
                                                @onclick="RemoveVoucher">
                                            Đang chọn
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="bakery-btn bakery-btn-primary bakery-btn-sm"
                                                @onclick="() => UseVoucherFromModal(promo)">
                                            Dùng ngay
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="bakery-modal-footer">
                <button type="button" class="bakery-btn bakery-btn-outline" @onclick="() => isVoucherModalOpen = false">Đóng</button>
            </div>
        </div>
    </div>
}

<!-- MODAL THANH TOÁN QR MÔ PHỎNG -->
@if (isQrModalOpen)
{
    <div class="bakery-modal-backdrop" @onclick="() => isQrModalOpen = false">
        <div class="bakery-modal-card bakery-qr-payment-modal" @onclick:stopPropagation="true">
            <div class="bakery-modal-header">
                <div class="flex items-center gap-2.5">
                    <div class="bakery-modal-icon-badge blue"><iconify-icon icon="solar:qr-code-bold"></iconify-icon></div>
                    <div>
                        <h4 class="text-base font-bold text-slate-900 mb-0">Thanh toán chuyển khoản QR</h4>
                        <p class="text-xs text-slate-500 mb-0">Quét mã VietQR để thanh toán đơn hàng</p>
                    </div>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 text-lg border-0 bg-transparent cursor-pointer"
                        @onclick="() => isQrModalOpen = false">
                    <iconify-icon icon="solar:close-circle-linear"></iconify-icon>
                </button>
            </div>
            <div class="bakery-qr-payment-content">
                <div class="bakery-fake-qr" aria-label="Mã QR thanh toán giả lập">
                    @for (var row = 0; row < 21; row++)
                    {
                        @for (var col = 0; col < 21; col++)
                        {
                            <span class="@(IsFakeQrCellDark(row, col) ? "dark" : "")"></span>
                        }
                    }
                </div>
                <div class="bakery-qr-payment-amount">
                    <span>Số tiền cần thanh toán</span>
                    <strong>@($"{CartService.FinalAmount:N0} đ")</strong>
                </div>
                <div class="bakery-qr-payment-note">
                    <iconify-icon icon="solar:info-circle-linear" class="text-base shrink-0"></iconify-icon>
                    <span>Đây là mô phỏng thanh toán trực tuyến trên hệ thống. Bấm xác nhận sau khi kiểm tra số tiền.</span>
                </div>
            </div>
            <div class="bakery-modal-footer">
                <button type="button" class="bakery-btn bakery-btn-outline" @onclick="() => isQrModalOpen = false">Hủy</button>
                <button type="button" class="bakery-btn bakery-btn-primary" disabled="@isSubmittingOrder" @onclick="ConfirmQrPaymentAsync">
                    <iconify-icon icon="solar:check-circle-bold"></iconify-icon>
                    <span>@(isSubmittingOrder ? "Đang xử lý..." : "Tôi đã thanh toán")</span>
                </button>
            </div>
        </div>
    </div>
}

