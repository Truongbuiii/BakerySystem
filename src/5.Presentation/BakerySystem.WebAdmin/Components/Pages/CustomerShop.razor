@code {
    private CustomerDto? customerProfile;
    private List<Category> categories = [];
    private List<Product> products = [];
    private List<Promotion> promotions = [];
    private List<Order> customerOrders = [];

    private bool isLoading = true;
    private string searchQuery = string.Empty;
    private int selectedCategoryId;
    private string sortOrder = "default";

    private Product? selectedProduct;
    private int modalQuantity = 1;

    private bool isVoucherModalOpen;
    private string voucherInput = string.Empty;
    private string voucherMessage = string.Empty;
    private bool voucherAppliedSuccess;

    private string receiverName = string.Empty;
    private string receiverPhone = string.Empty;
    private string receiverAddress = string.Empty;
    private string orderNote = string.Empty;
    private string selectedPaymentMethod = PaymentMethod.COD;
    private string? checkoutError;

    private bool isSubmittingOrder;
    private bool isQrModalOpen;
    private Order? justPlacedOrder;
    private string? toastMessage;
    private bool isDisposed;

    private IEnumerable<Product> FilteredProducts
    {
        get
        {
            var query = products.AsEnumerable();
            if (selectedCategoryId > 0)
                query = query.Where(p => p.CategoryID == selectedCategoryId);

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var term = searchQuery.Trim();
                query = query.Where(p => p.ProductName.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (p.Description != null && p.Description.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            return sortOrder switch
            {
                "price-asc" => query.OrderBy(p => p.Price),
                "price-desc" => query.OrderByDescending(p => p.Price),
                _ => query
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += HandleStateChanged;
        NotifService.OnOrderChanged += HandleExternalOrderChanged;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        int.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var accountId);

        if (accountId > 0)
        {
            customerProfile = await AuthService.GetCustomerByAccountIdAsync(accountId);
            if (customerProfile is not null)
            {
                receiverName = customerProfile.FullName;
                receiverPhone = customerProfile.Phone ?? string.Empty;
                receiverAddress = customerProfile.Address ?? string.Empty;
            }
        }

        await LoadDataAsync();
        isLoading = false;
    }

    private async Task LoadDataAsync()
    {
        categories = await CustomerOrderService.GetCategoriesAsync();
        products = await CustomerOrderService.GetActiveProductsAsync();
        promotions = await CustomerOrderService.GetActivePromotionsAsync();
        if (customerProfile is not null)
            customerOrders = await CustomerOrderService.GetOrdersAsync(customerProfile.CustomerId, null);
    }

    private async Task RefreshCatalogAsync()
    {
        await LoadDataAsync();
        ShowToast("Đã cập nhật thực đơn mới nhất!");
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    private void HandleExternalOrderChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (isDisposed) return;
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    private void ResetFilters()
    {
        searchQuery = string.Empty;
        selectedCategoryId = 0;
        sortOrder = "default";
    }

    private void OpenProductModal(Product product)
    {
        selectedProduct = product;
        modalQuantity = product.Quantity > 0 ? 1 : 0;
    }

    private void AddFromModal()
    {
        if (selectedProduct is null || selectedProduct.Quantity <= 0 || modalQuantity <= 0)
            return;

        CartService.AddItem(selectedProduct, modalQuantity);
        ShowToast($"Đã thêm {modalQuantity} × {selectedProduct.ProductName} vào đơn.");
        selectedProduct = null;
    }

    private void QuickAddToCart(Product product)
    {
        if (product.Quantity <= 0) return;
        CartService.AddItem(product, 1);
        ShowToast($"Đã chọn {product.ProductName} vào đơn.");
    }

    private void ClearCart()
    {
        CartService.Clear();
        voucherMessage = string.Empty;
        checkoutError = null;
    }

    private async Task ApplyVoucherByCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(voucherInput))
        {
            voucherAppliedSuccess = false;
            voucherMessage = "Vui lòng nhập mã khuyến mãi.";
            return;
        }

        var ok = await CartService.ApplyVoucherAsync(voucherInput, CustomerOrderService);
        if (ok)
        {
            voucherAppliedSuccess = true;
            voucherMessage = $"Đã áp dụng mã {CartService.AppliedVoucherCode}!";
            ShowToast($"Đã áp dụng mã {CartService.AppliedVoucherCode}!");
            voucherInput = string.Empty;
        }
        else
        {
            voucherAppliedSuccess = false;
            voucherMessage = "Mã voucher không hợp lệ, đã hết hạn hoặc hết lượt sử dụng.";
        }
    }

    private void UseVoucherFromModal(Promotion promo)
    {
        if (CartService.ApplyPromotion(promo))
        {
            voucherAppliedSuccess = true;
            voucherMessage = $"Đã áp dụng mã {promo.PromotionCode}!";
            isVoucherModalOpen = false;
            ShowToast($"Đã áp dụng mã {promo.PromotionCode}!");
        }
    }

    private void RemoveVoucher()
    {
        CartService.RemoveVoucher();
        voucherMessage = string.Empty;
        ShowToast("Đã bỏ áp dụng voucher.");
    }

    private async Task CopyVoucherCodeAsync(string code)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            ShowToast($"Đã sao chép mã {code}!");
        }
        catch
        {
            ShowToast($"Mã ưu đãi: {code}");
        }
    }

    private string? GetUpsellSuggestion()
    {
        var subtotal = CartService.SubTotalAmount;
        var candidate = promotions
            .Where(p => p.PromotionInvoice is not null && p.PromotionInvoice.MinOrderAmount > subtotal)
            .Select(p => new { Promo = p, Missing = p.PromotionInvoice!.MinOrderAmount - subtotal })
            .Where(x => x.Missing <= 150000m)
            .OrderBy(x => x.Missing)
            .FirstOrDefault();

        if (candidate is null) return null;
        var inv = candidate.Promo.PromotionInvoice!;
        var discountDesc = inv.DiscountAmount is > 0
            ? $"{inv.DiscountAmount.Value:N0}đ"
            : $"{inv.DiscountPercent:0.##}%";
        return $"Mua thêm {candidate.Missing:N0}đ để được giảm {discountDesc} với mã {candidate.Promo.PromotionCode}!";
    }

    private async Task RequestPlaceOrder()
    {
        checkoutError = null;
        if (isSubmittingOrder || !CartService.Items.Any())
            return;

        if (customerProfile is null)
        {
            checkoutError = "Không tìm thấy hồ sơ khách hàng. Vui lòng đăng nhập lại.";
            return;
        }

        if (string.IsNullOrWhiteSpace(receiverName) || string.IsNullOrWhiteSpace(receiverPhone) || string.IsNullOrWhiteSpace(receiverAddress))
        {
            checkoutError = "Vui lòng nhập đầy đủ họ tên, số điện thoại và địa chỉ giao bánh.";
            return;
        }

        if (CartService.RemainingForVoucher > 0)
        {
            checkoutError = $"Đơn hàng chưa đạt mức tối thiểu của mã {CartService.AppliedVoucherCode}. Vui lòng mua thêm {CartService.RemainingForVoucher:N0}đ hoặc bỏ chọn mã.";
            return;
        }

        if (selectedPaymentMethod == PaymentMethod.BankTransfer)
        {
            isQrModalOpen = true;
            return;
        }

        await SubmitOrderAsync();
    }

    private async Task ConfirmQrPaymentAsync()
    {
        isQrModalOpen = false;
        await SubmitOrderAsync();
    }

    private async Task SubmitOrderAsync()
    {
        if (isSubmittingOrder || customerProfile is null)
            return;

        isSubmittingOrder = true;
        checkoutError = null;
        try
        {
            var input = new CreateCustomerOrderInput(
                customerProfile.CustomerId,
                receiverName,
                receiverPhone,
                receiverAddress,
                orderNote,
                selectedPaymentMethod,
                CartService.AppliedPromotionId,
                CartService.Items.Select(i => new CustomerOrderLineInput(i.ProductID, i.Quantity)).ToList());

            var created = await CustomerOrderService.CreateOrderAsync(input);
            justPlacedOrder = created;
            orderNote = string.Empty;
            voucherMessage = string.Empty;
            CartService.Clear();

            await LoadDataAsync();
            NotifService.NotifyOrderChanged();
        }
        catch (Exception ex)
        {
            checkoutError = ex.Message;
        }
        finally
        {
            isSubmittingOrder = false;
        }
    }

    private async Task ConfirmDeliveredOrderAsync(int orderId)
    {
        if (customerProfile is null) return;
        var ok = await CustomerOrderService.ConfirmReceivedOrderAsync(orderId, customerProfile.CustomerId);
        if (ok)
        {
            ShowToast($"Đã xác nhận nhận thành công đơn #HD-{orderId:D4}!");
            await LoadDataAsync();
            NotifService.NotifyOrderChanged();
        }
    }

    private static bool IsFakeQrCellDark(int row, int column)
    {
        static bool InFinder(int r, int c, int startRow, int startColumn)
        {
            var localRow = r - startRow;
            var localColumn = c - startColumn;
            return localRow is >= 0 and < 7 && localColumn is >= 0 and < 7
                && (localRow is 0 or 6 || localColumn is 0 or 6
                    || (localRow is >= 2 and <= 4 && localColumn is >= 2 and <= 4));
        }

        if (InFinder(row, column, 0, 0) || InFinder(row, column, 0, 14) || InFinder(row, column, 14, 0))
            return true;

        return ((row * 13 + column * 7 + row * column) % 5) < 2;
    }

    private void ShowToast(string message)
    {
        toastMessage = message;
        _ = Task.Run(async () =>
        {
            await Task.Delay(2600);
            if (isDisposed) return;
            toastMessage = null;
            await InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose()
    {
        isDisposed = true;
        CartService.OnChange -= HandleStateChanged;
        NotifService.OnOrderChanged -= HandleExternalOrderChanged;
    }
}
